+#elif defined(__APPLE__)
+	// Darwin has CLOCK_MONOTONIC but no clock_nanosleep/TIMER_ABSTIME.
+	// Recheck the same clock after interruption to retain an absolute deadline.
+	for (;;)
+	{
+		const int64_t remaining = timepoint - get_current_time_nsecs();
+		if (remaining <= 0)
+			break;
+		const timespec delay = { time_t(remaining / 1000000000ll), long(remaining % 1000000000ll) };
+		if (nanosleep(&delay, nullptr) < 0 && errno != EINTR)
+			break;
+	}
