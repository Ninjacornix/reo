+    void toggleBorderless(HWND hwnd)
+    {
+        const LONG_PTR style = GetWindowLongPtrW(hwnd, GWL_STYLE);
+        if (style & WS_OVERLAPPEDWINDOW)
+        {
+            g_windowedStyle = style;
+            g_windowedPlacement.length = sizeof(g_windowedPlacement);
+            g_havePlacement = GetWindowPlacement(hwnd, &g_windowedPlacement) != FALSE;
+            MONITORINFO monitor{sizeof(MONITORINFO)};
+            if (!GetMonitorInfoW(MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST), &monitor)) return;
+            SetWindowLongPtrW(hwnd, GWL_STYLE, style & ~WS_OVERLAPPEDWINDOW);
+            SetWindowPos(hwnd, HWND_TOP, monitor.rcMonitor.left, monitor.rcMonitor.top,
+                monitor.rcMonitor.right - monitor.rcMonitor.left, monitor.rcMonitor.bottom - monitor.rcMonitor.top,
+                SWP_FRAMECHANGED | SWP_NOOWNERZORDER);
+            std::fprintf(stderr, "[HOST-WINDOW] fullscreen=1 (Ctrl+Enter)\n");
+        }
+        else
+        {
+            SetWindowLongPtrW(hwnd, GWL_STYLE, g_havePlacement ? g_windowedStyle : style | WS_OVERLAPPEDWINDOW);
+            if (g_havePlacement) SetWindowPlacement(hwnd, &g_windowedPlacement);
+            else
+            {
+                auto dimension = [](const char* name, int fallback, int minimum, int maximum) {
+                    const char* value = std::getenv(name);
+                    return value ? std::clamp(std::atoi(value), minimum, maximum) : fallback;
+                };
+                RECT rect{0,0,dimension("REO_WINDOW_WIDTH",1024,320,8192),dimension("REO_WINDOW_HEIGHT",768,240,4320)};
+                AdjustWindowRectExForDpi(&rect, static_cast<DWORD>(style | WS_OVERLAPPEDWINDOW), FALSE,
+                    static_cast<DWORD>(GetWindowLongPtrW(hwnd,GWL_EXSTYLE)), GetDpiForWindow(hwnd));
+                SetWindowPos(hwnd, nullptr, 80, 60, rect.right-rect.left, rect.bottom-rect.top, SWP_NOZORDER);
+            }
+            SetWindowPos(hwnd, nullptr, 0,0,0,0,SWP_NOMOVE|SWP_NOSIZE|SWP_NOZORDER|SWP_FRAMECHANGED);
+            std::fprintf(stderr, "[HOST-WINDOW] fullscreen=0 (Ctrl+Enter)\n");
+        }
+    }
 
