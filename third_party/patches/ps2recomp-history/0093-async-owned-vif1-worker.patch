+class PS2Memory;
+class PS2Runtime;
+namespace reo_async_vif {
+bool requested() noexcept;
+bool onWorker(const PS2Memory&) noexcept;
+void attach(PS2Memory&,PS2Runtime*);
+bool active(PS2Memory&);
+bool enqueue(PS2Memory&,std::function<void()>,size_t bytes);
+bool deferPublication(PS2Memory&,std::function<void()>);
+bool queueRegisterWrite(PS2Memory&,uint32_t,uint32_t);
+void beforeAccess(PS2Memory&,uint32_t,bool);
+void beforeRegisterRead(PS2Memory&,uint32_t);
+void drain(PS2Memory&);
+void check(PS2Memory&);
+void requestStop(PS2Memory&);
+void shutdown(PS2Memory&);
+}
