+    int resolveTextureCoordinate(int coordinate, int size, uint64_t clamp, bool vertical)
+    {
+        const unsigned mode = unsigned((clamp >> (vertical ? 2 : 0)) & 3u);
+        const int minimum = int((clamp >> (vertical ? 24 : 4)) & 0x3FFu);
+        const int maximum = int((clamp >> (vertical ? 34 : 14)) & 0x3FFu);
+        switch (mode)
+        {
+        case 0: return int(uint32_t(coordinate) & uint32_t(size - 1)); // REPEAT
+        case 1: return clampInt(coordinate, 0, size - 1); // CLAMP
+        case 2: return std::min(std::max(coordinate, minimum), maximum); // REGION_CLAMP
+        default: return int((uint32_t(coordinate) & uint32_t(minimum)) | uint32_t(maximum)); // REGION_REPEAT
+        }
+    }
+
+    bool textureCoordinatesStayInDeclaredSize(uint64_t clamp)
+    {
+        // Region modes can address valid VRAM beyond TEX0.TW/TH. Existing
+        // sprite tile/page proofs cover only the declared texture rectangle.
+        return (clamp & 2u) == 0 && (clamp & 8u) == 0;
     }
 
