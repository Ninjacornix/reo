diff --git a/ps2xRuntime/src/lib/vu_specialized_route.cpp b/ps2xRuntime/src/lib/vu_specialized_route.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu_specialized_route.cpp
@@ -0,0 +1,81 @@
+#include "vu_specialized_route.h"
+#include <atomic>
+#include <cstring>
+#include <limits>
+
+namespace vu_specialized {
+namespace {
+std::atomic<const ProgramTable*> publishedTable{nullptr};
+
+uint64_t firstPair(const uint8_t* code) noexcept {
+    uint64_t value;
+    std::memcpy(&value, code, sizeof(value));
+    return value;
+}
+
+bool disjoint(const uint8_t* a, uint32_t aBytes, const uint8_t* b, uint32_t bBytes) noexcept {
+    const uintptr_t x = reinterpret_cast<uintptr_t>(a);
+    const uintptr_t y = reinterpret_cast<uintptr_t>(b);
+    const uintptr_t max = std::numeric_limits<uintptr_t>::max();
+    if (!a || !b || x > max - aBytes || y > max - bBytes) return false;
+    return x + aBytes <= y || y + bBytes <= x;
+}
+}
+
+bool registerProgramTable(const ProgramTable* table) noexcept {
+    if (!table || !table->count) {
+        publishedTable.store(nullptr, std::memory_order_release);
+        return true;
+    }
+    if (!table->programs || table->count > 64u) return false;
+    for (uint32_t i = 0; i < table->count; ++i) {
+        const auto& p = table->programs[i];
+        if (!p.exactCodeImage || !p.entryBlocks || p.codeBytes < 8u ||
+            p.codeBytes > 16384u || (p.codeBytes & 7u) || !p.dataBytes || p.dataBytes > 16384u)
+            return false;
+        for (uint32_t j = 0; j < i; ++j)
+            if (firstPair(p.exactCodeImage) == firstPair(table->programs[j].exactCodeImage))
+                return false;
+        for (uint32_t entry = 0; entry < p.codeBytes / 8u; ++entry) {
+            const Block* block = p.entryBlocks[entry];
+            if (!block) continue;
+            if (!block->execute || !block->instructionPairs ||
+                block->instructionPairs > p.codeBytes / 8u - entry)
+                return false;
+            for (uint32_t pair = 0; pair < block->instructionPairs; ++pair) {
+                uint32_t lower, upper;
+                const auto* bytes = p.exactCodeImage + (entry + pair) * 8u;
+                std::memcpy(&lower, bytes, 4);
+                std::memcpy(&upper, bytes + 4, 4);
+                if (upper & 0x40000000u) return false;
+                if (!(upper & 0x80000000u) && ((lower >> 25) & 0x7Fu) == 0x40u &&
+                    (lower & 0x7FFu) == 0x6FCu)
+                    return false;
+            }
+        }
+    }
+    publishedTable.store(table, std::memory_order_release);
+    return true;
+}
+
+uint32_t registeredProgramCount() noexcept {
+    const ProgramTable* table = publishedTable.load(std::memory_order_acquire);
+    return table ? table->count : 0u;
+}
+
+const Program* selectProgram(const uint8_t* code, uint32_t codeBytes,
+    const uint8_t* data, uint32_t dataBytes, bool captureActive) noexcept {
+    const ProgramTable* table = publishedTable.load(std::memory_order_acquire);
+    if (!table || captureActive || codeBytes < 8u || !disjoint(code, codeBytes, data, dataBytes))
+        return nullptr;
+    const uint64_t prefix = firstPair(code);
+    for (uint32_t i = 0; i < table->count; ++i) {
+        const Program& p = table->programs[i];
+        if (p.codeBytes != codeBytes || p.dataBytes != dataBytes || firstPair(p.exactCodeImage) != prefix)
+            continue;
+        // First-pair uniqueness means at most one full comparison, once per run.
+        return std::memcmp(code, p.exactCodeImage, codeBytes) == 0 ? &p : nullptr;
+    }
+    return nullptr;
+}
+}
diff --git a/ps2xRuntime/src/lib/vu_specialized_route.h b/ps2xRuntime/src/lib/vu_specialized_route.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu_specialized_route.h
@@ -0,0 +1,71 @@
+#pragma once
+// Private implementation API. No public VU class fields or headers change.
+#include <cstdint>
+
+struct VU1State;
+class GS;
+class PS2Memory;
+
+namespace vu_specialized {
+struct Invocation {
+    VU1State& state;
+    uint8_t* data;
+    uint32_t dataBytes;
+    GS& gs;
+    PS2Memory* memory; // May be null: original interpreter supports this.
+    bool& branchPending;
+    uint32_t& branchTarget;
+    uint32_t remainingPairs;
+    void* interpreter;
+    // Created inside VU1Interpreter::run to retain exact private C++ handlers.
+    void (*genericUpper)(void*, uint32_t upper);
+    void (*genericLower)(void*, uint32_t lower, uint8_t*, uint32_t, GS&, PS2Memory*, uint32_t upper);
+};
+
+// Adaptor for existing generated template<class Generic> block implementations.
+// A stack value, not std::function; no allocation or per-pair code comparison.
+struct GenericFallback {
+    Invocation& invocation;
+    void operator()(uint32_t lower, uint32_t upper, bool isUpper) const {
+        if (isUpper) invocation.genericUpper(invocation.interpreter, upper);
+        else invocation.genericLower(invocation.interpreter, lower,
+            invocation.data, invocation.dataBytes, invocation.gs, invocation.memory, upper);
+    }
+};
+
+struct Block {
+    uint32_t instructionPairs;
+    // Must complete exactly instructionPairs. No partial execution/refusal.
+    // Preserve original per-pair scheduling, zero-register invariants, PC,
+    // branchPending/branchTarget, arithmetic fallbacks and ordered side effects.
+    // Registered blocks contain no E pair or XGKICK; generic code handles them.
+    uint32_t (*execute)(Invocation&);
+};
+
+struct Program {
+    const uint8_t* exactCodeImage;
+    uint32_t codeBytes;
+    uint32_t dataBytes;
+    // Dense array of codeBytes/8 entries, null except complete block entries.
+    const Block* const* entryBlocks;
+};
+
+struct ProgramTable {
+    const Program* programs;
+    uint32_t count;
+};
+
+// Publish immutable caller-owned program/table/image storage before runtime init.
+// All storage, including replaced tables, must live until every VU call ends.
+// Duplicate first instruction-pair identities are rejected, avoiding ambiguous
+// matching and more than one complete image comparison per launch.
+// Null clears the registry. Failed validation leaves the prior table unchanged.
+bool registerProgramTable(const ProgramTable*) noexcept;
+uint32_t registeredProgramCount() noexcept;
+
+// One call per synchronous launch. Requires code stability for the whole launch,
+// including its generic XGKICK callbacks. Caller serializes concurrent/reentrant MPG writes; this API
+// creates no async VU/MPG lifetime protocol and never caches mutable code pointers.
+const Program* selectProgram(const uint8_t* code, uint32_t codeBytes,
+    const uint8_t* data, uint32_t dataBytes, bool captureActive) noexcept;
+}
