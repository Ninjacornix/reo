--- /dev/null
+++ b/ps2xRuntime/src/lib/vblank_music_diag.h
@@ -0,0 +1,128 @@
+#pragma once
+// Private, bounded, default-off diagnostic. Never replays an IRQ or wakes a guest.
+#include "ps2_guest_sched.h"
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace ps2_vblank_music_diag {
+enum class Kind : uint32_t {
+    TickPlan=1, Flag=2, GsCallbackDone=3, IntcLatch=4, AdmissionBegin=5,
+    Admitted=6, HandlersDone=7, CaptureQueued=8, HandlerBegin=9, HandlerEnd=10,
+    ThreadStatus=11, Wake=12, SleepEnter=13, SleepResolved=14, SleepReturn=15,
+    SjxPoll=16, PcmRetire=17, SjxPublished=18, PcmPush=19, Voice=20,
+    AudioReport=21, AsyncIntcRaise=22
+};
+struct Config { bool enabled=false; double after=0, until=5; uint32_t limit=8192; };
+inline const Config& config() noexcept {
+    static const Config c=[] {
+        Config value;
+        const char* flag=std::getenv("REO_VBLANK_MUSIC_LOG");
+        if(!flag || std::strcmp(flag,"1")) return value;
+        value.enabled=true;
+        if(const char* s=std::getenv("REO_VBLANK_MUSIC_AT")) value.after=std::max(0.0,std::atof(s));
+        value.until=value.after+5;
+        if(const char* s=std::getenv("REO_VBLANK_MUSIC_UNTIL")) value.until=std::max(value.after,std::atof(s));
+        if(const char* s=std::getenv("REO_VBLANK_MUSIC_LIMIT"))
+            value.limit=uint32_t(std::min(16384ul,std::strtoul(s,nullptr,10)));
+        return value;
+    }();
+    return c;
+}
+inline bool enabled() noexcept {return config().enabled;}
+inline uint64_t nowNs() noexcept {
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+struct Record {
+    uint64_t ns=0, irqTick=0, observedLatestTick=0;
+    uint32_t kind=0; int32_t tid=0; // zero-initialized bounded storage; populated rows carry the real ID
+    uint64_t a[8]{};
+};
+struct Slot { Record record{}; std::atomic<bool> ready{false}; };
+inline std::array<Slot,16384> records{};
+inline std::atomic<uint64_t> epochNs{0}, generation{0}, claimed{0}, latestTick{0};
+inline std::atomic<bool> closed{false};
+inline thread_local uint64_t currentIrqTick=0;
+// Coordinator must join all writers before begin() or flush(). No callback records.
+inline void begin() noexcept {
+    if(!enabled()) return;
+    for(auto& slot:records) slot.ready.store(false,std::memory_order_relaxed);
+    claimed.store(0,std::memory_order_relaxed); latestTick.store(0,std::memory_order_relaxed);
+    epochNs.store(nowNs(),std::memory_order_release);
+    generation.fetch_add(1,std::memory_order_relaxed); closed.store(false,std::memory_order_release);
+}
+struct TickScope {
+    uint64_t previous=0;
+    explicit TickScope(uint64_t tick) noexcept {
+        if(!enabled()) return;
+        previous=currentIrqTick; currentIrqTick=tick; latestTick.store(tick,std::memory_order_relaxed);
+    }
+    ~TickScope() { if(enabled()) currentIrqTick=previous; }
+};
+inline void note(Kind kind,uint64_t a0=0,uint64_t a1=0,uint64_t a2=0,uint64_t a3=0,
+                 uint64_t a4=0,uint64_t a5=0,uint64_t a6=0,uint64_t a7=0) noexcept {
+    const auto& c=config();
+    if(!c.enabled || !c.limit || closed.load(std::memory_order_acquire)) return;
+    const uint64_t epoch=epochNs.load(std::memory_order_acquire);
+    if(!epoch) return; // prepareRuntimeWorkers owns explicit arming.
+    const uint64_t ns=nowNs();
+    const double elapsed=double(ns-epoch)/1000000000.0;
+    if(elapsed<c.after || elapsed>c.until) return;
+    const uint64_t index=claimed.fetch_add(1,std::memory_order_relaxed);
+    if(index>=c.limit) return;
+    auto& slot=records[size_t(index)];
+    slot.record={ns,currentIrqTick,latestTick.load(std::memory_order_relaxed),
+                 uint32_t(kind),ps2_sched::currentThread(),{a0,a1,a2,a3,a4,a5,a6,a7}};
+    slot.ready.store(true,std::memory_order_release);
+}
+inline uint32_t read32(const uint8_t* ram,uint32_t address) noexcept {
+    uint32_t value;std::memcpy(&value,ram+address,4);return value;
+}
+inline uint64_t read64(const uint8_t* ram,uint32_t address) noexcept {
+    uint64_t value;std::memcpy(&value,ram+address,8);return value;
+}
+// Call only while the original guest-execution scope is held.
+inline void guestSnapshot(Kind kind,const uint8_t* ram) noexcept {
+    if(!enabled() || !ram) return;
+    const uint64_t busy=uint64_t(read32(ram,0x210488)) |
+        (uint64_t(read32(ram,0x210490))<<8) | (uint64_t(read32(ram,0x210494))<<16);
+    const uint64_t phaseRoom=uint64_t(ram[0x4BADD0]) |
+        (uint64_t(ram[0x4BADD1])<<8) | (uint64_t(read32(ram,0x3243DC)&0xFFFFu)<<16);
+    note(kind,read32(ram,0x20F3C4),read64(ram,0x2104B0),read64(ram,0x2104B8),
+         read64(ram,0x2104C0),busy,read32(ram,0x21055C),read32(ram,0x21049C),phaseRoom);
+}
+inline bool watchedThread(int tid) noexcept {return tid==1 || tid==5 || tid==6 || tid==7;}
+inline void flush() noexcept {
+    const auto& c=config();
+    if(!c.enabled || closed.exchange(true,std::memory_order_acq_rel)) return;
+    char name[96];std::snprintf(name,sizeof(name),"reo-vblank-music-%llu.jsonl",
+                              static_cast<unsigned long long>(generation.load()));
+    FILE* output=std::fopen(name,"wx");
+    if(!output) {std::fprintf(stderr,"[VBLANK-MUSIC] export failed (existing file or IO error): %s\n",name);return;}
+    const uint64_t count=claimed.load(std::memory_order_acquire);
+    std::fprintf(output,"{\"metadata\":true,\"epoch_ns\":%llu,\"after\":%.6f,\"until\":%.6f,\"limit\":%u,\"claimed\":%llu,\"dropped\":%llu}\n",
+        static_cast<unsigned long long>(epochNs.load()),c.after,c.until,c.limit,
+        static_cast<unsigned long long>(count),static_cast<unsigned long long>(count>c.limit?count-c.limit:0));
+    uint32_t unpublished=0;
+    for(uint64_t i=0;i<std::min<uint64_t>(count,c.limit);++i) {
+        auto& slot=records[size_t(i)];
+        if(!slot.ready.load(std::memory_order_acquire)) {++unpublished;continue;}
+        const auto& r=slot.record;
+        std::fprintf(output,"{\"slot\":%llu,\"ns\":%llu,\"kind\":%u,\"tid\":%d,\"irq_tick\":%llu,\"observed_latest_tick\":%llu,\"args\":[",
+            static_cast<unsigned long long>(i),static_cast<unsigned long long>(r.ns),r.kind,r.tid,
+            static_cast<unsigned long long>(r.irqTick),static_cast<unsigned long long>(r.observedLatestTick));
+        for(unsigned a=0;a<8;++a) std::fprintf(output,a?",%llu":"%llu",static_cast<unsigned long long>(r.a[a]));
+        std::fputs("]}\n",output);
+    }
+    std::fprintf(output,"{\"end\":true,\"unpublished\":%u}\n",unpublished);
+    const int result=std::fclose(output);
+    std::fprintf(stderr,"[VBLANK-MUSIC] export=%s claimed=%llu dropped=%llu unpublished=%u close=%d\n",name,
+        static_cast<unsigned long long>(count),static_cast<unsigned long long>(count>c.limit?count-c.limit:0),unpublished,result);
+}
+}
