--- /dev/null
+++ b/ps2xRuntime/src/lib/vif_launch_overhead.cpp
@@ -0,0 +1,168 @@
+#include "vif_launch_overhead.h"
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+
+namespace vif_launch_overhead {
+namespace {
+struct ProgramWork {
+    bool identityKnown = false, overflow = false;
+    uint64_t firstPair = 0, shaPrefix = 0, generationMin = UINT64_MAX, generationMax = 0;
+    uint32_t codeBytes = 0, firstPc = 0, lastPc = 0;
+    uint64_t launches = 0, returned = 0, wrapperNs = 0, bodyNs = 0, programObserverNs = 0;
+    uint64_t pairs = 0, bodyCalls = 0, capped = 0;
+    std::array<uint64_t, StageCount> stageNs{}, stageCalls{}, stageBytes{};
+};
+struct Work {
+    Work* previous = nullptr;
+    LaunchScope* previousLaunch = nullptr;
+    std::array<ProgramWork, 16> programs{};
+    ProgramWork overflow{};
+    uint32_t used = 0;
+    uint64_t launchNs = 0, launches = 0, parserNs = 0, parserCalls = 0, streamLockNs = 0;
+    uint64_t setupNs = 0, identityProviderNs = 0;
+    std::array<uint64_t, 128> commandNs{}, commandCalls{}, commandLaunchNs{};
+    std::array<uint64_t, StageCount> stageNs{}, stageCalls{}, stageBytes{};
+};
+thread_local Work* currentWork = nullptr;
+thread_local LaunchScope* currentLaunch = nullptr;
+std::atomic<IdentityProvider> identityProvider{nullptr};
+
+void printProgram(const ProgramWork& p, uint32_t kick, uint64_t startNs) noexcept {
+    if (!p.launches) return;
+    const uint64_t nestedXg = p.stageNs[XgkickPrep] + p.stageNs[XgkickSubmit];
+    std::fprintf(stderr, "[VIF-LAUNCH-PROGRAM] kick_n=%u kick_ns=%llu overflow=%u identity_known=%u code_first_pair=%016llx sha256_prefix64=%016llx generation_min=%llu generation_max=%llu code_bytes=%u first_pc=%04x last_pc=%04x launches=%llu returned=%llu wrapper_ns=%llu vu_body_ns=%llu wrapper_outside_vu_ns=%llu code_observer_ns=%llu wrapper_other_ns=%llu vu_non_xgkick_ns=%llu actual_pairs=%llu vu_body_calls=%llu capped=%llu\n",
+        kick, static_cast<unsigned long long>(startNs), unsigned(p.overflow), unsigned(p.identityKnown),
+        static_cast<unsigned long long>(p.firstPair), static_cast<unsigned long long>(p.shaPrefix),
+        static_cast<unsigned long long>(p.identityKnown ? p.generationMin : 0),
+        static_cast<unsigned long long>(p.generationMax), p.codeBytes, p.firstPc, p.lastPc,
+        static_cast<unsigned long long>(p.launches), static_cast<unsigned long long>(p.returned),
+        static_cast<unsigned long long>(p.wrapperNs), static_cast<unsigned long long>(p.bodyNs),
+        static_cast<unsigned long long>(p.wrapperNs >= p.bodyNs ? p.wrapperNs - p.bodyNs : 0),
+        static_cast<unsigned long long>(p.programObserverNs),
+        static_cast<unsigned long long>(p.wrapperNs >= p.bodyNs + p.programObserverNs ? p.wrapperNs - p.bodyNs - p.programObserverNs : 0),
+        static_cast<unsigned long long>(p.bodyNs >= nestedXg ? p.bodyNs - nestedXg : 0),
+        static_cast<unsigned long long>(p.pairs), static_cast<unsigned long long>(p.bodyCalls),
+        static_cast<unsigned long long>(p.capped));
+    for (unsigned stage = 0; stage < StageCount; ++stage)
+        if (p.stageCalls[stage]) std::fprintf(stderr,
+            "[VIF-LAUNCH-STAGE] kick_n=%u identity_known=%u sha256_prefix64=%016llx code_first_pair=%016llx overflow=%u stage=%u calls=%llu ns=%llu bytes=%llu\n",
+            kick, unsigned(p.identityKnown), static_cast<unsigned long long>(p.shaPrefix),
+            static_cast<unsigned long long>(p.firstPair), unsigned(p.overflow), stage,
+            static_cast<unsigned long long>(p.stageCalls[stage]),
+            static_cast<unsigned long long>(p.stageNs[stage]), static_cast<unsigned long long>(p.stageBytes[stage]));
+}
+}
+
+void setIdentityProvider(IdentityProvider provider) noexcept { identityProvider.store(provider, std::memory_order_release); }
+bool active() noexcept { return currentWork != nullptr; }
+uint64_t nestedLaunchNs() noexcept { return currentWork ? currentWork->launchNs : 0; }
+
+DmaScope::DmaScope() {
+    const auto started = Clock::now();
+    auto work = std::make_unique<Work>();
+    work->previous = currentWork;
+    work->previousLaunch = currentLaunch;
+    work->setupNs = durationNs(started);
+    currentWork = work.get();
+    currentLaunch = nullptr;
+    impl_ = work.release();
+}
+DmaScope::~DmaScope() {
+    auto* work = static_cast<Work*>(impl_);
+    if (work) { currentWork = work->previous; currentLaunch = work->previousLaunch; delete work; }
+}
+void DmaScope::complete(uint32_t kick, uint64_t startNs, uint64_t wallUs) noexcept {
+    const auto* w = static_cast<const Work*>(impl_);
+    if (!w) return;
+    std::fprintf(stderr, "[VIF-LAUNCH-DMA] kick_n=%u kick_ns=%llu kick_wall_us=%llu launches=%llu programs=%u parser_calls=%llu parser_ns=%llu stream_lock_ns=%llu launch_wrapper_ns=%llu collector_setup_ns=%llu identity_provider_ns=%llu clock_overhead_subtracted=0\n",
+        kick, static_cast<unsigned long long>(startNs), static_cast<unsigned long long>(wallUs),
+        static_cast<unsigned long long>(w->launches), w->used,
+        static_cast<unsigned long long>(w->parserCalls), static_cast<unsigned long long>(w->parserNs),
+        static_cast<unsigned long long>(w->streamLockNs), static_cast<unsigned long long>(w->launchNs),
+        static_cast<unsigned long long>(w->setupNs), static_cast<unsigned long long>(w->identityProviderNs));
+    for (const auto& p : w->programs) printProgram(p, kick, startNs);
+    printProgram(w->overflow, kick, startNs);
+    for (unsigned stage = 0; stage < StageCount; ++stage) if (w->stageCalls[stage])
+        std::fprintf(stderr, "[VIF-LAUNCH-DMA-STAGE] kick_n=%u stage=%u calls=%llu ns=%llu bytes=%llu\n",
+            kick, stage, static_cast<unsigned long long>(w->stageCalls[stage]),
+            static_cast<unsigned long long>(w->stageNs[stage]), static_cast<unsigned long long>(w->stageBytes[stage]));
+    for (unsigned opcode = 0; opcode < 128; ++opcode) if (w->commandCalls[opcode])
+        std::fprintf(stderr, "[VIF-LAUNCH-COMMAND] kick_n=%u opcode=%02x calls=%llu ns=%llu nested_launch_ns=%llu outside_launch_ns=%llu\n",
+            kick, opcode, static_cast<unsigned long long>(w->commandCalls[opcode]),
+            static_cast<unsigned long long>(w->commandNs[opcode]),
+            static_cast<unsigned long long>(w->commandLaunchNs[opcode]),
+            static_cast<unsigned long long>(w->commandNs[opcode] >= w->commandLaunchNs[opcode] ?
+                w->commandNs[opcode] - w->commandLaunchNs[opcode] : 0));
+}
+
+LaunchScope::LaunchScope(const void* owner, const uint8_t* code, uint32_t bytes,
+    uint32_t pc, uint32_t budget, uint32_t top)
+    : memoryIdentity(owner), codeBytes(bytes), startPc(pc), maxPairs(budget), itop(top), started(Clock::now()) {
+    if (code && bytes >= sizeof(codeFirstPair)) std::memcpy(&codeFirstPair, code, sizeof(codeFirstPair));
+    previous = currentLaunch;
+    currentLaunch = this;
+}
+LaunchScope::~LaunchScope() {
+    const uint64_t wrapperNs = durationNs(started);
+    currentLaunch = previous;
+    auto* w = currentWork;
+    if (!w) return;
+    uint64_t generation = 0, hash = 0;
+    bool known = false;
+    if (const auto provider = identityProvider.load(std::memory_order_acquire)) {
+        const auto identityStart = Clock::now();
+        known = provider(memoryIdentity, generation, hash);
+        w->identityProviderNs += durationNs(identityStart);
+    }
+    ProgramWork* p = nullptr;
+    for (uint32_t i = 0; i < w->used; ++i) {
+        auto& candidate = w->programs[i];
+        if (candidate.identityKnown == known && candidate.codeBytes == codeBytes &&
+            (known ? candidate.shaPrefix == hash : candidate.firstPair == codeFirstPair)) { p = &candidate; break; }
+    }
+    if (!p && w->used < w->programs.size()) {
+        p = &w->programs[w->used++];
+        p->identityKnown = known; p->shaPrefix = hash; p->firstPair = codeFirstPair;
+        p->codeBytes = codeBytes; p->firstPc = startPc;
+    }
+    if (!p) { p = &w->overflow; p->overflow = true; }
+    ++p->launches; p->returned += unsigned(returned); p->wrapperNs += wrapperNs;
+    p->lastPc = startPc; p->bodyNs += bodyNs; p->pairs += pairs; p->bodyCalls += bodyCalls; p->capped += capped;
+    p->programObserverNs += programObserverNs;
+    if (known && !p->overflow) {
+        p->generationMin = std::min(p->generationMin, generation);
+        p->generationMax = std::max(p->generationMax, generation);
+    }
+    for (unsigned i = 0; i < StageCount; ++i) {
+        p->stageNs[i] += stageNs[i]; p->stageCalls[i] += stageCalls[i]; p->stageBytes[i] += stageBytes[i];
+    }
+    ++w->launches; w->launchNs += wrapperNs;
+}
+
+void recordStage(unsigned stage, uint64_t ns, uint64_t bytes) noexcept {
+    if (!currentWork || stage >= StageCount) return;
+    currentWork->stageNs[stage] += ns; ++currentWork->stageCalls[stage]; currentWork->stageBytes[stage] += bytes;
+    if (auto* launch = currentLaunch) {
+        launch->stageNs[stage] += ns; ++launch->stageCalls[stage]; launch->stageBytes[stage] += bytes;
+    }
+}
+void recordVu(uint64_t ns, uint32_t pairs, bool capped) noexcept {
+    if (auto* launch = currentLaunch) {
+        launch->bodyNs += ns; launch->pairs += pairs; ++launch->bodyCalls; launch->capped += unsigned(capped);
+    }
+}
+void recordProgramObserver(uint64_t ns) noexcept {
+    if (auto* launch = currentLaunch) launch->programObserverNs += ns;
+}
+void recordParse(uint64_t ns, uint64_t lockNs) noexcept {
+    if (auto* w = currentWork) { ++w->parserCalls; w->parserNs += ns; w->streamLockNs += lockNs; }
+}
+void recordCommand(uint8_t opcode, uint64_t ns, uint64_t nestedLaunch) noexcept {
+    if (auto* w = currentWork; w && opcode < 128u) {
+        ++w->commandCalls[opcode]; w->commandNs[opcode] += ns; w->commandLaunchNs[opcode] += nestedLaunch;
+    }
+}
+}
diff --git a/ps2xRuntime/src/lib/vif_launch_overhead.h b/ps2xRuntime/src/lib/vif_launch_overhead.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vif_launch_overhead.h
@@ -0,0 +1,91 @@
+#pragma once
+// Private, opt-in diagnostics. No public runtime header or class changes.
+#include <array>
+#include <chrono>
+#include <cstdint>
+
+namespace vif_launch_overhead {
+using Clock = std::chrono::steady_clock;
+using IdentityProvider = bool (*)(const void*, uint64_t& generation, uint64_t& sha256Prefix64) noexcept;
+void setIdentityProvider(IdentityProvider) noexcept;
+bool active() noexcept;
+constexpr unsigned StageCount = 11;
+enum Stage : unsigned {
+    XgkickPrep = 0, XgkickSubmit = 1, GsPacketAllocationCopy = 2,
+    GsQueueLock = 3, GsQueueWait = 4, ArbiterAllocationZero = 5,
+    ArbiterCopy = 6, ArbiterPush = 7, ArbiterSort = 8, ArbiterDispatch = 9, GsPushNotify = 10
+};
+void recordStage(unsigned, uint64_t ns, uint64_t bytes) noexcept;
+void recordVu(uint64_t ns, uint32_t pairs, bool capped) noexcept;
+void recordProgramObserver(uint64_t ns) noexcept;
+void recordParse(uint64_t ns, uint64_t lockNs) noexcept;
+void recordCommand(uint8_t opcode, uint64_t ns, uint64_t nestedLaunchNs) noexcept;
+uint64_t nestedLaunchNs() noexcept;
+
+class DmaScope {
+    void* impl_ = nullptr;
+public:
+    DmaScope(); // Construct only inside an already selected bounded kick.
+    ~DmaScope();
+    DmaScope(const DmaScope&) = delete;
+    DmaScope& operator=(const DmaScope&) = delete;
+    void complete(uint32_t kickNumber, uint64_t kickStartNs, uint64_t kickWallUs) noexcept;
+};
+
+class LaunchScope {
+public: // Implementation-only TLS accounting; not a runtime public class.
+    const void* memoryIdentity;
+    uint64_t codeFirstPair = 0;
+    uint32_t codeBytes, startPc, maxPairs, itop;
+    uint64_t bodyNs = 0, pairs = 0, bodyCalls = 0, capped = 0, programObserverNs = 0;
+    std::array<uint64_t, StageCount> stageNs{}, stageCalls{}, stageBytes{};
+    Clock::time_point started;
+    LaunchScope* previous = nullptr;
+    bool returned = false;
+    LaunchScope(const void*, const uint8_t* code, uint32_t codeBytes,
+        uint32_t startPc, uint32_t maxPairs, uint32_t itop);
+    ~LaunchScope();
+    LaunchScope(const LaunchScope&) = delete;
+    LaunchScope& operator=(const LaunchScope&) = delete;
+};
+
+inline uint64_t durationNs(Clock::time_point begin) noexcept {
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - begin).count());
+}
+
+class ProgramObserverScope {
+    bool enabled_;
+    Clock::time_point started_{};
+public:
+    explicit ProgramObserverScope(bool enabled) : enabled_(enabled) {
+        if (enabled_) started_ = Clock::now();
+    }
+    ~ProgramObserverScope() { if (enabled_) recordProgramObserver(durationNs(started_)); }
+};
+
+class ParseScope {
+    bool enabled_;
+    Clock::time_point started_{};
+    uint64_t lockNs_ = 0;
+public:
+    explicit ParseScope(bool enabled) : enabled_(enabled) {
+        if (enabled_) started_ = Clock::now();
+    }
+    void lockAcquired() noexcept { if (enabled_) lockNs_ = durationNs(started_); }
+    ~ParseScope() { if (enabled_) recordParse(durationNs(started_), lockNs_); }
+};
+
+class CommandScope {
+    bool enabled_;
+    uint8_t opcode_;
+    Clock::time_point started_{};
+    uint64_t nestedBefore_ = 0;
+public:
+    CommandScope(bool enabled, uint8_t opcode) : enabled_(enabled), opcode_(opcode) {
+        if (enabled_) { nestedBefore_ = nestedLaunchNs(); started_ = Clock::now(); }
+    }
+    ~CommandScope() {
+        if (enabled_) recordCommand(opcode_, durationNs(started_), nestedLaunchNs() - nestedBefore_);
+    }
+};
+}
diff --git a/ps2xRuntime/src/lib/vu_program_collection.cpp b/ps2xRuntime/src/lib/vu_program_collection.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu_program_collection.cpp
@@ -0,0 +1,191 @@
+#include "vu_program_collection.h"
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <stdexcept>
+#include <utility>
+#include <unordered_map>
+#include <vector>
+
+namespace vu_program_collection {
+namespace {
+using Digest=std::array<uint8_t,32>;
+uint32_t rotate(uint32_t value,unsigned bits) {return (value>>bits)|(value<<(32-bits));}
+Digest sha256(const uint8_t* bytes,uint32_t size) {
+    static constexpr uint32_t constants[64]={
+        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+    uint32_t state[8]={0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
+    const uint64_t total=((uint64_t(size)+9+63)/64)*64;
+    const uint64_t lengthBits=uint64_t(size)*8;
+    for(uint64_t base=0;base<total;base+=64) {
+        uint32_t words[64]{};
+        for(unsigned i=0;i<64;++i) {
+            const uint64_t offset=base+i;
+            uint8_t value=offset<size?bytes[offset]:offset==size?0x80:0;
+            if(offset>=total-8)value=uint8_t(lengthBits>>(8*(total-1-offset)));
+            words[i/4]|=uint32_t(value)<<(24-8*(i%4));
+        }
+        for(unsigned i=16;i<64;++i) {
+            const uint32_t a=words[i-15],b=words[i-2];
+            words[i]=words[i-16]+(rotate(a,7)^rotate(a,18)^(a>>3))+words[i-7]+(rotate(b,17)^rotate(b,19)^(b>>10));
+        }
+        uint32_t a=state[0],b=state[1],c=state[2],d=state[3],e=state[4],f=state[5],g=state[6],h=state[7];
+        for(unsigned i=0;i<64;++i) {
+            const uint32_t t1=h+(rotate(e,6)^rotate(e,11)^rotate(e,25))+((e&f)^(~e&g))+constants[i]+words[i];
+            const uint32_t t2=(rotate(a,2)^rotate(a,13)^rotate(a,22))+((a&b)^(a&c)^(b&c));
+            h=g;g=f;f=e;e=d+t1;d=c;c=b;b=a;a=t1+t2;
+        }
+        state[0]+=a;state[1]+=b;state[2]+=c;state[3]+=d;state[4]+=e;state[5]+=f;state[6]+=g;state[7]+=h;
+    }
+    Digest result{};
+    for(unsigned i=0;i<32;++i)result[i]=uint8_t(state[i/4]>>(24-8*(i%4)));
+    return result;
+}
+std::string hex(const Digest& digest) {
+    static constexpr char digits[]="0123456789abcdef";
+    std::string text(64,'0');
+    for(unsigned i=0;i<32;++i){text[i*2]=digits[digest[i]>>4];text[i*2+1]=digits[digest[i]&15];}
+    return text;
+}
+uint64_t number(const char* name,uint64_t fallback,uint64_t maximum) {
+    const char* value=std::getenv(name);
+    return std::min(maximum,value?std::strtoull(value,nullptr,0):fallback);
+}
+struct Configuration {
+    bool enabled=false;
+    std::filesystem::path directory;
+    uint64_t uploadLimit=16384,launchLimit=262144,imageLimit=1024,byteLimit=64*1024*1024;
+    Configuration() noexcept {
+        try {
+            const char* enabledText=std::getenv("REO_VU_PROGRAM_LOG");
+            const char* output=std::getenv("REO_VU_PROGRAM_DIR");
+            if(!enabledText||!std::strtoull(enabledText,nullptr,0)||!output||!*output)return;
+            directory=std::filesystem::path(output);
+            uploadLimit=number("REO_VU_PROGRAM_UPLOAD_LIMIT",uploadLimit,1048576);
+            launchLimit=number("REO_VU_PROGRAM_LAUNCH_LIMIT",launchLimit,1048576);
+            imageLimit=number("REO_VU_PROGRAM_IMAGE_LIMIT",imageLimit,4096);
+            byteLimit=number("REO_VU_PROGRAM_BYTE_LIMIT",byteLimit,256*1024*1024);
+            enabled=uploadLimit&&launchLimit&&imageLimit&&byteLimit;
+        } catch(...) {}
+    }
+};
+const Configuration& configuration(){static const Configuration config;return config;}
+struct Image {Digest digest{};std::string name;std::vector<uint8_t> code;};
+struct Memory {uint32_t id=0;uint64_t generation=0;size_t image=SIZE_MAX;};
+struct State {
+    std::mutex mutex;
+    bool opened=false,failed=false,stopped=false;
+    uint64_t bytes=0,uploads=0,launches=0,event=0;
+    std::ofstream output;
+    std::unordered_map<const void*,Memory> memories;
+    std::vector<Image> images;
+};
+State& state(){static State instance;return instance;}
+bool open(State& state,const Configuration& config) {
+    if(state.failed||state.stopped)return false;
+    if(state.opened)return true;
+    std::filesystem::create_directories(config.directory);
+    const auto log=config.directory/"events.jsonl";
+    if(std::filesystem::exists(log))throw std::runtime_error("collector output already exists");
+    state.output.open(log,std::ios::out|std::ios::binary);
+    if(!state.output)throw std::runtime_error("cannot open collector output");
+    state.opened=true;
+    state.output<<"{\"event\":\"configuration\",\"format\":1,\"classification\":\"diagnostic_observer_not_fps\",\"upload_limit\":"<<config.uploadLimit
+        <<",\"launch_limit\":"<<config.launchLimit<<",\"image_limit\":"<<config.imageLimit<<",\"byte_limit\":"<<config.byteLimit<<"}\n";
+    state.bytes=uint64_t(state.output.tellp());
+    return true;
+}
+void stop(State& state,const char* reason) {
+    if(!state.stopped){state.output<<"{\"event\":\"stopped\",\"reason\":\""<<reason<<"\",\"uploads\":"<<state.uploads<<",\"launches\":"<<state.launches<<"}\n";state.output.flush();state.stopped=true;}
+}
+void line(State& state,const Configuration& config,const std::string& text) {
+    if(state.bytes+text.size()+1>config.byteLimit){stop(state,"byte_limit");return;}
+    state.output<<text<<'\n';
+    if(!state.output)throw std::runtime_error("collector log write failed");
+    state.bytes+=text.size()+1;
+}
+size_t image(State& state,const Configuration& config,const uint8_t* code,uint32_t codeBytes) {
+    const auto digest=sha256(code,codeBytes);
+    for(size_t i=0;i<state.images.size();++i)
+        if(state.images[i].digest==digest&&state.images[i].code.size()==codeBytes&&std::memcmp(code,state.images[i].code.data(),codeBytes)==0)return i;
+    if(state.images.size()>=config.imageLimit){stop(state,"image_limit");return SIZE_MAX;}
+    if(state.bytes+codeBytes>config.byteLimit){stop(state,"byte_limit");return SIZE_MAX;}
+    Image entry{digest,"image-"+hex(digest)+".bin",std::vector<uint8_t>(code,code+codeBytes)};
+    const auto path=config.directory/entry.name;
+    if(std::filesystem::exists(path))throw std::runtime_error("collector image path already exists");
+    std::ofstream file(path,std::ios::binary);file.write(reinterpret_cast<const char*>(code),codeBytes);file.close();
+    if(!file)throw std::runtime_error("collector image write failed");
+    state.bytes+=codeBytes;
+    const size_t id=state.images.size();state.images.push_back(std::move(entry));
+    line(state,config,"{\"event\":\"image\",\"image\":"+std::to_string(id)+",\"sha256\":\""+hex(digest)+"\",\"bytes\":"+std::to_string(codeBytes)+",\"file\":\""+state.images.back().name+"\"}");
+    return id;
+}
+Memory& memory(State& state,const void* identity) {
+    auto [entry,inserted]=state.memories.try_emplace(identity);
+    if(inserted)entry->second.id=uint32_t(state.memories.size()-1);
+    return entry->second;
+}
+void fail() noexcept {
+    // No observer error changes guest execution or throws through runtime.
+    try {auto& s=state();std::lock_guard lock(s.mutex);if(!s.failed){s.failed=true;std::fprintf(stderr,"[VU-PROGRAM] collector disabled after I/O or allocation failure\n");}}catch(...){}
+}
+}
+void recordMpg(const void* identity,const uint8_t* code,uint32_t codeBytes,
+    uint32_t destination,uint32_t instructions,const uint8_t* payload,uint32_t payloadBytes) noexcept {
+    const auto& config=configuration();if(!config.enabled)return;
+    try {
+        auto& s=state();std::lock_guard lock(s.mutex);if(!open(s,config))return;
+        if(!code||!codeBytes||codeBytes>16384||!payload||!payloadBytes||payloadBytes>2048){stop(s,"invalid_span");return;}
+        if(s.uploads>=config.uploadLimit){stop(s,"upload_limit");return;}
+        auto& m=memory(s,identity);++m.generation;m.image=image(s,config,code,codeBytes);if(m.image==SIZE_MAX)return;
+        const auto event=s.event++;
+        line(s,config,"{\"event\":\"mpg\",\"sequence\":"+std::to_string(event)+",\"memory\":"+std::to_string(m.id)+",\"generation\":"+std::to_string(m.generation)
+            +",\"image\":"+std::to_string(m.image)+",\"sha256\":\""+hex(s.images[m.image].digest)+"\",\"destination_byte\":"+std::to_string(destination)
+            +",\"instructions\":"+std::to_string(instructions)+",\"payload_bytes\":"+std::to_string(payloadBytes)+",\"payload_sha256\":\""+hex(sha256(payload,payloadBytes))+"\"}");
+        ++s.uploads;s.output.flush();
+    }catch(...){fail();}
+}
+void recordLaunch(const void* identity,const uint8_t* code,uint32_t codeBytes,
+    uint32_t startPc,uint32_t maxPairs,uint32_t itop) noexcept {
+    const auto& config=configuration();if(!config.enabled)return;
+    try {
+        auto& s=state();std::lock_guard lock(s.mutex);if(!open(s,config))return;
+        if(!code||!codeBytes||codeBytes>16384){stop(s,"invalid_span");return;}
+        if(s.launches>=config.launchLimit){stop(s,"launch_limit");return;}
+        auto& m=memory(s,identity);
+        // Enabled-only full comparison also detects initialization/reset/non-MPG mutation.
+        if(m.image==SIZE_MAX||s.images[m.image].code.size()!=codeBytes||std::memcmp(code,s.images[m.image].code.data(),codeBytes)!=0) {
+            m.image=image(s,config,code,codeBytes);if(m.image==SIZE_MAX)return;
+            line(s,config,"{\"event\":\"entry_image_change\",\"memory\":"+std::to_string(m.id)+",\"generation\":"+std::to_string(m.generation)+",\"image\":"+std::to_string(m.image)+"}");
+        }
+        line(s,config,"{\"event\":\"launch\",\"sequence\":"+std::to_string(s.event++)+",\"memory\":"+std::to_string(m.id)+",\"generation\":"+std::to_string(m.generation)
+            +",\"image\":"+std::to_string(m.image)+",\"sha256\":\""+hex(s.images[m.image].digest)+"\",\"start_pc\":"+std::to_string(startPc)
+            +",\"max_pairs\":"+std::to_string(maxPairs)+",\"itop\":"+std::to_string(itop)+"}");
+        ++s.launches;if((s.launches&255)==0)s.output.flush();
+    }catch(...){fail();}
+}
+bool currentIdentity(const void* identity,uint64_t& generation,uint64_t& hash) noexcept {
+    if(!configuration().enabled)return false;
+    try {
+        auto& s=state();std::lock_guard lock(s.mutex);
+        const auto found=s.memories.find(identity);
+        if(found==s.memories.end()||found->second.image==SIZE_MAX||s.failed||s.stopped)return false;
+        generation=found->second.generation;hash=0;
+        for(unsigned i=0;i<8;++i)hash=(hash<<8)|s.images[found->second.image].digest[i];
+        return true;
+    }catch(...){return false;}
+}
+}
