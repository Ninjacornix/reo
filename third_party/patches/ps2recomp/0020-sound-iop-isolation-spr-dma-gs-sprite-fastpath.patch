+    bool resolveSoundDriverIopTransfer(PS2Runtime *runtime, uint32_t addr, uint32_t size, uint8_t *&ptr)
+    {
+        ptr = nullptr;
+        std::lock_guard<std::mutex> lock(g_rpc_mutex);
