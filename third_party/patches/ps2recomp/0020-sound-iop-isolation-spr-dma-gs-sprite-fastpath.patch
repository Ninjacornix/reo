+            const uint64_t tag = makeDmaTag(kQwc, 7u, kIgnoredAddress, true);
+            writeDmaTag(ram, kTagAddress, tag);
+            std::memset(ram + kIgnoredAddress, 0xA5, kQwc * 16u);
+            for (uint32_t i = 0u; i < kQwc * 16u; ++i)
+                ram[kTagAddress + 16u + i] = static_cast<uint8_t>(0x50u + i);
+            mem.writeIORegister(kChannel + 0x20u, 0u);
+            mem.writeIORegister(kChannel + 0x30u, kTagAddress);
+            mem.writeIORegister(kChannel + 0x80u, kStart);
+            t.IsTrue(mem.writeIORegister(kChannel, 0x185u), "toSPR chain with TIE should start");
+            bool payloadMatches = true;
+            for (uint32_t i = 0u; i < kQwc * 16u; ++i)
+                payloadMatches = payloadMatches && spr[(kStart + i) & (PS2_SCRATCHPAD_SIZE - 1u)] == static_cast<uint8_t>(0x50u + i);
+            t.IsTrue(payloadMatches, "END payload should follow the tag rather than use ADDR");
+            t.Equals(mem.readIORegister(kChannel) & 0xFFFF0000u, 0xF0000000u, "CHCR TAG must reflect END ID and IRQ from tag bits31:16, not ADDR");
+            t.Equals(mem.readIORegister(kChannel) & 0x1FFu, 0x85u, "chain completion should preserve MOD DIR TIE and clear STR");
+            t.Equals(mem.readIORegister(kChannel + 0x10u), kTagAddress + 16u + kQwc * 16u, "chain MADR should advance past END payload");
+            t.Equals(mem.readIORegister(kChannel + 0x80u), 16u, "END payload should wrap SADR");
+            t.Equals(mem.readIORegister(kChannel + 0x20u), 0u, "END chain completion should clear QWC");
+            t.Equals(mem.readIORegister(0x1000E010u) & (1u << 9), 1u << 9, "END chain completion should set toSPR status");
+        });
+
+        tc.Run("toSPR source chain stops on IRQ only with TIE enabled", [](TestCase &t)
+        {
+            constexpr uint32_t kChannel = 0x1000D400u;
+            constexpr uint32_t kFirstTag = 0x00028000u;
+            constexpr uint32_t kSecondTag = kFirstTag + 32u;
+            for (const bool tie : {false, true})
+            {
+                PS2Memory mem;
+                t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+                uint8_t *const ram = mem.getRDRAM();
+                uint8_t *const spr = mem.getScratchpad();
+                std::memset(spr, 0xA5, 48u);
+                writeDmaTag(ram, kFirstTag, makeDmaTag(1u, 1u, 0u, true));
+                writeDmaTag(ram, kSecondTag, makeDmaTag(1u, 7u, 0u));
+                std::memset(ram + kFirstTag + 16u, 0x31, 16u);
+                std::memset(ram + kSecondTag + 16u, 0x72, 16u);
+                mem.writeIORegister(kChannel + 0x20u, 0u);
+                mem.writeIORegister(kChannel + 0x30u, kFirstTag);
+                mem.writeIORegister(kChannel + 0x80u, 0u);
+                mem.writeIORegister(kChannel, 0x105u | (tie ? 0x80u : 0u));
+                bool firstMatches = true;
+                bool secondMatches = true;
+                for (uint32_t i = 0u; i < 16u; ++i)
+                {
+                    firstMatches = firstMatches && spr[i] == 0x31u;
+                    secondMatches = secondMatches && spr[16u + i] == (tie ? 0xA5u : 0x72u);
+                }
+                t.IsTrue(firstMatches, "IRQ-tagged CNT payload should always transfer");
+                t.IsTrue(secondMatches, "TIE should control whether the following END payload transfers");
+                t.Equals(mem.readIORegister(kChannel) & 0xFFFF0000u, tie ? 0x90000000u : 0x70000000u, "CHCR TAG should retain the tag that terminated the chain");
+                t.Equals(mem.readIORegister(kChannel + 0x80u), tie ? 16u : 32u, "SADR should reflect the number of transferred qwords");
+                t.Equals(mem.readIORegister(kChannel) & 0x100u, 0u, "IRQ and END termination should both clear STR");
+                t.Equals(mem.readIORegister(kChannel + 0x20u), 0u, "IRQ and END termination should both clear QWC");
+            }
+        });
+    });
+}
