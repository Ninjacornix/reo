+void register_ps2_sound_driver_isolation_tests()
+{
+    MiniTest::Case("PS2SoundDriverIsolation", [](TestCase &tc)
+    {
+        tc.Run("sound-driver IOP state and transfers preserve EE code and constants", [](TestCase &t)
+        {
+            TestEnv env;
+            // Synthetic EE sentinels spanning the former HLE arena, including the MPEG clamp table.
+            constexpr std::array<uint32_t, 4> sentinels{0x00120000u, 0x00121000u, 0x00143F70u, 0x0017CFF0u};
+            constexpr uint32_t replyAddr = 0x00025000u, rdAddr = 0x00025100u, statusCopy = 0x00025200u;
+            constexpr uint32_t tableCopy = 0x00025300u, upload = 0x00025400u, descAddr = 0x00025500u;
+            constexpr uint32_t roundTrip = 0x00025600u;
+            std::array<std::array<uint8_t, 16>, sentinels.size()> expected{};
+            for (size_t i = 0; i < sentinels.size(); ++i)
+            {
+                for (size_t j = 0; j < expected[i].size(); ++j)
+                    expected[i][j] = static_cast<uint8_t>(0x40u + i * 16u + j);
+                std::memcpy(env.rdram.data() + sentinels[i], expected[i].data(), expected[i].size());
+            }
+            auto checkSentinels = [&]()
+            {
+                for (size_t i = 0; i < sentinels.size(); ++i)
+                    t.IsTrue(std::memcmp(env.rdram.data() + sentinels[i], expected[i].data(), expected[i].size()) == 0,
+                             "sound-driver HLE must preserve unrelated EE code/constants");
+            };
+            auto request = [&](uint32_t rpcNum) -> uint32_t
+            {
+                uint32_t resultPtr = 0u;
+                bool signalCompletion = false;
+                const bool handled = ps2_syscalls::handleSoundDriverRpcService(
+                    env.rdram.data(), &env.runtime, IOP_SID_SNDDRV_STATE, rpcNum,
+                    0u, 0u, replyAddr, sizeof(uint32_t), resultPtr, signalCompletion);
+                t.IsTrue(handled, "sound-driver state RPC should remain available");
+                t.Equals(resultPtr, replyAddr, "sound-driver state RPC should return the supplied reply buffer");
+                t.IsTrue(signalCompletion, "sound-driver state RPC should signal completion");
+                return readGuestU32(env.rdram.data(), replyAddr);
+            };
+            auto readIop = [&](uint32_t src, uint32_t dest, uint32_t size)
+            {
+                std::memset(env.rdram.data() + dest, 0xEE, size);
+                setRegU32(env.ctx, 4, rdAddr);
+                setRegU32(env.ctx, 5, src);
+                setRegU32(env.ctx, 6, dest);
+                setRegU32(env.ctx, 7, size);
+                ps2_stubs::sceSifGetOtherData(env.rdram.data(), &env.ctx, &env.runtime);
+                t.Equals(getRegS32(env.ctx, 2), 0, "IOP-to-EE sound transfer should succeed");
+            };
+            const uint32_t statusAddr = request(IOP_RPC_SNDDRV_GET_STATUS_ADDR);
+            t.IsTrue(statusAddr > 0u && uint64_t(statusAddr) + 0x42u <= 0x00200000u,
+                     "sound-driver status address must fit IOP RAM");
+            checkSentinels();
+            readIop(statusAddr, statusCopy, 0x42u);
+            std::array<uint8_t, 0x42> zeroStatus{};
+            t.IsTrue(std::memcmp(env.rdram.data() + statusCopy, zeroStatus.data(), zeroStatus.size()) == 0,
+                     "initial sound status should be readable through SIF");
+
+            const uint32_t tableAddr = request(IOP_RPC_SNDDRV_GET_ADDR_TABLE);
+            t.IsTrue(tableAddr > 0u && uint64_t(tableAddr) + 64u <= 0x00200000u,
+                     "sound-driver address table must fit IOP RAM");
+            readIop(tableAddr, tableCopy, 64u);
+            const uint32_t hd = readGuestU32(env.rdram.data(), tableCopy);
+            const uint32_t sq = readGuestU32(env.rdram.data(), tableCopy + 4u);
+            const uint32_t data = readGuestU32(env.rdram.data(), tableCopy + 8u);
+            const bool hdValid = hd > 0u && uint64_t(hd) + 0x4000u <= 0x00200000u;
+            t.IsTrue(hdValid, "HD buffer must fit IOP RAM");
+            t.IsTrue(sq > hd && uint64_t(sq) + 0x18000u <= 0x00200000u, "SQ buffer must fit IOP RAM");
+            t.IsTrue(data > sq && uint64_t(data) + 0x40000u <= 0x00200000u, "sound data buffer must fit IOP RAM");
+            if (hdValid)
+            {
+                std::array<uint8_t, 16> payload{};
+                payload.fill(0xA7u);
+                std::memcpy(env.rdram.data() + upload, payload.data(), payload.size());
+                const Ps2SifDmaTransfer desc{upload, hd, static_cast<int32_t>(payload.size()), 0};
+                std::memcpy(env.rdram.data() + descAddr, &desc, sizeof(desc));
+                setRegU32(env.ctx, 4, descAddr);
+                setRegU32(env.ctx, 5, 1u);
+                ps2_stubs::sceSifSetDma(env.rdram.data(), &env.ctx, &env.runtime);
+                t.IsTrue(getRegS32(env.ctx, 2) > 0, "EE-to-IOP sound upload should succeed");
+                t.IsTrue(std::memcmp(env.runtime.memory().getIOPRAM() + hd, payload.data(), payload.size()) == 0,
+                         "sound upload must write IOP backing, not EE memory at the same address");
+                readIop(hd, roundTrip, static_cast<uint32_t>(payload.size()));
+                t.IsTrue(std::memcmp(env.rdram.data() + roundTrip, payload.data(), payload.size()) == 0,
+                         "uploaded sound payload should round-trip through SIF");
+                // Transfers crossing either edge of the owned arena must fail without selecting EE fallback.
+                const uint32_t arenaEnd = data + 0x40000u;
+                if (statusAddr >= 8u && data > sq && uint64_t(arenaEnd) + 8u <= 0x00200000u)
+                {
+                    for (const uint32_t crossing : {statusAddr - 8u, arenaEnd - 8u})
+                    {
+                        std::array<uint8_t, 16> originalEe{}, originalIop{}, untouched{};
+                        std::memcpy(originalEe.data(), env.rdram.data() + crossing, originalEe.size());
+                        std::memcpy(originalIop.data(), env.runtime.memory().getIOPRAM() + crossing, originalIop.size());
+                        untouched.fill(0xCCu);
+                        std::memcpy(env.rdram.data() + roundTrip, untouched.data(), untouched.size());
+                        setRegU32(env.ctx, 4, rdAddr);
+                        setRegU32(env.ctx, 5, crossing);
+                        setRegU32(env.ctx, 6, roundTrip);
+                        setRegU32(env.ctx, 7, static_cast<uint32_t>(untouched.size()));
+                        ps2_stubs::sceSifGetOtherData(env.rdram.data(), &env.ctx, &env.runtime);
+                        t.Equals(getRegS32(env.ctx, 2), -1, "cross-boundary IOP read must be rejected");
+                        t.IsTrue(std::memcmp(env.rdram.data() + roundTrip, untouched.data(), untouched.size()) == 0,
+                                 "rejected IOP read must preserve its EE destination");
+
+                        const Ps2SifDmaTransfer invalid{upload, crossing, static_cast<int32_t>(payload.size()), 0};
+                        std::memcpy(env.rdram.data() + descAddr, &invalid, sizeof(invalid));
+                        setRegU32(env.ctx, 4, descAddr);
+                        setRegU32(env.ctx, 5, 1u);
+                        ps2_stubs::sceSifSetDma(env.rdram.data(), &env.ctx, &env.runtime);
+                        t.Equals(getRegS32(env.ctx, 2), 0, "cross-boundary sound upload must be rejected");
+                        t.IsTrue(std::memcmp(env.rdram.data() + crossing, originalEe.data(), originalEe.size()) == 0,
+                                 "rejected sound upload must preserve EE memory at the same address");
+                        t.IsTrue(std::memcmp(env.runtime.memory().getIOPRAM() + crossing, originalIop.data(), originalIop.size()) == 0,
+                                 "rejected sound upload must preserve IOP memory without partial writes");
+                    }
+                }
+                // Reinitialization retains known IOP pointers: a stale pointer must never select EE memory.
+                ps2_syscalls::SifInitRpc(env.rdram.data(), &env.ctx, &env.runtime);
+                readIop(hd, roundTrip, static_cast<uint32_t>(payload.size()));
+                t.IsTrue(std::memcmp(env.rdram.data() + roundTrip, payload.data(), payload.size()) == 0,
+                         "known sound pointer remains IOP-backed after SifInitRpc before a new state RPC");
+                checkSentinels();
+            }
+            t.Equals(request(IOP_RPC_SNDDRV_GET_STATUS_ADDR), statusAddr,
+                     "sound-driver status address should remain stable across repeated calls");
+            checkSentinels();
+            ps2_syscalls::resetSoundDriverRpcState();
+            request(IOP_RPC_SNDDRV_GET_STATUS_ADDR);
+            checkSentinels();
+        });
+    });
+}
