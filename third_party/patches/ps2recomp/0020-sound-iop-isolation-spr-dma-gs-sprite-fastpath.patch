+        const uint64_t end = static_cast<uint64_t>(g_soundDriverRpcState.storageBaseAddr) +
+                             g_soundDriverRpcState.storageSize;
+        const uint64_t transferEnd = static_cast<uint64_t>(addr) + size;
+        if (addr >= end || transferEnd <= begin)
+        {
+            return false;
+        }
+        // An overlapping but incomplete range must not fall back to EE memory.
+        if (addr >= begin && transferEnd <= end && g_soundDriverIopRam)
+        {
+            ptr = g_soundDriverIopRam + addr;
+        }
+        return true;
+    }
