 namespace
 {
+    struct VifKickWriteTiming
+    {
+        using Clock = std::chrono::steady_clock;
+        struct Config {
+            bool enabled = false;
+            double after = 0, until = 0;
+            int64_t minUs = 20000;
+            uint32_t limit = 64;
+            Clock::time_point epoch{};
+        };
+        static const Config& config()
+        {
+            static const Config cfg = [] {
+                Config c;
+                const char* at = std::getenv("REO_VIF_KICK_TIMING_AT");
+                if (!at || !*at) return c;
+                c.enabled = true;
+                c.after = std::max(0.0, std::atof(at));
+                if (const char* v = std::getenv("REO_VIF_KICK_TIMING_UNTIL")) c.until = std::max(0.0, std::atof(v));
+                if (const char* v = std::getenv("REO_VIF_KICK_TIMING_MIN_US")) c.minUs = std::max<int64_t>(0, std::strtoll(v, nullptr, 10));
+                if (const char* v = std::getenv("REO_VIF_KICK_TIMING_LIMIT")) c.limit = uint32_t(std::min(512ul, std::strtoul(v, nullptr, 10)));
+                c.epoch = Clock::now();
+                const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(c.epoch.time_since_epoch()).count();
+                std::fprintf(stderr, "[VIF-KICK-TIMING-CONFIG] epoch_ns=%lld after=%.6f until=%.6f min_us=%lld limit=%u scope=write32 admission_excluded=1\n",
+                    static_cast<long long>(ns), c.after, c.until, static_cast<long long>(c.minUs), c.limit);
+                return c;
+            }();
+            return cfg;
+        }
+        static std::atomic<uint32_t>& records() { static std::atomic<uint32_t> count{0}; return count; }
+        Clock::time_point start{};
+        uint32_t pc = 0, ra = 0, ioDepth = 0;
+        int tid = -1;
+        bool active = false;
+        VifKickWriteTiming(uint32_t address, uint32_t value, const R5900Context* ctx)
+        {
+            const auto& c = config(); // First Store32 arms the epoch, including boot writes.
+            if (!c.enabled || !c.limit || (address & 0x1FFFFFFFu) != 0x10009000u || !(value & 0x100u) ||
+                records().load(std::memory_order_relaxed) >= c.limit) return;
+            start = Clock::now();
+            const double elapsed = std::chrono::duration<double>(start-c.epoch).count();
+            if (elapsed < c.after || (c.until > 0 && elapsed > c.until)) return;
+            active = true;
+            tid = ps2_sched::currentThread(); ioDepth = ps2IoRegLockDepth();
+            if (ctx) { pc = ctx->pc; ra = static_cast<uint32_t>(_mm_extract_epi32(ctx->r[31], 0)); }
+        }
+        ~VifKickWriteTiming()
+        {
+            if (!active) return;
+            const auto end = Clock::now();
+            const auto us = std::chrono::duration_cast<std::chrono::microseconds>(end-start).count();
+            const auto& c = config();
+            if (us < c.minUs) return;
+            const uint32_t n = records().fetch_add(1, std::memory_order_relaxed);
+            if (n >= c.limit) return;
+            const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(start.time_since_epoch()).count();
+            std::fprintf(stderr, "[VIF-KICK-TIMING] n=%u elapsed=%.6f ns=%lld duration_us=%lld tid=%d pc=%08x ra=%08x io_depth=%u\n",
+                n, std::chrono::duration<double>(start-c.epoch).count(), static_cast<long long>(ns),
+                static_cast<long long>(us), tid, pc, ra, ioDepth);
+        }
+    };
+
