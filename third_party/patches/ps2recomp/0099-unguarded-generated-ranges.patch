+    // PS2RECOMP_UNGUARDED_RANGES="0x142000-0x148000,..." (end exclusive) names guest code
+    // emitted without source instrumentation, for hot code that no source owner reads, such
+    // as a software video decoder. Each such body refuses to run while an owner is bound,
+    // so a guarded configuration fails loudly instead of losing coverage.
+    const std::vector<std::pair<uint32_t, uint32_t>> &unguardedRanges()
+    {
+        static const std::vector<std::pair<uint32_t, uint32_t>> ranges = []
+        {
+            std::vector<std::pair<uint32_t, uint32_t>> result;
+            const char *text = std::getenv("PS2RECOMP_UNGUARDED_RANGES");
+            if (!text)
+                return result;
+            const std::regex item(R"(\s*0x([0-9a-fA-F]+)\s*-\s*0x([0-9a-fA-F]+)\s*)");
+            std::string all(text);
+            size_t at = 0;
+            while (at <= all.size())
+            {
+                const size_t end = std::min(all.find(',', at), all.size());
+                std::smatch match;
+                const std::string part = all.substr(at, end - at);
+                if (!std::regex_match(part, match, item))
+                    throw std::runtime_error("Invalid PS2RECOMP_UNGUARDED_RANGES entry: " + part);
+                const auto first = static_cast<uint32_t>(std::stoul(match[1].str(), nullptr, 16));
+                const auto last = static_cast<uint32_t>(std::stoul(match[2].str(), nullptr, 16));
+                if (first >= last)
+                    throw std::runtime_error("Empty PS2RECOMP_UNGUARDED_RANGES entry: " + part);
+                result.emplace_back(first, last);
+                at = end + 1;
+            }
+            return result;
+        }();
+        return ranges;
+    }
+
+    bool unguardedFunction(uint32_t start)
+    {
+        for (const auto &[first, last] : unguardedRanges())
+            if (start >= first && start < last)
+                return true;
+        return false;
+    }
+
+    std::string unguardedSource(const std::string &text)
+    {
+        static const std::regex signature(
+            R"((void\s+[A-Za-z_0-9]+\s*\(\s*uint8_t\s*\*\s*rdram\s*,\s*R5900Context\s*\*\s*ctx\s*,\s*PS2Runtime\s*\*\s*runtime\s*\)\s*\{))");
+        std::string body = std::regex_replace(
+            text, signature,
+            "$1\n    if (reo_parent_natural::actualOwnerBindingCount.load(std::memory_order_acquire))\n"
+            "        reo_parent_natural::refuseUnguardedSource(ctx->pc);\n");
+        // Compile batches share a translation unit, so an earlier instrumented file can leave
+        // guarded accessor macros defined; restore the plain ones around these bodies only.
+        std::smatch first;
+        const size_t bodies = std::regex_search(body, first, signature) ? size_t(first.position()) : 0;
+        const size_t comment = body.rfind("// Function:", bodies);
+        const size_t at = comment != std::string::npos ? comment : bodies;
+        body.insert(at, "#include \"ps2_plain_access_begin.hpp\"\n");
+        return "#include <atomic>\n#include <cstddef>\n#include <cstdint>\n"
+               "namespace reo_parent_natural {\n"
+               "extern std::atomic<std::size_t> actualOwnerBindingCount;\n"
+               "[[noreturn]] void refuseUnguardedSource(std::uint32_t pc);\n"
+               "}\n" +
+               body + "#include \"ps2_plain_access_end.hpp\"\n";
+    }
+}
 
