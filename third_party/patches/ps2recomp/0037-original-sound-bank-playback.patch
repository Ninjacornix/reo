--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/Syscalls/Helpers/ReoSoundBanks.h
@@ -0,0 +1,74 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+#include <memory>
+#include <unordered_map>
+
+// Owned Tsnd/HSYN bank format. Private helper: no guest state or output hooks.
+namespace ps2_reo_sound {
+constexpr unsigned kOutputRate = 48000;
+constexpr unsigned kSequenceRate = 240; // TsndInitTimer: 36864000 / 0x25800.
+constexpr unsigned kFramesPerTick = kOutputRate / kSequenceRate;
+
+struct Sample {
+    uint32_t bdOffset = 0;
+    uint16_t sampleRate = 0, adsr1 = 0, adsr2 = 0;
+    uint8_t flags = 0, rootNote = 0, programVolume = 0, regionVolume = 0, sampleVolume = 0;
+    int8_t programTranspose = 0, programFine = 0, regionTranspose = 0, regionFine = 0, sampleFine = 0;
+    uint32_t programRecord = 0, regionRecord = 0, sampleRecord = 0, vagiRecord = 0;
+    uint8_t velocityCurve = 0, regionLow = 0, regionCenter = 0, regionHigh = 0;
+    uint8_t velocityLow = 0, velocityCenter = 0, velocityHigh = 0;
+    uint16_t bendDown = 0, bendUp = 0;
+    int basePan = 64;
+};
+
+struct DecodedSample {
+    std::vector<int16_t> pcm;
+    size_t loopStart = 0;
+    bool hasLoop = false;
+};
+
+class Bank {
+public:
+    bool load(const uint8_t* hd, size_t hdBytes, const uint8_t* bd, size_t bdBytes,
+              const uint8_t* tq, size_t tqBytes);
+    bool sequence(unsigned index, uint32_t& offset, uint8_t& priority) const;
+    bool resolve(unsigned program, uint8_t note, uint8_t velocity, std::vector<Sample>& out) const;
+    bool decode(const Sample& sample, DecodedSample& out) const;
+    std::shared_ptr<const DecodedSample> decoded(const Sample& sample) const;
+    const std::vector<uint8_t>& tq() const { return tq_; }
+    unsigned sequenceCount() const;
+private:
+    std::vector<uint8_t> hd_, bd_, tq_;
+    uint32_t prog_ = 0, sset_ = 0, smpl_ = 0, vagi_ = 0;
+    std::unordered_map<uint32_t,std::shared_ptr<const DecodedSample>> decoded_;
+    bool record(uint32_t chunk, unsigned index, size_t bytes, uint32_t& offset) const;
+};
+
+enum class EventType { Note, Program, Volume, Pan, Pitch, Expression, Control,
+                       AllNotesOff, AllSoundOff, End, Unsupported };
+struct Event { EventType type; uint16_t value = 0; uint8_t note = 0, group = 0; };
+// One instance is one Tsnd TQ queue slot. Voice allocation/mixing is separate.
+class Sequence {
+public:
+    bool start(const Bank& bank, unsigned index, uint8_t programOffset);
+    bool tick(const Bank& bank, bool voicesActive, std::vector<Event>& events);
+    bool active() const { return active_; }
+private:
+    uint32_t cursor_ = 0;
+    uint16_t wait_ = 0;
+    uint8_t programOffset_ = 0;
+    bool active_ = false, hasNote_ = false;
+};
+
+// Synchronous EE bank transfers; queries report no pending load after return.
+bool submitBank(unsigned port, const uint8_t* hd, size_t hdBytes, const uint8_t* bd, size_t bdBytes,
+                const uint8_t* tq, size_t tqBytes);
+bool submitPacket(const uint8_t* ram, size_t ramBytes, const uint8_t* packet, size_t packetBytes);
+void mix(float* stereo, unsigned frames); // Add to an existing 48 kHz buffer.
+void reset();
+uint32_t pendingLoads();
+uint32_t portState(unsigned port, uint32_t& sequenceCount);
+uint32_t seState(unsigned port, unsigned index, unsigned group);
+}
diff --git a/ps2xRuntime/src/lib/Kernel/Syscalls/Helpers/ReoSoundBanks.cpp b/ps2xRuntime/src/lib/Kernel/Syscalls/Helpers/ReoSoundBanks.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/Syscalls/Helpers/ReoSoundBanks.cpp
@@ -0,0 +1,538 @@
+#include "ReoSoundBanks.h"
+#include <algorithm>
+#include <cstring>
+#include <limits>
+#include <utility>
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <mutex>
+
+namespace ps2_reo_sound {
+namespace {
+constexpr size_t kBankLimit = 2u * 1024u * 1024u;
+bool range(const std::vector<uint8_t>& bytes, size_t offset, size_t count) {
+    return offset <= bytes.size() && count <= bytes.size() - offset;
+}
+uint16_t u16(const std::vector<uint8_t>& b, size_t p) { return uint16_t(b[p]) | uint16_t(b[p + 1]) << 8; }
+uint32_t u32(const std::vector<uint8_t>& b, size_t p) {
+    return uint32_t(b[p]) | uint32_t(b[p + 1]) << 8 | uint32_t(b[p + 2]) << 16 | uint32_t(b[p + 3]) << 24;
+}
+bool signature(const std::vector<uint8_t>& b, uint32_t p, const char* name) {
+    if (!range(b, p, 16)) return false;
+    // HSYN signature helper 0x2E0 compares each four-byte word backwards:
+    // literal "SCEI" is stored as IECS, literal "Vers" as sreV.
+    for (unsigned i = 0; i < 4; ++i)
+        if (b[p + i] != uint8_t("SCEI"[3 - i]) || b[p + 4 + i] != uint8_t(name[3 - i])) return false;
+    return true;
+}
+}
+
+bool Bank::load(const uint8_t* hd, size_t hn, const uint8_t* bd, size_t bn,
+                const uint8_t* tq, size_t tn) {
+    hd_.clear(); bd_.clear(); tq_.clear(); decoded_.clear(); prog_ = sset_ = smpl_ = vagi_ = 0;
+    if (!hd || !bd || !tq || hn < 0x34 || tn < 16 || !bn ||
+        hn > kBankLimit || bn > kBankLimit || tn > kBankLimit) return false;
+    std::vector<uint8_t> header(hd, hd + hn);
+    if (!signature(header, 0, "Vers") || !signature(header, 0x10, "Head")) return false;
+    uint32_t chunks[4];
+    const char* names[4] = { "Prog", "Sset", "Smpl", "Vagi" };
+    for (unsigned i = 0; i < 4; ++i) {
+        chunks[i] = u32(header, 0x24 + i * 4);
+        if (chunks[i] == 0xFFFFFFFFu || !signature(header, chunks[i], names[i])) return false;
+    }
+    const size_t count = size_t(tq[14]) | size_t(tq[15]) << 8;
+    if (count > (tn - 16) / 4) return false;
+    hd_ = std::move(header); bd_.assign(bd, bd + bn); tq_.assign(tq, tq + tn);
+    prog_ = chunks[0]; sset_ = chunks[1]; smpl_ = chunks[2]; vagi_ = chunks[3];
+    // Guest-load work, never device-callback work. Bound both table scans and
+    // overlapping malformed sample records; valid non-overlapping 2 MiB BD
+    // data expands to at most 7 MiB PCM (28 samples per 16-byte ADPCM block).
+    const uint32_t maxVagi = u32(hd_, size_t(vagi_) + 12);
+    if (maxVagi > 4095 || !range(hd_,size_t(vagi_) + 16,size_t(maxVagi + 1) * 4)) return false;
+    size_t pcmBytes = 0;
+    for (unsigned index = 0; index <= maxVagi; ++index) {
+        uint32_t va;
+        if (!record(vagi_,index,8,va)) continue;
+        const uint32_t start = u32(hd_,va);
+        if (start == 0xFFFFFFFFu || decoded_.count(start)) continue;
+        Sample sample; sample.bdOffset = start;
+        auto pcm = std::make_shared<DecodedSample>();
+        if (!decode(sample,*pcm)) continue;
+        if (pcm->pcm.size() > (8u * 1024u * 1024u - pcmBytes) / sizeof(int16_t)) return false;
+        pcmBytes += pcm->pcm.size() * sizeof(int16_t);
+        decoded_.emplace(start,std::move(pcm));
+    }
+    return true;
+}
+
+bool Bank::record(uint32_t chunk, unsigned index, size_t bytes, uint32_t& offset) const {
+    if (!range(hd_, chunk, 16) || index > u32(hd_, size_t(chunk) + 12) ||
+        !range(hd_, size_t(chunk) + 16, size_t(index) * 4 + 4)) return false;
+    const uint32_t relative = u32(hd_, size_t(chunk) + 16 + size_t(index) * 4);
+    if (relative == 0xFFFFFFFFu || relative > std::numeric_limits<uint32_t>::max() - chunk) return false;
+    offset = chunk + relative;
+    return range(hd_, offset, bytes);
+}
+
+unsigned Bank::sequenceCount() const { return range(tq_, 14, 2) ? u16(tq_, 14) : 0; }
+bool Bank::sequence(unsigned index, uint32_t& offset, uint8_t& priority) const {
+    const unsigned count = sequenceCount();
+    if (!count && !index && range(tq_, 4, 1)) { offset = 4; priority = 0x40; return true; }
+    if (index >= count || !range(tq_, 16 + size_t(index) * 4, 4)) return false;
+    const uint32_t entry = u32(tq_, 16 + size_t(index) * 4);
+    offset = entry & 0xFFFF; priority = uint8_t(entry >> 24);
+    return range(tq_, offset, 1);
+}
+
+bool Bank::resolve(unsigned program, uint8_t note, uint8_t velocity, std::vector<Sample>& out) const {
+    out.clear();
+    uint32_t pr;
+    if (!record(prog_, program, 0x22, pr)) return false;
+    const unsigned count = hd_[pr + 4];
+    const uint32_t relative = u32(hd_, pr);
+    if (relative > std::numeric_limits<uint32_t>::max() - pr ||
+        !range(hd_, size_t(pr) + relative, size_t(count) * 20)) return false;
+    for (unsigned region = 0; region < count; ++region) {
+        const size_t r = size_t(pr) + relative + region * 20;
+        if (note < (hd_[r + 2] & 127) || note > (hd_[r + 4] & 127)) continue;
+        uint32_t ss;
+        if (!record(sset_, u16(hd_, r), 4, ss) || velocity < hd_[ss + 1] || velocity > hd_[ss + 2]) continue;
+        const unsigned samples = hd_[ss + 3];
+        if (!range(hd_, size_t(ss) + 4, samples * 2)) return false;
+        for (unsigned i = 0; i < samples; ++i) {
+            uint32_t sm, va;
+            if (!record(smpl_, u16(hd_, size_t(ss) + 4 + i * 2), 0x2A, sm) ||
+                velocity < (hd_[sm + 2] & 127) || velocity > (hd_[sm + 4] & 127) ||
+                !record(vagi_, u16(hd_, sm), 8, va)) continue;
+            const uint32_t start = u32(hd_, va);
+            if (start == 0xFFFFFFFFu || !range(bd_, start, 16) || !u16(hd_, va + 4)) continue;
+            Sample s;
+            s.bdOffset = start; s.sampleRate = u16(hd_, va + 4); s.flags = hd_[va + 6];
+            s.adsr1 = u16(hd_, sm + 0x12); s.adsr2 = u16(hd_, sm + 0x14);
+            s.rootNote = hd_[sm + 0xB]; s.sampleFine = int8_t(hd_[sm + 0xC]);
+            s.programVolume = hd_[pr + 6]; s.regionVolume = hd_[r + 0x10]; s.sampleVolume = hd_[sm + 0x10];
+            s.programTranspose = int8_t(hd_[pr + 8]); s.programFine = int8_t(hd_[pr + 9]);
+            s.regionTranspose = int8_t(hd_[r + 0x12]); s.regionFine = int8_t(hd_[r + 0x13]);
+            s.programRecord = pr; s.regionRecord = uint32_t(r); s.sampleRecord = sm; s.vagiRecord = va;
+            s.velocityCurve = hd_[ss];
+            s.regionLow = hd_[r + 2]; s.regionCenter = hd_[r + 3]; s.regionHigh = hd_[r + 4];
+            s.velocityLow = hd_[sm + 2]; s.velocityCenter = hd_[sm + 3]; s.velocityHigh = hd_[sm + 4];
+            s.bendDown = u16(hd_, r + 6); s.bendUp = u16(hd_, r + 8);
+            s.basePan = std::clamp(std::abs(int(int8_t(hd_[pr + 7]))) +
+                std::abs(int(int8_t(hd_[r + 0x11]))) + std::abs(int(int8_t(hd_[sm + 0xD]))) - 128, 0, 127);
+            out.push_back(s);
+        }
+    }
+    return true;
+}
+
+bool Bank::decode(const Sample& sample, DecodedSample& out) const {
+    const auto cached = decoded_.find(sample.bdOffset);
+    if (cached != decoded_.end()) { out = *cached->second; return true; }
+    out = {};
+    if (!range(bd_, sample.bdOffset, 16)) return false;
+    static constexpr int coefficients[5][2] = {{0,0},{60,0},{115,-52},{98,-55},{122,-60}};
+    int previous = 0, older = 0;
+    bool sawLoopStart = false;
+    for (size_t at = sample.bdOffset; range(bd_, at, 16); at += 16) {
+        const uint8_t control = bd_[at], flags = bd_[at + 1];
+        unsigned shift = control & 15, filter = control >> 4;
+        if (shift > 12) shift = 9;
+        if (filter > 4) return false;
+        if (flags & 4) { out.loopStart = out.pcm.size(); sawLoopStart = true; }
+        for (unsigned i = 0; i < 28; ++i) {
+            const uint8_t packed = bd_[at + 2 + i / 2];
+            int nibble = ((i & 1) ? packed >> 4 : packed) & 15;
+            if (nibble & 8) nibble -= 16;
+            const int prediction = (previous * coefficients[filter][0] + older * coefficients[filter][1] + 32) >> 6;
+            const int value = std::clamp(nibble * (1 << (12 - shift)) + prediction, -32768, 32767);
+            older = previous; previous = value;
+            out.pcm.push_back(int16_t(value));
+        }
+        if (flags & 1) { out.hasLoop = (flags & 2) != 0; if (!sawLoopStart) out.loopStart = 0; return true; }
+    }
+    // A sample without an end block is truncated; do not play adjacent bank data.
+    out = {};
+    return false;
+}
+
+std::shared_ptr<const DecodedSample> Bank::decoded(const Sample& sample) const {
+    const auto cached = decoded_.find(sample.bdOffset);
+    return cached == decoded_.end() ? nullptr : cached->second;
+}
+
+bool Sequence::start(const Bank& bank, unsigned index, uint8_t programOffset) {
+    uint8_t priority;
+    active_ = bank.sequence(index, cursor_, priority);
+    wait_ = 0; programOffset_ = programOffset; hasNote_ = false;
+    return active_;
+}
+
+bool Sequence::tick(const Bank& bank, bool voicesActive, std::vector<Event>& events) {
+    events.clear();
+    if (!active_) return false;
+    if (wait_) { --wait_; return true; }
+    const auto& tq = bank.tq();
+    auto need = [&](size_t n) { return range(tq, cursor_, n); };
+    auto end = [&]() { active_ = false; events.push_back({EventType::End}); return false; };
+    bool noteThisTick = false;
+    // Bound malformed loops independently of bank-controlled sequence offsets.
+    for (unsigned commands = 0; commands < 1024; ++commands) {
+        if (!need(1)) return end();
+        const uint32_t start = cursor_;
+        const uint8_t op = tq[cursor_++];
+        if (!(op & 128)) {
+            if (!need(1)) return end();
+            if (!(tq[cursor_] & 128)) { wait_ = uint16_t(op) + uint16_t(tq[cursor_++]) * 128; }
+            else wait_ = uint16_t(op) * 4 + 3;
+            return true;
+        }
+        if (op < 0xE0) {
+            if (!need(1)) return end();
+            uint8_t velocity = tq[cursor_++], group = 0;
+            if (velocity & 128) { group = velocity & 127; if (!need(1)) return end(); velocity = tq[cursor_++]; }
+            events.push_back({EventType::Note, velocity, uint8_t((op & 127) + 12), group});
+            hasNote_ = true;
+            noteThisTick = true;
+            continue;
+        }
+        if (op == 0xFF || op == 0xFE) {
+            if (op == 0xFF) {
+                if (voicesActive || noteThisTick || !hasNote_) { cursor_ = start; return true; }
+                events.push_back({EventType::AllSoundOff}); return end();
+            }
+            if (!need(1)) return end();
+            const uint8_t mode = tq[cursor_++];
+            if (!mode) {
+                if (voicesActive || noteThisTick || !hasNote_) { cursor_ = start; return true; }
+                continue;
+            }
+            events.push_back({mode == 0xFE ? EventType::AllNotesOff : EventType::AllSoundOff});
+            return end();
+        }
+        if (op == 0xF8) {
+            if (!need(2)) return end();
+            cursor_ = u16(tq, cursor_);
+            continue;
+        }
+        if (op == 0xE5 || op == 0xE6) {
+            events.push_back({op == 0xE5 ? EventType::AllNotesOff : EventType::AllSoundOff}); continue;
+        }
+        if (op == 0xE3) {
+            if (!need(2)) return end();
+            const uint16_t pitch = uint16_t(tq[cursor_]) | uint16_t(tq[cursor_ + 1]) << 7;
+            cursor_ += 2; events.push_back({EventType::Pitch, pitch}); continue;
+        }
+        if (op >= 0xE0 && op <= 0xEA) {
+            if (!need(1)) return end();
+            const uint8_t value = tq[cursor_++];
+            if (op == 0xE0) events.push_back({EventType::Volume, value});
+            else if (op == 0xE1) events.push_back({EventType::Pan, value});
+            else if (op == 0xE2) events.push_back({EventType::Program, uint16_t(std::min(unsigned(value) + programOffset_, 127u))});
+            else if (op == 0xE4) events.push_back({EventType::Expression, value});
+            else events.push_back({EventType::Control, value, op});
+            continue;
+        }
+        // Extended voice-change/RPN commands remain explicit until implemented.
+        active_ = false; events.push_back({EventType::Unsupported, op}); return false;
+    }
+    active_ = false; events.push_back({EventType::Unsupported, 0xFFFF}); return false;
+}
+
+namespace {
+struct Envelope {
+    enum Phase { Attack, Decay, Sustain, Release, Off } phase = Attack;
+    int value = 0;
+    uint32_t countdown = 0;
+    uint16_t first = 0, second = 0;
+    void release() { phase = Release; countdown = 0; }
+    float advance() {
+        if (phase == Off) return 0;
+        if (countdown) { --countdown; return float(value) / 32768.f; }
+        unsigned rate = 0; bool decreasing = false, exponential = false;
+        if (phase == Attack) { rate = (first >> 8) & 127; exponential = (first & 0x8000) != 0; }
+        else if (phase == Decay) { rate = ((first >> 4) & 15) * 4; decreasing = exponential = true; }
+        else if (phase == Sustain) {
+            rate = (second >> 6) & 127; decreasing = (second & 0x4000) != 0; exponential = (second & 0x8000) != 0;
+        } else { rate = (second & 31) * 4; decreasing = true; exponential = (second & 32) != 0; }
+        if (rate == 127) return float(value) / 32768.f;
+        const unsigned shift = rate >> 2;
+        int step = decreasing ? -8 + int(rate & 3) : 7 - int(rate & 3);
+        uint32_t cycles = 1u << (shift > 11 ? shift - 11 : 0);
+        if (shift < 11) step *= 1 << (11 - shift);
+        if (exponential && decreasing) step = (step * value) >> 15;
+        else if (exponential && value > 0x6000) cycles *= 4;
+        value = std::clamp(value + step, 0, 32767); countdown = cycles - 1;
+        if (phase == Attack && value == 32767) { phase = Decay; countdown = 0; }
+        else if (phase == Decay && value <= int((first & 15) + 1) * 0x800) { phase = Sustain; countdown = 0; }
+        else if (phase == Release && value == 0) phase = Off;
+        return float(value) / 32768.f;
+    }
+};
+struct Voice {
+    unsigned port = 0, slot = 0;
+    uint8_t note = 0, group = 0, velocity = 0;
+    Sample sample;
+    std::shared_ptr<const DecodedSample> data;
+    double position = 0;
+    double step = 0;
+    int cachedBend = 32768;
+    Envelope envelope;
+    bool active = true;
+};
+struct Request {
+    Sequence sequence;
+    uint8_t index = 0, group = 0, priority = 0, cancelFlags = 0;
+    uint8_t requestVolume = 127, requestPan = 64;
+    uint16_t requestPitch = 0x2000, pitch = 0x2000;
+    unsigned program = 0, volume = 127, expression = 127, pan = 64;
+    uint64_t age = 0;
+};
+struct Port { Bank bank; bool loaded = false; unsigned volume = 256; std::array<Request,16> requests; };
+std::array<Port,14> ports;
+std::vector<Voice> voices;
+std::mutex soundMutex;
+uint64_t requestAge = 0, frameClock = 0;
+bool muted = false, mono = false;
+unsigned unsupportedReports = 0;
+
+void report(const char* kind, unsigned value) {
+    if (unsupportedReports++ < 32) std::fprintf(stderr,"[REO-BANK] unsupported %s=%u\n",kind,value);
+}
+void stop(unsigned port, int slot = -1, bool release = false) {
+    for (auto& voice : voices) if (voice.port == port && (slot < 0 || voice.slot == unsigned(slot))) {
+        if (release) voice.envelope.release(); else voice.active = false;
+    }
+    if (!release) for (unsigned i = 0; i < 16; ++i)
+        if (slot < 0 || unsigned(slot) == i) ports[port].requests[i].sequence = {};
+}
+bool installBankUnlocked(unsigned port, Bank&& loaded, size_t hn, size_t bn, size_t tn) {
+    if (port >= ports.size()) return false;
+    stop(port); ports[port].bank = std::move(loaded); ports[port].loaded = true;
+    voices.reserve(48);
+    std::fprintf(stderr,"[REO-BANK] load port=%u hd=%zu bd=%zu tq=%zu sequences=%u\n",port,hn,bn,tn,ports[port].bank.sequenceCount());
+    return true;
+}
+bool matches(const Request& request, unsigned index, unsigned group) {
+    return ((index & 128) || request.index == (index & 127)) &&
+           ((group & 128) || request.group == (group & 127));
+}
+void request(unsigned portByte, unsigned indexByte, unsigned groupByte, uint8_t volume, uint8_t pan,
+             uint16_t pitch, uint8_t trailer, bool change, bool cancel) {
+    const unsigned port = portByte & 127;
+    if (port >= ports.size() || !ports[port].loaded) return;
+    auto& p = ports[port];
+    if (change || cancel) {
+        for (unsigned slot = 0; slot < 16; ++slot) {
+            auto& r = p.requests[slot];
+            if (!r.sequence.active() || !matches(r,indexByte,groupByte)) continue;
+            if (cancel) stop(port,int(slot),true);
+            else { if (volume != 255) r.requestVolume = volume; if (pan != 255) r.requestPan = pan;
+                   if (pitch != 65535) r.requestPitch = pitch; }
+        }
+        return;
+    }
+    uint32_t offset; uint8_t priority;
+    if (!p.bank.sequence(indexByte & 127, offset, priority)) return;
+    int available = -1;
+    for (int slot = 15; slot >= 0; --slot) {
+        auto& r = p.requests[unsigned(slot)];
+        if (r.sequence.active() && (((portByte & 128) && (r.cancelFlags & 1)) ||
+            ((indexByte & 128) && (r.cancelFlags & 4) && r.index == (indexByte & 127)) ||
+            ((groupByte & 128) && (r.cancelFlags & 2) && r.group == (groupByte & 127)))) stop(port,slot,true);
+        if (!r.sequence.active() && available < 0) available = slot;
+    }
+    if (available < 0) {
+        unsigned lowest = priority ? priority - 1 : 0; uint64_t oldest = requestAge;
+        for (int slot = 15; slot >= 0; --slot) {
+            const auto& r = p.requests[unsigned(slot)];
+            if (r.priority <= lowest && r.age <= oldest) { lowest = r.priority; oldest = r.age; available = slot; }
+        }
+    }
+    if (available < 0) return;
+    stop(port,available);
+    auto& r = p.requests[unsigned(available)]; r = {};
+    r.index = indexByte & 127; r.group = groupByte & 127; r.priority = priority;
+    r.cancelFlags = uint8_t((portByte >> 7) | ((groupByte >> 7) << 1) | ((indexByte >> 7) << 2));
+    r.requestVolume = volume; r.requestPan = pan; r.requestPitch = pitch; r.age = ++requestAge;
+    r.sequence.start(p.bank, r.index, trailer);
+}
+double crossfade(unsigned value, unsigned low, unsigned pivot, unsigned high) {
+    if (value < pivot && (low & 128) && (low & 127) != pivot)
+        return double(int(value) - int(low & 127) + 1) / double(int(pivot) - int(low & 127) + 1);
+    if (value >= pivot && (high & 128) && (high & 127) != pivot)
+        return double(int(high & 127) + 1 - int(value)) / double(int(high & 127) + 1 - int(pivot));
+    return 1;
+}
+void tickUnlocked() {
+    std::vector<Event> events; std::vector<Sample> samples;
+    for (unsigned port = 0; port < ports.size(); ++port) {
+        auto& p = ports[port]; if (!p.loaded) continue;
+        for (unsigned slot = 0; slot < 16; ++slot) {
+            auto& r = p.requests[slot];
+            bool playing = false;
+            for (const auto& v : voices) if (v.active && v.port == port && v.slot == slot) { playing = true; break; }
+            r.sequence.tick(p.bank, playing, events);
+            for (const auto& e : events) {
+                switch (e.type) {
+                case EventType::Program: r.program = e.value; break;
+                case EventType::Volume: r.volume = e.value; break;
+                case EventType::Expression: r.expression = e.value; break;
+                case EventType::Pan: r.pan = e.value; break;
+                case EventType::Pitch: r.pitch = e.value; break;
+                case EventType::AllNotesOff: stop(port,int(slot),true); break;
+                case EventType::AllSoundOff: stop(port,int(slot)); break;
+                case EventType::Note:
+                    if (!e.value) {
+                        for (auto& v : voices) if (v.active && v.port == port && v.slot == slot && v.note == e.note && v.group == e.group) v.envelope.release();
+                    } else if (p.bank.resolve(r.program,e.note,uint8_t(e.value),samples)) {
+                        for (const auto& s : samples) {
+                            if (s.velocityCurve) { report("velocity-curve",s.velocityCurve); continue; }
+                            Voice v; v.port = port; v.slot = slot; v.note = e.note; v.group = e.group;
+                            v.velocity = uint8_t(e.value); v.sample = s; v.envelope.first = s.adsr1; v.envelope.second = s.adsr2;
+                            v.data = p.bank.decoded(s);
+                            if (!v.data) { report("sample-decode",s.bdOffset); continue; }
+                            if (voices.size() >= 48) { report("voice-capacity",48); continue; }
+                            voices.push_back(std::move(v));
+                        }
+                    }
+                    break;
+                case EventType::Control: report("TQ-control",e.note); break;
+                case EventType::Unsupported: report("TQ-opcode",e.value); stop(port,int(slot)); break;
+                case EventType::End: break;
+                }
+            }
+        }
+    }
+}
+}
