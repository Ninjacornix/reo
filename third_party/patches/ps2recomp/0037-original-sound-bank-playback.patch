+bool submitBank(unsigned port, const uint8_t* hd, size_t hn, const uint8_t* bd, size_t bn,
+                const uint8_t* tq, size_t tn) {
+    Bank loaded;
+    if (port >= ports.size() || !loaded.load(hd,hn,bd,bn,tq,tn)) return false;
+    std::lock_guard<std::mutex> lock(soundMutex);
+    return installBankUnlocked(port,std::move(loaded),hn,bn,tn);
+}
+bool submitPacket(const uint8_t* ram, size_t ramBytes, const uint8_t* packet, size_t bytes) {
+    if (!packet || !bytes) return false;
+    std::unique_lock<std::mutex> lock(soundMutex);
+    for (size_t at = 0; at < bytes && packet[at] != 255;) {
+        const auto* cmd = packet + at; const uint8_t op = *cmd;
+        size_t length = 0;
+        if ((op & 0xF0) == 0) length = op == 8 ? 4 : 5 + ((op & 1) ? 1 : 0) + ((op & 2) ? 1 : 0) + ((op & 4) ? 2 : 0);
+        else if (op == 0x28 || op == 0x40 || op == 0x43) length = 1;
+        else if (op == 0x29 || op == 0x4B) length = 3;
+        else if (op == 0x41 || op == 0x42 || (op >= 0x47 && op <= 0x4A)) length = 2;
+        else if (op == 0x44) length = 6;
+        else if (op == 0x45 || op == 0x4C) length = 4;
+        else if (op == 0x4D || op == 0x4E) length = 21;
+        if (!length || length > bytes - at) { report("packet-opcode",op); return false; }
+        if ((op & 0xF0) == 0) {
+            size_t pos = 4;
+            const bool change = (op & 8) != 0;
+            uint8_t volume = change ? 255 : 127, pan = change ? 255 : 64;
+            uint16_t pitch = change ? 65535 : 0x2000;
+            if (op != 8) {
+                if (op & 1) volume = cmd[pos++]; if (op & 2) pan = cmd[pos++];
+                if (op & 4) { pitch = uint16_t(cmd[pos]) << 8 | cmd[pos + 1]; pos += 2; }
+            }
+            request(cmd[1],cmd[2],cmd[3],volume,pan,pitch,op == 8 ? 0 : cmd[pos],change,op == 8);
+        } else if (op == 0x4D || op == 0x4E) {
+            const unsigned port = unsigned(cmd[1]) << 8 | cmd[2];
+            if (port >= ports.size()) { report("load-id",port); return false; }
+            if (op == 0x4D || !ports[port].loaded) {
+                const uint8_t* data[3]; size_t sizes[3];
+                for (unsigned i = 0; i < 3; ++i) {
+                    const auto* p = cmd + 3 + i * 6;
+                    const uint32_t address = (uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | (p[3] & 240)) & 0x1FFFFFF;
+                    sizes[i] = size_t(p[3] & 15) << 20 | size_t(p[4]) << 12 | size_t(p[5]) << 4;
+                    if (!ram || address > ramBytes || sizes[i] > ramBytes - address) return false;
+                    data[i] = ram + address;
+                }
+                // Decode on the submitting guest thread without blocking the
+                // device callback while it continues other banks/CRI streams.
+                Bank loaded;
+                lock.unlock();
+                const bool valid = loaded.load(data[0],sizes[0],data[1],sizes[1],data[2],sizes[2]);
+                lock.lock();
+                if (!valid || !installBankUnlocked(port,std::move(loaded),sizes[0],sizes[1],sizes[2])) return false;
+            }
+        } else if (op == 0x29) {
+            for (auto& p : ports) p.volume = unsigned(cmd[1]) << 8 | cmd[2];
+        } else if (op == 0x41) muted = cmd[1] != 0;
+        else if (op == 0x42) mono = cmd[1] == 0;
+        else if (op == 0x4C) { if (cmd[1] < ports.size()) ports[cmd[1]].volume = unsigned(cmd[2]) << 8 | cmd[3]; }
+        else if (op == 0x28 || op == 0x40 || op == 0x43) {
+            for (unsigned port = 0; port < ports.size(); ++port) { stop(port); if (op == 0x43) ports[port].loaded = false; }
+        } else if (op >= 0x47 && op <= 0x4A && cmd[1] < ports.size()) {
+            stop(cmd[1]); if (op < 0x4A) ports[cmd[1]].loaded = false;
+        } else if (op == 0x44) report("reverb",cmd[1]);
+        else report("global-control",op);
+        at += length;
+    }
+    return true;
+}
+void mix(float* stereo, unsigned frames) {
+    if (!stereo || !frames) return;
+    std::lock_guard<std::mutex> lock(soundMutex);
+    for (unsigned frame = 0; frame < frames; ++frame, ++frameClock) {
+        if (frameClock % kFramesPerTick == 0) tickUnlocked();
+        for (auto& v : voices) {
+            if (!v.active || !v.data || v.data->pcm.empty()) continue;
+            const auto& data = *v.data;
+            if (v.position >= data.pcm.size()) {
+                if (data.hasLoop && data.loopStart < data.pcm.size())
+                    v.position = data.loopStart + std::fmod(v.position - data.loopStart, double(data.pcm.size() - data.loopStart));
+                else { v.active = false; continue; }
+            }
+            const auto& p = ports[v.port]; const auto& r = p.requests[v.slot]; const auto& s = v.sample;
+            const int bend = std::clamp(int(r.pitch) + int(r.requestPitch) - 0x4000, -8192, 8191);
+            if (bend != v.cachedBend) {
+                const double bendFine = double(bend) * (bend < 0 ? s.bendDown : s.bendUp) / 8192.;
+                const double semitones = int(v.note) + s.programTranspose + s.regionTranspose - int(s.rootNote) +
+                    (s.programFine + s.regionFine + s.sampleFine + bendFine) / 128.;
+                const unsigned pitch = std::min(0x3FFFu, unsigned(std::max(0.,std::floor(4096. * s.sampleRate / kOutputRate * std::exp2(semitones / 12.)))));
+                v.step = double(pitch) / 4096.; v.cachedBend = bend;
+            }
+            const size_t index = size_t(v.position);
+            const size_t next = index + 1 < data.pcm.size() ? index + 1 : data.hasLoop ? data.loopStart : index;
+            const double fraction = v.position - index;
+            const double pcm = data.pcm[index] + (data.pcm[next] - data.pcm[index]) * fraction;
+            double amplitude = double(s.programVolume) * s.regionVolume * s.sampleVolume * v.velocity / 16384.;
+            amplitude *= crossfade(v.note,s.regionLow,s.regionCenter,s.regionHigh) * crossfade(v.velocity,s.velocityLow,s.velocityCenter,s.velocityHigh);
+            const unsigned channelVolume = std::min(127u,r.volume * r.requestVolume / 127) * 128 / 127;
+            const unsigned expression = std::min(127u,r.expression) * 128 / 127;
+            amplitude = std::floor(amplitude * channelVolume * expression / 16384.);
+            amplitude = std::min(16383.,std::floor(amplitude * p.volume / 256.));
+            const float envelope = v.envelope.advance();
+            if (v.envelope.phase == Envelope::Off) { v.active = false; continue; }
+            const int pan = mono ? 64 : std::clamp(s.basePan + int(r.pan) + int(r.requestPan) - 128,0,127);
+            const double left = pan > 64 ? double(127 - pan) / 63 : 1;
+            const double right = pan < 64 ? double(std::max(pan - 1,0)) / 63 : 1;
+            if (!muted) { stereo[frame * 2] += float(pcm / 32768. * amplitude / 16384. * envelope * left);
+                          stereo[frame * 2 + 1] += float(pcm / 32768. * amplitude / 16384. * envelope * right); }
+            v.position += v.step;
+        }
+        if (frameClock % kFramesPerTick == kFramesPerTick - 1)
+            voices.erase(std::remove_if(voices.begin(),voices.end(),[](const Voice& v){return !v.active;}),voices.end());
+    }
+}
+void reset() {
+    std::lock_guard<std::mutex> lock(soundMutex);
+    ports = {}; voices.clear(); voices.reserve(48); requestAge = frameClock = 0; muted = mono = false; unsupportedReports = 0;
+}
+uint32_t pendingLoads() { return 0; }
+uint32_t portState(unsigned port, uint32_t& count) {
+    std::lock_guard<std::mutex> lock(soundMutex);
+    count = port < ports.size() && ports[port].loaded ? ports[port].bank.sequenceCount() : 0;
+    return port < ports.size() && ports[port].loaded ? 1 : 0;
+}
+uint32_t seState(unsigned port, unsigned index, unsigned group) {
+    std::lock_guard<std::mutex> lock(soundMutex);
+    if (port >= ports.size()) return 0;
+    for (const auto& r : ports[port].requests) if (r.sequence.active() && r.index == (index & 127) && r.group == (group & 127)) return 1;
+    return 0;
+}
