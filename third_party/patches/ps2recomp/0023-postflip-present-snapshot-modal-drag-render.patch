new file mode 100644
index 0000000..c07ce1b
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/Host/Win32ModalRender.cpp
@@ -0,0 +1,60 @@
+// Keeps the game window rendering while Windows runs its modal move/resize loop (D42).
+// Dragging or resizing a window makes DispatchMessage() block inside DefWindowProc until
+// the mouse is released, so the raylib/GLFW main loop stops presenting. A subclassed
+// window procedure starts a timer on WM_ENTERSIZEMOVE; each WM_TIMER calls back into the
+// runtime to draw and swap one frame (without polling events, which would steal the
+// modal loop's mouse messages). Kept separate from ps2_runtime.cpp: windows.h clashes
+// with raylib's names.
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+
+namespace
+{
+    constexpr UINT_PTR kModalTimerId = 0x52454F31u; // 'REO1'
+    WNDPROC g_prevProc = nullptr;
+    void (*g_render)() = nullptr;
+    bool g_inRender = false;
+
+    LRESULT CALLBACK modalAwareProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam)
+    {
+        switch (msg)
+        {
+        case WM_ENTERSIZEMOVE:
+            SetTimer(hwnd, kModalTimerId, USER_TIMER_MINIMUM, nullptr); // 10 ms
+            break;
+        case WM_EXITSIZEMOVE:
+            KillTimer(hwnd, kModalTimerId);
+            break;
+        case WM_TIMER:
+            if (wParam == kModalTimerId)
+            {
+                if (g_render && !g_inRender)
+                {
+                    g_inRender = true;
+                    g_render();
+                    g_inRender = false;
+                }
+                return 0;
+            }
+            break;
+        default:
+            break;
+        }
+        return CallWindowProcW(g_prevProc, hwnd, msg, wParam, lParam);
+    }
+}
+
+void ps2InstallModalRender(void *nativeWindow, void (*render)())
+{
+    HWND hwnd = static_cast<HWND>(nativeWindow);
+    if (!hwnd || g_prevProc)
+        return;
+    g_render = render;
+    g_prevProc = reinterpret_cast<WNDPROC>(
+        SetWindowLongPtrW(hwnd, GWLP_WNDPROC, reinterpret_cast<LONG_PTR>(&modalAwareProc)));
+}
+#else
+void ps2InstallModalRender(void *, void (*)()) {}
+#endif
