 using namespace GSInternal;
 
+// Runtime lifetime hooks intentionally stay private to the implementation.
+bool ps2GsWorkerStopRequested()
+{
+    return g_gsStopRequested.load(std::memory_order_acquire);
+}
+
+void ps2GsRequestWorkerStop()
+{
+    g_gsStopRequested.store(true, std::memory_order_release);
+    {
+        std::lock_guard<std::mutex> lock(g_gsAsync.m);
+        g_gsAsync.stopping = true;
+        g_gsAsync.queue.clear();
+        // Includes the item currently executing; completion handles stopped
+        // accounting explicitly, so cancellation cannot underflow this value.
+        g_gsAsync.queuedBytes = 0;
+    }
+    g_gsAsync.work.notify_all();
+    g_gsAsync.drained.notify_all();
+    // Pair with the wait mutex so a host waiter cannot miss the stop wake.
+    { std::lock_guard<std::mutex> lock(g_vblankWaitMutex); }
+    g_vblankCv.notify_all();
+}
+
+void ps2GsJoinWorker()
+{
+    ps2GsRequestWorkerStop();
+    if (t_isGsWorker) return; // Joining is owned by the host shutdown coordinator.
+    std::lock_guard<std::mutex> joinLock(g_gsJoinMutex);
+    std::thread worker;
+    {
+        std::lock_guard<std::mutex> lock(g_gsAsync.m);
+        worker = std::move(g_gsAsync.worker);
+    }
+    if (worker.joinable()) worker.join(); // Neither queue nor GS state mutex held.
+    {
+        std::lock_guard<std::mutex> lock(g_gsAsync.m);
+        g_gsInstance = nullptr;
+        g_gsPrivRegs = nullptr;
+        g_gsAsync.busy = false;
+        g_gsAsync.started = false;
+    }
+    {
+        std::lock_guard<std::mutex> lock(g_publishedDisplayMutex);
+        g_publishedDisplay.reset();
+    }
+}
