diff --git a/ps2xRecomp/include/ps2recomp/native_paths.h b/ps2xRecomp/include/ps2recomp/native_paths.h
new file mode 100644
--- /dev/null
+++ b/ps2xRecomp/include/ps2recomp/native_paths.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <filesystem>
+#include <string>
+
+namespace ps2recomp::native_paths {
+inline std::filesystem::path extended(std::filesystem::path path) {
+    path = std::filesystem::absolute(path).lexically_normal();
+#ifdef _WIN32
+    std::wstring value = path.native();
+    if (value.rfind(L"\\\\?\\", 0) != 0) {
+        value = value.rfind(L"\\\\", 0) == 0
+            ? L"\\\\?\\UNC\\" + value.substr(2)
+            : L"\\\\?\\" + value;
+    }
+    path = std::filesystem::path(value);
+#endif
+    return path;
+}
+inline std::filesystem::path utf8(const std::string& path) {
+    return extended(std::filesystem::u8path(path));
+}
+}
