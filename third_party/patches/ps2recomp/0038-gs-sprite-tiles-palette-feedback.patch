+            }();
+            static unsigned samples = 0;
+            if (samples >= limit || key[8] * key[9] < 4096)
+                return;
+            const auto now = Clock::now();
+            if (std::chrono::duration<double>(now - epoch).count() < at)
+                return;
+            active = true;
+            index = ++samples;
+            state = key;
+            started = now;
+        }
+        ~SpriteProfile()
+        {
+            if (!active)
+                return;
+            const auto us = std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - started).count();
+            std::fprintf(stderr, "[GS-SPR-PROFILE] n=%u us=%lld frame=%x tex=%x tme=%d fst=%d linear=%d abe=%d tfx=%d tcc=%d rect=%dx%d span=%dx%d uv_delta=%d,%d\n",
