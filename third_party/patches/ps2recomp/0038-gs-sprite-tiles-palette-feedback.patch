+        explicit SpriteProfile(const std::array<int, 14> &key)
+        {
+            static const char *atEnv = std::getenv("REO_SPR_PROFILE_AT");
+            static const bool enabled = atEnv != nullptr;
+            if (!enabled)
+                return;
+            static const auto epoch = Clock::now();
+            static const double at = std::max(0.0, std::strtod(atEnv, nullptr));
+            static const unsigned limit = [] {
+                const char *e = std::getenv("REO_SPR_PROFILE_COUNT");
