+        void disable(const char *reason) { known = false; disabledReason = reason; }
+        bool canBypass() const { return known && pendingImageBytes == 0u; }
+        // Producer-owned under the queue mutex. Track the only packet-to-packet
+        // payload continuation supported by processGIFPacket: fragmented IMAGE.
+        // Any unproven parse disables this experiment until the next GS::init.
+        void observe(const uint8_t *data, size_t size)
+        {
+            if (!known || size < 16u) return;
+            if (!data) { disable("null-data"); return; }
+            if (size > 16u * 1024u * 1024u) { disable("packet-size-limit"); return; }
+            if (pendingImageBytes)
+            {
+                const size_t take = std::min<size_t>(pendingImageBytes, size);
+                pendingImageBytes -= uint32_t(take); data += take; size -= take;
+                if (size < 16u) return;
+            }
+            size_t offset = 0;
+            unsigned tags = 0;
+            while (offset + 16u <= size)
+            {
+                if (++tags > 4096u) { disable("tag-limit"); return; }
+                const uint64_t tag = gsStateLoad64(data + offset);
+                offset += 16u;
+                const unsigned loops = unsigned(tag & 0x7fffu);
+                const unsigned format = unsigned((tag >> 58u) & 3u);
+                unsigned regs = unsigned(tag >> 60u);
+                if (!regs) regs = 16u;
+                size_t payload = 0;
+                if (format == 0u) payload = size_t(loops) * regs * 16u;
+                else if (format == 1u) payload = (size_t(loops) * regs * 8u + 15u) & ~size_t(15u);
