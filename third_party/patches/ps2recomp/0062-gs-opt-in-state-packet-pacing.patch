+    bool gsIsStateOnlyPacket(const uint8_t *data, size_t size)
+    {
+        if (!data || size < 32u || size > 272u || (size & 15u)) return false;
+        const uint64_t tag = gsStateLoad64(data);
+        const unsigned loops = unsigned(tag & 0x7fffu);
+        constexpr uint64_t allowedTagBits = 0x100000000000ffffull; // NREG=1, EOP, NLOOP.
+        if ((tag & ~allowedTagBits) || (tag >> 60u) != 1u || !(tag & 0x8000u) ||
+            !loops || loops > 16u || size != 16u + size_t(loops) * 16u || gsStateLoad64(data + 8u) != 0xeull)
+            return false;
+        for (unsigned i = 0; i < loops; ++i)
+        {
+            // Upper address bits must be zero, rather than silently truncating
+            // unknown A+D encodings as the general runtime parser currently does.
+            const uint64_t address = gsStateLoad64(data + 24u + size_t(i) * 16u);
+            switch (address)
+            {
+            case 0x18u: case 0x19u: // XYOFFSET1/2
+            case 0x45u: case 0x46u: // DTHE / COLCLAMP
+            case 0x4cu: case 0x4du: // FRAME1/2
+            case 0x4eu: case 0x4fu: // ZBUF1/2
+                break;
+            default: return false;
+            }
+        }
+        return true;
+    }
+    struct GsStatePacketStream
