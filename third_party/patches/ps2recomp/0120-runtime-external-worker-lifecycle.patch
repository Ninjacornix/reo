+bool PS2Runtime::registerExternalWorker(std::shared_ptr<ExternalWorker> worker) noexcept
+{
+    if (!worker) return false;
+    try
+    {
+        std::lock_guard<std::mutex> lock(m_externalWorkersMutex);
+        if (m_externalWorkersSealed || m_stopRequested.load(std::memory_order_acquire))
+            return false;
+        if (!m_externalWorkers) m_externalWorkers = std::make_shared<ExternalWorkerList>();
+        for (const auto &existing : *m_externalWorkers)
+            if (existing.get() == worker.get()) return false;
+        m_externalWorkers->push_back(std::move(worker));
+        return true;
+    }
+    catch (...) { return false; }
+}
+
+bool PS2Runtime::externalWorkerResetAllowed()
+{
+    std::lock_guard<std::mutex> lock(m_externalWorkersMutex);
+    return !m_externalWorkers || m_externalWorkers->empty();
+}
+
+void PS2Runtime::beginExternalWorkerRun()
+{
+    std::lock_guard<std::mutex> lock(m_externalWorkersMutex);
+    if (m_externalWorkersSealed && m_externalWorkers && !m_externalWorkers->empty())
+        throw std::logic_error("An attached external worker runtime cannot restart");
+    m_externalWorkersSealed = true;
+    // Serialized with requestStop: never reset a worker's stop after it has
+    // been signalled. No-worker runtimes retain their existing restart behavior.
+    m_stopRequested.store(false, std::memory_order_relaxed);
+}
+
+void PS2Runtime::joinExternalWorkersOrTerminate() noexcept
+{
+    try
+    {
+        std::shared_ptr<const ExternalWorkerList> workers;
+        {
+            std::lock_guard<std::mutex> lock(m_externalWorkersMutex);
+            m_externalWorkersSealed = true;
+            workers = m_externalWorkers;
+        }
+        if (!workers || workers->empty()) return;
+        if (ps2ActualGuestExecutionDepth(this) != 0u) std::terminate();
+        // A concurrent requestStop may still be signalling its snapshot. Stop
+        // methods are idempotent/concurrent-safe, so join never waits for an
+        // unsignalled worker and no registry lock is held across user code.
+        for (const auto &worker : *workers) worker->requestStop();
+        for (const auto &worker : *workers)
+            if (!worker->join()) std::terminate();
+    }
+    catch (...) { std::terminate(); }
+}
