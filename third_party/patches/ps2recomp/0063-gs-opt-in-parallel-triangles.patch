+    std::pair<uint32_t, uint32_t> triangleTextureDomain(uint64_t clamp, bool vertical, uint8_t exponent)
+    {
+        const unsigned mode = unsigned((clamp >> (vertical ? 2 : 0)) & 3u);
+        const uint32_t minimum = uint32_t((clamp >> (vertical ? 24 : 4)) & 1023u);
+        const uint32_t maximum = uint32_t((clamp >> (vertical ? 34 : 14)) & 1023u);
+        if (mode < 2u) return {0u, (1u << exponent) - 1u};
+        if (mode == 2u) return {std::min(minimum, maximum), std::max(minimum, maximum)};
+        return {maximum, minimum | maximum};
+    }
