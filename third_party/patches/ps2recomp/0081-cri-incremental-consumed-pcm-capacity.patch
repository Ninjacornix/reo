diff --git a/ps2xRuntime/src/lib/cri_pcm_retire.h b/ps2xRuntime/src/lib/cri_pcm_retire.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/cri_pcm_retire.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <cstdint>
+namespace ps2_cri_pcm_retire {
+struct Slice { uint32_t offset=0,length=0,totalReturned=0;uint64_t endByte=0;bool valid=false,complete=false; };
+// No time, callback, guest state, queue-size, or rate assumption. The watermark
+// counts bytes already consumed/copied by the existing real audio output path.
+inline Slice plan(uint64_t endByte,uint32_t incomingLength,uint32_t returned,
+                  uint64_t consumed) noexcept {
+    Slice result;
+    if(!incomingLength || (incomingLength&1u) || endByte<incomingLength || returned>incomingLength)
+        return result;
+    const uint64_t start=endByte-incomingLength;
+    uint64_t ready=consumed>start ? consumed-start : 0;
+    if(ready>incomingLength)ready=incomingLength;
+    // Preserve the existing whole/final-tail behavior. Intermediate free slices
+    // honor the original EE transfer alignment of 0x40 bytes.
+    if(ready<incomingLength)ready&=~uint64_t(63u);
+    result.valid=true;result.offset=returned;result.totalReturned=returned;
+    result.endByte=start+returned;
+    if(ready<=returned)return result; // Reset/backward counters never create space.
+    result.length=uint32_t(ready)-returned;result.totalReturned=uint32_t(ready);
+    result.endByte=start+ready;result.complete=ready==incomingLength;
+    return result;
+}
+}
