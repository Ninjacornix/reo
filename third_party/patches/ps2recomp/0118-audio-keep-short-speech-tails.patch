+            // Treat only a long remainder as an intentional cut; let short speech tails finish.
+            const size_t queued=std::max(ps2_cri_audio::queuedSamples(r0),r1?ps2_cri_audio::queuedSamples(r1):size_t(0));
+            const uint32_t freq=rna.sampleFreq?rna.sampleFreq:48000u;
+            const bool shortTail=queued<=size_t(freq)*3u/2u;
+            if (unreturned && !shortTail) {
