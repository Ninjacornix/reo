 #include "ps2_syscalls.h"
 #include "Kernel/Syscalls/Interrupt.h"
 #include "runtime/ps2_memory.h"
+#include <condition_variable>
+#include <deque>
+#include <thread>
+
+// ---------------------------------------------------------------------------------------
+// GS worker thread (default; REO_GS_THREAD=0 disables), in the spirit of PCSX2's MTGS. On the PS2
+// the GS draws in parallel with the EE; here processGIFPacket()/writeRegister() normally
+// run on the guest thread that kicked the DMA, holding the guest CPU and IO locks while
+// rasterizing (D37). With the worker, those calls copy their input into an ordered queue
+// and return; the worker replays them through the same methods. Every other public entry
+// point that reads or mutates GS state outside that stream drains the queue first.
+// GS processing only calls out to raiseIntcInterrupt()/GetCurrentVSyncTick(), so a drain
+// cannot deadlock against the guest or IO locks its caller may hold.
+namespace
+{
+    struct GsQueueItem
+    {
+        bool isPacket = true;
+        uint8_t reg = 0;
+        uint64_t value = 0;
+        std::vector<uint8_t> data;
+    };
+
+    struct GsAsync
+    {
+        std::mutex m;
+        std::condition_variable work;    // worker: items available
+        std::condition_variable drained; // producers/drainers: queue shrank or emptied
+        std::deque<GsQueueItem> queue;
+        size_t queuedBytes = 0;
+        uint64_t enqueued = 0;  // items ever queued
+        uint64_t completed = 0; // items ever executed
+        bool busy = false;
+        bool started = false;
+    };
+
+    GsAsync g_gsAsync;
+    thread_local bool t_isGsWorker = false;
+    constexpr size_t kGsQueueMaxBytes = 64u * 1024u * 1024u;
+
+    bool gsThreadEnabled()
+    {
+        // On by default; REO_GS_THREAD=0 runs the GS synchronously on the kicking thread.
+        static const bool on = []() {
+            const char *e = std::getenv("REO_GS_THREAD");
+            return !(e && e[0] == '0');
+        }();
+        return on;
+    }
+
+    void gsWorkerMain(GS *gs)
+    {
+        t_isGsWorker = true;
+        for (;;)
+        {
+            GsQueueItem item;
+            {
+                std::unique_lock<std::mutex> lock(g_gsAsync.m);
+                g_gsAsync.work.wait(lock, [] { return !g_gsAsync.queue.empty(); });
+                item = std::move(g_gsAsync.queue.front());
+                g_gsAsync.queue.pop_front();
+                g_gsAsync.busy = true;
+            }
+            if (item.isPacket)
+                gs->processGIFPacket(item.data.data(), static_cast<uint32_t>(item.data.size()));
+            else
+                gs->writeRegister(item.reg, item.value);
+            {
+                std::lock_guard<std::mutex> lock(g_gsAsync.m);
+                g_gsAsync.busy = false;
+                g_gsAsync.queuedBytes -= item.data.size();
+                ++g_gsAsync.completed;
+            }
+            g_gsAsync.drained.notify_all();
+        }
+    }
+
+    // Queues the call for the worker; false = run it synchronously (disabled / on worker).
+    bool gsEnqueue(GS *gs, GsQueueItem &&item)
+    {
+        if (t_isGsWorker || !gsThreadEnabled())
+            return false;
+        std::unique_lock<std::mutex> lock(g_gsAsync.m);
+        if (!g_gsAsync.started)
+        {
+            g_gsAsync.started = true;
+            std::thread(gsWorkerMain, gs).detach();
+        }
+        g_gsAsync.drained.wait(lock, [] { return g_gsAsync.queuedBytes < kGsQueueMaxBytes; });
+        g_gsAsync.queuedBytes += item.data.size();
+        ++g_gsAsync.enqueued;
+        g_gsAsync.queue.push_back(std::move(item));
+        lock.unlock();
+        g_gsAsync.work.notify_one();
+        return true;
+    }
+
+    // Waits until every GS call queued before this point has been executed (not until the
+    // queue is empty: producers keep adding, which could starve a reader such as present).
+    void gsDrain()
+    {
+        if (t_isGsWorker || !gsThreadEnabled())
+            return;
+        std::unique_lock<std::mutex> lock(g_gsAsync.m);
+        const uint64_t target = g_gsAsync.enqueued;
+        g_gsAsync.drained.wait(lock, [target] { return g_gsAsync.completed >= target; });
+    }
+}
