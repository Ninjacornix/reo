+// The game paused this voice while its stream was still decoding (ADXT status PLAYING),
+// not at the end of a clip. On hardware the voice stops at once; the next stop request
+// must not drain the queued PCM, which belongs to the resumed stream.
+// The PS2RNA stop command follows a frame later; stop the host voice now, so a stream the
+// game starts and pauses at once (to prime it) is never heard.
+// Legacy host mixer only; a selected native audio backend owns its own voice state.
+void pauseNow(uint32_t voice,bool paused) {
+    std::lock_guard<std::mutex> lock(mutex);
+    if (!paused) { pausedMidStream.erase(voice);return; } // resumed before the stop arrived
+    pausedMidStream.insert(voice);
+    const auto it=voices.find(voice);
+    if (it!=voices.end()) { it->second.playing=false;it->second.draining=false;it->second.lateSamples=0; }
