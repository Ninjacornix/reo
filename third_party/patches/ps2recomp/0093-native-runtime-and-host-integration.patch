+    try {
+        // An accelerated backend that parks submitted work behind a SIGNAL
+        // must report it here exactly; reporting zero while holding work
+        // would hide ownership from the runtime accounting.
+        bytes = backend_->heldGifBytes();
+        items = backend_->heldGifCount();
+    } catch (const std::exception& e) { error_ = e.what(); state_ = State::Failed; throw; }
+    catch (...) { error_ = "GPU backend held-work report failed"; state_ = State::Failed; throw; }
+}
 } // namespace gs_backend_bridge
+
+namespace gs_backend_bridge {
