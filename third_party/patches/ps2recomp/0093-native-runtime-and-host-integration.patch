+void abandonActualPreEntryControlWrite(const PreEntryControlWriteHandle& permit)noexcept{PreEntryControlJournalCore::abandon(permit);}
+void invalidateActualPreEntryControlBytes(const void* ram,uint32_t at,uint32_t bytes){PreEntryControlJournalCore::unknown(ram,at,bytes);}
+void beforeActualPreEntryRuntimeRamWrite(const void* ram,uint32_t at,const void* data,uint32_t bytes){PreEntryControlJournalCore::runtimeRamWrite(ram,at,data,bytes);}
+}
