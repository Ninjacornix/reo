+#include "irq_cpu_game_receiver.h"
+#include "parent_source_failure.h"
+#include <map>
+namespace reo_irq_integer {
+namespace {
+std::mutex receiverMutex;
+std::map<PS2Runtime*,OriginalCpuIrqGameReceiverHandle> receivers;
+OriginalCpuIrqGameReceiverHandle find(PS2Runtime& runtime){
+    std::lock_guard lock(receiverMutex);auto found=receivers.find(&runtime);
+    if(found==receivers.end())throw reo_parent_natural::OwnedSourceFailure("Owned original IRQ has no registered actual GAME integer receiver");
+    return found->second;
+}
+}
+OriginalCpuIrqGameReceiver::OriginalCpuIrqGameReceiver(PS2Runtime& runtime,PS2Runtime::RecompiledFunction original,Receive receive)
+ :runtime_(&runtime),original_(original),receive_(receive){
+    using namespace reo_parent_natural::context_lifecycle_detail;
+    std::lock_guard lock(storageMutex);auto found=primaryStorages.find(&runtime);
+    if(found==primaryStorages.end()||found->second->ended.load(std::memory_order_acquire)||!original||!receive||
+       runtime.isStopRequested()||runtime.lookupFunction(0x18d160u)!=original)
+        throw std::invalid_argument("GAME IRQ receiver has no current genuine Runtime/original registration");
+    lifetime_=found->second;
+}
+void OriginalCpuIrqGameReceiver::requireRuntime(PS2Runtime& runtime,uint32_t handler)const {
+    using namespace reo_parent_natural::context_lifecycle_detail;
+    auto retained=lifetime_.lock();std::lock_guard lock(storageMutex);auto found=primaryStorages.find(&runtime);
+    if(runtime_!=&runtime||handler!=0x18d160u||!retained||found==primaryStorages.end()||found->second!=retained||
+       retained->runtime!=&runtime||retained->context.get()!=&runtime.cpu()||!retained->embedded||retained->ended.load(std::memory_order_acquire)||
+       runtime.isStopRequested()||runtime.lookupFunction(handler)!=original_||!receive_)
+        throw reo_parent_natural::OwnedSourceFailure("GAME IRQ receiver registration is absent/foreign/ended/replaced");
+}
+void OriginalCpuIrqGameReceiver::receive(const reo_parent_natural::IrqInitializerHandle& init,const std::shared_ptr<reo_parent_natural::ControlTarget>& owner)const {
+    if(!init||!owner)throw std::invalid_argument("GAME IRQ receiver lacks genuine initializer/owner");
+    requireRuntime(init->runtime(),init->handler());init->validateBeforeAnyIrqInstructionOnEe();owner->requireHealthy();
+    if(owner->runtimeIdentity()!=runtime_||owner->ramIdentity()!=runtime_->memory().getRDRAM()||init->sourceStep()!=original_)
+        throw reo_parent_natural::OwnedSourceFailure("GAME IRQ receiver crossed its actual Runtime/source owner");
+    receive_(init,owner);requireRuntime(init->runtime(),init->handler());init->validateActualSourceOnEe();
+}
+void registerActualOriginalCpuIrqGameReceiver(PS2Runtime& runtime,OriginalCpuIrqGameReceiverHandle receiver){
+    if(!receiver)throw std::invalid_argument("Null GAME IRQ receiver registration");receiver->requireRuntime(runtime,0x18d160u);
+    std::lock_guard lock(receiverMutex);auto found=receivers.find(&runtime);
+    if(found!=receivers.end()){
+        // A reused Runtime address cannot inherit the old lifecycle token.
+        try{found->second->requireRuntime(runtime,0x18d160u);}catch(...){receivers.erase(found);found=receivers.end();}
+        if(found!=receivers.end())throw std::logic_error("Actual GAME IRQ receiver was already registered");
+    }
+    // Retain only this Runtime's sealed descriptor. Expired registrations are
+    // removed during installation; no callable token survives Runtime ending.
+    for(auto i=receivers.begin();i!=receivers.end();){
+        if(i->second->lifetime_.expired())i=receivers.erase(i);else ++i;
+    }
+    receivers.emplace(&runtime,std::move(receiver));
+}
+void requireRegisteredOriginalCpuIrqGameReceiver(PS2Runtime& runtime,uint32_t handler){find(runtime)->requireRuntime(runtime,handler);}
+void runRegisteredOriginalCpuIrq(const reo_parent_natural::IrqInitializerHandle& init,const std::shared_ptr<reo_parent_natural::ControlTarget>& owner){
+    if(!init)throw std::invalid_argument("Null original IRQ initializer");find(init->runtime())->receive(init,owner);
+}
+}
