diff --git a/ps2xRuntime/src/lib/bounded_graphics_entry_filter.h b/ps2xRuntime/src/lib/bounded_graphics_entry_filter.h
new file mode 100644
index 0000000..fe6f349
--- /dev/null
+++ b/ps2xRuntime/src/lib/bounded_graphics_entry_filter.h
@@ -0,0 +1,56 @@
+#pragma once
+#include "parent_natural_runtime.h"
+#include "parent_first_entry.h"
+#include "parent_context_lifecycle.h"
+#include "ps2_guest_sched.h"
+#include <algorithm>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+namespace reo_parent_natural {
+// A pre-owner entry filter only. This object cannot issue a ColdEntry, Call,
+// source permit, scalar role, GPU result, or complete-selection capability.
+class BoundedGraphicsEntryFilter final {
+    PS2Runtime* runtime_;PS2Runtime::RecompiledFunction body_;
+    uint32_t entry_,command_;bool setter_;
+public:
+    BoundedGraphicsEntryFilter(PS2Runtime& runtime,uint32_t entry,uint32_t command)
+      :runtime_(&runtime),body_(runtime.hasFunction(entry)?runtime.lookupFunction(entry):nullptr),entry_(entry),command_(command),setter_(entry==0x196010u){
+        if(!body_||(entry!=0x197900u&&entry!=0x196010u)||
+           (setter_?command!=0x5au:command!=0u)||runtime.isStopRequested())
+            throw std::invalid_argument("Bounded graphics filter requires its actual registered certified original body");
+    }
+    PS2Runtime* runtime()const noexcept{return runtime_;}
+    bool matches(PS2Runtime& runtime,R5900Context& context,uint32_t entry)const {
+        if(&runtime!=runtime_||currentRuntime()!=&runtime||currentContext()!=&context||
+           !ps2ActualGuestExecutionDepth(&runtime)||ps2_sched::currentThread()<1||context.pc!=entry||runtime.isStopRequested())
+            throw std::runtime_error("Bounded first graphics filter lost the actual Runtime.cpu task/scope");
+        if(entry!=entry_)return false;
+        const auto storage=retainActualGuestContextStorage(runtime,context);
+        if(!storage)throw std::runtime_error("Selected native graphics entry has no genuine retained context allocation");
+        if(!runtime.hasFunction(entry_)||runtime.lookupFunction(entry_)!=body_)throw std::runtime_error("Bounded first graphics original body changed after factory registration");
+        uint32_t command=0;if(setter_)std::memcpy(&command,&context.r[4],4u);
+        return !setter_||command==command_;
+    }
+};
+namespace bounded_entry_filter_detail {
+inline std::mutex mutex;
+inline std::vector<std::weak_ptr<const BoundedGraphicsEntryFilter>> filters;
+}
+inline std::shared_ptr<const BoundedGraphicsEntryFilter> retainBoundedGraphicsEntryFilter(PS2Runtime& runtime,uint32_t entry,uint32_t command){
+    auto filter=std::make_shared<const BoundedGraphicsEntryFilter>(runtime,entry,command);
+    std::lock_guard<std::mutex> lock(bounded_entry_filter_detail::mutex);
+    auto& filters=bounded_entry_filter_detail::filters;
+    filters.erase(std::remove_if(filters.begin(),filters.end(),[](const auto& weak){return weak.expired();}),filters.end());
+    for(const auto& weak:filters)if(auto existing=weak.lock())if(existing->runtime()==&runtime)
+        throw std::logic_error("Actual Runtime already has a retained bounded first graphics selector");
+    filters.push_back(filter);return filter;
+}
+inline bool boundedGraphicsFirstEntryMatches(PS2Runtime& runtime,R5900Context& context,uint32_t entry){
+    std::shared_ptr<const BoundedGraphicsEntryFilter> selected;
+    {std::lock_guard<std::mutex> lock(bounded_entry_filter_detail::mutex);
+     for(const auto& weak:bounded_entry_filter_detail::filters)if(auto filter=weak.lock())if(filter->runtime()==&runtime)selected=std::move(filter);}
+    return !selected||selected->matches(runtime,context,entry);
+}
+}
diff --git a/ps2xRuntime/src/lib/gpu_fresh_collector.h b/ps2xRuntime/src/lib/gpu_fresh_collector.h
new file mode 100644
index 0000000..8a3be19
--- /dev/null
+++ b/ps2xRuntime/src/lib/gpu_fresh_collector.h
@@ -0,0 +1,71 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <tuple>
+#include <vector>
+namespace reo_gpu_catalog_capture {
+struct Identity {
+    std::string digest;uint64_t bindingId=0;
+    std::array<uint8_t,16384> image{};std::vector<uint32_t> entries;
+};
+struct Meta {uint32_t magic=0x43415556u,version=1,stateBytes=632,dataBytes=16384,entryPC=0,top=0,itop=0,resume=0;};
+static_assert(sizeof(Meta)==32);
+// Optional, bounded diagnostic raw capture, installed before boot by root.
+// Call immediately before actual fresh VU dispatch, ahead of either native or
+// original interpreter. It does no geometry work and is not a live producer.
+class FreshCollector {
+    std::filesystem::path directory_;
+    std::vector<Identity> identities_;
+    std::set<std::tuple<uint64_t,uint32_t,uint32_t>> captured_;
+    std::ofstream index_;
+    unsigned unknownImages_=0,unknownEntries_=0;
+    static void write(const std::filesystem::path& p,const void* data,size_t size) {
+        if(std::filesystem::exists(p))throw std::runtime_error("Refuse existing fresh VU proof capture");
+        std::ofstream f(p,std::ios::binary);f.write(static_cast<const char*>(data),size);
+        if(!f)throw std::runtime_error("Failed fresh VU proof capture");
+    }
+public:
+    enum class Result {Captured,AlreadyCaptured,ResumeIgnored,UnknownImage,UnknownEntry};
+    FreshCollector(std::filesystem::path directory,std::vector<Identity> identities)
+        :directory_(std::move(directory)),identities_(std::move(identities)) {
+        if(identities_.size()!=8||std::filesystem::exists(directory_))
+            throw std::invalid_argument("Fresh collector requires exact eight identities and a new output directory");
+        std::set<uint64_t> ids;
+        for(const auto& i:identities_)if(!i.bindingId||i.digest.size()!=64||i.entries.empty()||!ids.insert(i.bindingId).second)
+            throw std::invalid_argument("Incomplete/duplicate fresh collector identity");
+        std::filesystem::create_directories(directory_);index_.open(directory_/"events.jsonl");
+        if(!index_)throw std::runtime_error("Fresh collector index allocation failed");
+    }
+    Result record(const uint8_t* image,const uint8_t* bank,const void* rawState,size_t stateBytes,
+                  uint32_t entryPC,uint32_t top,uint32_t itop,bool resume=false) {
+        if(resume)return Result::ResumeIgnored;
+        if(!image||!bank||!rawState||stateBytes!=632||entryPC>=16384||(entryPC&7)||top>1023||itop>1023)
+            throw std::invalid_argument("Incomplete fresh VU proof input");
+        const Identity* identity=nullptr;
+        for(const auto& i:identities_)if(std::memcmp(image,i.image.data(),16384)==0){identity=&i;break;}
+        if(!identity){if(++unknownImages_<=8){index_<<"{\"event\":\"unknown_image\",\"PC\":"<<entryPC<<"}\n";index_.flush();}return Result::UnknownImage;}
+        bool known=false;for(auto pc:identity->entries)known|=pc==entryPC;
+        if(!known){if(++unknownEntries_<=8){index_<<"{\"event\":\"unknown_entry\",\"sha256\":\""<<identity->digest<<"\",\"PC\":"<<entryPC<<"}\n";index_.flush();}return Result::UnknownEntry;}
+        // Two actual TOP halves per image/entry. Never fabricate a bank or
+        // imply that unobserved starts were captured from a different context.
+        const uint32_t half=top>>9;
+        if(!captured_.insert({identity->bindingId,entryPC,half}).second)return Result::AlreadyCaptured;
+        const std::string stem=identity->digest.substr(0,12)+"-PC"+std::to_string(entryPC)+"-bank"+std::to_string(half);
+        Meta meta{};meta.entryPC=entryPC;meta.top=top;meta.itop=itop;
+        write(directory_/(stem+".code.bin"),image,16384);write(directory_/(stem+".state.bin"),rawState,632);
+        write(directory_/(stem+".data.bin"),bank,16384);write(directory_/(stem+".meta.bin"),&meta,sizeof(meta));
+        index_<<"{\"event\":\"captured\",\"stem\":\""<<stem<<"\",\"sha256\":\""<<identity->digest<<"\",\"PC\":"<<entryPC<<",\"TOP\":"<<top<<",\"ITOP\":"<<itop<<"}\n";index_.flush();
+        if(!index_)throw std::runtime_error("Failed fresh proof index write");return Result::Captured;
+    }
+    size_t captures()const noexcept{return captured_.size();}
+    unsigned unknownImages()const noexcept{return unknownImages_;}
+    unsigned unknownEntries()const noexcept{return unknownEntries_;}
+};
+}
diff --git a/ps2xRuntime/src/lib/gpu_fresh_observer.h b/ps2xRuntime/src/lib/gpu_fresh_observer.h
new file mode 100644
index 0000000..fb59eec
--- /dev/null
+++ b/ps2xRuntime/src/lib/gpu_fresh_observer.h
@@ -0,0 +1,56 @@
+#pragma once
+#include "gpu_fresh_collector.h"
+#include <cstdlib>
+#include <cstdio>
+#include <sstream>
+#include <mutex>
+
+namespace reo_gpu_fresh_observer {
+inline std::unique_ptr<reo_gpu_catalog_capture::FreshCollector> collector;
+inline std::once_flag configuration;
+inline std::mutex captureMutex;
+inline bool requested=false;
+inline void configure() noexcept {
+    const char* output=std::getenv("REO_GPU_FRESH_CAPTURE_DIR");
+    if(!output || !*output)return;
+    requested=true;
+    try {
+        const char* listing=std::getenv("REO_GPU_FRESH_IMAGE_LIST");
+        if(!listing || !*listing)throw std::runtime_error("Missing exact fresh image listing");
+        std::ifstream file(listing);if(!file)throw std::runtime_error("Cannot read fresh image listing");
+        std::vector<reo_gpu_catalog_capture::Identity> images;std::string line;
+        while(std::getline(file,line)) {
+            if(line.empty())continue;
+            std::istringstream fields(line);std::string digest,binding,entries,path;
+            if(!std::getline(fields,digest,'\t') || !std::getline(fields,binding,'\t') ||
+               !std::getline(fields,entries,'\t') || !std::getline(fields,path))
+                throw std::runtime_error("Malformed fresh image listing");
+            if(!path.empty() && path.back()=='\r')path.pop_back();
+            reo_gpu_catalog_capture::Identity image;image.digest=digest;image.bindingId=std::stoull(binding,nullptr,0);
+            std::ifstream raw(path,std::ios::binary);raw.read(reinterpret_cast<char*>(image.image.data()),image.image.size());
+            if(raw.gcount()!=16384 || raw.peek()!=std::char_traits<char>::eof())
+                throw std::runtime_error("Fresh image must contain exactly16KiB");
+            std::istringstream pcs(entries);std::string pc;
+            while(std::getline(pcs,pc,','))image.entries.push_back(uint32_t(std::stoul(pc,nullptr,0)));
+            images.push_back(std::move(image));
+        }
+        collector=std::make_unique<reo_gpu_catalog_capture::FreshCollector>(output,std::move(images));
+        std::fprintf(stderr,"[GPU-FRESH] bounded raw input capture enabled, no geometry replacement\n");
+    } catch(const std::exception& error) {
+        std::fprintf(stderr,"[GPU-FRESH] capture disabled: %s\n",error.what());
+    }
+}
+inline void record(const uint8_t* code,const uint8_t* data,const void* state,size_t bytes,
+                   uint32_t pc,uint32_t top,uint32_t itop) noexcept {
+    std::call_once(configuration,configure);
+    if(!requested)return;
+    std::lock_guard<std::mutex> lock(captureMutex);
+    if(!collector)return;
+    try {
+        collector->record(code,data,state,bytes,pc,top&1023u,itop&1023u,false);
+    } catch(const std::exception& error) {
+        std::fprintf(stderr,"[GPU-FRESH] capture stopped: %s\n",error.what());
+        collector.reset();
+    }
+}
+}
diff --git a/ps2xRuntime/src/lib/gpu_resume_collector.h b/ps2xRuntime/src/lib/gpu_resume_collector.h
new file mode 100644
index 0000000..99df31c
--- /dev/null
+++ b/ps2xRuntime/src/lib/gpu_resume_collector.h
@@ -0,0 +1,153 @@
+#pragma once
+#include "gpu_fresh_collector.h"
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <mutex>
+#include <sstream>
+
+namespace reo_gpu_resume_capture {
+using Identity=reo_gpu_catalog_capture::Identity;
+using Meta=reo_gpu_catalog_capture::Meta;
+struct Ticket {std::string resumeStem,continuityStem;uint32_t ordinal=0;};
+class Collector {
+    std::vector<Identity> identities_;
+    std::filesystem::path resumeDirectory_,continuityDirectory_;
+    std::ofstream resumeIndex_,continuityIndex_;
+    std::set<std::tuple<uint64_t,uint32_t,uint32_t>> captured_;
+    uint32_t resumeLimit_=128,continuityLimit_=64,continuityCount_=0,unknown_=0;
+    uint64_t writtenBytes_=0;
+    static constexpr uint64_t ByteBudget=16u*1024u*1024u;
+    bool continuityArmed_=false,continuityStopped_=false,continuityOutstanding_=false;
+    std::string startImage_;
+    uint32_t startSelector_=std::numeric_limits<uint32_t>::max();
+    double afterSeconds_=0;
+    std::chrono::steady_clock::time_point created_=std::chrono::steady_clock::now();
+    const Identity* identify(const uint8_t* code)const {
+        for(const auto& i:identities_)if(std::memcmp(code,i.image.data(),16384)==0)return &i;
+        return nullptr;
+    }
+    void write(const std::filesystem::path& p,const void* data,size_t size) {
+        if(!data||writtenBytes_+size>ByteBudget||std::filesystem::exists(p))
+            throw std::runtime_error("Resume/continuity capture budget or immutable-file violation");
+        std::ofstream file(p,std::ios::binary);file.write(static_cast<const char*>(data),size);file.flush();
+        if(!file)throw std::runtime_error("Incomplete readonly resume capture");
+        writtenBytes_+=size;
+    }
+    static void openDirectory(const std::filesystem::path& path,std::ofstream& index) {
+        if(path.empty())return;
+        if(std::filesystem::exists(path))throw std::runtime_error("Readonly collector requires a new directory");
+        std::filesystem::create_directories(path);index.open(path/"events.jsonl");
+        if(!index)throw std::runtime_error("Readonly capture index allocation failed");
+    }
+    void pre(const std::filesystem::path& directory,const std::string& stem,const uint8_t* code,
+             const uint8_t* bank,const void* state,const Meta& meta,const void* regs,size_t regBytes) {
+        write(directory/(stem+".code.bin"),code,16384);write(directory/(stem+".state.bin"),state,632);
+        write(directory/(stem+".data.bin"),bank,16384);write(directory/(stem+".vif-regs.bin"),regs,regBytes);
+        write(directory/(stem+".meta.bin"),&meta,sizeof(meta));
+    }
+    static void event(std::ofstream& index,const char* eventName,const std::string& stem,
+                      const Identity& identity,const Meta& meta,uint32_t ordinal) {
+        index<<"{\"event\":\""<<eventName<<"\",\"stem\":\""<<stem<<"\",\"sha256\":\""<<identity.digest
+             <<"\",\"bindingId\":"<<identity.bindingId<<",\"PC\":"<<meta.entryPC<<",\"TOP\":"<<meta.top
+             <<",\"ITOP\":"<<meta.itop<<",\"resume\":"<<meta.resume<<",\"ordinal\":"<<ordinal<<"}\n";
+        index.flush();if(!index)throw std::runtime_error("Readonly capture index failed");
+    }
+public:
+    Collector(std::vector<Identity> identities,std::filesystem::path resumeDirectory,
+              std::filesystem::path continuityDirectory,uint32_t resumeLimit,uint32_t continuityLimit,
+              std::string startImage,uint32_t startSelector,double afterSeconds)
+        :identities_(std::move(identities)),resumeDirectory_(std::move(resumeDirectory)),
+         continuityDirectory_(std::move(continuityDirectory)),resumeLimit_(resumeLimit),continuityLimit_(continuityLimit),
+         startImage_(std::move(startImage)),startSelector_(startSelector),afterSeconds_(afterSeconds) {
+        if(identities_.size()!=8||!resumeLimit_||resumeLimit_>128||!continuityLimit_||continuityLimit_>128||afterSeconds_<0)
+            throw std::invalid_argument("Resume collector requires eight identities and bounded limits");
+        std::set<uint64_t> ids;
+        for(const auto& i:identities_){
+            if(!i.bindingId||i.digest.size()!=64||!ids.insert(i.bindingId).second)
+                throw std::invalid_argument("Incomplete readonly resume identity");
+            for(const auto c:i.digest)if(!((c>='0'&&c<='9')||(c>='a'&&c<='f')))
+                throw std::invalid_argument("Nonhex readonly resume identity");
+        }
+        if(!startImage_.empty()&&startImage_.size()!=64)throw std::invalid_argument("Continuity start image must be full SHA256");
+        if(!resumeDirectory_.empty()&&resumeDirectory_==continuityDirectory_)
+            throw std::invalid_argument("Resume and continuity directories must differ");
+        openDirectory(resumeDirectory_,resumeIndex_);openDirectory(continuityDirectory_,continuityIndex_);
+    }
+    Ticket begin(const uint8_t* code,const uint8_t* bank,const void* state,size_t bytes,uint32_t pc,
+                 uint32_t top,uint32_t itop,bool resume,const void* regs,size_t regBytes) {
+        if(!code||!bank||!state||bytes!=632||pc>=16384||(pc&7u)||top>1023||itop>1023||!regs||!regBytes||regBytes>512)
+            throw std::invalid_argument("Incomplete actual readonly launch boundary");
+        uint32_t rawPC=0;std::memcpy(&rawPC,static_cast<const uint8_t*>(state)+604,4);
+        if(resume&&pc!=rawPC)throw std::invalid_argument("MSCNT metadata must use actual resident prestate PC");
+        Ticket ticket;const auto* identity=identify(code);
+        if(!identity){
+            if(resume&&resumeIndex_&&++unknown_<=8){resumeIndex_<<"{\"event\":\"unknown_resume_image\",\"PC\":"<<pc<<"}\n";resumeIndex_.flush();}
+            if(continuityArmed_&&!continuityStopped_){continuityStopped_=true;continuityIndex_<<"{\"event\":\"cut_unknown_image\",\"PC\":"<<pc<<"}\n";continuityIndex_.flush();}
+            return ticket;
+        }
+        Meta meta{};meta.entryPC=pc;meta.top=top;meta.itop=itop;meta.resume=resume?1u:0u;
+        if(resume&&!resumeDirectory_.empty()&&captured_.size()<resumeLimit_){
+            // Actual PC and actual TOP, with no fresh-entry whitelist. All PC
+            // values remain bounded by the global cap; no synthetic resume.
+            const auto key=std::make_tuple(identity->bindingId,pc,top);
+            if(captured_.insert(key).second){
+                ticket.resumeStem=identity->digest.substr(0,12)+"-resumePC"+std::to_string(pc)+"-TOP"+std::to_string(top);
+                pre(resumeDirectory_,ticket.resumeStem,code,bank,state,meta,regs,regBytes);
+                event(resumeIndex_,"resume_pre",ticket.resumeStem,*identity,meta,uint32_t(captured_.size()-1));
+            }
+        }
+        if(!continuityDirectory_.empty()&&!continuityStopped_){
+            if(continuityOutstanding_){
+                continuityStopped_=true;continuityIndex_<<"{\"event\":\"cut_missing_previous_native_return\"}\n";continuityIndex_.flush();
+                return ticket;
+            }
+            if(!continuityArmed_){
+                uint32_t selector=0;std::memcpy(&selector,bank+(top&1023u)*16u,4);selector&=65535u;
+                const double elapsed=std::chrono::duration<double>(std::chrono::steady_clock::now()-created_).count();
+                continuityArmed_=elapsed>=afterSeconds_&&(startImage_.empty()||identity->digest==startImage_)&&
+                    (startSelector_==std::numeric_limits<uint32_t>::max()||selector==startSelector_);
+            }
+            if(continuityArmed_&&continuityCount_<continuityLimit_){
+                // EVERY adjacent launch after arming, including fresh and
+                // resume. Do not deduplicate or silently skip an image change.
+                ticket.ordinal=continuityCount_++;char ordinal[32];std::snprintf(ordinal,sizeof(ordinal),"call-%04u",ticket.ordinal);
+                ticket.continuityStem=ordinal;
+                continuityOutstanding_=true;
+                pre(continuityDirectory_,ticket.continuityStem,code,bank,state,meta,regs,regBytes);
+                event(continuityIndex_,"adjacent_pre",ticket.continuityStem,*identity,meta,ticket.ordinal);
+            }
+        }
+        return ticket;
+    }
+    void finish(const Ticket& ticket,const uint8_t* code,const uint8_t* bank,const void* state,size_t bytes,
+                const void* regs,size_t regBytes) {
+        if(ticket.resumeStem.empty()&&ticket.continuityStem.empty())return;
+        if(!code||!bank||!state||bytes!=632||!regs||!regBytes||regBytes>512)
+            throw std::invalid_argument("Incomplete native-return observation");
+        auto post=[&](const std::filesystem::path& directory,const std::string& stem){
+            if(stem.empty())return;
+            write(directory/(stem+".native-post-state.bin"),state,632);
+            write(directory/(stem+".native-post-data.bin"),bank,16384);
+            write(directory/(stem+".native-post-vif-regs.bin"),regs,regBytes);
+            // This records actual native/original-path return. It is NOT
+            // independent original gold and contains no ordered packet tape.
+            const uint32_t marker[]{0x3154414eu,1u,632u,16384u,uint32_t(regBytes),1u};
+            write(directory/(stem+".native-return.complete.bin"),marker,sizeof(marker));
+        };
+        post(resumeDirectory_,ticket.resumeStem);post(continuityDirectory_,ticket.continuityStem);
+        if(!ticket.continuityStem.empty()){
+            if(!continuityOutstanding_)throw std::runtime_error("Duplicate/out-of-order native continuity return");
+            continuityOutstanding_=false;
+            continuityIndex_<<"{\"event\":\"adjacent_native_return\",\"stem\":\""<<ticket.continuityStem
+                            <<"\",\"ordinal\":"<<ticket.ordinal<<",\"independent_original_gold\":false}\n";
+            if(continuityCount_==continuityLimit_&&!continuityStopped_){
+                continuityStopped_=true;const uint32_t complete[]{0x31544341u,1u,continuityCount_,1u};
+                write(continuityDirectory_/"burst-return.complete.bin",complete,sizeof(complete));
+            }
+            continuityIndex_.flush();if(!continuityIndex_)throw std::runtime_error("Continuity return index failed");
+        }
+    }
+};
+}
