+    // through the same synchronous handoff. Unknown images, uncertified entry
+    // points and uncertified effects still fall back to CPU after restoring
+    // CPU-visible ownership. Defaults false.
+    bool perProgramAdmission=false;
+    std::vector<std::shared_ptr<const Program>> programs;
+    // Derive unchanged literal command bytes ONLY from certified V4-32 uploads.
+    // Return false before bank ownership if this launch's event class is unknown.
+    std::function<bool(const Program&,const LiteralCommands&,bool resume,uint32_t startPC,uint32_t top,LiteralEffect&)> literalEffect;
+    bool complete()const noexcept {
+        if(!fullReachedRegistry || !mappedBankCoherence || !gpuLiteralEffects || !literalPoliciesCertified || programs.empty())return false;
+        for(const auto& p:programs)if(!p || !p->complete())return false;
+        return true;
+    }
+};
+void registerBeforeBoot(std::shared_ptr<const Registry>);
+void bindCold(PS2Memory&,GifArbiter&,const VU1State&);
+bool enabled(PS2Memory&);
+bool resident(PS2Memory&);
+void codeUploaded(PS2Memory&);
+bool control(PS2Memory&,uint32_t offset,const void* bits,uint32_t bytes);
+bool unpack(PS2Memory&,uint32_t command,uint32_t tops,const uint8_t* raw,uint32_t bytes);
+// Actual owner-issued token only; no raw payload or fallback source.
+void opaqueParentUnpack(PS2Memory&,Operation);
+// launch() takes the live pointer to the guest interpreter's CURRENT
+// architectural VU state. The bindCold() snapshot is stale the moment any CPU
+// program has executed, so the CPU->GPU import and the GPU->CPU restore both
+// read/write through this reference. Returns true when the launch ran on the
+// GPU; false means CPU fallback with all GPU-visible state already exported
+// and restored into *state / the memory VU data bank / the VIF controls.
+bool launch(PS2Memory&,VU1State&,bool resume,uint32_t startPC,uint32_t itop);
+void drainTail(PS2Memory&);
+void barrier(PS2Memory&,Barrier);
+bool readMapped(PS2Memory&,uint32_t address,void* dst,uint32_t bytes);
+bool writeMapped(PS2Memory&,uint32_t address,const void* src,uint32_t bytes);
+bool readControlMmio(PS2Memory&,uint32_t address,uint32_t& value);
+bool writeControlMmio(PS2Memory&,uint32_t address,uint32_t value);
+void resetVifControls(PS2Memory&);
+void beforeColdReset(PS2Memory&);
+void releaseAfterGsStop(PS2Memory&);
+void beforeGsReset();
+void afterGsReset(uint64_t newEpoch);
+// Implemented next to g_backendRoute behind its existing owner FIFO.
+void queueBackendBatch(std::shared_ptr<const Batch>);
+std::vector<Retired> retireBackend(Barrier,uint64_t epoch,uint64_t bankGeneration);
+void readBackendData(uint32_t offset,uint8_t* dst,uint32_t bytes);
+void readBackendControls(uint32_t offset,uint8_t* dst,uint32_t bytes);
+// Explicit synchronous CPU<->GPU ownership handoff through the same owner
+// FIFO. Import copies the current CPU architectural state/data/controls into
+// the GPU bank (creating it on first use) before an admitted GPU launch;
+// export reads the GPU-computed state/data/controls back after all enrolled
+// work retired, before any CPU fallback launch restores them. Both run their
+// device wait on the existing GS owner worker, never under the caller's IO
+// scope, and both require the packet frontier (no local outstanding work).
+void importBackendHandoff(Handoff& handoff);
+void exportBackendHandoff(Handoff& handoff);
+// Retained PRE-LAUNCH snapshot readback for verifier-rejection recovery.
+// Runs its device wait on the existing GS owner worker. Fills the vector with
+// every refused ordinal's retained record (ordered by ordinal); the owner
+// consumes its retention exactly once per record.
+void retainFailedLaunchBackend(std::vector<RetainedLaunchFailure>& out);
+// Live mixed-execution counters for the demonstration receipt.
+uint64_t residentGpuLaunchCount()noexcept;
+uint64_t residentCpuFallbackWithRestoreCount()noexcept;
+uint64_t residentOwnershipTransitionCount()noexcept;
+uint64_t currentGsEpoch();
+}
