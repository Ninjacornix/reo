+        }
+    }
+    static void runtimeRamWrite(const void* ram,uint32_t at,const void* data,uint32_t bytes){
+        if(!actualFirstEntryEnrollmentRequested()||!bytes)return;
+        if(!data||at>=0x2000000u||bytes>0x2000000u-at)throw std::out_of_range("Pre-entry Runtime RAM store crosses its actual bank");
+        std::lock_guard lock(mutex_);
+        for(auto& [runtime,ptr]:states_){auto& s=*ptr;
+            if(runtime->memory().getRDRAM()!=ram||!s.generation->active.load(std::memory_order_acquire)||s.generation->frozen.load(std::memory_order_acquire))continue;
+            if(s.failed)throw std::runtime_error("Runtime RAM store reached failed pre-entry history");
+            if(s.pending){const auto& p=*s.pending;
+                // The original guarded special-address write calls the real
+                // Runtime memory API inside its already prepared transaction.
+                // Exact bits alone never waive unknown-writer invalidation.
+                if(p.generation_==s.generation&&!p.completed_&&p.ordinal_==s.nextWriter&&p.at_==at&&p.bytes_==bytes&&
+                   p.source_->ramIdentity()==ram&&actualPreEntryIntegerSource==p.source_&&
+                   (p.source_->kind()==PreEntryIntegerSource::Kind::Pool||(p.source_->pc()==p.pc_&&p.source_->word()==p.word_))&&
+                   reo_source_instrumentation::actualInstructionOrigin.pc==p.pc_&&
+                   reo_source_instrumentation::actualInstructionOrigin.word==p.word_&&
+                   bytes<=p.data_.size()&&!std::memcmp(p.data_.data(),data,bytes)){
+                    p.source_->requireCurrent();
