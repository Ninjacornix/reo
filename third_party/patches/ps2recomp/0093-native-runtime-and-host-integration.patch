+#pragma once
+#include "tools/parallel_gs_backend/resident_geometry/explicit_source_write.hpp"
+namespace reo_source_instrumentation {
+enum class ContextWriteIntent:uint32_t {GeneratedPcProgress=1,GenuineScalarControl=2,NumericOrOpaque=3,ReviewedRawIngress=4};
+struct InstructionOrigin {uint32_t pc=0,word=0;ContextWriteIntent intent=ContextWriteIntent::NumericOrOpaque;};
+// These are source claims, never authority by offset/GPR index/value alone.
+// The real NativeTarget must validate registered source/retained role and
+// issue the same exact immutable permit before any CPU mutation.
+class TypedSourceWriteTarget {
+public:
+    virtual ~TypedSourceWriteTarget()=default;
+    virtual reo_parent_natural::SourceWritePermit beginTypedSourceWrite(reo_parent_natural::SourceSpace,uint32_t,const void*,uint32_t,
+        R5900Context*,uint32_t,const InstructionOrigin&)=0;
+};
+inline thread_local InstructionOrigin actualInstructionOrigin{};
+inline InstructionOrigin classifyInstruction(uint32_t pc,uint32_t word){
+    InstructionOrigin result{pc,word,ContextWriteIntent::GenuineScalarControl};
+    const uint32_t op=word>>26,rs=(word>>21)&31,fn=word&63;
+    if(op==0x11u||op==0x12u)result.intent=ContextWriteIntent::NumericOrOpaque; // FP/VU arithmetic and moves out.
+    if(op==0x1eu)result.intent=ContextWriteIntent::NumericOrOpaque; // LQ cannot infer scalar/control provenance.
+    if(op==0x31u||op==0x36u||(op==0x11u&&(rs==4u||rs==6u))||(op==0x12u&&(rs==5u||rs==6u)))result.intent=ContextWriteIntent::ReviewedRawIngress;
+    // All candidates still need exact source/operand lineage in the target.
+    (void)fn;return result;
+}
+}
