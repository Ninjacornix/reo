+    return progressed || !publish.empty();
+}
+void finishResidentMemoryWrite(PS2Memory& memory) {
+    if(!waitRequested() || ps2IoRegLockDepth()!=0 || !localWaitHandoffs.count(&memory))return;
+    if(asyncRequested()) {
+        const auto session=find(memory);
+        if(session && session->waitRuntime && !session->waitRuntime->isStopRequested() &&
+           residentCompletionWorkerReady(session->waitRuntime)) {
+            // All original completion callbacks are owned now, even if a very
+            // fast fence signalled before their registration. Returning here
+            // leaves STR/QWC unchanged until a validated persistent dispatch.
+            localWaitHandoffs.erase(&memory);notifyResidentCompletionReady();return;
+        }
+    }
+    // Boot before the existing IRQ worker is bound retains synchronous joins;
+    // this never starts a new clock or transient completion thread.
+    settleResidentWaits(memory);
+}
+bool deferResidentDmaPublication(PS2Memory& memory,std::function<void()> callback) {
+    if(!waitRequested())return false;
+    const auto session=find(memory);if(!session)return false;
+    std::lock_guard<std::recursive_mutex> guard(session->mutex);requireLive(*session);
+    if(!session->authoritative)return false;
+    if(!callback)throw std::invalid_argument("Missing owned DMA completion publication");
+    const uint64_t cut=session->nextWaitCut-1;
