+void settleResidentWaits(PS2Memory& memory) {
+    if(!waitRequested())return;
+    const auto session=find(memory);if(!session)return;
+    if(ps2IoRegLockDepth()!=0)throw std::logic_error("Resident wait handoff has not left its outermost IO scope");
+    for(;;) {
+        std::shared_ptr<WaitReceipt> receipt;
+        {
+            std::lock_guard<std::recursive_mutex> guard(session->mutex);requireLive(*session);
+            if(session->waitReceipts.empty())break;
+            receipt=session->waitReceipts.front();
+        }
+        std::vector<Retired> result;
+        try {waitOutsideGuest(session,receipt,result);}
+        catch(...) {
+            std::lock_guard<std::recursive_mutex> guard(session->mutex);session->failed=true;
+            throw; // No successful DMA/register/IRQ publication on cancellation.
+        }
+        {
+            std::lock_guard<std::recursive_mutex> guard(session->mutex);requireLive(*session);
+            if(receipt->committed)continue; // Another follower retired this shared prefix.
+            if(session->waitReceipts.empty() || session->waitReceipts.front()!=receipt)
+                throw std::runtime_error("Resident receipt commit overtook a previous prefix");
+            try {validateWaitReceipt(*session,*receipt,result);}
+            catch(...) {session->failed=true;throw;}
+            receipt->committed=true;session->committedWaitCut=receipt->cut;
+            session->waitReceipts.pop_front();
+        }
+    }
+    std::vector<std::function<void()>> publish;
+    {
+        std::lock_guard<std::recursive_mutex> guard(session->mutex);requireLive(*session);
+        if(asyncRequested() && session->waitRuntime && session->waitRuntime->isStopRequested()) {
+            session->failed=true;throw std::runtime_error("Stopped owner cannot publish DMA success");
+        }
+        auto &pending=session->waitPublications;
+        for(auto it=pending.begin();it!=pending.end();) {
+            if(it->first<=session->committedWaitCut) {publish.push_back(std::move(it->second));it=pending.erase(it);}
+            else ++it;
+        }
+    }
+    // The real guest scope was reacquired by waitOutsideGuest before callbacks.
+    // Each callback owns its exact register values and reacquires short IO.
+    for(auto &callback:publish)callback();
