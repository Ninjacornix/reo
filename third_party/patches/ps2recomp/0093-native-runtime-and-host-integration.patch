+// unless a replay capture is armed by the verifier-rejection recovery.
+void recordReplayKick(uint32_t is,uint32_t vi,uint32_t addr,uint32_t totalBytes,uint32_t tags,bool done);
+void recordReplayFinish(uint32_t cycles,uint32_t maxCycles,const VU1State& state,bool ended,bool bounds);
+
+inline void validate(const Batch& batch) {
+    if(!batch.epoch || !batch.bankGeneration || batch.operations.empty() ||
+       batch.operations.size()>MaxOperations || batch.payloadBytes>MaxBatchBytes)
+        throw std::invalid_argument("Invalid resident VIF batch envelope");
+    uint64_t total=0,lastOrdinal=0;uint32_t launches=0;
+    std::vector<const OpaqueLeaseUpload*> leaseTokens;
+    for(const auto& op:batch.operations) {
+        if(op.kind!=Kind::OpaqueLeaseUnpack&&op.opaqueLease)
+            throw std::invalid_argument("Opaque token attached to a nonlease operation");
+        total+=op.payload.size();
+        if(total>MaxBatchBytes)throw std::invalid_argument("Resident VIF payload limit");
+        if(op.kind==Kind::Control) {
+            const bool vector=(op.controlByte==0 || op.controlByte==16) && op.payload.size()==16;
+            const bool scalar=op.controlByte<=40 && !(op.controlByte&3u) && op.payload.size()==4;
+            if(!vector&&!scalar)throw std::invalid_argument("Invalid GPU VIF control write");
+        } else if(op.kind==Kind::Unpack) {
+            const uint32_t opcode=(op.command>>24)&127u;
+            if((opcode&96u)!=96u || ((opcode&3u)==3u && ((opcode>>2)&3u)!=3u) ||
+               op.payload.empty() || op.payload.size()>4096 || (op.payload.size()&3u) || op.latchedTops>1023)
+                throw std::invalid_argument("Invalid complete raw UNPACK");
+        } else if(op.kind==Kind::OpaqueLeaseUnpack) {
+            if(!op.opaqueLease||!op.payload.empty()||op.program||op.orderedStream||op.ordinal||op.codeGeneration||op.resume||
+               op.controlByte||op.effect.type!=LiteralEffect::Type::None)
+                throw std::invalid_argument("Opaque UNPACK requires an owner token and no raw payload/launch metadata");
+            const auto& s=op.opaqueLease->stamp();
+            if(!validLeaseUploadStamp(s)||s.command!=op.command||s.tops!=op.latchedTops||s.epoch!=batch.epoch||s.bankGeneration!=batch.bankGeneration)
+                throw std::invalid_argument("Opaque UNPACK envelope does not match batch/command identity");
+            for(const auto* token:leaseTokens)if(token==op.opaqueLease.get())throw std::invalid_argument("Repeated opaque UNPACK in one batch");
+            leaseTokens.push_back(op.opaqueLease.get());
+        } else if(op.kind==Kind::DataWrite) {
+            if(op.payload.empty() || op.payload.size()>4096 || op.controlByte>=DataBytes || op.payload.size()>DataBytes-op.controlByte)
+                throw std::invalid_argument("Invalid ordered raw VU byte write");
+        } else if(op.kind==Kind::ControlByteWrite) {
+            if(op.payload.empty() || op.payload.size()>4 || op.controlByte>=32 || op.payload.size()>32-op.controlByte)
+                throw std::invalid_argument("Invalid ordered ROW/COL byte write");
+        } else if(op.kind==Kind::Launch) {
+            if(!op.program || !op.program->accepts(op.startPC,op.resume) || !op.ordinal ||
+               op.ordinal<=lastOrdinal || op.maxPairs!=65536 || op.top>1023 || op.itop>1023 ||
+               !op.payload.empty() || ++launches>MaxLaunches)
+                throw std::invalid_argument("Incomplete or unordered resident semantic launch");
+            lastOrdinal=op.ordinal;
+        } else throw std::invalid_argument("Unknown resident VIF operation");
+    }
+    if(total!=batch.payloadBytes)throw std::invalid_argument("Incorrect resident VIF payload accounting");
+}
+// Implemented only inside the accelerated GS owner. A retire call must perform
+// a genuine device/fence wait and inspect completion metadata, never vertices.
+class SemanticOwner {
+public:
+    virtual ~SemanticOwner()=default;
+    virtual bool authenticFirstEntryRequested()const noexcept{return false;}
+    virtual void enrollFirstGraphicsEntry(const std::shared_ptr<const reo_parent_natural::ColdEntry>&){throw std::runtime_error("Owner has no authentic first-entry enrollment");}
+    virtual void parentControl(const std::function<void(reo_parent_natural::ControlTarget&)>&) {throw std::runtime_error("Owner has no connected parent control target");}
+    virtual void enqueue(const Batch&)=0;
+    virtual std::vector<Retired> retire(Barrier,uint64_t epoch,uint64_t bankGeneration)=0;
+    virtual void readData(uint32_t offset,uint8_t* destination,uint32_t bytes)=0;
+    virtual void readControls(uint32_t offset,uint8_t* destination,uint32_t bytes)=0;
+    virtual void guardPublishedEffects()=0;
+    // Genuine synchronous CPU->GPU handoff: the runtime imports the current CPU
+    // VU state/data/controls into the GPU bank immediately before an admitted
+    // GPU launch. Distinct from cold(): it never reinitializes an existing bank
+    // from the boot snapshot, and it is checked against the live epoch/bank
+    // generation. Must not be called while semantic work is unretired.
+    virtual void importHandoff(const Handoff&)=0;
+
+    // Retained PRE-LAUNCH snapshot readback for verifier-rejection recovery.
+    // Default: no retention (recovery reports the failure and stops cleanly).
+    // The owner fills `out` with one retained record per refused ordinal it
+    // parked on (pre-publication wrapper refusal, statuses 20..24), ordered by
+    // ordinal, and consumes each retention exactly once.
+    virtual void retainFailedLaunch(std::vector<RetainedLaunchFailure>&) {
+        throw std::runtime_error("Owner retains no pre-launch snapshot for verifier-rejection recovery");
+    }
+
+    // Genuine synchronous GPU->CPU handoff: read the current GPU architectural
+    // state/data/controls back (a real device fence wait, never a stale shadow).
+    // The runtime restores the CPU interpreter/VIF from this before a CPU
+    // fallback launch. Must not be called while semantic work is unretired.
+    virtual void exportHandoff(Handoff&)=0;
+    // GS-only RESET changes render state/epoch, not VU registers or data.
+    // All previous tickets must first retire at an actual guest barrier.
+    virtual void prepareGsReset(uint64_t newEpoch)=0;
+    virtual void drainBeforeEpochReset()=0;
+};
+} // namespace reo_resident_live
