+++ b/ps2xRuntime/src/lib/resident_gif_sidecar.h
@@ -0,0 +1,12 @@
+#pragma once
+#include <cstdint>
+#include <functional>
+class GifArbiter;
+namespace reo_resident_live {
+// Private source-level typed queue. GifArbiter's public header/layout stays exact.
+void armArbiter(GifArbiter&);
+void disarmArbiter(GifArbiter&)noexcept;
+void submitResidentPath1(GifArbiter&,std::function<void()>);
+void submitMoviePath3(GifArbiter&,bool image,
+    std::function<void(const std::function<void(const uint8_t*,uint32_t)>&)>);
+}
diff --git a/ps2xRuntime/src/lib/resident_gif_sidecar.inl b/ps2xRuntime/src/lib/resident_gif_sidecar.inl
new file mode 100644
index 0000000..94d6825
--- /dev/null
+++ b/ps2xRuntime/src/lib/resident_gif_sidecar.inl
@@ -0,0 +1,121 @@
+// Include in ps2_gif_arbiter.cpp after its existing namespace helper block.
+#include "resident_gif_sidecar.h"
+#include <mutex>
+#include <unordered_map>
+#include <stdexcept>
+namespace reo_resident_live {
+namespace {
+using RawPacket=std::function<void(const uint8_t*,uint32_t)>;
+struct TypedEffect {uint64_t ordinal;GifPathId path;bool image;std::function<void(const RawPacket&)> callback;};
+struct ArbiterSidecar {uint64_t nextOrdinal=1;uint32_t owners=1;const void* singleOrdinary=nullptr;uint64_t singleOrdinal=0;std::unordered_map<const void*,uint64_t> ordinary;std::vector<TypedEffect> effects;};
+std::mutex sidecarMutex;
+std::unordered_map<GifArbiter*,ArbiterSidecar> sidecars;
+std::atomic<uint32_t> sidecarCount{0};
+}
+void armArbiter(GifArbiter& arbiter) {
+    std::lock_guard<std::mutex> lock(sidecarMutex);
+    auto inserted=sidecars.emplace(&arbiter,ArbiterSidecar{});
+    if(!inserted.second)++inserted.first->second.owners;
+    sidecarCount.store(uint32_t(sidecars.size()),std::memory_order_release);
+}
+void disarmArbiter(GifArbiter& arbiter)noexcept {
+    std::lock_guard<std::mutex> lock(sidecarMutex);auto found=sidecars.find(&arbiter);
+    if(found!=sidecars.end()&&!--found->second.owners)sidecars.erase(found);
+    sidecarCount.store(uint32_t(sidecars.size()),std::memory_order_release);
+}
+void submitResidentPath1(GifArbiter& arbiter,std::function<void()> callback) {
+    if(!callback)throw std::invalid_argument("Null resident PATH1 effect");
+    std::lock_guard<std::mutex> lock(sidecarMutex);
+    const auto found=sidecars.find(&arbiter);
+    if(found==sidecars.end())throw std::logic_error("Resident arbiter was not armed before submission");
+    auto& state=found->second;
+    if(state.effects.size()==4096)throw std::overflow_error("Resident arbitration prefix full");
+    state.effects.push_back({state.nextOrdinal++,GifPathId::Path1,false,
+        [callback=std::move(callback)](const RawPacket&){callback();}});
+}
+void submitMoviePath3(GifArbiter& arbiter,bool image,std::function<void(const RawPacket&)> callback) {
+    if(!callback)throw std::invalid_argument("Null movie PATH3 operation");
+    std::lock_guard<std::mutex> lock(sidecarMutex);auto found=sidecars.find(&arbiter);
+    if(found==sidecars.end())throw std::logic_error("Movie arbiter was not armed before ordinary submissions");
+    auto& state=found->second;
+    if(state.effects.size()==4096)throw std::overflow_error("Movie arbitration prefix full");
+    state.effects.push_back({state.nextOrdinal++,GifPathId::Path3,image,std::move(callback)});
+}
+void noteOrdinary(GifArbiter& arbiter,const GifArbiterPacket& packet) {
+    if(!sidecarCount.load(std::memory_order_acquire))return;
+    std::lock_guard<std::mutex> lock(sidecarMutex);const auto found=sidecars.find(&arbiter);
+    if(found==sidecars.end())return;
+    auto& state=found->second;
+    // vector moves/reallocation/stable_sort retain the raw byte allocation.
+    // No opaque bytes or forged GIF tags are inserted into the actual queue.
+    if(packet.data.empty() || packet.data.data()==state.singleOrdinary)
+        throw std::logic_error("Resident raw packet allocation identity collision");
+    // XGKICK usually submits and drains exactly one ordinary packet. Keep its
+    // provenance inline instead of allocating a hash node for every kick.
+    if(!state.singleOrdinary&&state.ordinary.empty()){
+        state.singleOrdinary=packet.data.data();state.singleOrdinal=state.nextOrdinal++;return;
+    }
+    if(!state.ordinary.emplace(packet.data.data(),state.nextOrdinal++).second)
+        throw std::logic_error("Resident raw packet allocation identity collision");
+}
+bool drainSidecar(GifArbiter& arbiter,std::vector<GifArbiterPacket>& packets,
+                  const std::function<void(const uint8_t*,uint32_t)>& raw) {
+    if(!sidecarCount.load(std::memory_order_acquire))return false;
+    ArbiterSidecar prefix;bool single=false;
+    {
+        std::lock_guard<std::mutex> lock(sidecarMutex);const auto found=sidecars.find(&arbiter);
+        if(found==sidecars.end())return false;
+        auto& state=found->second;
+        single=packets.size()==1&&state.effects.empty()&&state.ordinary.empty()&&
+            state.singleOrdinary==packets.front().data.data()&&!packets.front().data.empty();
+        prefix.singleOrdinary=state.singleOrdinary;prefix.singleOrdinal=state.singleOrdinal;
+        state.singleOrdinary=nullptr;state.singleOrdinal=0;
+        prefix.ordinary=std::move(state.ordinary);prefix.effects=std::move(state.effects);
+    }
+    if(single){
+        // No competing paths/effects exist, so priority and ordinal sorting are
+        // identities. Preserve the same callback, path, and exception cleanup.
+        try{gs_backend_bridge::PathScope scope(uint8_t(packets.front().pathId));
+            raw(packets.front().data.data(),uint32_t(packets.front().data.size()));}
+        catch(...){packets.clear();disarmArbiter(arbiter);throw;}
+        packets.clear();return true;
+    }
+    struct Dispatch {
+        uint64_t ordinal=0;GifPathId path=GifPathId::Path1;
+        bool directHl=false,path3Image=false;
+        GifArbiterPacket* packet=nullptr;std::function<void(const RawPacket&)> effect;
+    };
+    std::vector<Dispatch> ordered;ordered.reserve(packets.size()+prefix.effects.size());
+    for(auto& packet:packets) {
+        const auto found=prefix.ordinary.find(packet.data.data());
+        if(found==prefix.ordinary.end()&&packet.data.data()!=prefix.singleOrdinary) {
+            disarmArbiter(arbiter);packets.clear();
+            throw std::logic_error("Arbiter armed after an ordinary queued packet; sequence provenance unavailable");
+        }
+        const uint64_t ordinal=packet.data.data()==prefix.singleOrdinary?prefix.singleOrdinal:found->second;
+        ordered.push_back({ordinal,packet.pathId,packet.path2DirectHl,packet.path3Image,&packet,{}});
+    }
+    for(auto& effect:prefix.effects)ordered.push_back({effect.ordinal,effect.path,false,effect.image,nullptr,std::move(effect.callback)});
+    std::sort(ordered.begin(),ordered.end(),[](const Dispatch& a,const Dispatch& b){return a.ordinal<b.ordinal;});
+    std::stable_sort(ordered.begin(),ordered.end(),[](const Dispatch& a,const Dispatch& b){
+        // Mechanically identical priority/exception ordering to original drain.
+        if(a.directHl!=b.directHl || a.path3Image!=b.path3Image) {
+            if(a.path3Image&&b.directHl)return true;
+            if(a.directHl&&b.path3Image)return false;
+        }
+        return uint8_t(a.path)<uint8_t(b.path);
+    });
+    try {
+        for(auto& entry:ordered) {
+            gs_backend_bridge::PathScope scope(uint8_t(entry.path));
+            if(entry.effect)entry.effect(raw);
+            else if(entry.packet && !entry.packet->data.empty())
+                raw(entry.packet->data.data(),uint32_t(entry.packet->data.size()));
+        }
+    } catch(...) {
+        // No stale allocation identities/callbacks survive exception or retry.
+        packets.clear();disarmArbiter(arbiter);throw;
+    }
+    packets.clear();return true;
+}
+} // namespace reo_resident_live
diff --git a/ps2xRuntime/src/lib/resident_gs_worker.inl b/ps2xRuntime/src/lib/resident_gs_worker.inl
new file mode 100644
index 0000000..34288bd
--- /dev/null
+++ b/ps2xRuntime/src/lib/resident_gs_worker.inl
@@ -0,0 +1,159 @@
+#include "resident_wait_integration.h"
+// Insert after gsBackendControl definition in copied ps2_gs_gpu.cpp.
+// All symbols below share that TU's existing GS FIFO/Route/epoch owner.
+namespace reo_resident_live {
+uint64_t currentGsEpoch(){return gsPrivCurrentEpoch();}
+namespace {
+class QueuedResidentRetirement final:public BackendRetirementRequest {
+    std::shared_ptr<GsBackendReply> reply_;
+    std::shared_ptr<std::vector<Retired>> results_;
+public:
+    QueuedResidentRetirement(std::shared_ptr<GsBackendReply> reply,std::shared_ptr<std::vector<Retired>> results)
+        :reply_(std::move(reply)),results_(std::move(results)) {}
+    bool ready()const noexcept override {return reply_->done.load(std::memory_order_acquire);}
+    std::vector<Retired> wait()override {
+        if(!reply_->done.load(std::memory_order_acquire)) {
+            std::unique_lock<std::mutex> guard(g_gsAsync.m);
+            g_gsAsync.drained.wait(guard,[&]{return g_gsAsync.stopping || reply_->done.load(std::memory_order_acquire);});
+        }
+        if(!reply_->done.load(std::memory_order_acquire))throw std::runtime_error("Resident retirement cancelled before worker completion");
+        if(reply_->error)std::rethrow_exception(reply_->error);
+        return *results_; // Immutable actual metadata; concurrent followers share it.
+    }
+};
+}
+std::shared_ptr<BackendRetirementRequest> requestBackendRetirement(Barrier reason,uint64_t epoch,uint64_t generation) {
+    if(t_isGsWorker || !gsThreadEnabled())throw std::logic_error("Resident CPU wait requires the separate GS owner");
+    auto reply=std::make_shared<GsBackendReply>();
+    auto results=std::make_shared<std::vector<Retired>>();
+    auto work=[reply,results,reason,epoch,generation] {
+        const GsBackendEpochScope scope(epoch);
+        try {
+            if(epoch!=gsPrivCurrentEpoch())throw std::runtime_error("Resident wait request crossed RESET epoch");
+            if(!g_backendRoute.residentRetire(reason,epoch,generation,*results))
+                throw std::runtime_error("Resident wait request has no active semantic owner");
+        } catch(...) {reply->error=std::current_exception();}
+        reply->done.store(true,std::memory_order_release);g_gsAsync.drained.notify_all();
+        // No Memory/Runtime pointer is captured by the GS worker. This only
+        // wakes the existing owner; actual register/IRQ publication is later.
+        notifyResidentCompletionReady();
+    };
+    std::unique_lock<std::mutex> guard(g_gsAsync.m);
+    // Enqueue owns the existing exact frontier and cannot block an IO/session
+    // holder. Capacity refusal is terminal and never fakes DMA completion.
+    if(g_gsAsync.stopping)throw std::runtime_error("Resident wait request cancelled before FIFO admission");
+    if(!FifoReservation::residentRoom(g_gsAsync.queuedBytes,g_gsAsync.residentOwnedBytes,16u))
+        throw std::runtime_error("Resident completion receipt cannot fit the bounded GS FIFO");
+    if(!g_gsAsync.started) {g_gsAsync.started=true;g_gsAsync.worker=std::thread(gsWorkerMain,g_gsInstance);}
+    GsQueueItem item;item.epoch=epoch;item.isPacket=false;item.control=std::move(work);item.chargedControlBytes=16u;
+    item.residentReserved=true;g_gsAsync.residentOwnedBytes+=16u;
+    ++g_gsAsync.enqueued;g_gsAsync.queuedBytes+=16u;g_gsAsync.queue.push_back(std::move(item));
+    guard.unlock();g_gsAsync.work.notify_one();
+    return std::make_shared<QueuedResidentRetirement>(std::move(reply),std::move(results));
+}
+
+void queueBackendBatch(std::shared_ptr<const Batch> batch) {
+    if(!batch)throw std::invalid_argument("Null resident command batch");
+    validate(*batch);
+    if(!gs_backend_bridge::active() || !gsThreadEnabled())
+        throw std::runtime_error("Resident VIF requires the existing accelerated GS worker");
+    const size_t charge=16u+batch->payloadBytes+batch->operations.size()*sizeof(Operation)+
+        (batch->cold?sizeof(ColdBank):0u);
+    if(charge>kGsQueueMaxBytes)throw std::overflow_error("Resident GS command charge exceeds bounded FIFO");
+    auto work=[batch] {
+        // RESET cancellation must fail explicitly. No stale launch may run on
+        // a new GS/VU bank merely because it reached the worker later.
+        if(batch->epoch!=gsPrivCurrentEpoch())throw std::runtime_error("Resident VIF command crossed GS RESET epoch");
+        if(!g_backendRoute.residentEnqueue(*batch))throw std::runtime_error("Resident backend owner unavailable");
+    };
+    if(t_isGsWorker) {work();return;}
+    std::unique_lock<std::mutex> lock(g_gsAsync.m);
+    const bool reserved=residentWaitSpaceEnabled();
+    if(reserved) {
+        if(!FifoReservation::residentRoom(g_gsAsync.queuedBytes,g_gsAsync.residentOwnedBytes,charge))
+            throw std::runtime_error("Owned resident input exceeds its bounded FIFO reservation");
+    } else g_gsAsync.drained.wait(lock,[&]{return g_gsAsync.stopping || charge<=kGsQueueMaxBytes-g_gsAsync.queuedBytes;});
+    if(g_gsAsync.stopping)throw std::runtime_error("Resident GS command cancelled before queue ownership");
+    if(!g_gsAsync.started) {
+        g_gsAsync.started=true;g_gsAsync.worker=std::thread(gsWorkerMain,g_gsInstance);
+    }
+    GsQueueItem item;item.epoch=batch->epoch;item.isPacket=false;
+    item.control=std::move(work);item.chargedControlBytes=charge;item.residentReserved=reserved;
+    if(reserved)g_gsAsync.residentOwnedBytes+=charge;
+    ++g_gsAsync.enqueued;g_gsAsync.queuedBytes+=charge;
+    // Resident rendering must participate in the existing display marker
+    // serials; otherwise unchanged-display coalescing can hide new geometry.
+    bool hasLaunch=false;for(const auto& operation:batch->operations)hasLaunch|=operation.kind==Kind::Launch;
+    if(hasLaunch){++g_gsAsync.drawingSerial;g_gsAsync.lastDrawingMark=g_gsAsync.enqueued;}
+    g_gsAsync.queue.push_back(std::move(item));lock.unlock();g_gsAsync.work.notify_one();
+}
+std::vector<Retired> retireBackend(Barrier reason,uint64_t epoch,uint64_t generation) {
+    auto result=std::make_shared<std::vector<Retired>>();
+    const bool completed=gsBackendControl([reason,epoch,generation,result] {
+        if(epoch!=gsPrivCurrentEpoch())throw std::runtime_error("Stale resident VIF retirement epoch");
+        if(!g_backendRoute.residentRetire(reason,epoch,generation,*result))
+            throw std::runtime_error("Resident VIF retirement owner unavailable");
+    });
+    if(!completed)throw std::runtime_error("Resident VIF device retirement cancelled");
+    return std::move(*result);
+}
+void readBackendData(uint32_t offset,uint8_t* destination,uint32_t bytes) {
+    if(!destination || !bytes || offset>=DataBytes || bytes>DataBytes-offset)
+        throw std::out_of_range("Explicit guest VU read bounds");
+    auto owned=std::make_shared<std::vector<uint8_t>>(bytes);
+    const bool completed=gsBackendControl([offset,bytes,owned] {
+        if(!g_backendRoute.residentReadData(offset,owned->data(),bytes))
+            throw std::runtime_error("Resident VU bank read owner unavailable");
+    });
+    if(!completed)throw std::runtime_error("Explicit guest VU bank read cancelled");
+    std::memcpy(destination,owned->data(),bytes);
+}
+void readBackendControls(uint32_t offset,uint8_t* destination,uint32_t bytes) {
+    if(!destination || !bytes || offset>=48 || bytes>48-offset)throw std::out_of_range("Explicit VIF control read bounds");
+    auto owned=std::make_shared<std::vector<uint8_t>>(bytes);
+    const bool completed=gsBackendControl([offset,bytes,owned] {
+        if(!g_backendRoute.residentReadControls(offset,owned->data(),bytes))
+            throw std::runtime_error("Resident VIF control read owner unavailable");
+    });
+    if(!completed)throw std::runtime_error("Explicit VIF control read cancelled");
+    std::memcpy(destination,owned->data(),bytes);
+}
+// Explicit synchronous CPU<->GPU ownership handoff. Both run through the
+// existing gsBackendControl frontier (the GS owner worker executes the device
+// copy and its fence wait; the guest thread only blocks on the completion
+// condition, releasing no ownership it did not already hold). Handoff storage
+// is shared-owned because on worker cancellation the callback may still run
+// after the caller resumes — the same rule as every wrapper above.
+void importBackendHandoff(Handoff& handoff) {
+    auto owned=std::make_shared<Handoff>(handoff);
+    const bool completed=gsBackendControl([owned] {
+        if(owned->epoch!=gsPrivCurrentEpoch())throw std::runtime_error("Resident handoff crossed GS RESET epoch");
+        if(!g_backendRoute.residentImportHandoff(*owned))
+            throw std::runtime_error("Resident handoff owner unavailable");
+    });
+    if(!completed)throw std::runtime_error("Resident CPU->GPU handoff cancelled");
+}
+// Retained PRE-LAUNCH snapshot readback for verifier-rejection recovery. Same
+// ownership rule as the handoff wrappers: the GS owner worker executes the
+// device copy and its fence wait; the guest thread only blocks on the
+// completion frontier. Exactly-once inside the owner.
+void retainFailedLaunchBackend(std::vector<RetainedLaunchFailure>& out) {
+    auto owned=std::make_shared<std::vector<RetainedLaunchFailure>>();
+    const bool completed=gsBackendControl([owned] {
+        if(!g_backendRoute.residentRetainFailedLaunch(*owned))
+            throw std::runtime_error("Resident retained-snapshot owner unavailable");
+    });
+    if(!completed)throw std::runtime_error("Resident retained-snapshot readback cancelled");
+    out=std::move(*owned);
+}
+void exportBackendHandoff(Handoff& handoff) {    auto owned=std::make_shared<Handoff>();
+    owned->epoch=handoff.epoch;owned->bankGeneration=handoff.bankGeneration;
+    const bool completed=gsBackendControl([owned] {
+        if(owned->epoch!=gsPrivCurrentEpoch())throw std::runtime_error("Resident handoff crossed GS RESET epoch");
+        if(!g_backendRoute.residentExportHandoff(*owned))
+            throw std::runtime_error("Resident handoff owner unavailable");
+    });
+    if(!completed)throw std::runtime_error("Resident GPU->CPU handoff cancelled");
+    handoff=std::move(*owned);
+}
+} // namespace reo_resident_live
