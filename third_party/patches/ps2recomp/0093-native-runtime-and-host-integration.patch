+// Literal-source refusal decoder (status 24 at the digest-pinned wrapper:
+// forced-post-v4/vu_5273fa3e9893.comp lines 17/21 -> aot_common.glsl
+// verifyLiteralSourcePreservation). The kernel required
+// work[((top+1+q)&1023)*4+lane] == its echo qwords on the DEVICE bank at
+// dispatch (kind 1: 1 qword, kind 2: 7 qwords; kind 0: no provenance event).
+// Reproduce that comparison on the retained PRE-LAUNCH device snapshot (which
+// already contains this job's recorded uploads) so the log carries the actual
+// expected/actual values instead of a guessed refusal reason.
+//
+// Echo layout: words 0..3 = kindCountFlags (x=kind, y=flags, z+w reserved);
+// qwords [0..6] each are uvec4 => start at word 4 + (q*4), span lanes 0..3.
+// The runtime contract padding differs from the rect literal lattice note: only
+// the qword words are comparable; the header's kindCountFlags is metadata
+// (NOT read by the shader as a data word).
+void captureLiteralSourceCheck(const RetainedLaunchFailure& retained,uint32_t status) {
+    // Only emit this capture for status 24 (= literal-source refusal); for
+    // status 21 the wrapper refused for a kernel-execution reason and the
+    // literal-source comparison is incidental, not the cause. Decoupling the
+    // capture from the status prevents misleading cross-references.
+    if(status!=24u) return;
+    const uint32_t kind=retained.echo[0];
+    const uint32_t flags=retained.echo[1];
+    if(kind!=1u && kind!=2u) {
+        std::fprintf(stderr,"[GPU-REJECT] literal-source check: echo kind=%u flags=0x%08x has no qword contract (kind 0 = no provenance event)\n",kind,flags);
+        return;
+    }
+    const uint32_t count=kind==1u?1u:7u;
+    const uint32_t top=retained.push[2]&1023u;
+    bool matched=true;
+    for(uint32_t q=0;q<count;++q) {
+        const uint32_t offset=((top+1u+q)&1023u)*4u;
+        for(uint32_t lane=0;lane<4u;++lane) {
+            uint32_t actual=0;
+            std::memcpy(&actual,retained.data.data()+(offset+lane)*4u,4);
+            // Qword q starts at echo word 4 + q*4 (skip the kindCountFlags
+            // header uvec4). This is what the wrapper shader reads via
+            // echoCommand.qwords[q][lane].
+            const uint32_t expected=retained.echo[4u+q*4u+lane];
+            if(actual!=expected) {
+                std::fprintf(stderr,
+                    "[GPU-REJECT] literal-source mismatch q=%u/%u lane=%u bankWordOffset=%u top=0x%x expected=%08x actual=%08x (first mismatch; wrapper checks qwords 0..%u)\n",
+                    q,count-1u,lane,offset+lane,top,expected,actual,count-1u);
+                matched=false;q=count;break;
+            }
+        }
+    }
+    if(matched)
+        std::fprintf(stderr,"[GPU-REJECT] literal-source contract MATCHES on the retained pre-dispatch snapshot (qwords 0..%u at top=0x%x) — the refusal came from the kernel's post-run re-verification or a device-only delta\n",
+            count-1u,top);
