+#pragma once
+#include <cstdint>
+#include <memory>
+#include <utility>
+namespace reo_parent_install {class Service;}
+namespace reo_resident_live {
+// No Vulkan handles or graphical bytes cross the runtime command interface.
+struct LeaseUploadStamp {
+    uint64_t session=0,epoch=0,bankGeneration=0,allocation=0,revision=0,ordinal=0;
+    uint32_t guestSource=0,bytes=0,command=0,tops=0;
+};
+inline bool validLeaseUploadStamp(const LeaseUploadStamp& s) noexcept {
+    return s.session&&s.epoch&&s.bankGeneration&&s.allocation&&s.revision&&s.ordinal&&
+        s.command==0x6cf80000u&&s.tops<=1023u&&s.bytes==3968u&&
+        !(s.guestSource&15u)&&s.guestSource<0x2000000u&&s.bytes<=0x2000000u-s.guestSource;
+}
+class OpaqueLeaseUpload final {
+    friend class reo_parent_install::Service;
+    LeaseUploadStamp stamp_;
+    const void* issuer_=nullptr;
+    std::shared_ptr<const void> lifetime_;
+    OpaqueLeaseUpload(const LeaseUploadStamp& stamp,const void* issuer,std::shared_ptr<const void> lifetime)
+        :stamp_(stamp),issuer_(issuer),lifetime_(std::move(lifetime)){}
+public:
+    OpaqueLeaseUpload(const OpaqueLeaseUpload&)=delete;
+    OpaqueLeaseUpload& operator=(const OpaqueLeaseUpload&)=delete;
+    const LeaseUploadStamp& stamp()const noexcept{return stamp_;}
+};
+}
