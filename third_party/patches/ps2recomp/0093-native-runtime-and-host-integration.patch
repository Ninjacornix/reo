+++ b/ps2xRuntime/src/lib/native_movie_owner.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+
+// Private same-GS-owner transport. No D3D/Vulkan types, guest pointers,
+// extra graphics worker, scheduling clock or decoded RAM shadow enter Runtime.
+namespace reo_movie_owner {
+class Target {
+public:
+    virtual ~Target()=default;
+    virtual uint64_t epoch()const noexcept=0;
+    virtual const void* deviceIdentity()const noexcept=0;
+    virtual void requireHealthy()const=0;
+    virtual void stop()noexcept=0;
+    virtual void runControl(const std::function<void(Target&)>&)=0;
+};
+class Request {
+public:
+    virtual ~Request()=default;
+    virtual bool ready()const noexcept=0;
+    virtual void wait()=0;
+};
+// Backend creates/withdraws the real same-Device service in serialized init /
+// close / RESET. The registration never creates a synthetic movie completion.
+void installActualOwner(const std::shared_ptr<Target>&);
+void retireActualOwner(const std::shared_ptr<Target>&)noexcept;
+bool actualOwnerAvailable()noexcept;
+bool onActualOwnerThread()noexcept;
+// The caller retains immutable arguments/results, releases EE ownership while
+// waiting, and publishes guest integer controls only after reacquiring it.
+// Retained compressed bytes count against the existing bounded GS FIFO.
+std::shared_ptr<Request> request(uint64_t epoch,size_t retainedBytes,bool publishesDrawing,
+                               const std::function<void(Target&)>&);
+}
diff --git a/ps2xRuntime/src/lib/native_movie_worker.inl b/ps2xRuntime/src/lib/native_movie_worker.inl
new file mode 100644
index 0000000..37a1f58
--- /dev/null
+++ b/ps2xRuntime/src/lib/native_movie_worker.inl
@@ -0,0 +1,118 @@
+// Included beside parent_natural_worker.inl in the real GS FIFO translation unit.
+#include "native_movie_owner.h"
+#include "native_movie_image.h"
+namespace reo_movie_owner {
+namespace {
+std::mutex actualMovieOwnerMutex;
+std::weak_ptr<Target> actualMovieOwner;
+class ActualMovieRequest final:public Request {
+    std::shared_ptr<GsBackendReply> reply_;
+public:
+    explicit ActualMovieRequest(std::shared_ptr<GsBackendReply> reply):reply_(std::move(reply)){}
+    bool ready()const noexcept override{return reply_->done.load(std::memory_order_acquire);}
+    void wait()override{
+        if(!ready()){std::unique_lock<std::mutex> lock(g_gsAsync.m);g_gsAsync.drained.wait(lock,[&]{return g_gsAsync.stopping||ready();});}
+        if(!ready())throw std::runtime_error("Movie owner work cancelled before the actual GS worker completed");
+        if(reply_->error)std::rethrow_exception(reply_->error);
+    }
+};
+}
+void installActualOwner(const std::shared_ptr<Target>& target){
+    if(!target||!target->epoch()||target->epoch()!=gsPrivCurrentEpoch()||!target->deviceIdentity())
+        throw std::invalid_argument("Movie service lacks its actual GS Device/epoch");
+    target->requireHealthy();std::lock_guard<std::mutex> lock(actualMovieOwnerMutex);
+    if(!actualMovieOwner.expired())throw std::logic_error("A real movie GS owner is already installed");
+    actualMovieOwner=target;
+}
+void retireActualOwner(const std::shared_ptr<Target>& target)noexcept{
+    std::lock_guard<std::mutex> lock(actualMovieOwnerMutex);
+    if(actualMovieOwner.lock()==target)actualMovieOwner.reset();
+}
+bool actualOwnerAvailable()noexcept{
+    std::lock_guard<std::mutex> lock(actualMovieOwnerMutex);auto target=actualMovieOwner.lock();
+    return target&&target->epoch()==gsPrivCurrentEpoch()&&gs_backend_bridge::active();
+}
+bool onActualOwnerThread()noexcept{return t_isGsWorker;}
+std::shared_ptr<Request> request(uint64_t epoch,size_t retainedBytes,bool drawing,
+                                const std::function<void(Target&)>& call){
+    if(!epoch||!call||t_isGsWorker||!gsThreadEnabled()||!gs_backend_bridge::active()||
+       retainedBytes>512u*1024u||ps2IoRegLockDepth())
+        throw std::logic_error("Movie caller requires the actual separate GS worker outside IO ownership");
+    std::shared_ptr<Target> target;{std::lock_guard<std::mutex> lock(actualMovieOwnerMutex);target=actualMovieOwner.lock();}
+    if(!target||target->epoch()!=epoch)throw std::runtime_error("No actual movie owner for this GS epoch");
+    const size_t charge=16u+retainedBytes;
+    auto reply=std::make_shared<GsBackendReply>();
+    auto work=[reply,target,epoch,call]{const GsBackendEpochScope scope(epoch);try{
+        if(epoch!=gsPrivCurrentEpoch()||target->epoch()!=epoch)throw std::runtime_error("Movie control crossed a real GS RESET");
+        {std::lock_guard<std::mutex> lock(actualMovieOwnerMutex);if(actualMovieOwner.lock()!=target)throw std::runtime_error("Movie Device owner was retired before its FIFO operation");}
+        target->requireHealthy();target->runControl(call);
+    }catch(...){reply->error=std::current_exception();}
+        reply->done.store(true,std::memory_order_release);g_gsAsync.drained.notify_all();};
+    std::unique_lock<std::mutex> lock(g_gsAsync.m);
+    if(g_gsAsync.stopping||!reo_resident_live::FifoReservation::residentRoom(g_gsAsync.queuedBytes,g_gsAsync.residentOwnedBytes,charge))
+        throw std::runtime_error("Movie operation cannot reserve the existing bounded GS FIFO");
+    if(!g_gsAsync.started){g_gsAsync.started=true;g_gsAsync.worker=std::thread(gsWorkerMain,g_gsInstance);}
+    GsQueueItem item;item.epoch=epoch;item.isPacket=false;item.control=std::move(work);
+    item.chargedControlBytes=charge;item.residentReserved=true;g_gsAsync.residentOwnedBytes+=charge;
+    ++g_gsAsync.enqueued;g_gsAsync.queuedBytes+=charge;
+    if(drawing){++g_gsAsync.drawingSerial;g_gsAsync.lastDrawingMark=g_gsAsync.enqueued;}
+    g_gsAsync.queue.push_back(std::move(item));lock.unlock();g_gsAsync.work.notify_one();
+    return std::make_shared<ActualMovieRequest>(std::move(reply));
+}
+// Source-qualified IMAGE transfers are admitted by the actual GIF arbiter
+// while DMA owns IO. They reserve metadata only and never wait under IO.
+void queueNativeImageControl(uint64_t epoch,bool drawing,const std::function<void(Target&)>& call,size_t retainedBytes=0) {
+    if(!epoch||!call||t_isGsWorker||!gsThreadEnabled()||!gs_backend_bridge::active()||retainedBytes>512u*1024u)
+        throw std::runtime_error("Movie IMAGE requires the real separate bounded GS FIFO");
+    std::shared_ptr<Target> target;{std::lock_guard<std::mutex> lock(actualMovieOwnerMutex);target=actualMovieOwner.lock();}
+    if(!target||target->epoch()!=epoch||epoch!=gsPrivCurrentEpoch())throw std::runtime_error("Movie IMAGE refers to a retired GS owner");
+    auto work=[target,epoch,call]{const GsBackendEpochScope scope(epoch);
+        if(epoch!=gsPrivCurrentEpoch()||target->epoch()!=epoch)throw std::runtime_error("Movie IMAGE crossed a genuine GS reset");
+        {std::lock_guard<std::mutex> lock(actualMovieOwnerMutex);if(actualMovieOwner.lock()!=target)throw std::runtime_error("Movie IMAGE Device was retired before its FIFO operation");}
+        target->requireHealthy();target->runControl(call);
+    };
+    std::unique_lock<std::mutex> lock(g_gsAsync.m);const size_t charge=16u+retainedBytes;
+    if(g_gsAsync.stopping||!reo_resident_live::FifoReservation::residentRoom(g_gsAsync.queuedBytes,g_gsAsync.residentOwnedBytes,charge))
+        throw std::runtime_error("Movie IMAGE cannot reserve the bounded GS FIFO without waiting under IO");
+    if(!g_gsAsync.started){g_gsAsync.started=true;g_gsAsync.worker=std::thread(gsWorkerMain,g_gsInstance);}
+    GsQueueItem item;item.epoch=epoch;item.isPacket=false;item.control=std::move(work);
+    item.chargedControlBytes=charge;item.residentReserved=true;g_gsAsync.residentOwnedBytes+=charge;
+    ++g_gsAsync.enqueued;g_gsAsync.queuedBytes+=charge;
+    if(drawing){++g_gsAsync.drawingSerial;g_gsAsync.lastDrawingMark=g_gsAsync.enqueued;}
+    g_gsAsync.queue.push_back(std::move(item));lock.unlock();g_gsAsync.work.notify_one();
+}
+}
+namespace reo_native_movie {
+void queueImage(std::shared_ptr<PreparedImage> image) {
+    if(!image||!image->bytes())throw std::invalid_argument("Missing source-qualified movie IMAGE");
+    const auto epoch=image->epoch();
+    reo_movie_owner::queueNativeImageControl(epoch,true,[image=std::move(image)](reo_movie_owner::Target& target){image->consume(target);});
+}
+void queueImageBatch(std::shared_ptr<const std::vector<ImageChainPiece>> pieces) {
+    if(!pieces)throw std::invalid_argument("Missing original movie IMAGE batch");
+    std::shared_ptr<PreparedImage> leader;
+    for(const auto& piece:*pieces)if(piece.image){leader=piece.image;break;}
+    if(!leader)throw std::invalid_argument("Original movie IMAGE batch is empty");
+    const auto epoch=leader->epoch();
+    size_t retainedBytes=sizeof(*pieces)+pieces->capacity()*sizeof(ImageChainPiece)+64u;
+    for(const auto& piece:*pieces){
+        retainedBytes+=piece.control.capacity();
+        if(piece.image)retainedBytes+=piece.image->retainedBytes();
+        if(retainedBytes>512u*1024u)throw std::runtime_error("Original movie IMAGE batch exceeds bounded retained metadata");
+    }
+    reo_movie_owner::queueNativeImageControl(epoch,true,[pieces=std::move(pieces),leader](reo_movie_owner::Target& target){
+        leader->beginBatch(target);
+        for(const auto& piece:*pieces){
+            if(piece.image)piece.image->consumeBatched(target);
+            else if(!piece.control.empty())g_backendRoute.gif(3u,piece.control.data(),piece.control.size());
+        }
+        // End waits the one submitted real GPU fence before the next FIFO
+        // entry can publish any guest DMA completion or reuse source storage.
+        leader->endBatch(target);
+    },retainedBytes);
+}
+void queuePublication(uint64_t epoch,std::function<void()> publication) {
+    if(!publication)throw std::invalid_argument("Missing original GIF DMA publication");
+    reo_movie_owner::queueNativeImageControl(epoch,false,[publication=std::move(publication)](reo_movie_owner::Target&){publication();});
+}
+}
