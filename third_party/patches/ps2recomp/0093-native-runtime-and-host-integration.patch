+void registerActualPreEntryControlRuntime(PS2Runtime& rt){PreEntryControlJournalCore::registerRuntime(rt);}
+void stopActualPreEntryControlRuntime(PS2Runtime& rt)noexcept{PreEntryControlJournalCore::stopRuntime(rt);}
+PreEntryControlSnapshotHandle captureActualPreEntryControlsAtCold(PS2Runtime& rt,R5900Context& ctx,const std::shared_ptr<const void>& storage){return PreEntryControlJournalCore::capture(rt,ctx,storage);}
+PreEntryControlWriteHandle prepareActualPreEntryControlWrite(PS2Runtime& rt,const void* ram,R5900Context& ctx,uint32_t at,const void* data,uint32_t bytes,const reo_source_instrumentation::InstructionOrigin& origin){return PreEntryControlJournalCore::prepare(rt,ram,ctx,at,data,bytes,origin);}
