+    }return accessCache.target;
+}
+inline bool boundOwned(PS2Runtime* runtime){if(!runtime)return false;try{const auto& target=selectedTarget(runtime->memory().getRDRAM());return target&&(target->ownsAnySource()||target->readyForSelection());}catch(...){return true;}}
+[[noreturn]] inline void propagateOwnedFailure(PS2Runtime* runtime){
+    // Called only within catch. A guest exception handler must not convert an
+    // owned-source refusal into an address exception and continue callbacks.
+    if(runtime&&boundOwned(runtime)){runtime->requestStop();try{throw;}catch(const OwnedSourceFailure&){throw;}catch(const std::exception& e){throw OwnedSourceFailure(e.what());}catch(...){throw OwnedSourceFailure("Owned source access failed");}}
+    throw;
+}
+inline void rethrowOwnedFailure(PS2Runtime* runtime){reo_parent_natural::rethrowOwnedSourceFailure(runtime);}
+class EntryScope final {
+    inline static thread_local EntryScope* current_=nullptr;
+    EntryScope* previousScope_;PS2Runtime* runtime_;R5900Context* context_;
+    std::shared_ptr<FirstEntryInvocation> enrollmentInvocation_;
+    AccessScope scope_;InstructionInputScope inputs_;InstructionOrigin previous_;SourceAccessCache priorCache_;NativeInvocationScope* priorNative_;
+public:EntryScope(PS2Runtime* runtime,R5900Context* ctx):previousScope_(current_),runtime_(runtime),context_(ctx),scope_(runtime,ctx),inputs_(runtime,ctx),previous_(actualInstructionOrigin),priorCache_(accessCache),priorNative_(actualNativeInvocation){try{actualNativeInvocation=nullptr;
+        if(runtime)selectedTarget(runtime->memory().getRDRAM());else accessCache={};
+        if(runtime&&ctx&&boundOwned(runtime)&&!ps2ActualGuestExecutionDepth(runtime)){runtime->requestStop();throw OwnedSourceFailure("Source entry lacks genuine guest execution");}actualInstructionOrigin={};current_=this;
+        }catch(...){actualNativeInvocation=priorNative_;actualInstructionOrigin=previous_;accessCache=std::move(priorCache_);propagateOwnedFailure(runtime);}
+    }
+    ~EntryScope(){if(enrollmentInvocation_)enrollmentInvocation_->active_.store(false,std::memory_order_release);current_=previousScope_;actualInstructionOrigin=previous_;accessCache=std::move(priorCache_);actualNativeInvocation=priorNative_;}
+    static FirstEntryInvocationHandle retainFirstEntryInvocation(PS2Runtime& runtime,R5900Context& ctx){
+        if(!current_||current_->runtime_!=&runtime||current_->context_!=&ctx||
+           currentRuntime()!=&runtime||currentContext()!=&ctx||!ps2ActualGuestExecutionDepth(&runtime))
+            throw OwnedSourceFailure("First graphics entry lacks the authentic live EntryScope");
+        if(!current_->enrollmentInvocation_)current_->enrollmentInvocation_=std::shared_ptr<FirstEntryInvocation>(new FirstEntryInvocation(runtime,ctx,[scope=current_]{
+            if(current_!=scope||currentRuntime()!=scope->runtime_||currentContext()!=scope->context_)
+                throw OwnedSourceFailure("First graphics capture is not this exact current EntryScope");
+        }));
+        return current_->enrollmentInvocation_;
+    }
+    void at(uint32_t pc,uint32_t opcode){actualInstructionOrigin=classifyInstruction(pc,opcode);inputs_.at(pc,opcode);}
+};
+inline bool dispatchEntry(uint8_t* ram,R5900Context& ctx,PS2Runtime& runtime,uint32_t entry){
+    // The current real PC is retained for registered continuations. No entry
+    // or command is inferred from mutated argument registers.
+    try{
+        if(actualFirstEntryEnrollmentRequested()){
+            if(isActualFirstGraphicsEntry(entry)&&ctx.pc==entry)
+                ensureActualFirstGraphicsEntry(ram,ctx,runtime,entry,EntryScope::retainFirstEntryInvocation(runtime,ctx));
+        }
+        if(entry==0x191280u&&ctx.pc==entry)return reo_gpu_upstream::dispatchOriginal191280(ram,ctx,runtime);
+        if(entry==0x196010u&&ctx.pc==entry)return reo_gpu_upstream::dispatchOriginal196010(ram,ctx,runtime);
+        if(entry==0x197900u&&ctx.pc==entry)return reo_gpu_upstream::dispatchOriginalStatePacket197900(ram,ctx,runtime);
+#ifdef REO_SOURCE_COMPOSITION_DISPATCH_PRESENT
+        if(entry==0x18f6a0u&&ctx.pc==entry)return reo_gpu_upstream::dispatchOriginalComposition(ram,ctx,runtime);
+#endif
+        if(entry==0x18f710u||entry==0x1921b0u||entry==0x18f570u||entry==0x18fdf0u)return reo_gpu_upstream::dispatchOriginalPerspective(ram,ctx,runtime);
+        if(entry==0x18f970u||entry==0x18fce0u||entry==0x18f880u||entry==0x18f7e0u||entry==0x197490u)return reo_gpu_upstream::dispatchOriginalViewport(ram,ctx,runtime);
+        return false;
+    }catch(...){propagateOwnedFailure(&runtime);}
+}
+template<class T> uint32_t fieldOffset(R5900Context& ctx,const T* field){
+    const auto base=reinterpret_cast<uintptr_t>(&ctx),at=reinterpret_cast<uintptr_t>(field);
+    if(at<base||at-base>sizeof(ctx)||sizeof(T)>sizeof(ctx)-(at-base))throw std::out_of_range("Actual Context field outside1648 ABI");return uint32_t(at-base);
+}
+template<class T> T readField(R5900Context& ctx,const T* field){
+    static_assert(std::is_trivially_copyable_v<T>);const uint32_t at=fieldOffset(ctx,field);
+    try{
+        auto* runtime=currentRuntime();const auto& target=runtime?selectedTarget(runtime->memory().getRDRAM()):selectedTarget(nullptr);
+        if(target&&(target->ownsAnySource()||target->readyForSelection())){
+            if(currentContext()!=&ctx||!ps2ActualGuestExecutionDepth(runtime))throw OwnedSourceFailure("Context read lacks actual source scope");
+            target->read(SourceSpace::Context,at,sizeof(T),&ctx,ctx.pc);
+        }
+        T value;std::memcpy(&value,field,sizeof(T));if(target&&(target->ownsAnySource()||target->readyForSelection())){recordNativeGuardedRead(*target,ctx,SourceSpace::Context,at,sizeof(T));recordActualGuardedContextInput(target,ctx,at,&value,sizeof(T));}return value;
+    }catch(...){propagateOwnedFailure(currentRuntime());}
+}
+template<class T> void writeField(uint8_t* ram,R5900Context& ctx,T* field,T value,InstructionOrigin origin=actualInstructionOrigin){
+    static_assert(std::is_trivially_copyable_v<T>);const uint32_t at=fieldOffset(ctx,field);
+    try{
+        const auto& target=selectedTarget(ram);
+        if(!target||(!target->ownsAnySource()&&!target->readyForSelection())){std::memcpy(field,&value,sizeof(T));return;}
+        if(currentContext()!=&ctx||currentRuntime()!=target->runtimeIdentity()||!ps2ActualGuestExecutionDepth(currentRuntime()))throw OwnedSourceFailure("Context write lacks actual source scope");
+        // The typed issuer chooses true CPU-only versus opaque fork policy for
+        // separate IRQ/callback contexts. Different identity alone is not RAW.
+        auto* typed=accessCache.typed;auto* exact=accessCache.exact;
+        if(!typed||!exact)throw OwnedSourceFailure("Owned Context lacks actual typed source/role writer");
+        const uint32_t actualPc=ctx.pc;SourceWritePermit permit;
+        if(origin.intent==ContextWriteIntent::NumericOrOpaque&&actualInstructionInputs&&accessCache.cpuInputs){auto inputs=actualInstructionInputs->capture(ctx,origin,target);permit=accessCache.cpuInputs->beginGuardedCpuContextWrite(ctx,inputs,at,&value,sizeof(T),origin);}
+        else permit=typed->beginTypedSourceWrite(SourceSpace::Context,at,&value,sizeof(T),&ctx,actualPc,origin);
+        if(!permit)throw OwnedSourceFailure("Typed Context write failed to issue actual immutable permit");
+        try{exact->authorizeSourceWrite(permit,SourceSpace::Context,at,&value,sizeof(T),&ctx,actualPc);std::memcpy(field,permit->data(),sizeof(T));exact->finishSourceWrite(permit,SourceSpace::Context,at,&ctx,actualPc);}
+        catch(...){exact->abandonSourceWrite(permit);throw;}
+    }catch(...){propagateOwnedFailure(currentRuntime());}
+}
+template<class T> class FieldCell final {
+    uint8_t* ram_;R5900Context& ctx_;T* field_;InstructionOrigin origin_;
+public:FieldCell(uint8_t* ram,R5900Context& ctx,T* field,InstructionOrigin origin):ram_(ram),ctx_(ctx),field_(field),origin_(origin){}
+    FieldCell(const FieldCell&)=delete;T operator=(const FieldCell& other){return *this=T(other);}
+    operator T()const{return readField(ctx_,field_);}
+    T operator=(T value){writeField(ram_,ctx_,field_,value,origin_);return value;}
+    template<class V>T operator|=(V value){return *this=T(T(*this)|value);}template<class V>T operator&=(V value){return *this=T(T(*this)&value);}
+    template<class V>T operator^=(V value){return *this=T(T(*this)^value);}template<class V>T operator+=(V value){return *this=T(T(*this)+value);}
+    template<class V>T operator-=(V value){return *this=T(T(*this)-value);}template<class V>T operator*=(V value){return *this=T(T(*this)*value);}
+    template<class V>T operator/=(V value){return *this=T(T(*this)/value);}template<class V>T operator%=(V value){return *this=T(T(*this)%value);}
+    template<class V>T operator<<=(V value){return *this=T(T(*this)<<value);}template<class V>T operator>>=(V value){return *this=T(T(*this)>>value);}
+    T operator++(){return *this=T(T(*this)+1);}T operator++(int){T old=*this;*this=T(old+1);return old;}
+    T operator--(){return *this=T(T(*this)-1);}T operator--(int){T old=*this;*this=T(old-1);return old;}
+};
+template<class T> FieldCell<T> cell(uint8_t* ram,R5900Context& ctx,T* field){auto origin=actualInstructionOrigin;
+    const auto at=fieldOffset(ctx,field);if(origin.pc&&at==offsetof(R5900Context,pc))origin.intent=ContextWriteIntent::GeneratedPcProgress;
+    else if(origin.pc&&(at==offsetof(R5900Context,branch_pc)||at==offsetof(R5900Context,in_delay_slot)))origin.intent=ContextWriteIntent::GeneratedPcProgress;
+    return {ram,ctx,field,origin};}
+struct ContextAddress {R5900Context* ctx;uint32_t offset,capacity;};
+template<class T> ContextAddress address(R5900Context& ctx,T* field){return {&ctx,fieldOffset(ctx,field),sizeof(T)};}
+inline void* copyBytes(void* destination,ContextAddress source,size_t bytes){
+    if(!destination||bytes>source.capacity)throw std::invalid_argument("Context copy escaped its exact field");
+    try{auto* runtime=currentRuntime();const auto& target=runtime?selectedTarget(runtime->memory().getRDRAM()):selectedTarget(nullptr);if(target&&(target->ownsAnySource()||target->readyForSelection())){if(currentContext()!=source.ctx||!ps2ActualGuestExecutionDepth(runtime))throw OwnedSourceFailure("Context bit copy lacks actual source scope");target->read(SourceSpace::Context,source.offset,uint32_t(bytes),source.ctx,source.ctx->pc);}
