+void PS2Runtime::replayResidentLaunch(const reo_resident_live::RetainedLaunchFailure &retained,
+                                      reo_resident_live::ReplayLaunchDiagnostic &diag)
+{
+    // Exactly-once CPU replay of a verifier-refused launch's program body.
+    // The retained snapshot is the owner's PRE-dispatch device bank capture
+    // (memcpy ABI identical to the import/export handoff state), so restoring
+    // it reproduces exactly the interpreter state the refused kernel was
+    // recorded to consume. The program then runs through the same
+    // execute/resume calls the MSCAL/MSCNT CPU fallback uses.
+    //
+    // Recovery is bound to the rejected launch's exact image: the owner
+    // recorded the certified image's FNV-1a digest at enqueue, so the live
+    // VU code bank must digest-match before the replay runs. A mismatch
+    // (a different image was uploaded in between) is a strict stop — the
+    // replay never runs against "whichever image is uploaded now".
+    static_assert(PS2_VU1_CODE_SIZE == reo_resident_live::CodeBytes,
+                  "VU1 code bank size must match the certified image size");
+    const uint8_t* codeBank = m_memory.getVU1Code();
+    if (codeBank)
+    {
+        uint64_t live = 0xcbf29ce484222325ull;
+        for (size_t i = 0; i < reo_resident_live::CodeBytes; ++i)
+        { live ^= codeBank[i]; live *= 0x100000001b3ull; }
+        if (retained.imageDigest && live != retained.imageDigest)
+            throw std::runtime_error("Resident replay image digest mismatch: "
+                                     "the live VU code bank is not the refused launch's certified image");
+    }
+    std::memcpy(&m_vu1.state(), retained.state.data(), retained.state.size());
+    std::memcpy(m_memory.getVU1Data(), retained.data.data(), retained.data.size());
+    // Restore the launch-time VIF controls (ROW/COL/cycle/mode/mask, the
+    // owner's retained 48-byte controls block) so the replayed body runs with
+    // the same VIF control state the refused kernel was dispatched under —
+    // not only the VU registers and data bank.
+    {
+        auto& regs = m_memory.vif1_regs;
+        std::memcpy(regs.row, retained.controls.data(), 16);
+        std::memcpy(regs.col, retained.controls.data() + 16, 16);
+        std::memcpy(&regs.cycle, retained.controls.data() + 32, 4);
+        std::memcpy(&regs.mode, retained.controls.data() + 36, 4);
+        std::memcpy(&regs.mask, retained.controls.data() + 40, 4);
+    }
+    // The CPU interpreter's XTOP instruction reads m_memory.vif1_regs.top
+    // (the VIF parser's chronological TOP), but the kernel that was refused
+    // dispatched against the launch's recorded TOP (retained.push[2]): if the
+    // VIF parser has advanced since dispatch, a replay that reads the live
+    // parser TOP would consume from the wrong input address. Restore the
+    // launch's TOP — and TOPS (the queue-top register — same field in PS2
+    // register layout) — for the duration of the replay, then unwind the
+    // parser state so the chronology outside the replay is unchanged.
+    const uint32_t savedTop = m_memory.vif1_regs.top;
+    const uint32_t savedTops = m_memory.vif1_regs.tops;
+    m_memory.vif1_regs.top = retained.push[2] & 1023u;
+    m_memory.vif1_regs.tops = retained.push[2] & 1023u; // TOPS upper-bits cleared; the launch's tag window only
+    reo_resident_live::armReplayCapture();
+    const uint32_t operation = retained.push[4];
+    if (operation == 0u)
+    {
+        // Fresh MSCAL: explicit start PC.
+        m_vu1.execute(m_memory.getVU1Code(), PS2_VU1_CODE_SIZE,
+            m_memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+            m_gs, &m_memory, retained.push[0], retained.push[3] & 1023u, 65536);
+    }
+    else
+    {
+        // MSCNT continuation: resumes from the restored resident PC.
+        m_vu1.resume(m_memory.getVU1Code(), PS2_VU1_CODE_SIZE,
+            m_memory.getVU1Data(), PS2_VU1_DATA_SIZE,
+            m_gs, &m_memory, retained.push[3] & 1023u, 65536);
+    }
+    reo_resident_live::sampleReplayCapture(diag);
+    diag.armed = retained.available;
+    // Unwind the parser state to its pre-replay chronology so future
+    // guest-side UNPACKs / MSCNTs see the unchanged TOP/TOPS state. The
+    // interpreter may have mutated them during ITS XTOP/MTC0/-equivalent
+    // instructions; saving-and-restoring is the only safe way to keep the
+    // replay's VIF timeline local.
+    m_memory.vif1_regs.top = savedTop;
+    m_memory.vif1_regs.tops = savedTops;
+}
