+}
+bool serviceReadyResidentCompletions(PS2Memory& memory) {
+    if(!asyncRequested() || ps2IoRegLockDepth()!=0)return false;
+    const auto session=find(memory);if(!session || !session->waitRuntime)return false;
+    PS2Runtime::GuestExecutionScope execution(session->waitRuntime);
+    if(session->waitRuntime->isStopRequested())return false;
+    bool progressed=false;unsigned retired=0;
+    // A burst cannot consume an unbounded VBlank/IRQ service interval. Original
+    // ordered prefixes remain owned; another wake services the rest.
+    constexpr unsigned ServiceBudget=32;
+    for(;retired<ServiceBudget;++retired) {
+        std::shared_ptr<WaitReceipt> receipt;
+        {std::lock_guard<std::recursive_mutex> guard(session->mutex);requireLive(*session);
+            if(session->waitReceipts.empty())break;receipt=session->waitReceipts.front();}
+        if(!receipt->request->ready())break;
+        std::vector<Retired> result;
+        try {result=receipt->request->wait();}
+        catch(...) {std::lock_guard<std::recursive_mutex> guard(session->mutex);session->failed=true;throw;}
+        {std::lock_guard<std::recursive_mutex> guard(session->mutex);requireLive(*session);
+            if(receipt->committed)continue;
+            if(session->waitReceipts.empty() || session->waitReceipts.front()!=receipt)
+                throw std::runtime_error("Ready completion overtook its immutable frontier");
+            try {validateWaitReceipt(*session,*receipt,result);}
+            catch(...) {session->failed=true;throw;}
+            receipt->committed=true;session->committedWaitCut=receipt->cut;session->waitReceipts.pop_front();progressed=true;}
+    }
+    std::vector<std::function<void()>> publish;bool moreReady=false;
+    {std::lock_guard<std::recursive_mutex> guard(session->mutex);requireLive(*session);
+        if(session->waitRuntime->isStopRequested()) {session->failed=true;throw std::runtime_error("Stopped owner cannot publish DMA success");}
+        for(auto it=session->waitPublications.begin();it!=session->waitPublications.end();) {
+            if(it->first<=session->committedWaitCut) {publish.push_back(std::move(it->second));it=session->waitPublications.erase(it);}
+            else ++it;
+        }
+        moreReady=!session->waitReceipts.empty() && session->waitReceipts.front()->request->ready();}
+    // FIFO status was validated under the Session mutex. Publish outside that
+    // mutex, under restored guest ownership and each callback's short IO scope.
+    for(auto &callback:publish)callback();
