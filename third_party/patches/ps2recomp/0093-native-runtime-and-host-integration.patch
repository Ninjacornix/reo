+#pragma once
+// Private command ABI shared by runtime and the same-Device backend adapter.
+// Raw upload/GS command metadata only. No CPU vertex, light or clip arithmetic.
+#include <array>
+#include "ordered_stream_hints.h"
+#include "opaque_lease_upload.hpp"
+#include <cstdint>
+#include <cstring>
