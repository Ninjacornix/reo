+// State must be disjoint from code/data before any specialized mutation.
+// Caller serializes MPG and excludes code changes/reentrant MPG during execution.
+// Unknown image/start, alias, size or active capture keeps the existing runtime.
+const Program* selectProgram(const uint8_t* code,uint32_t codeBytes,
+    const uint8_t* data,uint32_t dataBytes,uint32_t startPc,bool captureActive,const VU1State* state) noexcept;
+}
