+std::atomic<bool> s_retainedDumpConsumed{false};
+void captureRetainedDumpIfRequested(const RetainedLaunchFailure& r,uint32_t status) {
+    if(s_retainedDumpConsumed.load(std::memory_order_acquire))return;
+    const char* dir=std::getenv("REO_RETAINED_DUMP_DIR");
+    if(!dir || !*dir)return;
+    char path[512];
+    std::snprintf(path,sizeof(path),"%s/retained_ordinal_%llu_status_0x%02x.bin",dir,
+        static_cast<unsigned long long>(r.ordinal),status&0xffu);
