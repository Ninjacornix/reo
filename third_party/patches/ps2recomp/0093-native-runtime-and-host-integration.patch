+            const bool gifReg=physical>=0x10003000u&&physical<0x10003100u;
+            const bool gifDma=physical>=0x1000a000u&&physical<0x1000a090u;
+            const bool gsPriv=physical>=0x12000000u&&physical<0x12002000u;
