index 0000000..8bab312
--- /dev/null
+++ b/ps2xRuntime/src/lib/ipu/ps2_ipu_native.h
@@ -0,0 +1,45 @@
+#pragma once
+#include <cstdint>
+class PS2Runtime;
+
+// Internal, opt-in compressed transport for a genuine hardware-decoded movie.
+// This interface never publishes decoded bytes, frame completion or a DMA lie.
+namespace ps2_ipu_native {
+using Resolve=bool(*)(void* owner,uint32_t sourceAddress,uint32_t bytes,uint64_t& elementaryOffset);
+using Accept=bool(*)(void* owner,uint64_t generation,uint64_t dmaSerial,uint64_t elementaryOffset,
+                    uint32_t sourceAddress,const uint8_t* compressed,uint32_t bytes);
+struct Binding {
+    PS2Runtime* runtime=nullptr;
+    void* owner=nullptr;
+    uint64_t generation=0;
+    Resolve resolve=nullptr;
+    Accept accept=nullptr;
+};
+struct Cursor {uint64_t generation=0,elementaryBit=0,dmaSerial=0;};
+// Called by the actual EE owner outside the recursive IO lock. Callbacks run
+// inside that lock, may copy compressed transport/control only and must not
+// wait on the GS worker, acquire guest ownership, or execute graphics.
+void attach(PS2Runtime&,const Binding&);
+void detach(PS2Runtime&,void* owner,uint64_t generation);
+bool cursor(PS2Runtime&,void* owner,uint64_t generation,Cursor&);
+void thresholds(PS2Runtime&,void* owner,uint64_t generation,uint32_t& th0,uint32_t& th1);
+// Invoke only after the matching real GPU decoder completion. Bits, rather
+// than bytes, preserve the original 145B58 alignment/start-code convention.
+// False means genuine input/backpressure; real partial DMA progress is kept.
+bool advanceTo(PS2Runtime&,void* owner,uint64_t generation,uint64_t elementaryBit);
+// Runtime memory wrappers call this inside catch. Owned IPU failures must not
+// become a synthetic address exception followed by CPU decoder execution.
+void rethrowOwnedAccessFailure(PS2Runtime&,uint32_t guestAddress);
+
+// Implementation boundary; only ps2_memory.cpp calls these under its IO lock.
+namespace detail {
+bool hostMatches(const uint8_t* ram);
+bool ownsMemory(const uint8_t* ram);
+bool ownsRuntime(PS2Runtime&);
+void attachLocked(const Binding&);
+void detachLocked(PS2Runtime&,void*,uint64_t);
+bool cursorLocked(PS2Runtime&,void*,uint64_t,Cursor&);
+void thresholdsLocked(PS2Runtime&,void*,uint64_t,uint32_t&,uint32_t&);
+bool advanceToLocked(PS2Runtime&,void*,uint64_t,uint64_t);
+}
+}
