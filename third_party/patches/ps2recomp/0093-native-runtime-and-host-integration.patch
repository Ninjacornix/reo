@@ -0,0 +1,54 @@
+#include "vu_whole_program.h"
+#include "runtime/ps2_vu1.h"
+#include <atomic>
+#include <cstring>
+#include <limits>
+namespace vu_whole_program {
+namespace {
+std::atomic<const Table*> published{nullptr};
+bool disjoint(const uint8_t* a,uint32_t aBytes,const uint8_t* b,uint32_t bBytes) noexcept {
+    const auto x=reinterpret_cast<uintptr_t>(a),y=reinterpret_cast<uintptr_t>(b);
+    const auto maximum=std::numeric_limits<uintptr_t>::max();
+    return a&&b&&x<=maximum-aBytes&&y<=maximum-bBytes&&(x+aBytes<=y||y+bBytes<=x);
+}
+}
+bool registerProgramTable(const Table* table) noexcept {
+    if(!table||!table->count){published.store(nullptr,std::memory_order_release);return true;}
+    if(!table->programs||table->count>256u)return false;
+    for(uint32_t i=0;i<table->count;++i) {
+        const auto& program=table->programs[i];
+        // Generated baseline executor specializes16KiB code/data semantics.
+        if(!program.code||program.codeBytes!=16384u||program.dataBytes!=16384u||
+            !program.entryPcs||!program.entryCount||program.entryCount>2048u||!program.execute)return false;
+        uint32_t previous=0;
+        for(uint32_t j=0;j<program.entryCount;++j) {
+            const uint32_t pc=program.entryPcs[j];
+            if(pc>=program.codeBytes||(pc&7u)||(j&&pc<=previous))return false;
+            previous=pc;
+        }
+        // One descriptor owns all observed entries for an image, avoiding
+        // ambiguous duplicate keys or matching a cached subset of entries.
+        for(uint32_t j=0;j<i;++j)
+            if(std::memcmp(program.code,table->programs[j].code,program.codeBytes)==0)return false;
+    }
+    published.store(table,std::memory_order_release);return true;
+}
+uint32_t registeredProgramCount() noexcept {
+    const Table* table=published.load(std::memory_order_acquire);return table?table->count:0u;
+}
+const Program* selectProgram(const uint8_t* code,uint32_t codeBytes,
+    const uint8_t* data,uint32_t dataBytes,uint32_t startPc,bool captureActive,const VU1State* state) noexcept {
+    const Table* table=published.load(std::memory_order_acquire);
+    if(!table||captureActive||codeBytes!=16384u||dataBytes!=16384u||startPc>=codeBytes||(startPc&7u)||
+        !disjoint(code,codeBytes,data,dataBytes)||
+        !disjoint(reinterpret_cast<const uint8_t*>(state),sizeof(VU1State),code,codeBytes)||
+        !disjoint(reinterpret_cast<const uint8_t*>(state),sizeof(VU1State),data,dataBytes))return nullptr;
+    for(uint32_t i=0;i<table->count;++i) {
+        const auto& program=table->programs[i];
+        bool entry=false;
+        for(uint32_t j=0;j<program.entryCount;++j)entry|=program.entryPcs[j]==startPc;
+        if(entry&&std::memcmp(code,program.code,codeBytes)==0)return &program;
+    }
+    return nullptr;
+}
+}
