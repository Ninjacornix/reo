+    const bool vif=physical>=0x10003c00u && physical<0x10003e00u;
+    const bool dma=physical>=0x10009000u && physical<0x10009090u;
+    const bool bank=physical>=PS2_VU1_CODE_BASE && physical<PS2_VU1_DATA_BASE+DataBytes;
