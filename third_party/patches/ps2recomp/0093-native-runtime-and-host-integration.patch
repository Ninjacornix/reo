diff --git a/ps2xRuntime/src/lib/resident_fifo_reservation.h b/ps2xRuntime/src/lib/resident_fifo_reservation.h
new file mode 100644
index 0000000..e661eff
--- /dev/null
+++ b/ps2xRuntime/src/lib/resident_fifo_reservation.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <cstddef>
+namespace reo_resident_live {
+// One original 64MiB owned-input ceiling, partitioned only while wait-release
+// mode is requested. Resident jobs reserve FIFO order without a blocked parser.
+struct FifoReservation {
+    static constexpr size_t Total=64u*1024u*1024u;
+    static constexpr size_t Resident=16u*1024u*1024u;
+    static constexpr size_t Ordinary=Total-Resident;
+    static bool valid(size_t total,size_t resident)noexcept {return resident<=total && resident<=Resident && total<=Total;}
+    static bool residentRoom(size_t total,size_t resident,size_t bytes)noexcept {
+        return valid(total,resident) && bytes<=Resident-resident && bytes<=Total-total;
+    }
+    static bool ordinaryRoom(size_t total,size_t resident,size_t bytes)noexcept {
+        return valid(total,resident) && total-resident<=Ordinary && bytes<=Ordinary-(total-resident) && bytes<=Total-total;
+    }
+};
+} // namespace reo_resident_live
