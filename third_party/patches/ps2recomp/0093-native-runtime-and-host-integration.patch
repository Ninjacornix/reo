+    }catch(...){propagateOwnedFailure(currentRuntime());}
+}
+inline void* copyBytes(ContextAddress destination,const void* source,size_t bytes){
+    if(!source||bytes>destination.capacity)throw std::invalid_argument("Context copy escaped its exact destination");
+    // Field bit copies preserve raw FPR/VU payloads without a host float load.
+    auto* runtime=currentRuntime();if(!runtime)throw std::invalid_argument("Context copy lacks actual runtime");
+    try{const auto& target=selectedTarget(runtime->memory().getRDRAM());if(target&&(target->ownsAnySource()||target->readyForSelection())){
+        if(currentContext()!=destination.ctx||!ps2ActualGuestExecutionDepth(runtime))throw OwnedSourceFailure("Context ingress lacks actual source scope");
+        auto* typed=accessCache.typed;auto* exact=accessCache.exact;if(!typed||!exact)throw OwnedSourceFailure("Context RAW ingress lacks actual typed issuer");
+        const uint32_t pc=destination.ctx->pc;auto origin=actualInstructionOrigin;SourceWritePermit permit;
+        if(actualInstructionInputs&&origin.pc&&accessCache.cpuInputs){auto inputs=actualInstructionInputs->capture(*destination.ctx,origin,target);permit=accessCache.cpuInputs->beginGuardedCpuContextWrite(*destination.ctx,inputs,destination.offset,source,uint32_t(bytes),origin);}
+        else permit=typed->beginTypedSourceWrite(SourceSpace::Context,destination.offset,source,uint32_t(bytes),destination.ctx,pc,origin);if(!permit)throw OwnedSourceFailure("Context ingress permit missing");
+        try{exact->authorizeSourceWrite(permit,SourceSpace::Context,destination.offset,source,uint32_t(bytes),destination.ctx,pc);std::memcpy(reinterpret_cast<uint8_t*>(destination.ctx)+destination.offset,permit->data(),bytes);exact->finishSourceWrite(permit,SourceSpace::Context,destination.offset,destination.ctx,pc);}catch(...){exact->abandonSourceWrite(permit);throw;}
+    }else std::memcpy(reinterpret_cast<uint8_t*>(destination.ctx)+destination.offset,source,bytes);return reinterpret_cast<uint8_t*>(destination.ctx)+destination.offset;
+    }catch(...){propagateOwnedFailure(runtime);}
+}
+inline void* copyBytes(ContextAddress destination,ContextAddress source,size_t bytes){std::vector<uint8_t> captured(bytes);copyBytes(captured.data(),source,bytes);return copyBytes(destination,captured.data(),bytes);}
+struct PointerView {bool source=false;SourceSpace space=SourceSpace::Ram;uint32_t at=0;};
+inline PointerView actualPointerView(const std::shared_ptr<ControlTarget>& target,R5900Context* ctx,const void* pointer,size_t bytes){
+    const auto at=reinterpret_cast<uintptr_t>(pointer);
+    if(bytes>UINTPTR_MAX-at)throw OwnedSourceFailure("Native transfer address interval overflow");
+    const std::array<std::pair<const void*,uint32_t>,3> banks{{{target->ramIdentity(),0x2000000u},{target->sprIdentity(),0x4000u},{ctx,1648u}}};
+    for(unsigned bank=0;bank<3;++bank){if(!banks[bank].first)continue;const auto base=reinterpret_cast<uintptr_t>(banks[bank].first);if(at>=base&&at-base<banks[bank].second){if(bytes>banks[bank].second-(at-base))throw OwnedSourceFailure("Native copy crosses actual bank");return {true,SourceSpace(bank),uint32_t(at-base)};}if(at<base&&bytes>base-at)throw OwnedSourceFailure("Native host copy overlaps an actual source bank");}
+    return {};
+}
+inline void invalidatePreEntryHostDestination(const void* ram,void* destination,size_t bytes){
+    if(!ram||!destination||!bytes||!actualFirstEntryEnrollmentRequested())return;
+    const auto base=reinterpret_cast<uintptr_t>(ram),at=reinterpret_cast<uintptr_t>(destination);
+    if(bytes>UINTPTR_MAX-at)throw std::out_of_range("Pre-entry host copy address overflow");
+    const auto begin=std::max(base,at),end=std::min(base+uintptr_t(0x2000000u),at+bytes);
+    if(begin<end)invalidateActualPreEntryControlBytes(ram,uint32_t(begin-base),uint32_t(end-begin));
+}
+inline void* copyBytes(void* destination,const void* source,size_t bytes){
+    auto* runtime=currentRuntime();auto* ctx=currentContext();
+    try{
+        const auto& target=runtime?selectedTarget(runtime->memory().getRDRAM()):selectedTarget(nullptr);
+        if(!target||(!target->ownsAnySource()&&!target->readyForSelection())){invalidatePreEntryHostDestination(runtime?runtime->memory().getRDRAM():nullptr,destination,bytes);return std::memcpy(destination,source,bytes);}
+        if(!bytes)return destination;
+        const auto src=actualPointerView(target,ctx,source,bytes),dst=actualPointerView(target,ctx,destination,bytes);
+        if(!src.source&&!dst.source)return std::memcpy(destination,source,bytes);
+        if(!ctx||!ps2ActualGuestExecutionDepth(runtime)||!destination||!source||bytes>1024u*1024u)throw OwnedSourceFailure("Native transfer lacks bounded actual source lease");
+        if(src.source)target->read(src.space,src.at,uint32_t(bytes),ctx,ctx->pc);
+        std::vector<uint8_t> capture(static_cast<const uint8_t*>(source),static_cast<const uint8_t*>(source)+bytes);
+        if(dst.source){auto* typed=accessCache.typed;auto* exact=accessCache.exact;if(!typed||!exact)throw OwnedSourceFailure("Native transfer lacks actual typed writer");auto origin=actualInstructionOrigin;origin.intent=ContextWriteIntent::ReviewedRawIngress;
+            const uint32_t pc=ctx->pc;auto permit=typed->beginTypedSourceWrite(dst.space,dst.at,capture.data(),uint32_t(bytes),ctx,pc,origin);if(!permit)throw OwnedSourceFailure("Native transfer permit missing");try{exact->authorizeSourceWrite(permit,dst.space,dst.at,capture.data(),uint32_t(bytes),ctx,pc);std::memcpy(destination,permit->data(),bytes);exact->finishSourceWrite(permit,dst.space,dst.at,ctx,pc);}catch(...){exact->abandonSourceWrite(permit);throw;}}
+        else std::memcpy(destination,capture.data(),bytes);return destination;
