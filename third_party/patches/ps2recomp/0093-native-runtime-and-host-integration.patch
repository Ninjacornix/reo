+#pragma once
+#include "parent_context_lifecycle.h"
+#include "parent_source_failure.h"
+#include "tools/parallel_gs_backend/resident_geometry/explicit_source_write.hpp"
+#include "ps2_syscalls.h"
+#include "ps2_stubs.h"
+#include <array>
+#include <limits>
+namespace ps2_syscalls {bool dispatchNumericSyscall(uint32_t,uint8_t*,R5900Context*,PS2Runtime*);}
+namespace reo_source_instrumentation {class EntryScope;}
+namespace reo_parent_natural {
+enum class NativeRoutine:uint32_t {Abs=1,Rand,Srand,GetThreadId,EndOfHeap,GetMemorySize};
+enum class NativeReturnRole:uint32_t {Integer=1,KernelControl=2,GuestPointer=3};
+struct NativeReadWitness {SourceSpace space;uint32_t offset,bytes;};
+class NativeInvocationScope;
+class NativeDispatchScope;
+inline thread_local NativeInvocationScope* actualNativeInvocation=nullptr;
+inline thread_local NativeDispatchScope* actualNativeDispatch=nullptr;
+struct NativeInvocationLife final {bool active=true;};
+inline PS2Runtime::RecompiledFunction nativeRoutineFunction(NativeRoutine routine){
+    switch(routine){
+    case NativeRoutine::Abs:return &ps2_stubs::abs;
+    case NativeRoutine::Rand:return &ps2_stubs::rand;
+    case NativeRoutine::Srand:return &ps2_stubs::srand;
+    case NativeRoutine::GetThreadId:return &ps2_syscalls::GetThreadId;
+    case NativeRoutine::EndOfHeap:return &ps2_syscalls::EndOfHeap;
+    case NativeRoutine::GetMemorySize:return &ps2_syscalls::GetMemorySize;
+    }throw std::invalid_argument("Unreviewed native routine has no scalar return contract");
+}
+class NativeDispatchScope final {
+    friend bool ps2_syscalls::dispatchNumericSyscall(uint32_t,uint8_t*,R5900Context*,PS2Runtime*);
+    PS2Runtime* runtime_;R5900Context* context_;PS2Runtime::RecompiledFunction function_;
+    NativeDispatchScope* prior_;uint32_t number_,pc_;int32_t task_;std::thread::id thread_;bool active_=false;
+    NativeDispatchScope(PS2Runtime& runtime,R5900Context& context,uint32_t number,PS2Runtime::RecompiledFunction function,const std::shared_ptr<ControlTarget>& target)
+      :runtime_(&runtime),context_(&context),function_(function),prior_(actualNativeDispatch),number_(number),pc_(context.pc),
+       task_(ps2_sched::currentThread()),thread_(std::this_thread::get_id()){
+        if(!target||(!target->ownsAnySource()&&!target->readyForSelection()))return;
+        try{
+        if(currentRuntime()!=runtime_||currentContext()!=context_||!ps2ActualGuestExecutionDepth(runtime_)||runtime_->isStopRequested()||target->runtimeIdentity()!=runtime_)
+            throw std::invalid_argument("Native syscall dispatch lacks actual guest execution");
+        // Only these genuine switch arms construct this private record.
+        if(!((function==&ps2_syscalls::GetThreadId&&(number==0x2fu||number==uint32_t(-0x2f)))||
+             (function==&ps2_syscalls::EndOfHeap&&number==0x3eu)))
+            throw std::invalid_argument("Native dispatch record is outside reviewed actual switch arms");
+        actualNativeDispatch=this;active_=true;
+        }catch(...){throwOwnedSourceFailure(runtime_);}
+    }
+public:
+    NativeDispatchScope(const NativeDispatchScope&)=delete;
+    ~NativeDispatchScope(){if(active_)actualNativeDispatch=prior_;}
+    bool matches(PS2Runtime& runtime,R5900Context& context,PS2Runtime::RecompiledFunction function,uint32_t pc)const noexcept{
+        return actualNativeDispatch==this&&runtime_==&runtime&&context_==&context&&function_==function&&pc_==pc&&
+            task_==ps2_sched::currentThread()&&thread_==std::this_thread::get_id();
+    }
+    uint32_t number()const noexcept{return number_;}
+};
+class NativeControlReturn final {
+    friend class NativeInvocationScope;
+    std::shared_ptr<ControlTarget> target_;std::shared_ptr<const NativeInvocationLife> life_;
+    PS2Runtime* runtime_;R5900Context* context_;NativeRoutine routine_;NativeReturnRole role_;
+    uint64_t epoch_,binding_;uint32_t entryPc_,dispatchNumber_,bytes_;
+    int32_t task_;std::thread::id thread_;PS2Runtime::RecompiledFunction function_;
+    std::array<NativeReadWitness,8> reads_{};uint32_t readCount_;
+    std::array<uint8_t,32> value_{};
+    mutable bool claimed_=false;
+    NativeControlReturn(const NativeInvocationScope&,const void*,uint32_t);
+public:
+    NativeControlReturn(const NativeControlReturn&)=delete;
+    PS2Runtime& runtime()const noexcept{return *runtime_;}
+    R5900Context& context()const noexcept{return *context_;}
+    const ControlTarget* issuerTarget()const noexcept{return target_.get();}
+    NativeRoutine routine()const noexcept{return routine_;}
+    NativeReturnRole role()const noexcept{return role_;}
+    uint64_t epoch()const noexcept{return epoch_;}
+    uint64_t bindingGeneration()const noexcept{return binding_;}
+    uint32_t entryPc()const noexcept{return entryPc_;}
+    uint32_t dispatchNumber()const noexcept{return dispatchNumber_;}
+    uint32_t bytes()const noexcept{return bytes_;}
+    const void* data()const noexcept{return value_.data();}
+    uint32_t readCount()const noexcept{return readCount_;}
+    const NativeReadWitness& read(uint32_t index)const{if(index>=readCount_)throw std::out_of_range("Native read witness");return reads_[index];}
+    void validateBeforeActualNativeStore(const ControlTarget&,R5900Context&,uint32_t,const void*,uint32_t)const;
+    void claimBeforeActualNativeStore(const ControlTarget& target,R5900Context& context,uint32_t offset,const void* data,uint32_t bytes)const{
+        validateBeforeActualNativeStore(target,context,offset,data,bytes);
+        if(claimed_)throw std::invalid_argument("Native scalar return event already consumed");claimed_=true;
+    }
+};
+using NativeControlReturnHandle=std::shared_ptr<const NativeControlReturn>;
+class NativeControlWriteTarget {
+public:virtual ~NativeControlWriteTarget()=default;
+    virtual SourceWritePermit beginAuthenticatedNativeControlWrite(R5900Context&,const NativeControlReturnHandle&,uint32_t,const void*,uint32_t)=0;
+};
+class NativeInvocationScope final {
+    friend class NativeControlReturn;
+    friend void ps2_stubs::abs(uint8_t*,R5900Context*,PS2Runtime*);
+    friend void ps2_stubs::rand(uint8_t*,R5900Context*,PS2Runtime*);
+    friend void ps2_stubs::srand(uint8_t*,R5900Context*,PS2Runtime*);
+    friend void ps2_syscalls::GetThreadId(uint8_t*,R5900Context*,PS2Runtime*);
+    friend void ps2_syscalls::EndOfHeap(uint8_t*,R5900Context*,PS2Runtime*);
+    friend void ps2_syscalls::GetMemorySize(uint8_t*,R5900Context*,PS2Runtime*);
+    std::shared_ptr<ControlTarget> target_;std::shared_ptr<NativeInvocationLife> life_;
+    PS2Runtime* runtime_;R5900Context* context_;NativeRoutine routine_;NativeReturnRole role_;
+    NativeInvocationScope* prior_;NativeDispatchScope* dispatch_=nullptr;
+    PS2Runtime::RecompiledFunction function_;uint64_t epoch_=0,binding_=0;
+    uint32_t entryPc_=0,dispatchNumber_=0;int32_t task_=0;std::thread::id thread_;
+    std::array<NativeReadWitness,8> reads_{};uint32_t readCount_=0;bool returned_=false;
+    NativeInvocationScope(PS2Runtime* runtime,R5900Context* context,NativeRoutine routine,const std::shared_ptr<ControlTarget>& target)
+      :target_(target),runtime_(runtime),context_(context),routine_(routine),
+       role_(routine==NativeRoutine::EndOfHeap?NativeReturnRole::GuestPointer:
+             routine==NativeRoutine::GetThreadId||routine==NativeRoutine::GetMemorySize?NativeReturnRole::KernelControl:NativeReturnRole::Integer),
+       prior_(actualNativeInvocation),function_(nativeRoutineFunction(routine)),thread_(std::this_thread::get_id()){
+        if(!target_||(!target_->ownsAnySource()&&!target_->readyForSelection())){target_.reset();return;}
+        try{
+        if(!runtime_||!context_||target_->runtimeIdentity()!=runtime_||currentRuntime()!=runtime_||currentContext()!=context_||
+           !ps2ActualGuestExecutionDepth(runtime_)||runtime_->isStopRequested())throw std::invalid_argument("Native body lacks actual selected guest invocation");
+        target_->requireHealthy();target_->read(SourceSpace::Context,offsetof(R5900Context,pc),4,context_,context_->pc);
+        entryPc_=context_->pc;epoch_=target_->epoch();binding_=actualOwnerBindingGeneration();task_=ps2_sched::currentThread();
+        if(task_<1)throw std::invalid_argument("Native body lacks actual guest task");
+        if(actualNativeDispatch&&actualNativeDispatch->matches(*runtime_,*context_,function_,entryPc_)){
+            dispatch_=actualNativeDispatch;dispatchNumber_=dispatch_->number();
+        }else if(runtime_->lookupFunction(entryPc_)!=function_)throw std::invalid_argument("Native body differs from actual registered entry function");
+        life_=std::make_shared<NativeInvocationLife>();actualNativeInvocation=this;
+        }catch(...){throwOwnedSourceFailure(runtime_);}
+    }
+    void validate()const{
+        if(!target_||!life_||!life_->active||actualNativeInvocation!=this||currentRuntime()!=runtime_||currentContext()!=context_||
+           !ps2ActualGuestExecutionDepth(runtime_)||runtime_->isStopRequested()||context_->pc!=entryPc_||
+           target_->epoch()!=epoch_||actualOwnerBindingGeneration()!=binding_||ps2_sched::currentThread()!=task_||thread_!=std::this_thread::get_id())
+            throw std::invalid_argument("Stale/foreign native source invocation");
+        target_->requireHealthy();
+        if(dispatch_){if(actualNativeDispatch!=dispatch_||!dispatch_->matches(*runtime_,*context_,function_,entryPc_))throw std::invalid_argument("Native numeric dispatch ended before return");}
+        else if(runtime_->lookupFunction(entryPc_)!=function_)throw std::invalid_argument("Actual native function binding changed before return");
+    }
+public:
+    NativeInvocationScope(const NativeInvocationScope&)=delete;
+    ~NativeInvocationScope(){if(life_)life_->active=false;if(target_)actualNativeInvocation=prior_;}
+    void guardedRead(ControlTarget& target,R5900Context& context,SourceSpace space,uint32_t offset,uint32_t bytes){
+        validate();if(&target!=target_.get()||&context!=context_||returned_)throw std::invalid_argument("Native read differs from actual invocation");
+        // These six pinned bodies have no guest-memory input. Only abs/srand
+        // read a0.low32; EndOfHeap's null-runtime fallback is not selected.
+        if(space!=SourceSpace::Context||offset!=64u||bytes!=4u||
+           (routine_!=NativeRoutine::Abs&&routine_!=NativeRoutine::Srand))
+            throw std::invalid_argument("Native body read exceeds its complete reviewed input set");
+        if(readCount_==reads_.size())throw std::length_error("Native input witness exhausted");
+        reads_[readCount_++]={space,offset,bytes};
+    }
+    NativeControlReturnHandle captureReturn(R5900Context& context,const void* bytes,uint32_t count){
+        validate();if(&context!=context_||returned_||count!=16u||!bytes)throw std::invalid_argument("Native return differs from reviewed U32 architectural result");
+        if((routine_==NativeRoutine::Abs||routine_==NativeRoutine::Srand)&&readCount_!=1u)throw std::invalid_argument("Native result lacks its guarded actual a0 read");
+        // Allocation completes before any CPU result mutation or permit issue.
+        auto result=NativeControlReturnHandle(new NativeControlReturn(*this,bytes,count));returned_=true;return result;
+    }
+};
+inline NativeControlReturn::NativeControlReturn(const NativeInvocationScope& source,const void* data,uint32_t bytes)
+ :target_(source.target_),life_(source.life_),runtime_(source.runtime_),context_(source.context_),routine_(source.routine_),role_(source.role_),
+  epoch_(source.epoch_),binding_(source.binding_),entryPc_(source.entryPc_),dispatchNumber_(source.dispatchNumber_),bytes_(bytes),task_(source.task_),
+  thread_(source.thread_),function_(source.function_),reads_(source.reads_),readCount_(source.readCount_){std::memcpy(value_.data(),data,bytes);}
+inline void NativeControlReturn::validateBeforeActualNativeStore(const ControlTarget& target,R5900Context& context,uint32_t offset,const void* data,uint32_t bytes)const{
+    if(!actualNativeInvocation||!life_||!life_->active||&target!=target_.get()||&context!=context_||offset!=32u||bytes!=bytes_||!data||
+       std::memcmp(data,value_.data(),bytes)||currentRuntime()!=runtime_||currentContext()!=context_||context_->pc!=entryPc_||
+       !ps2ActualGuestExecutionDepth(runtime_)||runtime_->isStopRequested()||target.epoch()!=epoch_||actualOwnerBindingGeneration()!=binding_||
+       ps2_sched::currentThread()!=task_||std::this_thread::get_id()!=thread_)
+        throw std::invalid_argument("Native scalar permit is stale/substituted/foreign to its actual body return");
+    actualNativeInvocation->validate();
+    if(actualNativeInvocation->life_.get()!=life_.get()||actualNativeInvocation->function_!=function_||!actualNativeInvocation->returned_)
+        throw std::invalid_argument("Native scalar event belongs to another invocation");
+}
+inline void recordNativeGuardedRead(ControlTarget& target,R5900Context& context,SourceSpace space,uint32_t offset,uint32_t bytes){
+    if(actualNativeInvocation)actualNativeInvocation->guardedRead(target,context,space,offset,bytes);
+}
+// Only source delivery. The authoritative ledger/immutable permit receiver,
+// whole native catalogue and numerical routing still require their own proof.
+inline constexpr bool CompleteNativeScalarCatalogue=false;
+}
diff --git a/ps2xRuntime/src/lib/native_movie_batch.h b/ps2xRuntime/src/lib/native_movie_batch.h
new file mode 100644
index 0000000..bb23f80
--- /dev/null
+++ b/ps2xRuntime/src/lib/native_movie_batch.h
@@ -0,0 +1,36 @@
+#pragma once
+#include "native_movie_image.h"
+#include <cstring>
+namespace reo_native_movie {
+// Parse command metadata only; no pixels, vertices or numerical shadows.
+// One admitted span is a complete literal HOST->LOCAL GIF transfer stream.
+inline bool batchableTransferChain(const std::vector<ImageChainPiece>& pieces){
+    std::shared_ptr<PreparedImage> leader;uint32_t adRemaining=0;uint64_t imageRemaining=0;size_t images=0;
+    for(const auto& piece:pieces){
+        if(piece.image){
+            if(!piece.control.empty()||adRemaining||!imageRemaining||!piece.image->bytes()||(piece.image->bytes()&15u)||piece.image->bytes()>imageRemaining)return false;
+            if(!leader){leader=piece.image;if(!leader->canBatchWith(*leader))return false;}
+            else if(leader->epoch()!=piece.image->epoch()||!leader->canBatchWith(*piece.image))return false;
+            imageRemaining-=piece.image->bytes();++images;continue;
+        }
+        if(piece.control.size()&15u)return false;
+        for(size_t offset=0;offset<piece.control.size();offset+=16u){
+            if(imageRemaining)return false;
+            uint64_t low=0,high=0;std::memcpy(&low,piece.control.data()+offset,8);std::memcpy(&high,piece.control.data()+offset+8,8);
+            if(adRemaining){
+                // Original uploader uses TEXFLUSH, BITBLTBUF, TRXPOS, TRXREG
+                // and HOST->LOCAL TRXDIR. No draw, texture read or event allowed.
+                if(high!=0x50u&&high!=0x51u&&high!=0x52u&&high!=0x53u&&!(high==0x3fu&&images==0))return false;
+                if(high==0x53u&&low!=0)return false;
+                --adRemaining;continue;
+            }
+            const auto loops=uint32_t(low&0x7fffu),kind=uint32_t((low>>58u)&3u);
+            if(low&(uint64_t(1)<<46u))return false;
+            if(kind==2u){if(!loops)return false;imageRemaining=uint64_t(loops)*16u;}
+            else if(kind==0u){if(((low>>60u)&15u)!=1u||high!=0xeu)return false;adRemaining=loops;}
+            else return false;
+        }
+    }
+    return images>1u&&!adRemaining&&!imageRemaining;
+}
+}
diff --git a/ps2xRuntime/src/lib/native_movie_image.h b/ps2xRuntime/src/lib/native_movie_image.h
new file mode 100644
index 0000000..808b747
--- /dev/null
+++ b/ps2xRuntime/src/lib/native_movie_image.h
@@ -0,0 +1,56 @@
+#pragma once
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <vector>
+#include <stdexcept>
+class PS2Runtime;
+class PS2Memory;
+class GifArbiter;
+namespace reo_movie_owner { class Target; }
+namespace reo_native_movie {
+enum class Ownership { Unowned,Owned,Stale };
+class PreparedImage {
+public:
+    virtual ~PreparedImage()=default;
+    virtual uint64_t epoch()const noexcept=0;
+    virtual uint32_t bytes()const noexcept=0;
+    // Actual GS worker only; must wait the real fragment consumer fence.
+    virtual void consume(reo_movie_owner::Target&)=0;
+    // Batch support is optional and restricted to one source-qualified picture
+    // in one actual GS FIFO closure. Legacy strict consumption remains valid.
+    virtual bool canBatchWith(const PreparedImage&)const noexcept{return false;}
+    virtual size_t retainedBytes()const noexcept{return sizeof(PreparedImage);}
+    virtual void beginBatch(reo_movie_owner::Target&){throw std::logic_error("Movie IMAGE has no GPU batch support");}
+    virtual void consumeBatched(reo_movie_owner::Target&){throw std::logic_error("Movie IMAGE has no GPU batch recorder");}
+    virtual void endBatch(reo_movie_owner::Target&){throw std::logic_error("Movie IMAGE has no GPU batch completion");}
+
+};
+// sourceEvent is the monotonic actual GIF source-fragment receipt, not a
+// fabricated PS2 hardware DMA counter. Runtime owns DMA completion separately.
+using Lookup=Ownership(*)(PS2Runtime&,uint64_t sourceEvent,uint32_t source,uint32_t bytes,std::shared_ptr<PreparedImage>&);
+void installImageProvider(PS2Runtime&,Lookup);
+void bindImageArbiter(PS2Runtime&,PS2Memory&,GifArbiter&);
+void releaseImageProviderAfterGsJoin(PS2Runtime&)noexcept;
+struct ImageChainPiece {std::vector<uint8_t> control;std::shared_ptr<PreparedImage> image;};
+class Chain {
+    using Piece=ImageChainPiece;
+    std::vector<Piece> pieces_;
+    size_t ordinaryBegin_=0;
+    void flush(const std::vector<uint8_t>&);
+public:
+    bool append(PS2Memory&,uint32_t source,uint32_t bytes,bool scratch,const std::vector<uint8_t>&);
+    bool hasImages()const noexcept{return !pieces_.empty();}
+    void bind(PS2Memory&,std::vector<uint8_t>&);
+};
+bool submitChain(PS2Memory&,const uint8_t* identity);
+bool submitDirect(PS2Memory&,uint32_t source,uint32_t bytes,bool masked=false);
+uint64_t submitted(PS2Memory&)noexcept;
+bool ownsDma(PS2Memory&)noexcept;
+void queueDmaPublication(PS2Memory&,std::function<void()>,bool finalTag);
+// Existing FIFO implementation; enqueue never waits while IO is held.
+void queueImage(std::shared_ptr<PreparedImage>);
+void queueImageBatch(std::shared_ptr<const std::vector<ImageChainPiece>>);
+void queuePublication(uint64_t,std::function<void()>);
+void rethrowOwnedAccessFailure(PS2Runtime&,uint32_t address);
+}
diff --git a/ps2xRuntime/src/lib/native_movie_image.inl b/ps2xRuntime/src/lib/native_movie_image.inl
new file mode 100644
index 0000000..901c2ce
--- /dev/null
+++ b/ps2xRuntime/src/lib/native_movie_image.inl
@@ -0,0 +1,122 @@
+// Included by ps2_memory.cpp; no public Runtime/Memory/GifArbiter layout change.
+#include "native_movie_image.h"
+#include "native_movie_batch.h"
+#include "resident_gif_sidecar.h"
+#include "gs_priv_atomic.h"
+#include "ps2_runtime.h"
+#include <map>
+namespace reo_native_movie {
+void publishWithActualIoLock(const std::function<void()>&);
+namespace {
+using Dispatch=std::function<void(GifArbiter&)>;
+struct Binding {
+    PS2Runtime* runtime=nullptr;GifArbiter* arbiter=nullptr;Lookup lookup=nullptr;
+    uint64_t nextSourceEvent=0,submissions=0,epoch=0;std::atomic<bool> activeDma{false};
+    std::map<const void*,Dispatch> chains;
+    std::function<void()> pendingPublication;
+};
+std::mutex imageBindingsMutex;
+std::map<PS2Memory*,std::shared_ptr<Binding>> imageBindings;
+std::shared_ptr<Binding> imageBinding(PS2Memory& memory) {
+    std::lock_guard<std::mutex> lock(imageBindingsMutex);
+    auto found=imageBindings.find(&memory);return found==imageBindings.end()?nullptr:found->second;
+}
+std::shared_ptr<PreparedImage> prepare(PS2Memory& memory,uint32_t source,uint32_t bytes) {
+    auto binding=imageBinding(memory);if(!binding||!binding->lookup)return {};
+    std::shared_ptr<PreparedImage> image;
+    const auto ownership=binding->lookup(*binding->runtime,++binding->nextSourceEvent,source,bytes,image);
+    if(ownership==Ownership::Unowned) {if(image)throw std::logic_error("Unowned movie source returned an image");return {};}
+    if(ownership!=Ownership::Owned||!image||image->bytes()!=bytes||!image->epoch()||image->epoch()!=gsPrivCurrentEpoch())
+        throw std::runtime_error("Original GIF source touches a stale or invalid GPU movie output");
+    return image;
+}
+void noteSubmitted(const std::shared_ptr<Binding>& binding,uint64_t epoch) {
+    if(!binding||!binding->arbiter||!epoch)throw std::logic_error("Movie source has no actual arbiter binding");
+    if(binding->activeDma)throw std::runtime_error("Original GIF DMA restarted before its real movie consumer fence");
+    binding->epoch=epoch;binding->activeDma=true;++binding->submissions;
+}
+}
+void bindImageArbiter(PS2Runtime& runtime,PS2Memory& memory,GifArbiter& arbiter) {
+    const char* enabled=std::getenv("REO_GPU_MOVIE");if(!enabled||std::atoi(enabled)==0)return;
+    std::lock_guard<std::mutex> lock(imageBindingsMutex);
+    auto& binding=imageBindings[&memory];if(!binding)binding=std::make_shared<Binding>();
+    if(binding->runtime&&binding->runtime!=&runtime)throw std::logic_error("Movie arbiter belongs to a different Runtime");
+    if(binding->arbiter==&arbiter)return;
+    if(binding->arbiter)throw std::runtime_error("Movie arbiter replaced before a real joined teardown");
+    reo_resident_live::armArbiter(arbiter);binding->runtime=&runtime;binding->arbiter=&arbiter;
+}
+void installImageProvider(PS2Runtime& runtime,Lookup lookup) {
+    if(!lookup)throw std::invalid_argument("Missing original movie IMAGE source provider");
+    std::lock_guard<std::mutex> lock(imageBindingsMutex);
+    auto& binding=imageBindings[&runtime.memory()];if(!binding)binding=std::make_shared<Binding>();
+    if(binding->lookup||binding->runtime&&binding->runtime!=&runtime)throw std::logic_error("Original movie source provider already installed");
+    binding->runtime=&runtime;binding->lookup=lookup;
+}
+void releaseImageProviderAfterGsJoin(PS2Runtime& runtime)noexcept {
+    std::lock_guard<std::mutex> lock(imageBindingsMutex);auto found=imageBindings.find(&runtime.memory());
+    if(found==imageBindings.end())return;
+    if(found->second->arbiter)reo_resident_live::disarmArbiter(*found->second->arbiter);
+    imageBindings.erase(found);
+}
+void Chain::flush(const std::vector<uint8_t>& bytes) {
+    if(bytes.size()>ordinaryBegin_)pieces_.push_back({{bytes.begin()+ordinaryBegin_,bytes.end()},nullptr});
+    ordinaryBegin_=bytes.size();
+}
+bool Chain::append(PS2Memory& memory,uint32_t source,uint32_t bytes,bool scratch,const std::vector<uint8_t>& controls) {
+    if(scratch)return false;
+    auto image=prepare(memory,source,bytes);if(!image)return false;
+    flush(controls);pieces_.push_back({{},std::move(image)});return true;
+}
+void Chain::bind(PS2Memory& memory,std::vector<uint8_t>& controls) {
+    if(!hasImages())return;flush(controls);if(controls.empty())controls.reserve(1);
+    auto binding=imageBinding(memory);uint64_t epoch=0;
+    for(const auto& piece:pieces_)if(piece.image){if(epoch&&epoch!=piece.image->epoch())throw std::runtime_error("One original GIF chain crosses movie epochs");epoch=piece.image->epoch();}
+    bool beginsImage=!pieces_.empty()&&bool(pieces_.front().image);
+    if(!pieces_.empty()&&pieces_.front().control.size()>=16) {
+        uint64_t tag=0;std::memcpy(&tag,pieces_.front().control.data(),8);
+        beginsImage=((tag>>58u)&3u)==2u;
+    }
+    auto pieces=std::make_shared<std::vector<Piece>>(std::move(pieces_));
+    if(!binding||!binding->chains.emplace(controls.data(),[pieces,beginsImage,binding,epoch](GifArbiter& arbiter){
+        noteSubmitted(binding,epoch);
+        reo_resident_live::submitMoviePath3(arbiter,beginsImage,[pieces](const std::function<void(const uint8_t*,uint32_t)>& raw){
+            if(batchableTransferChain(*pieces)){queueImageBatch(pieces);return;}
+            for(const auto& piece:*pieces) {
+                if(piece.image)queueImage(piece.image);
+                else if(!piece.control.empty())raw(piece.control.data(),uint32_t(piece.control.size()));
+            }
+        });
+    }).second)throw std::logic_error("Duplicate original movie chain allocation identity");
+}
+bool submitChain(PS2Memory& memory,const uint8_t* identity) {
+    auto binding=imageBinding(memory);if(!binding)return false;
+    auto found=binding->chains.find(identity);if(found==binding->chains.end())return false;
+    auto dispatch=std::move(found->second);binding->chains.erase(found);dispatch(*binding->arbiter);return true;
+}
+bool submitDirect(PS2Memory& memory,uint32_t source,uint32_t bytes,bool masked) {
+    auto image=prepare(memory,source,bytes);if(!image)return false;
+    if(masked)throw std::runtime_error("Owned movie IMAGE cannot lose source identity in masked PATH3 storage");
+    auto binding=imageBinding(memory);noteSubmitted(binding,image->epoch());
+    reo_resident_live::submitMoviePath3(*binding->arbiter,true,[image](const std::function<void(const uint8_t*,uint32_t)>&){queueImage(image);});return true;
+}
+uint64_t submitted(PS2Memory& memory)noexcept {auto binding=imageBinding(memory);return binding?binding->submissions:0;}
+bool ownsDma(PS2Memory& memory)noexcept {auto binding=imageBinding(memory);return binding&&binding->activeDma;}
+void queueDmaPublication(PS2Memory& memory,std::function<void()> publication,bool finalTag) {
+    auto binding=imageBinding(memory);if(!binding||!binding->activeDma||!publication)throw std::logic_error("No original movie DMA publication owner");
+    if(!finalTag) {
+        if(binding->pendingPublication)throw std::logic_error("Original movie DMA has duplicate completion publication");
+        binding->pendingPublication=std::move(publication);return;
+    }
+    auto channels=std::move(binding->pendingPublication);
+    if(!channels)throw std::logic_error("Original movie DMA final tag preceded its channel publication");
+    queuePublication(binding->epoch,[binding,channels=std::move(channels),publication=std::move(publication)]{
+        publishWithActualIoLock([&]{channels();publication();binding->activeDma=false;});
+    });
+}
+void rethrowOwnedAccessFailure(PS2Runtime& runtime,uint32_t address) {
+    const uint32_t physical=address&0x1fffffffu;
+    if(physical<0x1000a000u||physical>=0x1000a100u)return;
+    auto binding=imageBinding(runtime.memory());if(!binding||!binding->lookup)return;
+    runtime.requestStop();throw;
+}
+}
diff --git a/ps2xRuntime/src/lib/native_movie_owner.h b/ps2xRuntime/src/lib/native_movie_owner.h
new file mode 100644
index 0000000..4132a39
