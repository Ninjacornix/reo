@@ -0,0 +1,44 @@
+#pragma once
+#include "parent_context_lifecycle.h"
+#include <array>
+#include <cstring>
+namespace ps2_syscalls {void dispatchDmacHandlersForCause(uint8_t*,PS2Runtime*,uint32_t);}
+namespace reo_parent_natural {
+class IrqInitializer final {
+    friend void ps2_syscalls::dispatchDmacHandlersForCause(uint8_t*,PS2Runtime*,uint32_t);
+    PS2Runtime* runtime_;uint8_t* ram_;int32_t task_;std::thread::id hostThread_;
+    uint32_t registration_,handler_,cause_,gp_,argument_,stackTop_;
+    PS2Runtime::RecompiledFunction originalStep_;
+    std::shared_ptr<GuestContextStorage> storage_;std::array<uint8_t,sizeof(R5900Context)> initialImage_{};
+    IrqInitializer(PS2Runtime& runtime,uint8_t* ram,uint32_t registration,uint32_t handler,uint32_t cause,
+        uint32_t gp,uint32_t argument,uint32_t stackTop)
+      :runtime_(&runtime),ram_(ram),task_(ps2_sched::currentThread()),hostThread_(std::this_thread::get_id()),
+       registration_(registration),handler_(handler),cause_(cause),gp_(gp),argument_(argument),stackTop_(stackTop),originalStep_(runtime.lookupFunction(handler)){
+        if(!ram||ram!=runtime.memory().getRDRAM()||!registration||!handler||!originalStep_||!stackTop||task_<0||runtime.isStopRequested())throw std::invalid_argument("IRQ initializer lacks actual registered source/runtime/stack");
+        storage_=std::shared_ptr<GuestContextStorage>(new GuestContextStorage(runtime,task_,this));
+        auto* ctx=storage_->get();
+        // Exactly the original dispatch initializer. This is a fresh literal
+        // Context/control image; no parent's numerical lane is copied.
+        ctx->r[28]=_mm_set_epi64x(0,int64_t(int32_t(gp_)));ctx->r[29]=_mm_set_epi64x(0,int64_t(int32_t(stackTop_)));ctx->r[31]=_mm_set_epi64x(0,0);
+        ctx->r[4]=_mm_set_epi64x(0,int64_t(int32_t(cause_)));ctx->r[5]=_mm_set_epi64x(0,int64_t(int32_t(argument_)));ctx->r[6]=_mm_set_epi64x(0,0);ctx->r[7]=_mm_set_epi64x(0,0);ctx->pc=handler_;
+        std::memcpy(initialImage_.data(),ctx,sizeof(R5900Context));
+    }
+public:
+    IrqInitializer(const IrqInitializer&)=delete;
+    PS2Runtime& runtime()const noexcept{return *runtime_;}
+    R5900Context& context()const noexcept{return *storage_->get();}
+    const std::shared_ptr<GuestContextStorage>& storage()const noexcept{return storage_;}
+    uint32_t handler()const noexcept{return handler_;}uint32_t cause()const noexcept{return cause_;}
+    uint32_t gp()const noexcept{return gp_;}uint32_t argument()const noexcept{return argument_;}uint32_t stackTop()const noexcept{return stackTop_;}
+    uint32_t registration()const noexcept{return registration_;}int32_t task()const noexcept{return task_;}
+    PS2Runtime::RecompiledFunction sourceStep()const noexcept{return originalStep_;}
+    const std::array<uint8_t,sizeof(R5900Context)>& certifiedInitialImage()const noexcept{return initialImage_;}
+    void validateBeforeAnyIrqInstructionOnEe()const {validateActualSourceOnEe();if(std::memcmp(initialImage_.data(),storage_->get(),sizeof(R5900Context)))throw std::invalid_argument("IRQ fresh initializer was changed before its first source instruction");}
+    void validateActualSourceOnEe()const {
+        if(currentRuntime()!=runtime_||currentContext()!=storage_->get()||!ps2ActualGuestExecutionDepth(runtime_)||ps2_sched::currentThread()!=task_||hostThread_!=std::this_thread::get_id()||runtime_->isStopRequested()||runtime_->lookupFunction(handler_)!=originalStep_)
+            throw std::invalid_argument("IRQ source event lost actual guest/context/thread/registered function identity");
+    }
+};
+using IrqInitializerHandle=std::shared_ptr<const IrqInitializer>;
+inline constexpr bool ActualIrqInitializerRegistrationInstalled=false;
+}
diff --git a/ps2xRuntime/src/lib/literal_command_provenance.h b/ps2xRuntime/src/lib/literal_command_provenance.h
new file mode 100644
index 0000000..774c988
--- /dev/null
+++ b/ps2xRuntime/src/lib/literal_command_provenance.h
@@ -0,0 +1,108 @@
+#pragma once
+#include "resident_vif_commands.h"
+#include <algorithm>
+namespace reo_resident_live {
+// Raw source provenance, never a CPU shadow of GPU-transformed numerical data.
+class LiteralCommands {
+    struct Qword {std::array<uint8_t,16> bytes{};bool valid=false;};
+    std::array<Qword,1024> qwords_{};
+    uint32_t cycle_=0,mode_=0;
+public:
+    LiteralCommands(uint32_t cycle,uint32_t mode):cycle_(cycle),mode_(mode){}
+    void control(uint32_t byte,const void* raw,uint32_t bytes) {
+        if(bytes!=4)return;
+        uint32_t value;std::memcpy(&value,raw,4);
+        if(byte==32)cycle_=value;else if(byte==36)mode_=value;
+    }
+    void upload(uint32_t command,uint32_t tops,const uint8_t* raw,uint32_t bytes) {
+        const uint32_t opcode=(command>>24)&127u,vn=(opcode>>2)&3u,vl=opcode&3u;
+        const uint32_t count=((command>>16)&255u)?((command>>16)&255u):256u;
+        uint32_t dest=command&1023u;if(command&32768u)dest=(dest+tops)&1023u;
+        const uint32_t cl=(cycle_&255u)?(cycle_&255u):1u,wl=((cycle_>>8)&255u)?((cycle_>>8)&255u):1u;
+        const bool literal=vn==3u && vl==0u && !(opcode&16u) && (mode_&3u)==0u && cl==wl && bytes==count*16u;
+        for(uint32_t index=0;index<count;++index) {
+            const uint32_t target=cl>=wl?(dest+(index/wl)*cl+index%wl)&1023u:(dest+index)&1023u;
+            auto& qword=qwords_[target];qword.valid=literal;
+            if(literal)std::memcpy(qword.bytes.data(),raw+index*16u,16);
+        }
+    }
+    // Exact248 V4-32 rows written by the genuine opaque parent lease.
+    // The CPU never receives these bytes. Invalidate only rows actually
+    // overwritten by this command; unrelated original RAW tag facts survive.
+    void opaqueParentUpload(uint32_t command,uint32_t tops,uint32_t bytes) {
+        if(command!=0x6cf80000u||tops>1023u||bytes!=3968u||cycle_!=0x0404u||(mode_&3u)!=0u)
+            throw std::invalid_argument("Opaque literal invalidation lacks the exact parent 4/4 upload");
+        const uint32_t first=((command&1023u)+tops)&1023u;
+        for(uint32_t q=0;q<248u;++q)qwords_[(first+q)&1023u].valid=false;
+    }
+    void byteWrite(uint32_t offset,const uint8_t* raw,uint32_t bytes) {
+        for(uint32_t n=0;n<bytes;) {
+            const uint32_t address=offset+n,index=address/16u,inside=address&15u,count=std::min(16u-inside,bytes-n);
+            auto& qword=qwords_[index];
+            if(!inside&&count==16u)qword.valid=true;
+            if(qword.valid)std::memcpy(qword.bytes.data()+inside,raw+n,count);
+            n+=count;
+        }
+    }
+    bool read(uint32_t firstQword,uint8_t* output,uint32_t qwords)const {
+        if(!output || !qwords || qwords>7)return false;
+        for(uint32_t n=0;n<qwords;++n)if(!qwords_[(firstQword+n)&1023u].valid)return false;
+        for(uint32_t n=0;n<qwords;++n)std::memcpy(output+n*16u,qwords_[(firstQword+n)&1023u].bytes.data(),16);
+        return true;
+    }
+    void afterGpuLaunch(const Program& program,uint32_t top,const LiteralEffect& effect) {
+        if(!program.literalSourcePreserved || program.inputTagOffsetFromTop!=1u ||
+           effect.type==LiteralEffect::Type::None){afterGpuLaunch();return;}
+        const uint32_t count=effect.type==LiteralEffect::Type::Strip?1u:7u;
+        const uint32_t first=(top+program.inputTagOffsetFromTop)&1023u;
+        std::array<Qword,7> protectedFacts{};
+        for(uint32_t q=0;q<count;++q) {
+            const auto& fact=qwords_[(first+q)&1023u];
+            if(!fact.valid)throw std::runtime_error("Literal reuse requires original raw source facts");
+            protectedFacts[q]=fact;
+        }
+        afterGpuLaunch();
+        // Conditional on ordered prefix success: the selected full kernel
+        // verifies these exact raw bytes before execution AND before commit.
+        // Sticky failures gate dependent geometry and every published effect.
+        for(uint32_t q=0;q<count;++q)qwords_[(first+q)&1023u]=protectedFacts[q];
+    }
+    void afterGpuLaunch() {
+        // Conservative: no source facts survive possible GPU writes unless a
+        // later original raw upload re-establishes exact command provenance.
+        for(auto& qword:qwords_)qword.valid=false;
+    }
+};
+struct LiteralPolicy {
+    bool entryZeroHasNoEvent=false;
+    bool variableOutputCount=false;
+    uint32_t tagOffsetFromTop=1;
+};
+inline bool describeLiteralLaunch(const LiteralCommands& commands,const LiteralPolicy& policy,
+                                  bool resume,uint32_t startPC,uint32_t top,LiteralEffect& out) {
+    out={};
+    if(!resume && startPC==0 && policy.entryZeroHasNoEvent)return true;
+    std::array<uint8_t,112> raw{};
+    const uint32_t first=(top+policy.tagOffsetFromTop)&1023u;
+    if(!commands.read(first,raw.data(),1))return false;
+    // Decode fixed, source-joined command fields directly into the private ABI.
+    // This avoids duplicate Root/Runtime copies of the GPU helper's C++ types.
+    uint32_t header[4];std::memcpy(header,raw.data(),16);
+    const uint32_t count=header[0]&32767u,high=header[1],nreg=(high>>28u)&15u;
+    const bool pre=((high>>14u)&1u)!=0;
+    if((header[0]&0xffff0000u) || !(header[0]&32768u) || ((high>>26u)&3u) || header[3])return false;
+    if(pre && nreg==3u && header[2]==0x412u && ((high>>15u)&7u)==4u && count>0 && count<=256) {
+        out.type=LiteralEffect::Type::Strip;out.vertexCapacity=256;
+        out.echo[0]=1;out.echo[1]=policy.variableOutputCount?256u:count;out.echo[2]=(high>>15u)&2047u;
+        std::memcpy(out.echo.data()+4,raw.data(),16);
+    } else {
+        if(pre || nreg!=1u || header[2]!=14u || count!=6u || !commands.read(first,raw.data(),7))return false;
+        uint32_t records[28];std::memcpy(records,raw.data(),112);
+        constexpr uint32_t addresses[6]{0x3b,0x14,0x06,0x08,0x34,0x36};
+        for(uint32_t q=0;q<6;++q)if(records[(q+1u)*4u+2u]!=addresses[q] || records[(q+1u)*4u+3u])return false;
+        out.type=LiteralEffect::Type::MaterialAD;out.echo[0]=2;out.echo[1]=6;
+        std::memcpy(out.echo.data()+4,raw.data(),112);
+    }
+    return true;
+}
+}
