+#pragma once
+// Private runtime/backend boundary. Public runtime/Memory/PCH layouts stay exact.
+#include "resident_vif_commands.h"
+#include <functional>
+#include <memory>
+class PS2Memory;
+class PS2Runtime;
+namespace reo_resident_live {
+class BackendRetirementRequest {
+public:
+    virtual ~BackendRetirementRequest()=default;
+    virtual std::vector<Retired> wait()=0;
+    // acquire-only observation; false is conservative for legacy/test owners.
+    virtual bool ready()const noexcept{return false;}
+};
+// Nonblocking FIFO reservation. This cannot call Device retirement inline or
+// wait for FIFO space while an IO/session/arbiter scope is live.
+std::shared_ptr<BackendRetirementRequest> requestBackendRetirement(Barrier,uint64_t epoch,uint64_t generation);
+void attachWaitRuntime(PS2Memory&,PS2Runtime*);
+bool waitReleaseEnabled(PS2Memory&);
+void settleResidentWaits(PS2Memory&);
+void finishResidentMemoryWrite(PS2Memory&);
+// Runs only ready prefixes under real guest ownership; never waits on a fence.
+bool serviceReadyResidentCompletions(PS2Memory&);
+// Implemented by the existing persistent joined IRQ worker, no new threads.
+bool residentCompletionWorkerReady(PS2Runtime*)noexcept;
+void notifyResidentCompletionReady()noexcept;
+void beforeResidentMemoryAccess(PS2Memory&,uint32_t address,bool write);
+bool deferResidentDmaPublication(PS2Memory&,std::function<void()>);
+// Default-off, isolated actual registry/Memory/scheduler fixture seam. It
+// supplies controlled worker completion metadata, never graphical results.
+struct WaitFixtureBackend {
+    std::function<void(std::shared_ptr<const Batch>)> queue;
+    std::function<std::shared_ptr<BackendRetirementRequest>(Barrier,uint64_t,uint64_t)> retire;
+    std::function<void(uint32_t,uint8_t*,uint32_t)> readData;
+    std::function<void(uint32_t,uint8_t*,uint32_t)> readControls;
+};
+void setWaitFixtureBackend(WaitFixtureBackend);
+bool fixtureRawIoPeekActive()noexcept;
+uint32_t fixtureReadRawDma(PS2Memory&,uint32_t address);
+} // namespace reo_resident_live
