+    static void abandon(const PreEntryControlWriteHandle& permit)noexcept{if(!permit)return;try{std::lock_guard lock(mutex_);auto i=states_.find(&permit->source_->runtime());if(i!=states_.end()&&i->second->pending==permit){invalidate(*i->second,permit->at_,permit->bytes_);i->second->failed=true;i->second->pending.reset();}}catch(...){}}
+    static PreEntryControlSnapshotHandle capture(PS2Runtime& rt,R5900Context& ctx,const std::shared_ptr<const void>& storage){
+        if(currentRuntime()!=&rt||currentContext()!=&ctx||!ps2ActualGuestExecutionDepth(&rt)||!matchesActualGuestContextStorage(rt,ctx,storage))throw std::runtime_error("Pre-entry snapshot lacks authentic cold EE/context ownership");
