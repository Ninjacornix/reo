diff --git a/ps2xRuntime/src/lib/parent_natural_worker.inl b/ps2xRuntime/src/lib/parent_natural_worker.inl
new file mode 100644
index 0000000..7da6764
--- /dev/null
+++ b/ps2xRuntime/src/lib/parent_natural_worker.inl
@@ -0,0 +1,59 @@
+// Included after the existing GS backend control/FIFO definitions. No new
+// Device, worker, scheduler clock or queue is introduced.
+#include "parent_natural_runtime.h"
+#include "parent_first_entry.h"
+namespace reo_parent_natural {
+namespace {
+class ActualParentOwnerRequest final:public OwnerRequest {
+    std::shared_ptr<GsBackendReply> reply_;
+public:
+    explicit ActualParentOwnerRequest(std::shared_ptr<GsBackendReply> r):reply_(std::move(r)){}
+    bool ready()const noexcept override{return reply_->done.load(std::memory_order_acquire);}
+    void wait()override {
+        if(!ready()){std::unique_lock<std::mutex> lock(g_gsAsync.m);g_gsAsync.drained.wait(lock,[&]{return g_gsAsync.stopping||ready();});}
+        if(!ready())throw std::runtime_error("Actual parent owner work cancelled before completion");
+        if(reply_->error)std::rethrow_exception(reply_->error);
+    }
+};
+}
+std::shared_ptr<OwnerRequest> requestActualOwnerControl(uint64_t epoch,const std::function<void(ControlTarget&)>& call) {
+    if(!epoch||!call||t_isGsWorker||!gsThreadEnabled()||!gs_backend_bridge::active())
+        throw std::logic_error("Parent caller requires its existing separate actual GS owner");
+    auto reply=std::make_shared<GsBackendReply>();
+    auto work=[reply,epoch,call]{const GsBackendEpochScope scope(epoch);try{
+        if(epoch!=gsPrivCurrentEpoch())throw std::runtime_error("Parent control crossed actual GS epoch");
+        if(!g_backendRoute.residentParentControl(call))throw std::runtime_error("Actual parent semantic owner absent");
+    }catch(...){reply->error=std::current_exception();}
+        reply->done.store(true,std::memory_order_release);g_gsAsync.drained.notify_all();};
+    std::unique_lock<std::mutex> lock(g_gsAsync.m);
+    if(g_gsAsync.stopping||!reo_resident_live::FifoReservation::residentRoom(g_gsAsync.queuedBytes,g_gsAsync.residentOwnedBytes,16u))
+        throw std::runtime_error("Actual parent control cannot reserve the existing GS FIFO");
+    if(!g_gsAsync.started){g_gsAsync.started=true;g_gsAsync.worker=std::thread(gsWorkerMain,g_gsInstance);}
+    GsQueueItem item;item.epoch=epoch;item.isPacket=false;item.control=std::move(work);
+    item.chargedControlBytes=16u;item.residentReserved=true;g_gsAsync.residentOwnedBytes+=16u;
+    ++g_gsAsync.enqueued;g_gsAsync.queuedBytes+=16u;g_gsAsync.queue.push_back(std::move(item));
+    lock.unlock();g_gsAsync.work.notify_one();return std::make_shared<ActualParentOwnerRequest>(std::move(reply));
+}
+std::shared_ptr<OwnerRequest> requestActualFirstEntryEnrollment(ColdEntryHandle capture){
+    if(!capture||t_isGsWorker||!gsThreadEnabled()||!gs_backend_bridge::active())throw std::logic_error("First graphics enrollment requires its existing actual GS worker");
+    capture->requireOnEe();const size_t charge=capture->queueBytes();const uint64_t epoch=capture->epoch();
+    auto reply=std::make_shared<GsBackendReply>();
+    auto work=[reply,capture,epoch]{const GsBackendEpochScope scope(epoch);try{
+        capture->requireOnOwner();if(epoch!=gsPrivCurrentEpoch())throw std::runtime_error("First graphics enrollment crossed actual GS epoch");
+        if(!g_backendRoute.residentFirstEntry(capture))throw std::runtime_error("First graphics enrollment has no accelerated actual owner");
+    }catch(...){reply->error=std::current_exception();}
+        reply->done.store(true,std::memory_order_release);g_gsAsync.drained.notify_all();};
+    std::unique_lock<std::mutex> lock(g_gsAsync.m);
+    // 32MiB RAM cannot be hidden in the 16MiB resident reserve. Its one-time
+    // immutable snapshot uses the existing 48MiB ordinary FIFO allotment.
+    if(g_gsAsync.stopping||!reo_resident_live::FifoReservation::ordinaryRoom(g_gsAsync.queuedBytes,g_gsAsync.residentOwnedBytes,charge))
+        throw std::runtime_error("First graphics snapshot cannot reserve the bounded existing GS FIFO");
+    if(!g_gsAsync.started){g_gsAsync.started=true;g_gsAsync.worker=std::thread(gsWorkerMain,g_gsInstance);}
+    GsQueueItem item;item.epoch=epoch;item.isPacket=false;item.control=std::move(work);item.chargedControlBytes=charge;
+    ++g_gsAsync.enqueued;g_gsAsync.queuedBytes+=charge;g_gsAsync.queue.push_back(std::move(item));
+    lock.unlock();g_gsAsync.work.notify_one();return std::make_shared<ActualParentOwnerRequest>(std::move(reply));
+}
+void runActualOwnerControl(uint64_t epoch,const std::function<void(ControlTarget&)>& call) {
+    auto request=requestActualOwnerControl(epoch,call);request->wait();
+}
+} // namespace reo_parent_natural
