+    return frontier;
+}
+void completeFirstEntryVuFrontierOnEe(PS2Runtime& runtime,const FirstEntryVuFrontier& frontier){
+    auto session=find(runtime.memory());if(!session||!ps2ActualGuestExecutionDepth(&runtime))throw std::runtime_error("First-entry completion lost actual EE/VU owner");
+    std::lock_guard<std::recursive_mutex> lock(session->mutex);requireLive(*session);
+    if(!session->firstEntryPending||session->epoch!=frontier.epoch||session->bankGeneration!=frontier.generation||session->waitRuntime!=&runtime)
+        throw std::runtime_error("First-entry completion changed its genuine VU frontier");
+    if(frontier.cold){if(session->authoritative||session->coldSent)throw std::runtime_error("First-entry CPU VU cold bank was already consumed");
