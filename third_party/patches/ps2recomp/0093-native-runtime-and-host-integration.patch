+        static_cast<unsigned long long>(r.ordinal),status&0xffu);
+    s_retainedDumpConsumed.store(true,std::memory_order_release);
+}
+void replayVerifierRejection(Session& session,const std::vector<uint64_t>& expected,
+    const std::vector<uint64_t>& refusedOrdinals,const std::vector<uint32_t>& refusedStatuses) {
+    if(refusedOrdinals.empty()||refusedOrdinals.size()!=refusedStatuses.size())
+        failVerifierRejection(session,"Resident verifier rejection refused-tail envelope invalid",
+            "empty or mismatched refused-ordinal/status lists");
+    const uint64_t firstOrdinal=refusedOrdinals.front();
+    const uint32_t status=refusedStatuses.front();
+    for(size_t i=0;i<refusedOrdinals.size();++i) {
+        if(refusedStatuses[i]<20u||refusedStatuses[i]>24u)
+            failVerifierRejection(session,"Resident verifier rejection is not a pre-publication wrapper refusal",
+                "an effect validator/expansion/expansion status (or a sticky fold) may already carry committed graphics");
+        if(std::find(session.replayedRecoveryOrdinals.begin(),session.replayedRecoveryOrdinals.end(),
+                     refusedOrdinals[i])!=session.replayedRecoveryOrdinals.end())
+            failVerifierRejection(session,"Resident verifier rejection replay attempted twice for one ordinal",
+                "each refused ordinal's program body may replay exactly once per epoch");
+    }
+    std::vector<RetainedLaunchFailure> retained;
+    if(!fixtureRequested()) {
+        try {retainFailedLaunchBackend(retained);}
+        catch(const std::exception& error) {
+            std::fprintf(stderr,"[GPU-REJECT] ordinal=%llu status=0x%08x retained-tail readback refused: %s\n",
+                static_cast<unsigned long long>(firstOrdinal),status,error.what());
+        }
+    }
+    // Mandated rejection capture. The retained records carry each launch's
+    // push (entry/maxPairs/top/itop/operation/capacity), the validated
+    // literal-effect contract words, the launch-time VIF controls and the
+    // exact-image binding recorded at enqueue.
+    const auto* program=session.matchedProgram?session.matchedProgram.get():
+        session.resumeProgram.get();
+    const uint64_t imageDigest=program?captureDigest(program->exactImage.data(),program->exactImage.size()):0u;
+    char park[16]{};std::snprintf(park,sizeof(park),"0x%08x",status);
+    if(retained.empty())
+        failVerifierRejection(session,"Resident verifier rejection has no retained pre-launch snapshot",
+            "replay requires the owner's retained PRE-LAUNCH captures, not a post-failure export");
+    if(!session.waitRuntime)
+        failVerifierRejection(session,"Resident verifier rejection has no bound guest runtime",
+            "the CPU replay path needs the live interpreter owner");
+    // The retained tail must cover EVERY refused ordinal of this receipt, in
+    // order: a single replay may not stand in for later refused launches. Any
+    // refused ordinal without a retained PRE-LAUNCH capture stops cleanly
+    // (never marked recovered).
+    std::vector<const RetainedLaunchFailure*> ordered;
+    ordered.reserve(refusedOrdinals.size());
+    for(uint64_t ordinal:refusedOrdinals) {
+        const RetainedLaunchFailure* matchRecord=nullptr;
+        for(const auto& record:retained)
+            if(record.available&&record.ordinal==ordinal) {matchRecord=&record;break;}
+        if(!matchRecord)
+            failVerifierRejection(session,"Retained pre-launch snapshot does not cover the refused tail",
+                "a refused ordinal has no retained PRE-LAUNCH capture; refusing to mark it recovered");
+        if(std::find(expected.begin(),expected.end(),ordinal)==expected.end())
+            failVerifierRejection(session,"Retained pre-launch snapshot does not match the refused launch",
+                "a refused ordinal is not part of this sealed receipt");
+        // Recovery is bound to the rejected launch's exact image identity
+        // (bindingId + certified-image digest recorded at enqueue), never to
+        // whichever image happens to be uploaded or matched later.
+        if(!program||matchRecord->bindingId!=program->bindingId||matchRecord->imageDigest!=imageDigest)
+            failVerifierRejection(session,"Recovery image binding mismatch",
+                "the refused launch's image is not the currently matched certified program; refusing to replay a different image");
+        ordered.push_back(matchRecord);
+    }
+    for(size_t r=0;r<ordered.size();++r) {
+        const auto& record=*ordered[r];
+        std::uint32_t stateWords[8]{};for(unsigned w=0;w<8;++w)std::memcpy(stateWords+w,record.state.data()+(145u+w)*4u,4);
+        if(r==0) {
+            std::fprintf(stderr,
+                "[GPU-REJECT] ordinal=%llu status=%s op=%u entryPC=0x%x top=0x%x itop=0x%x residentPC(state.w151)=0x%x\n"
+                "[GPU-REJECT] image binding=%llu digest=%016llx state+dataDigest=%016llx state.w145..152=%08x %08x %08x %08x %08x %08x %08x %08x\n"
+                "[GPU-REJECT] effect kindWords=%08x %08x %08x %08x q0=%08x %08x %08x %08x capacityPush=%u\n",
+                static_cast<unsigned long long>(record.ordinal),
+                park,record.push[4],record.push[0],record.push[2],record.push[3],stateWords[6],
+                static_cast<unsigned long long>(program?program->bindingId:0u),imageDigest,
+                captureDigest(record.state.data(),StateBytes)^captureDigest(record.data.data(),DataBytes),
+                stateWords[0],stateWords[1],stateWords[2],stateWords[3],stateWords[4],stateWords[5],stateWords[6],stateWords[7],
+                record.echo[0],record.echo[1],record.echo[2],record.echo[3],
+                record.echo[4],record.echo[5],record.echo[6],record.echo[7],record.push[5]);
+            if(record.push[4]==0u||record.push[4]==4u)
+                captureLiteralSourceCheck(record,refusedStatuses[0]);
+            captureRetainedDumpIfRequested(record,refusedStatuses[0]);
+        } else {
+            std::fprintf(stderr,"[GPU-REJECT] tail ordinal=%llu status=0x%08x op=%u top=0x%x itop=0x%x residentPC(state.w151)=0x%x\n",
+                static_cast<unsigned long long>(record.ordinal),refusedStatuses[r],record.push[4],
+                record.push[2],record.push[3],stateWords[6]);
+            if(record.push[4]==0u||record.push[4]==4u)
+                captureLiteralSourceCheck(record,refusedStatuses[r]);
+            captureRetainedDumpIfRequested(record,refusedStatuses[r]);
+        }
+        // Exactly-once CPU replay: restore the snapshot (VU state, data and
+        // launch-time VIF controls), verify the live image digest, and run
+        // the refused body through the same execute/resume path the CPU
+        // fallback uses. Per ordinal; the whole refused tail replays in order.
+        ReplayLaunchDiagnostic diag;
+        session.waitRuntime->replayResidentLaunch(record,diag);
+        const char* verdict=nullptr;
+        char verdictTail[128];
+        std::snprintf(verdictTail,sizeof(verdictTail),"status=0x%02x finalPC=0x%x",refusedStatuses[r]&0xffu,diag.finalPC);
+        // First try kick-envelope violations — the same diagnostic covers
+        // status 21 (envelope violation post-XGKICK) and status 24 (none
+        // expected).
+        uint32_t causeKick=8u;
+        for(uint32_t k=0;k<diag.kicks && k<8u;++k) {
+            const auto& kick=diag.kick[k];
+            if(kick.totalBytes==0u) {
+                std::snprintf(verdictTail,sizeof(verdictTail),
+                    "kick%u viSrc=0x%04x addr=0x%03x bytes=0 total=0 (kernel emitOrderedXg requires total>0)",
+                    k,kick.sourceVi,kick.firstAddr);
+                verdict="kernel XGKICK envelope zero-total (emitOrderedXg)";
+                causeKick=k;break;
+            }
+            if(kick.totalBytes>16384u) {
+                std::snprintf(verdictTail,sizeof(verdictTail),
+                    "kick%u viSrc=0x%04x addr=0x%03x bytes=%u (>16KiB envelope)",
+                    k,kick.sourceVi,kick.firstAddr,kick.totalBytes);
+                verdict="kernel XGKICK envelope overflow (emitOrderedXg)";
+                causeKick=k;break;
+            }
+            if(!kick.done) {
+                std::snprintf(verdictTail,sizeof(verdictTail),
+                    "kick%u viSrc=0x%04x addr=0x%03x tags=%u no-EOP",
+                    k,kick.sourceVi,kick.firstAddr,kick.tags);
+                verdict="kernel XGKICK envelope without EOP within 256 tags";
+                causeKick=k;break;
+            }
+        }
+        if(!verdict && diag.exhausted)verdict="kernel runProgram loop exhaustion (maxPairs=65536 hit; CPU tolerates spin-out)";
+        if(!verdict && diag.boundsStop)verdict="kernel default-case instructionPC refusal (out-of-envelope PC)";
+        // Status separation: a status-24 refusal is literal-source (the GPU
+        // wrapper compared bank words vs echo qwords); a status-21 refusal is
+        // a kernel-exit reason (runProgram retired false OR vuFailed). The
+        // CPU replay normally reproduces status-21 by hitting the same
+        // bound; status-24 typically reproduces as a CPU-NORMAL exit (the
+        // wrapper's comparison is not part of the interpreter), in which case
+        // the verdict must NOT masquerade the GPU's literal-source rejection
+        // as a CPU-replay abnormality.
+        if(!verdict) {
+            if(refusedStatuses[r]==24u) {
+                verdict="kernel literal-source comparison mismatch (status 24; CPU may end normally — see the [GPU-REJECT] literal-source capture)";
+            } else if(refusedStatuses[r]==21u) {
+                verdict="kernel runProgram refused (status 21; CPU replay shows no specific bound — bare quantize NaN or default-case invalid PC)";
+            } else if(refusedStatuses[r]>=20u && refusedStatuses[r]<=24u) {
+                verdict="kernel pre-publication refusal (status in 20..24; see capture)";
+            } else {
+                verdict="wrapper refusal status outside 20..24";
+            }
+        }
+        std::fprintf(stderr,
+            "[GPU-REPLAY] ordinal=%llu executed=%u finalPC=0x%x ended=%u bounds=%u exhausted=%u kicks=%u verdict=%s | %s\n",
+            static_cast<unsigned long long>(record.ordinal),diag.executed,diag.finalPC,
+            diag.ended?1u:0u,diag.boundsStop?1u:0u,diag.exhausted?1u:0u,diag.kicks,verdict,verdictTail);
+        std::fprintf(stderr,
+            "[GPU-REPLAY] ordinal=%llu executed=%u finalPC=0x%x ended=%u bounds=%u exhausted=%u kicks=%u verdict=%s\n",
+            static_cast<unsigned long long>(record.ordinal),diag.executed,diag.finalPC,
+            diag.ended?1u:0u,diag.boundsStop?1u:0u,diag.exhausted?1u:0u,diag.kicks,verdict);
+        for(uint32_t k=0;k<diag.kicks && k<4u;++k) {
+            const auto& kick=diag.kick[k];
+            std::fprintf(stderr,"[GPU-REPLAY] kick%u: viSrc=0x%04x addr=0x%03x bytes=%u tags=%u done=%u\n",
+                k,kick.sourceVi,kick.firstAddr,kick.totalBytes,kick.tags,kick.done?1u:0u);
+        }
+        (void)causeKick;
+        session.replayedRecoveryOrdinals.push_back(record.ordinal);
+    }
+    // EXPLICIT OWNERSHIP TRANSFER: the replayed interpreter state is the
+    // recovered CPU truth. The GPU bank holds only pre-launch bytes, so it
+    // must never export over the replay (the fallback export path rechecks
+    // authority after its barrier for exactly this reason).
+    session.authoritative=false;
+    s_residentOwnershipTransitions.fetch_add(1,std::memory_order_relaxed);
+    traceIncremental(session,"recovery-cpu-authority",(uint32_t)firstOrdinal,(uint32_t)refusedOrdinals.size(),status,true);
+    // Park: the sticky verifier is terminal for GPU geometry this epoch; the
+    // session continues CPU-owned under the normal record-only flush path.
+    // Both the runtime admission gate and the owner itself park together —
+    // a runtime-only "recoverable → continue" decision without a fenced owner
+    // reinitialization leaves the owner in its parked state, so the very next
+    // admit-boundary launch dereferences a failed backend and stops the
+    // worker without firing the first-error latch. Until an explicit
+    // reinitialization path is implemented, retain CPU ownership strictly.
+    session.verifierReplayUsed=true;
+    s_residentOwnerParkStatus.store(status,std::memory_order_relaxed);
+    s_residentOwnerParkOrdinal.store(firstOrdinal,std::memory_order_relaxed);
+    if(!s_residentOwnerParked.exchange(true,std::memory_order_acq_rel)) {
+        std::fprintf(stderr,"[GPU-MIXED] recovered status=%s ordinals=%zu first=%llu — refused tail replayed on CPU exactly once, CPU is authoritative, owner parked, GPU admissions disabled until a fenced backend reinitialization or a genuine GS reset\n",
+            park,refusedOrdinals.size(),static_cast<unsigned long long>(firstOrdinal));
+    }
+}
+bool requested() {
+    const char* value=std::getenv("REO_VIF1_GPU_RESIDENT");
+    return value && value[0]=='1';
+}
+std::shared_ptr<Session> find(PS2Memory& memory) {
+    std::lock_guard<std::mutex> lock(sessionsMutex);
+    const auto found=sessions.find(&memory);
+    return found==sessions.end()?nullptr:found->second;
+}
+void sealWaitReceipt(Session&,Barrier);
+void requireLive(const Session& session) {
+    if(session.failed)throw std::runtime_error("Resident VIF bank failed; CPU geometry fallback is forbidden");
+    if(session.epoch!=currentGsEpoch())throw std::runtime_error("Resident VIF bank belongs to a retired GS epoch");
+}
+void append(Session& session,Operation operation) {
+    requireLive(session);
+    if(session.firstEntryPending)throw std::runtime_error("VIF writer overtook first-entry enrollment");
+    if(!session.pending) {
+        session.pending=std::make_shared<Batch>();
+        session.pending->epoch=session.epoch;session.pending->bankGeneration=session.bankGeneration;
+        if(!session.coldSent)session.pending->cold=session.cold;
+    }
+    // Batch overflow is a SUSPECTED CAUSE of the resident-mode terminal tag
+    // regression (see the rotate comment below). A single record larger than
+    // the whole batch bound can never satisfy any rotation, so it is rejected
+    // unconditionally, before and after every rotation, in BOTH modes.
+    if(operation.payload.size()>MaxBatchBytes)
+        throw std::runtime_error("Resident VIF batch full; single record exceeds the batch byte bound");
+    if(session.pending->operations.size()==MaxOperations ||
+       operation.payload.size()>MaxBatchBytes-session.pending->payloadBytes) {
+        // Rotation is restricted to explicit record-only incremental mode
+        // (allowIncrementalFallback with an incomplete registry AND no live
+        // GPU bank ownership). In that mode the recorded prefix has no GPU
+        // consumer bound to the batch boundary, so rotate the immutable
+        // history instead of throwing: throwing unwinds processVIF1Data
+        // mid-chain with the parse position unadvanced and skips the DMA
+        // completion publication, which starves the guest ring of its
+        // terminal tag IRQ and stalls loading with a zero/REFE terminal tag.
+        // CPU banks were consumed in lock step by the dual-written fallback
+        // path, so discarding the historical prefix is semantically inert,
+        // and any later import re-carries the whole current CPU bank anyway.
+        // Any other mode (full-GPU complete registry, cold component
+        // enrollment, or a per-program-admission session whose bank is
+        // currently GPU-owned) keeps the strict bounded-prefix throw: there
+        // a real ordered prefix is required at submission because recorded
+        // uploads are required GPU work.
+        const bool incrementalRecordOnly=session.registry->allowIncrementalFallback && !session.registry->complete() && !session.authoritative;
+        if(incrementalRecordOnly) {
+            traceIncremental(session,"rotate-ops",session.pending->operations.size(),session.pending->payloadBytes,operation.payload.size(),true);
+            validate(*session.pending);
+            session.pending=std::make_shared<Batch>();
+            session.pending->epoch=session.epoch;
+            session.pending->bankGeneration=session.bankGeneration;
+        } else {
+            throw std::runtime_error("Resident VIF batch full; drain the real command prefix before continuing");
+        }
+    }
+    session.pending->payloadBytes+=uint32_t(operation.payload.size());
+    session.pending->operations.push_back(std::move(operation));
+    // Authoritative means the GPU backend owns the VU data bank, so guest VU
+    // reads must observe it rather than the CPU cold bank. In full-GPU mode
+    // (complete registry) every launch runs on the GPU, so the bank is owned
+    // from the first upload. With explicit incremental enrollment (incomplete
+    // registry) every launch falls back to CPU from coherent dual-written
+    // banks, so the CPU bank stays authoritative and reads keep observing it.
+    session.unsealedBankWork=true;
+    if(session.registry->complete())session.authoritative=true;
+}
+void flushPending(Session& session) {
+    if(!session.pending || session.pending->operations.empty())return;
+    traceIncremental(session,"flush",session.pending->operations.size(),session.pending->payloadBytes,0u,false);
+    validate(*session.pending);
+    std::shared_ptr<const Batch> immutable=std::move(session.pending);
+    // Incremental record-only rollout (incomplete registry, no GPU bank
+    // ownership) never launches on the GPU, so a record-only batch has no GPU
+    // work to submit. Skipping the owner avoids the cold() GPU-object
+    // allocation on the GS worker (ProgramBank/Strip/Unpack), which would
+    // stall the guest's GIF flow during loading. Full-GPU mode and a
+    // per-program-admission session with a live imported bank still submit
+    // through PATH1 at the semantic launch frontier.
+    if(session.registry->complete() ||
+       (session.registry->perProgramAdmission && session.authoritative)) {
+        submitResidentPath1(*session.arbiter,[immutable]{
+            if(fixtureRequested() && waitFixture.queue)waitFixture.queue(immutable);
+            else queueBackendBatch(immutable);
+        });
+    }
+    session.coldSent=true;
+}
+std::shared_ptr<const Program> match(Session& session) {
+    if(session.matchedCodeGeneration==session.codeGeneration)return session.matchedProgram;
+    const auto* image=session.memory->getVU1Code();
+    if(!image)throw std::runtime_error("Missing VU micro-memory identity");
+    session.matchedCodeGeneration=session.codeGeneration;session.matchedProgram.reset();
+    for(const auto& program:session.registry->programs)
+        if(std::memcmp(program->exactImage.data(),image,CodeBytes)==0){session.matchedProgram=program;break;}
+    return session.matchedProgram;
+}
+}
+void registerBeforeBoot(std::shared_ptr<const Registry> value) {
+    std::lock_guard<std::mutex> lock(sessionsMutex);
+    if(!sessions.empty())throw std::logic_error("Resident VIF registry changed during a running session");
+    registration=std::move(value);
+}
+void bindCold(PS2Memory& memory,GifArbiter& arbiter,const VU1State& state) {
+    static_assert(sizeof(VU1State)==StateBytes,"Resident raw state ABI changed");
+    if(!requested())return;
+    std::lock_guard<std::mutex> lock(sessionsMutex);
+    if(!registration || (!registration->complete()&&!registration->authenticColdComponentEnrollment&&!registration->allowIncrementalFallback))
+        throw std::runtime_error("REO_VIF1_GPU_RESIDENT requested before full program/effect/coherence registry is certified");
+    if(registration->authenticColdComponentEnrollment&&
+       (registration->complete()||!registration->programs.empty()||registration->literalEffect))
+        throw std::runtime_error("Cold component VIF registration cannot claim a numerical launch registry");
+    if(sessions.count(&memory))throw std::logic_error("Resident VIF bank already bound; retire before rebind");
+    if(!memory.getVU1Data())throw std::runtime_error("No cold VU data bank");
+
+    auto cold=std::make_shared<ColdBank>();
+    std::memcpy(cold->state.data(),&state,StateBytes);
+    std::memcpy(cold->data.data(),memory.getVU1Data(),DataBytes);
+    std::memcpy(cold->row.data(),memory.vif1_regs.row,16);
+    std::memcpy(cold->column.data(),memory.vif1_regs.col,16);
+    cold->cycle=memory.vif1_regs.cycle;cold->mode=memory.vif1_regs.mode;cold->mask=memory.vif1_regs.mask;
+    auto session=std::make_shared<Session>();session->memory=&memory;session->arbiter=&arbiter;
+    session->registry=registration;session->cold=cold;session->epoch=currentGsEpoch();
+    if(const auto found=waitRuntimes.find(&memory);found!=waitRuntimes.end())session->waitRuntime=found->second;
+    if(waitRequested() && !session->waitRuntime)throw std::runtime_error("Resident wait mode requires its actual guest CPU owner before binding");
+    session->literalCommands=std::make_unique<LiteralCommands>(cold->cycle,cold->mode);
+    if(!session->epoch)throw std::runtime_error("Resident VIF requires a live GS owner epoch");
+    armArbiter(arbiter);sessions.emplace(&memory,std::move(session));
+}
+bool enabled(PS2Memory& memory){return bool(find(memory));}
+bool resident(PS2Memory& memory) {
+    const auto session=find(memory);if(!session)return false;
+    std::lock_guard<std::recursive_mutex> lock(session->mutex);return session->authoritative;
+}
+void codeUploaded(PS2Memory& memory) {
+    const auto session=find(memory);if(!session)return;
+    std::lock_guard<std::recursive_mutex> lock(session->mutex);requireLive(*session);++session->codeGeneration;
+    // Old immutable launch bindings keep their codeGeneration and exact image.
+    // MPG copies microcode only; it never touches the resident data bank.
+}
+bool control(PS2Memory& memory,uint32_t offset,const void* bits,uint32_t bytes) {
+    const auto session=find(memory);if(!session)return false;
+    if(!bits)throw std::invalid_argument("Null resident VIF control payload");
+    const bool vector=(offset==0 || offset==16) && bytes==16;
+    const bool scalar=offset<=40 && !(offset&3u) && bytes==4;
+    if(!vector&&!scalar)throw std::invalid_argument("Unsupported resident VIF control register");
+    std::lock_guard<std::recursive_mutex> lock(session->mutex);
+    Operation operation{};operation.kind=Kind::Control;operation.controlByte=offset;
+    const auto* raw=static_cast<const uint8_t*>(bits);operation.payload.assign(raw,raw+bytes);
+    append(*session,std::move(operation));session->literalCommands->control(offset,bits,bytes);return true;
+}
+bool unpack(PS2Memory& memory,uint32_t command,uint32_t tops,const uint8_t* raw,uint32_t bytes) {
+    const auto session=find(memory);if(!session)return false;
+    if(!raw || !bytes || bytes>4096 || (bytes&3u))throw std::invalid_argument("Incomplete raw resident UNPACK");
+    std::lock_guard<std::recursive_mutex> lock(session->mutex);
+    traceIncremental(*session,"unpack",command,bytes,tops);
+    Operation operation{};operation.kind=Kind::Unpack;operation.command=command;
+    operation.latchedTops=tops;operation.payload.assign(raw,raw+bytes);
+    append(*session,std::move(operation));session->literalCommands->upload(command,tops,raw,bytes);return true;
+}
+void opaqueParentUnpack(PS2Memory& memory,Operation operation) {
+    const auto session=find(memory);
+    // This token already names an owned GPU source; absent destination
+    // ownership cannot fall through to raw CPU payload interpretation.
+    if(!session)throw std::runtime_error("Opaque parent upload has no actual resident VIF owner");
+    std::lock_guard<std::recursive_mutex> lock(session->mutex);requireLive(*session);
+    Batch envelope{};envelope.epoch=session->epoch;envelope.bankGeneration=session->bankGeneration;
+    envelope.operations.push_back(operation);validate(envelope);
+    if(operation.kind!=Kind::OpaqueLeaseUnpack)
+        throw std::invalid_argument("Not an actual opaque parent upload operation");
+    const auto& stamp=operation.opaqueLease->stamp();
+    if(stamp.command!=0x6cf80000u||stamp.bytes!=3968u)
+        throw std::invalid_argument("Not the exact parent payload command");
+    try {
+        // No memcpy of F80 and no LiteralCommands.upload(raw). Invalidation
+        // keeps other actual RAW control/tag facts and forbids stale HostEcho.
+        session->literalCommands->opaqueParentUpload(operation.command,operation.latchedTops,3968u);
+        append(*session,std::move(operation));
+    } catch(...) {session->failed=true;throw;}
+}
+bool launch(PS2Memory& memory,VU1State& state,bool resume,uint32_t startPC,uint32_t itop) {
+    const auto session=find(memory);if(!session)return false;
+    std::lock_guard<std::recursive_mutex> lock(session->mutex);requireLive(*session);
+    if(session->registry->authenticColdComponentEnrollment)
+        throw std::runtime_error("Cold component enrollment cannot admit a numerical VU launch");
+    // MSCNT also uses the currently uploaded exact image. An MPG switch must
+    // never silently execute the old program at the resident continuation PC.
+    const auto program=match(*session);
+    // An incomplete registry falls back to CPU for an unknown image, an
+    // unsupported/uncertified entry point or an uncertified effect. Per-program
+    // admission (packager opt-in) is the ONLY incremental GPU path: exactly the
+    // images whose admittedFreshPCs carries genuine retained-cold device parity
+    // evidence, fresh entries only. Everything else falls back — and when the
+    // GPU bank previously owned the state, the fallback FIRST retires every
+    // enrolled GPU work, exports the GPU-computed architectural state and
+    // restores it (register/flag/continuation carry, not just the data bank)
+    // into the guest interpreter before CPU execution.
+    // Verifier-rejection recovery: once a refused tail has been replayed on
+    // CPU, no further GPU admissions (the unadmitted branch below restores
+    // CPU ownership via the normal export handoff on the first post-recovery
+    // launch; the re-arming requires a genuine GS reset).
+    // The LIVE CPU continuation PC, captured before any import/export
+    // decision: for a first crossing this is exactly the state the GPU bank
+    // would inherit; for a refused continuation it is the evidence of what
+    // the interpreter was about to resume (answers: authentic, imported
+    // wrong, or simply outside the certified continuation envelope).
+    const uint32_t liveContinuationPC=state.pc;
+    // Resolve literal command metadata before transferring ownership. An
+    // unknown envelope must use the normal GPU->CPU handoff, never return to
+    // the interpreter with a stale CPU bank after importing GPU authority.
+    Operation operation{};operation.kind=Kind::Launch;operation.program=program;
+    operation.startPC=startPC;operation.resume=resume;operation.codeGeneration=session->codeGeneration;
+    operation.top=memory.vif1_regs.top&1023u;operation.itop=itop&1023u;operation.ordinal=session->nextOrdinal;
+    bool known=false;
