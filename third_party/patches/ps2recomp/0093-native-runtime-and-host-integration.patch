+    }
+    static void stopRuntime(PS2Runtime& rt)noexcept{try{std::lock_guard lock(mutex_);auto i=states_.find(&rt);if(i!=states_.end()){i->second->generation->active.store(false,std::memory_order_release);states_.erase(i);}}catch(...){}}
