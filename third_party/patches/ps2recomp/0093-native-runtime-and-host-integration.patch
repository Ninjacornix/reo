new file mode 100644
index 0000000..85222c7
--- /dev/null
+++ b/ps2xRuntime/src/lib/parent_natural_runtime.h
@@ -0,0 +1,120 @@
+#pragma once
+#include "ps2_runtime.h"
+#include "resident_vif_commands.h"
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+namespace reo_parent_natural {
+enum class SourceSpace:uint8_t {Ram,Spr,Context};
+struct Coverage {
+    bool bothParentBodies=false,beforeFastSpecialBulk=false,directContextAndCopies=false;
+    bool reviewedRawWriterCatalogue=false,gpuUpstreamInputs=false;
+    bool protectedInputsAndContextDuringGuestRelease=false,actualFifoAndReturnReceipt=false;
+    bool typedDmaParserAndLiteralCoverage=false,ownerStopAndContextHandoff=false;
+    bool complete()const noexcept{return bothParentBodies&&beforeFastSpecialBulk&&directContextAndCopies&&
+        reviewedRawWriterCatalogue&&gpuUpstreamInputs&&protectedInputsAndContextDuringGuestRelease&&
+        actualFifoAndReturnReceipt&&typedDmaParserAndLiteralCoverage&&ownerStopAndContextHandoff;}
+};
+struct Site {
+    enum class Kind:uint8_t {ScalarControl,RawAsset};
+    uint32_t pc=0,word=0,begin=0,bytes=0;
+    SourceSpace space=SourceSpace::Ram;Kind kind=Kind::ScalarControl;
+};
+struct Configuration {
+    bool requested=false;
+    // Cold upload/history adoption only; never enables numerical selection.
+    bool authenticColdComponentEnrollment=false;
+    // Zero disables the one-shot authentic first-entry GPU component.
+    uint32_t authenticColdSetterCommand=0;
+    uint32_t authenticColdComponentEntry=0;
+    PS2Runtime::RecompiledFunction authenticColdComponentBody=nullptr;
+    PS2Runtime* actualRuntime=nullptr;
+    Coverage coverage{};
+    // Reviewed exact source sites only. No arithmetic-result classification
+    // inferred from value equality or from an instruction class alone.
+    std::vector<Site> rawSites;
+};
+class OriginHandle {
+protected: OriginHandle()=default;
+public: virtual ~OriginHandle()=default;
+    virtual uint32_t bytes()const noexcept=0;
+};
+using Origins=std::shared_ptr<const OriginHandle>;
+class ControlTarget {
+public:
+    virtual ~ControlTarget()=default;
+    virtual const void* ramIdentity()const noexcept=0;
+    virtual const void* sprIdentity()const noexcept=0;
+    virtual R5900Context* contextIdentity()const noexcept=0;
+    virtual PS2Runtime* runtimeIdentity()const noexcept=0;
+    virtual uint64_t epoch()const noexcept=0;
+    virtual bool readyForSelection()const noexcept=0;
+    virtual bool ownsAnySource()const noexcept=0;
+    virtual void requireHealthy()const=0;
+    virtual void beforeAllocator(uint8_t*,R5900Context&,PS2Runtime&)=0;
+    virtual bool atAllocatorReturn(uint8_t*,R5900Context&,PS2Runtime&)=0;
+    virtual void read(SourceSpace,uint32_t,uint32_t,R5900Context*,uint32_t)=0;
+    virtual void beforeUnknownWrite(SourceSpace,uint32_t,uint32_t,R5900Context*,uint32_t)=0;
+    virtual void prepareRawWrite(SourceSpace,uint32_t,const void*,uint32_t,R5900Context*,uint32_t)=0;
+    virtual void completedRawWrite(SourceSpace,uint32_t,uint32_t,R5900Context*,uint32_t)=0;
+    virtual Origins emptyOrigins()const=0;
+    virtual Origins sliceOrigins(const Origins&,uint32_t,uint32_t)const=0;
+    virtual Origins concatOrigins(const Origins&,const Origins&)const=0;
+    virtual void appendParser(std::vector<uint8_t>&,Origins&,uint32_t,uint32_t,bool)=0;
+    virtual void bindParser(const uint8_t*,uint32_t,const Origins&)=0;
+    virtual Origins beginParser(const uint8_t*,uint32_t)=0;
+    virtual void requireRaw(const Origins&,uint32_t,uint32_t)const=0;
+    virtual bool hasOpaque(const Origins&,uint32_t,uint32_t)const=0;
