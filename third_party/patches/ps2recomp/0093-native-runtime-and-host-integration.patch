@@ -0,0 +1,18 @@
+#pragma once
+#include "literal_command_provenance.h"
+#include "ordered_stream_hints.h"
+namespace reo_resident_live {
+inline std::shared_ptr<const OrderedStreamHint> describeOrderedStream(const LiteralCommands& commands,
+                          uint32_t top,const LiteralEffect& effect,bool resume) {
+    if(!resume||effect.type!=LiteralEffect::Type::Strip)return {};
+    const uint32_t rawCount=effect.echo[4]&32767u;
+    if(!rawCount||rawCount>256)return {};
+    std::array<uint8_t,16> raw{};if(!commands.read(top,raw.data(),1))return {};
+    uint32_t selector=0;std::memcpy(&selector,raw.data(),4);selector&=65535u;
+    if(selector!=1&&selector!=2)return {};
+    auto hint=std::make_shared<OrderedStreamHint>();hint->selector=selector;hint->inputCount=rawCount;
+    hint->exactRawTop=true;hint->exactRawTag=true;return hint;
+}
+// Non39 hints are diagnostic source facts for a genuine complete-GPU boundary,
+// never an array admission. TOP facts retain the existing invalidation policy.
+}
diff --git a/ps2xRuntime/src/lib/palette_dma_origin.h b/ps2xRuntime/src/lib/palette_dma_origin.h
new file mode 100644
index 0000000..f032f44
--- /dev/null
+++ b/ps2xRuntime/src/lib/palette_dma_origin.h
@@ -0,0 +1,48 @@
+#pragma once
+// Private read-only source sidecar. No public runtime ABI/header changes.
+#include <algorithm>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <vector>
+#include <unordered_map>
+namespace reo_palette_origin {
+struct Span {uint32_t offset=0,address=0,bytes=0;uint64_t allocation=0;bool scratch=false;};
+using Spans=std::vector<Span>;
+struct Callbacks {
+    std::function<uint64_t(const void*,uint32_t,uint32_t,bool)> allocation;
+    std::function<void(const void*,uint32_t,uint32_t,const uint8_t*,uint32_t,const Spans&)> unpack;
+};
+inline std::mutex mutex;
+inline Callbacks callbacks;
+struct Frozen {const void* memory=nullptr;uint32_t bytes=0;Spans spans;};
+inline std::unordered_map<const uint8_t*,Frozen> frozen;
+inline bool enabled(){return bool(callbacks.allocation)&&bool(callbacks.unpack);}
+inline void install(Callbacks value){std::lock_guard<std::mutex> l(mutex);callbacks=std::move(value);frozen.clear();}
+inline Spans slice(const Spans& source,uint32_t at,uint32_t bytes){Spans result;const uint64_t end=uint64_t(at)+bytes;
+    for(const auto& s:source){const uint64_t begin=s.offset,finish=begin+s.bytes;if(finish<=at||begin>=end)continue;
+        const uint64_t low=std::max<uint64_t>(at,begin),high=std::min<uint64_t>(end,finish);
+        result.push_back({uint32_t(low-at),s.address+uint32_t(low-begin),uint32_t(high-low),s.allocation,s.scratch});}
+    return result;
+}
+inline Spans concatenate(const Spans& a,uint32_t firstBytes,const Spans& b){Spans out=a;
+    if(out.size()+b.size()>32768)return {};for(auto s:b){if(uint64_t(s.offset)+firstBytes>0xffffffffu)return {};s.offset+=firstBytes;out.push_back(s);}return out;
+}
+inline void append(Spans& spans,const void* memory,uint32_t offset,uint32_t address,uint32_t bytes,bool scratch)noexcept{
+    try{if(!enabled()||!bytes||spans.size()>=32768)return;const uint64_t id=callbacks.allocation(memory,address,bytes,scratch);spans.push_back({offset,address,bytes,id,scratch});}catch(...){}
+}
+inline void bind(const void* memory,const uint8_t* copied,uint32_t bytes,Spans spans)noexcept{
+    try{if(!enabled()||!copied||!bytes)return;std::lock_guard<std::mutex> l(mutex);if(frozen.size()>=128)frozen.clear();frozen[copied]={memory,bytes,std::move(spans)};}catch(...){}
+}
+inline Spans begin(const void* memory,const uint8_t* data,uint32_t bytes,const uint8_t* ram,const uint8_t* spr)noexcept{
+    try{if(!enabled())return {};{std::lock_guard<std::mutex> l(mutex);const auto it=frozen.find(data);if(it!=frozen.end()){auto copy=std::move(it->second);frozen.erase(it);if(copy.memory==memory&&copy.bytes==bytes)return std::move(copy.spans);return {};}}
+        const uintptr_t source=reinterpret_cast<uintptr_t>(data),main=reinterpret_cast<uintptr_t>(ram),scratch=reinterpret_cast<uintptr_t>(spr);Spans out;
+        if(ram&&source>=main&&source-main<0x2000000u&&bytes<=0x2000000u-(source-main))append(out,memory,0,uint32_t(source-main),bytes,false);
+        else if(spr&&source>=scratch&&source-scratch<16384u&&bytes<=16384u-(source-scratch))append(out,memory,0,uint32_t(source-scratch),bytes,true);
+        return out;
+    }catch(...){return {};}
+}
+inline void complete(const void* memory,uint32_t command,uint32_t tops,const uint8_t* raw,uint32_t bytes,const Spans& origins,uint32_t at)noexcept{
+    try{if(enabled())callbacks.unpack(memory,command,tops,raw,bytes,slice(origins,at,bytes));}catch(...){}
+}
+}
diff --git a/ps2xRuntime/src/lib/parent_context_lifecycle.h b/ps2xRuntime/src/lib/parent_context_lifecycle.h
new file mode 100644
index 0000000..d5d337d
--- /dev/null
+++ b/ps2xRuntime/src/lib/parent_context_lifecycle.h
@@ -0,0 +1,169 @@
+#pragma once
+#include "parent_natural_runtime.h"
+#include "ps2_guest_sched.h"
+#include <atomic>
+#include <map>
+#include <memory>
+#include <thread>
+
+uint32_t ps2ActualGuestExecutionDepth(PS2Runtime*) noexcept;
+
+namespace reo_parent_natural {
+// Optional private observer; no public R5900Context or runtime layout changes.
+class ContextLifetimeTarget {
+public:
+    virtual ~ContextLifetimeTarget() = default;
+    virtual bool retainsActualGuestContextIdentity(const R5900Context&)const noexcept{return false;}
+    virtual void observeActualGuestContextEnd(PS2Runtime&, R5900Context&, int32_t) noexcept = 0;
+};
+
+namespace context_lifecycle_detail {
+struct Storage final {
+    PS2Runtime* runtime;
+    int32_t task;
+    std::thread::id hostThread;
+    std::shared_ptr<R5900Context> context;
+    bool embedded = false,irqIssued = false;
+    std::atomic<bool> ended{false};
+    Storage(PS2Runtime& actualRuntime, int32_t actualTask)
+        : runtime(&actualRuntime), task(actualTask), hostThread(std::this_thread::get_id()),
+          context(std::make_shared<R5900Context>()) {
+        // This is a fresh CPU context, never an opaque context copied from a
+        // different task. Preserve the runtime's original hardware constant.
+        context->vu0_vf[0] = _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f);
+    }
+    explicit Storage(PS2Runtime& actualRuntime)
+        : runtime(&actualRuntime), task(-1),
+          context(&actualRuntime.cpu(), [](R5900Context*){}), embedded(true) {}
+};
+inline std::mutex storageMutex;
+inline std::map<R5900Context*, std::weak_ptr<Storage>> storages;
+inline std::map<PS2Runtime*, std::shared_ptr<Storage>> primaryStorages;
+inline void observeEnding(const std::shared_ptr<Storage>& storage) noexcept {
+    storage->ended.store(true, std::memory_order_release);
+    try {
+        auto target = findActualOwnerTarget(storage->runtime->memory().getRDRAM());
+        auto* observer=target?dynamic_cast<ContextLifetimeTarget*>(target.get()):nullptr;
+        if(target&&(target->contextIdentity()==storage->context.get()||(observer&&observer->retainsActualGuestContextIdentity(*storage->context)))) {
+            if(observer)
+                observer->observeActualGuestContextEnd(*storage->runtime, *storage->context, storage->task);
+            else if(target->ownsAnySource()) storage->runtime->requestStop();
+        }
+    } catch(...) { try { storage->runtime->requestStop(); } catch(...) {} }
+}
+} // namespace context_lifecycle_detail
+
+// Actual Runtime construction/destruction brackets its embedded context. The
+// Runtime joins guest/GS workers before finishing this lease and before its
+// embedded context is destroyed; the token cannot prolong a destroyed Runtime.
+inline void registerActualRuntimeContextStorage(PS2Runtime& runtime) {
+    auto storage = std::make_shared<context_lifecycle_detail::Storage>(runtime);
+    std::lock_guard<std::mutex> lock(context_lifecycle_detail::storageMutex);
+    auto& primary = context_lifecycle_detail::primaryStorages;
+    auto& all = context_lifecycle_detail::storages;
+    if(primary.count(&runtime) || all.count(&runtime.cpu()))
+        throw std::logic_error("Actual primary context was already registered");
+    auto inserted = primary.emplace(&runtime, storage);
+    try { all.emplace(&runtime.cpu(), storage); }
+    catch(...) { primary.erase(inserted.first); throw; }
+}
+inline void beginActualRuntimeContextStop(PS2Runtime& runtime) noexcept {
+    try {
+        std::shared_ptr<context_lifecycle_detail::Storage> storage;
+        {
+            std::lock_guard<std::mutex> lock(context_lifecycle_detail::storageMutex);
+            auto found = context_lifecycle_detail::primaryStorages.find(&runtime);
+            if(found == context_lifecycle_detail::primaryStorages.end()) return;
+            storage = found->second;
+        }
+        context_lifecycle_detail::observeEnding(storage);
+    } catch(...) { try { runtime.requestStop(); } catch(...) {} }
+}
+inline void finishActualRuntimeContextStopAfterGsJoin(PS2Runtime& runtime) noexcept {
+    try {
+        std::lock_guard<std::mutex> lock(context_lifecycle_detail::storageMutex);
+        auto& primary = context_lifecycle_detail::primaryStorages;
+        auto found = primary.find(&runtime);
+        if(found == primary.end()) return;
+        if(!found->second->ended.load(std::memory_order_acquire)) { runtime.requestStop(); return; }
+        auto& all = context_lifecycle_detail::storages;
+        auto context = all.find(&runtime.cpu());
+        if(context != all.end() && context->second.lock() == found->second) all.erase(context);
+        primary.erase(found);
+    } catch(...) { try { runtime.requestStop(); } catch(...) {} }
+}
+
+// Owns the genuine context allocated by a host-backed guest worker. A later
+// ColdSource lifetime can retain this same allocation through GPU retirement.
+// There is no constructor accepting another context or its shadow bytes.
+class IrqInitializer;
+class GuestContextStorage final {
+    friend class IrqInitializer;
+    std::shared_ptr<context_lifecycle_detail::Storage> storage_;
+    // Only the actual DMAC initializer issuer can create this task0-capable
+    // storage. The ordinary guest-worker constructor still requires task>=1.
+    GuestContextStorage(PS2Runtime& runtime,int32_t task,IrqInitializer*)
+      :storage_(std::make_shared<context_lifecycle_detail::Storage>(runtime,task)){
+        if(task<0)throw std::invalid_argument("IRQ context has no actual source task identity");
+        storage_->irqIssued=true;
+        std::lock_guard<std::mutex> lock(context_lifecycle_detail::storageMutex);
+        if(!context_lifecycle_detail::storages.emplace(storage_->context.get(),storage_).second)throw std::logic_error("IRQ context allocation already registered");
+    }
+public:
+    GuestContextStorage(PS2Runtime& runtime, int32_t task)
+        : storage_(std::make_shared<context_lifecycle_detail::Storage>(runtime, task)) {
+        if(task < 1) throw std::invalid_argument("Actual guest context has no task identity");
+        std::lock_guard<std::mutex> lock(context_lifecycle_detail::storageMutex);
+        auto& registry = context_lifecycle_detail::storages;
+        auto old = registry.find(storage_->context.get());
+        if(old != registry.end()) throw std::logic_error("Actual guest context allocation is already registered");
+        registry.emplace(storage_->context.get(), storage_);
+    }
+    GuestContextStorage(const GuestContextStorage&) = delete;
+    GuestContextStorage& operator=(const GuestContextStorage&) = delete;
+    R5900Context* get() const noexcept { return storage_->context.get(); }
+    ~GuestContextStorage() noexcept {
+        context_lifecycle_detail::observeEnding(storage_);
+        try {
+            std::lock_guard<std::mutex> lock(context_lifecycle_detail::storageMutex);
+            auto& registry = context_lifecycle_detail::storages;
+            auto found = registry.find(get());
+            if(found != registry.end() && found->second.lock() == storage_) registry.erase(found);
+        } catch(...) {
+            try { storage_->runtime->requestStop(); } catch(...) {}
+        }
+    }
+};
+
+inline std::shared_ptr<const void> retainActualGuestContextStorage(PS2Runtime& runtime, R5900Context& context) {
+    if(currentRuntime() != &runtime || currentContext() != &context ||
+       !ps2ActualGuestExecutionDepth(&runtime) || runtime.isStopRequested())
+        throw std::runtime_error("Context lifetime capture lacks actual guest execution");
+    std::lock_guard<std::mutex> lock(context_lifecycle_detail::storageMutex);
+    auto found = context_lifecycle_detail::storages.find(&context);
+    auto storage = found == context_lifecycle_detail::storages.end() ? nullptr : found->second.lock();
+    if(storage && storage->embedded && storage->task == -1 && storage->runtime == &runtime &&
+       &context == &runtime.cpu() && !storage->ended.load(std::memory_order_acquire)) {
+        if(ps2_sched::currentThread() < 1) throw std::runtime_error("Primary context has no genuine guest task");
+        storage->task = ps2_sched::currentThread(); storage->hostThread = std::this_thread::get_id();
+    }
+    if(!storage || storage->runtime != &runtime || storage->task != ps2_sched::currentThread() ||
+       storage->hostThread != std::this_thread::get_id() || storage->ended.load(std::memory_order_acquire))
+        throw std::runtime_error("Context lifetime capture is foreign or already ended");
+    return std::static_pointer_cast<const void>(storage);
+}
+inline bool matchesActualGuestContextStorage(PS2Runtime& runtime, R5900Context& context,
+                                             const std::shared_ptr<const void>& lifetime) {
+    if(!lifetime) return false;
+    std::lock_guard<std::mutex> lock(context_lifecycle_detail::storageMutex);
+    auto found = context_lifecycle_detail::storages.find(&context);
+    auto storage = found == context_lifecycle_detail::storages.end() ? nullptr : found->second.lock();
+    return storage && storage->runtime == &runtime && (storage->task>=1||(storage->task==0&&storage->irqIssued)) &&
+        !storage->ended.load(std::memory_order_acquire) && lifetime.get() == storage.get() &&
+        !lifetime.owner_before(storage) && !storage.owner_before(lifetime);
+}
+static_assert(sizeof(R5900Context) == 1648);
+// ColdSource retention is available. Transfer of an ended graphics task to a
+// different task remains a separate same-bank ownership transaction.
+inline constexpr bool CrossTaskGraphicsContextHandoffImplemented = false;
+} // namespace reo_parent_natural
diff --git a/ps2xRuntime/src/lib/parent_first_entry.h b/ps2xRuntime/src/lib/parent_first_entry.h
new file mode 100644
index 0000000..83dfc5b
--- /dev/null
+++ b/ps2xRuntime/src/lib/parent_first_entry.h
@@ -0,0 +1,98 @@
+#pragma once
+#include "parent_context_lifecycle.h"
+#include "pre_entry_control_journal.h"
+#include <atomic>
+#include <thread>
+namespace reo_source_instrumentation {class EntryScope;}
+namespace reo_parent_natural {
+class ColdEntry;
+class FirstEntryInvocation final {
+    friend class reo_source_instrumentation::EntryScope;
+    friend class ColdEntry;
+    PS2Runtime* runtime_; R5900Context* context_;
+    int32_t task_; std::thread::id thread_;
+    uint32_t originalEntry_;PS2Runtime::RecompiledFunction originalBody_;
+    std::shared_ptr<const void> storage_;
+    std::atomic<bool> active_{true};
+    std::function<void()> requireEeScope_;
+    FirstEntryInvocation(PS2Runtime& rt,R5900Context& ctx,std::function<void()> requireScope)
+      :runtime_(&rt),context_(&ctx),task_(ps2_sched::currentThread()),thread_(std::this_thread::get_id()),
+       originalEntry_(ctx.pc),originalBody_(rt.lookupFunction(ctx.pc)),
+       storage_(retainActualGuestContextStorage(rt,ctx)),requireEeScope_(std::move(requireScope)){}
+public:
+    FirstEntryInvocation(const FirstEntryInvocation&)=delete;
+};
+using FirstEntryInvocationHandle=std::shared_ptr<const FirstEntryInvocation>;
+class ColdEntry final {
+    friend void ensureActualFirstGraphicsEntry(uint8_t*,R5900Context&,PS2Runtime&,uint32_t,const FirstEntryInvocationHandle&);
+    FirstEntryInvocationHandle invocation_;
+    const void* ram_;const void* spr_;uint64_t epoch_,generation_;
+    std::vector<uint8_t> ramBytes_,sprBytes_;
+    R5900Context contextBytes_;
+    std::shared_ptr<const reo_resident_live::ColdBank> vuCold_;
+    PreEntryControlSnapshotHandle preEntryControls_;
+    ColdEntry(FirstEntryInvocationHandle invocation,uint64_t epoch,uint64_t generation,
+              std::shared_ptr<const reo_resident_live::ColdBank> vuCold)
+      :invocation_(std::move(invocation)),ram_(invocation_->runtime_->memory().getRDRAM()),
+       spr_(invocation_->runtime_->memory().getScratchpad()),epoch_(epoch),generation_(generation),
+       ramBytes_(0x2000000u),sprBytes_(0x4000u),vuCold_(std::move(vuCold)) {
+        requireOnEe();if(!ram_||!spr_||!epoch_||!generation_)throw std::invalid_argument("Incomplete authentic first graphics source");
+        preEntryControls_=captureActualPreEntryControlsAtCold(runtime(),context(),contextLifetime());
+        std::memcpy(ramBytes_.data(),ram_,ramBytes_.size());std::memcpy(sprBytes_.data(),spr_,sprBytes_.size());
+        std::memcpy(&contextBytes_,invocation_->context_,sizeof(contextBytes_));
+    }
+public:
+    ColdEntry(const ColdEntry&)=delete;
+    PS2Runtime& runtime()const noexcept{return *invocation_->runtime_;}
+    R5900Context& context()const noexcept{return *invocation_->context_;}
+    const void* ramIdentity()const noexcept{return ram_;}
+    const void* sprIdentity()const noexcept{return spr_;}
+    const std::shared_ptr<const void>& contextLifetime()const noexcept{return invocation_->storage_;}
+    uint64_t epoch()const noexcept{return epoch_;}uint64_t generation()const noexcept{return generation_;}
+    int32_t task()const noexcept{return invocation_->task_;}
+    uint32_t originalEntry()const noexcept{return invocation_->originalEntry_;}
+    PS2Runtime::RecompiledFunction originalBodyIdentity()const noexcept{return invocation_->originalBody_;}
+    const PreEntryControlSnapshotHandle& preEntryControls()const noexcept{return preEntryControls_;}
+    const void* initialRam()const noexcept{return ramBytes_.data();}
+    const void* initialSpr()const noexcept{return sprBytes_.data();}
+    const void* initialContext()const noexcept{return &contextBytes_;}
+    const std::shared_ptr<const reo_resident_live::ColdBank>& vuCold()const noexcept{return vuCold_;}
+    size_t queueBytes()const noexcept{return 16u+ramBytes_.size()+sprBytes_.size()+sizeof(contextBytes_)+(vuCold_?sizeof(*vuCold_):0u);}
+    void requireOnOwner()const {
+        if(!invocation_||!invocation_->active_.load(std::memory_order_acquire)||runtime().isStopRequested()||
+           runtime().memory().getRDRAM()!=ram_||runtime().memory().getScratchpad()!=spr_||
+           !matchesActualGuestContextStorage(runtime(),context(),contextLifetime()))
+            throw std::runtime_error("First graphics capture lost genuine current Context/storage lifetime");
+    }
+    void requireOnEe()const {
+        requireOnOwner();if(!originalBodyIdentity()||runtime().lookupFunction(originalEntry())!=originalBodyIdentity()||
+           currentRuntime()!=&runtime()||currentContext()!=&context()||
+           !ps2ActualGuestExecutionDepth(&runtime())||ps2_sched::currentThread()!=task()||
+           std::this_thread::get_id()!=invocation_->thread_)
+            throw std::runtime_error("First graphics capture lost its actual EntryScope/task/EE ownership");
+        if(!invocation_->requireEeScope_)throw std::runtime_error("First graphics capture has no genuine current source scope");
+        invocation_->requireEeScope_();
+    }
+};
+using ColdEntryHandle=std::shared_ptr<const ColdEntry>;
+// Registration is published by initialization of the actual same-Device owner.
+// No separate environment switch or complete/live readiness gate is introduced.
+inline bool isActualFirstGraphicsEntry(uint32_t entry)noexcept{
+    switch(entry){case 0x199d00u:case 0x19bbd0u:case 0x191280u:case 0x196010u:case 0x18f6a0u:
+        case 0x18f710u:case 0x1921b0u:case 0x18f570u:case 0x18fdf0u:
+        case 0x18f970u:case 0x18fce0u:case 0x18f880u:case 0x18f7e0u:case 0x197490u:case 0x197900u:return true;
+        default:return false;}
+}
+void setActualFirstEntryEnrollmentRequested(bool)noexcept;
+bool actualFirstEntryEnrollmentRequested()noexcept;
+std::shared_ptr<OwnerRequest> requestActualFirstEntryEnrollment(ColdEntryHandle);
+void ensureActualFirstGraphicsEntry(uint8_t*,R5900Context&,PS2Runtime&,uint32_t,const FirstEntryInvocationHandle&);
+} // namespace reo_parent_natural
+namespace reo_resident_live {
+struct FirstEntryVuFrontier {uint64_t epoch=0,generation=0;std::shared_ptr<const ColdBank> cold;};
+// This specific first enrollment waits while EE remains owned. Existing GPU
+// banks are retired/reused; only an untouched CPU-authoritative bank is copied.
+FirstEntryVuFrontier prepareFirstEntryVuFrontierOnEe(PS2Runtime&);
+void completeFirstEntryVuFrontierOnEe(PS2Runtime&,const FirstEntryVuFrontier&);
+void failFirstEntryVuFrontierOnEe(PS2Runtime&)noexcept;
+}
diff --git a/ps2xRuntime/src/lib/parent_natural_dispatch.cpp b/ps2xRuntime/src/lib/parent_natural_dispatch.cpp
new file mode 100644
index 0000000..558045e
--- /dev/null
+++ b/ps2xRuntime/src/lib/parent_natural_dispatch.cpp
@@ -0,0 +1,158 @@
+#include "parent_natural_runtime.h"
+#include "bounded_graphics_entry_filter.h"
+#include "parent_source_failure.h"
+#include "parent_first_entry.h"
+#include "pre_entry_control_journal.h"
+#include "resident_vif_live_hooks.h"
+#include <map>
+#include <atomic>
+#include <stdexcept>
+extern uint32_t ps2IoRegLockDepth()noexcept;
+namespace reo_parent_natural {
+namespace {
+struct Binding {std::weak_ptr<ControlTarget> target;R5900Context* actualContext=nullptr;bool tombstone=false;};
+std::mutex bindingsMutex;
+std::map<const void*,Binding> bindings;
+// bindings.size(), written only under bindingsMutex. Lets the per-guest-access
+// lookups below skip the global lock when nothing is bound (every route with the
+// GPU parent/source owners off); a non-empty map, tombstones included, still takes
+// the locked path, so guarded behaviour is unchanged. Profiled 2026-10-18: the
+// unconditional lock+scan cost ~40% of the guest render thread's samples.
+std::atomic<size_t> bindingCount{0};
+std::atomic<uint64_t> coldSessions{1};
+std::atomic<uint64_t> bindingGeneration{1};
+thread_local std::shared_ptr<ControlTarget> cachedTarget;
+thread_local const void* cachedRam=nullptr;
+thread_local uint64_t cachedGeneration=0,cachedEpoch=0;
+void preflightBindingGeneration(){if(bindingGeneration.load(std::memory_order_relaxed)==UINT64_MAX)throw std::overflow_error("Source binding generation exhausted");}
+void changedBindingGeneration()noexcept{bindingGeneration.fetch_add(1,std::memory_order_release);}
+thread_local PS2Runtime* actualRuntime=nullptr;
+thread_local R5900Context* actualContext=nullptr;
+std::shared_ptr<ControlTarget> checked(const void* ram) {
+    auto t=findActualOwnerTarget(ram);if(!t)return {};
+    t->requireHealthy();
+    if((t->ownsAnySource()||t->readyForSelection())&&(!actualRuntime||actualRuntime!=t->runtimeIdentity()||!actualContext))
+        throw std::runtime_error("Owned parent access lacks its actual guest execution scope");
+    return t;
+}
+std::shared_ptr<ControlTarget> forContext(R5900Context* ctx) {
+    if(bindingCount.load(std::memory_order_acquire)==0)return {};
+    std::lock_guard<std::mutex> lock(bindingsMutex);
+    for(const auto& pair:bindings)if(pair.second.actualContext==ctx){
+        if(pair.second.tombstone)throw std::runtime_error("Stopped parent context remains opaque");
+        auto t=pair.second.target.lock();
+        if(!t)throw std::runtime_error("Actual parent context owner expired before handoff");
+        return t;}
+    return {};
+}
+}
+void installActualOwnerTarget(const std::shared_ptr<ControlTarget>& t) {
+    if(!t||!t->ramIdentity()||!t->sprIdentity()||!t->contextIdentity()||!t->runtimeIdentity()||!t->epoch())
+        throw std::invalid_argument("Actual cold owner binding is incomplete");
+    std::lock_guard<std::mutex> lock(bindingsMutex);
+    if(bindings.count(t->ramIdentity()))throw std::runtime_error("Cold rebind requires an actual context/owner-stop certificate");
+    preflightBindingGeneration();bindings.emplace(t->ramIdentity(),Binding{t,t->contextIdentity(),false});
+    bindingCount.store(bindings.size(),std::memory_order_release);changedBindingGeneration();
+}
+uint64_t issueActualColdSession(){
+    auto next=coldSessions.load(std::memory_order_relaxed);
+    for(;;){if(next==UINT64_MAX)throw std::overflow_error("Actual cold parent sessions exhausted");
+        if(coldSessions.compare_exchange_weak(next,next+1,std::memory_order_relaxed))return next;}
+}
+void stopActualOwnerTarget(const std::shared_ptr<ControlTarget>& t) {
+    if(!t)return;std::lock_guard<std::mutex> lock(bindingsMutex);
+    auto found=bindings.find(t->ramIdentity());
+    if(found==bindings.end()||found->second.target.lock()!=t)throw std::invalid_argument("Foreign parent binding stop");
+    preflightBindingGeneration();
+    if(t->ownsAnySource())found->second.tombstone=true;
+    else bindings.erase(found); // No GPU source was selected; cold CPU still authoritative.
+    bindingCount.store(bindings.size(),std::memory_order_release);
+    changedBindingGeneration();
+}
+uint64_t actualOwnerBindingGeneration()noexcept{return bindingGeneration.load(std::memory_order_acquire);}
+std::shared_ptr<ControlTarget> findActualOwnerTarget(const void* ram) {
+    if(bindingCount.load(std::memory_order_acquire)==0)return {};
+    const uint64_t generation=actualOwnerBindingGeneration();
+    const bool scoped=actualRuntime&&actualRuntime->memory().getRDRAM()==ram;
+    if(scoped&&cachedRam==ram&&cachedGeneration==generation&&(!cachedTarget||cachedEpoch==cachedTarget->epoch()))return cachedTarget;
+    if(scoped){cachedTarget.reset();cachedRam=ram;cachedGeneration=0;cachedEpoch=0;}
+    std::shared_ptr<ControlTarget> result;
+    try{std::lock_guard<std::mutex> lock(bindingsMutex);auto found=bindings.find(ram);
+        if(found!=bindings.end()){
+            if(found->second.tombstone)throw std::runtime_error("Stopped GPU parent source remains guarded");
+            result=found->second.target.lock();if(!result)throw std::runtime_error("Actual parent callback expired before source retirement");
+        }
+        // The map and this stamp are observed under the same registry lock.
+        if(scoped){cachedTarget=result;cachedGeneration=actualOwnerBindingGeneration();cachedEpoch=result?result->epoch():0;}
+    }catch(...){throwOwnedSourceFailure(actualRuntime);}
+    return result;
+}
+AccessScope::AccessScope(PS2Runtime* r,R5900Context* c):priorRuntime_(actualRuntime),priorContext_(actualContext),priorCachedTarget_(cachedTarget),priorCachedRam_(cachedRam),priorCachedGeneration_(cachedGeneration),priorCachedEpoch_(cachedEpoch){
+    actualRuntime=r;actualContext=c;if(!r||cachedRam!=r->memory().getRDRAM()){cachedTarget.reset();cachedRam=nullptr;cachedGeneration=0;cachedEpoch=0;}
+}
+AccessScope::~AccessScope(){actualRuntime=priorRuntime_;actualContext=priorContext_;cachedTarget=std::move(priorCachedTarget_);cachedRam=priorCachedRam_;cachedGeneration=priorCachedGeneration_;cachedEpoch=priorCachedEpoch_;}
+PS2Runtime* currentRuntime()noexcept{return actualRuntime;}
+R5900Context* currentContext()noexcept{return actualContext;}
+Origins parserBegin(const void* ram,const uint8_t* p,uint32_t n){auto t=checked(ram);return t&&(t->ownsAnySource()||t->readyForSelection())?t->beginParser(p,n):Origins{};}
+Origins parserSlice(const void* ram,const Origins& x,uint32_t at,uint32_t n){if(!x)return {};auto t=checked(ram);if(!t)throw std::runtime_error("Owned parser tape lost its owner");return t->sliceOrigins(x,at,n);}
+Origins parserConcat(const void* ram,const Origins& a,const Origins& b){auto t=checked(ram);if(!t){if(a||b)throw std::runtime_error("Owned parser concatenate lost owner");return {};}if(!a&&!b)return {};if(!a||!b)throw std::runtime_error("Owned parser remainder lost a typed DMA origin");return t->concatOrigins(a,b);}
+void parserRequireRaw(const void* ram,const Origins& x,uint32_t at,uint32_t n){if(!x)return;auto t=checked(ram);if(!t)throw std::runtime_error("Owned parser raw read lost owner");t->requireRaw(x,at,n);}
+bool parserHasOpaque(const void* ram,const Origins& x,uint32_t at,uint32_t n){if(!x)return false;auto t=checked(ram);if(!t)throw std::runtime_error("Owned parser query lost owner");return t->hasOpaque(x,at,n);}
+bool parserOpaqueUnpack(PS2Memory& memory,const Origins& x,uint32_t at,uint32_t n,uint32_t command,uint32_t tops,uint32_t cycle,uint32_t mode){if(!x||!parserHasOpaque(memory.getRDRAM(),x,at,n))return false;auto t=checked(memory.getRDRAM());auto operation=t->opaqueUnpack(x,at,n,command,tops,cycle,mode);reo_resident_live::opaqueParentUnpack(memory,std::move(operation));return true;}
+bool appendActualParserBytes(const void* ram,std::vector<uint8_t>& bytes,Origins& x,uint32_t address,uint32_t n,bool spr){auto t=checked(ram);if(!t||(!t->ownsAnySource()&&!t->readyForSelection()))return false;if(!x)x=t->emptyOrigins();t->appendParser(bytes,x,address,n,spr);return true;}
+void bindActualParserBytes(const void* ram,const uint8_t* p,uint32_t n,const Origins& x){if(!x)return;auto t=checked(ram);if(!t)throw std::runtime_error("Owned DMA copy lost owner before binding");t->bindParser(p,n,x);}
+} // namespace reo_parent_natural
+namespace {
+using namespace reo_parent_natural;
+void sourceRead(const void* ram,SourceSpace space,uint32_t at,uint32_t n){try{auto t=findActualOwnerTarget(ram);if(!t)return;t->requireHealthy();if(!t->ownsAnySource()&&!t->readyForSelection())return;auto* c=currentContext();if(!c||currentRuntime()!=t->runtimeIdentity())throw std::runtime_error("Owned raw read has no bound guest scope");t->read(space,at,n,c,c->pc);}catch(...){reo_parent_natural::throwOwnedSourceFailure(reo_parent_natural::currentRuntime());}}
+void sourceWrite(const void* ram,SourceSpace space,uint32_t at,uint32_t n){try{auto t=findActualOwnerTarget(ram);if(!t)return;t->requireHealthy();if(!t->ownsAnySource()&&!t->readyForSelection())return;auto* c=currentContext();if(!c||currentRuntime()!=t->runtimeIdentity())throw std::runtime_error("Owned raw write has no bound guest scope");t->beforeUnknownWrite(space,at,n,c,c->pc);}catch(...){reo_parent_natural::throwOwnedSourceFailure(reo_parent_natural::currentRuntime());}}
+std::shared_ptr<ControlTarget> contextTarget(R5900Context* ctx){
+    auto t=forContext(ctx);if(!t)return {};t->requireHealthy();
+    if(!t->ownsAnySource()&&!t->readyForSelection())return {};
+    if(currentRuntime()!=t->runtimeIdentity()||currentContext()!=ctx)
+        throw std::runtime_error("Actual parent context access lacks its bound guest scope");
+    return t;
+}
+}
+void ReoNaturalBeforeActualAllocator(uint8_t* ram,R5900Context& ctx,PS2Runtime& r){reo_parent_natural::AccessScope scope(&r,&ctx);auto t=reo_parent_natural::findActualOwnerTarget(ram);if(t){t->requireHealthy();if(t->readyForSelection())t->beforeAllocator(ram,ctx,r);}}
+bool ReoNaturalAtActualAllocatorReturn(uint8_t* ram,R5900Context& ctx,PS2Runtime& r){reo_parent_natural::AccessScope scope(&r,&ctx);auto t=reo_parent_natural::findActualOwnerTarget(ram);if(t)t->requireHealthy();return t&&t->readyForSelection()?t->atAllocatorReturn(ram,ctx,r):false;}
+void ps2ParentBeforeFastRead(const void* ram,uint32_t at,uint32_t n){sourceRead(ram,reo_parent_natural::SourceSpace::Ram,at,n);}
+void ps2ParentBeforeFastWrite(const void* ram,uint32_t at,uint32_t n){reo_parent_natural::invalidateActualPreEntryControlBytes(ram,at,n);sourceWrite(ram,reo_parent_natural::SourceSpace::Ram,at,n);}
+void ps2ParentBeforeScratchpadRead(const void* ram,uint32_t at,uint32_t n){sourceRead(ram,reo_parent_natural::SourceSpace::Spr,at,n);}
+void ps2ParentBeforeScratchpadWrite(const void* ram,uint32_t at,uint32_t n){sourceWrite(ram,reo_parent_natural::SourceSpace::Spr,at,n);}
+void ps2ParentBeforeContextRead(R5900Context* ctx,uint32_t at,uint32_t n){try{auto t=contextTarget(ctx);if(t)t->read(reo_parent_natural::SourceSpace::Context,at,n,ctx,ctx->pc);}catch(...){reo_parent_natural::throwOwnedSourceFailure(reo_parent_natural::currentRuntime());}}
+void ps2ParentBeforeUnknownContextWrite(R5900Context* ctx,uint32_t at,uint32_t n){try{auto t=contextTarget(ctx);if(t)t->beforeUnknownWrite(reo_parent_natural::SourceSpace::Context,at,n,ctx,ctx->pc);}catch(...){reo_parent_natural::throwOwnedSourceFailure(reo_parent_natural::currentRuntime());}}
+void ps2ParentPrepareFastWrite(const void* ram,uint32_t at,const void* data,uint32_t n){auto t=reo_parent_natural::checked(ram);if(t&&(t->ownsAnySource()||t->readyForSelection())){auto* c=reo_parent_natural::currentContext();if(!c)throw std::runtime_error("Raw store lacks actual context");t->prepareRawWrite(reo_parent_natural::SourceSpace::Ram,at,data,n,c,c->pc);}}
+void ps2ParentCompleteFastWrite(const void* ram,uint32_t at,uint32_t n){auto t=reo_parent_natural::checked(ram);if(t&&(t->ownsAnySource()||t->readyForSelection())){auto* c=reo_parent_natural::currentContext();if(!c)throw std::runtime_error("Raw store completion lacks actual context");t->completedRawWrite(reo_parent_natural::SourceSpace::Ram,at,n,c,c->pc);}}
+void ps2ParentPrepareContextWrite(R5900Context* c,uint32_t at,const void* data,uint32_t n){auto t=contextTarget(c);if(t)t->prepareRawWrite(reo_parent_natural::SourceSpace::Context,at,data,n,c,c->pc);}
+void ps2ParentCompleteContextWrite(R5900Context* c,uint32_t at,uint32_t n){auto t=contextTarget(c);if(t)t->completedRawWrite(reo_parent_natural::SourceSpace::Context,at,n,c,c->pc);}
+
+namespace reo_parent_natural {
+namespace {std::atomic<bool> firstEntryEnrollmentRequested{false};}
+void setActualFirstEntryEnrollmentRequested(bool value)noexcept{firstEntryEnrollmentRequested.store(value,std::memory_order_release);}
+bool actualFirstEntryEnrollmentRequested()noexcept{return firstEntryEnrollmentRequested.load(std::memory_order_acquire);}
+void ensureActualFirstGraphicsEntry(uint8_t* ram,R5900Context& ctx,PS2Runtime& runtime,uint32_t entry,
+                                   const FirstEntryInvocationHandle& invocation){
+    if(!actualFirstEntryEnrollmentRequested())return;
+    if(ps2IoRegLockDepth()!=0u)throw std::logic_error("First graphics enrollment must leave actual IO ownership");
+    reo_resident_live::FirstEntryVuFrontier frontier{};
+    try{
+        if(!isActualFirstGraphicsEntry(entry)||ram!=runtime.memory().getRDRAM()||ctx.pc!=entry||!invocation||
+           currentRuntime()!=&runtime||currentContext()!=&ctx||!ps2ActualGuestExecutionDepth(&runtime)||runtime.isStopRequested())
+            throw std::runtime_error("First graphics enrollment lacks the actual original entry/EE scope");
+        if(auto existing=findActualOwnerTarget(ram)){existing->requireHealthy();if(existing->runtimeIdentity()!=&runtime||existing->contextIdentity()!=&ctx)throw std::runtime_error("First graphics entry reached a foreign existing source owner");return;}
+        if(!boundedGraphicsFirstEntryMatches(runtime,ctx,entry))return;
+        frontier=reo_resident_live::prepareFirstEntryVuFrontierOnEe(runtime);
+        auto capture=std::shared_ptr<const ColdEntry>(new ColdEntry(invocation,frontier.epoch,frontier.generation,frontier.cold));
+        // The submitting EE retains every recursive GuestExecutionScope level
+        // through snapshot, actual initial upload fence and owner registration.
+        // No Session/arbiter/IO lock survives this real FIFO completion wait.
+        auto request=requestActualFirstEntryEnrollment(capture);request->wait();capture->requireOnEe();
+        auto owner=findActualOwnerTarget(ram);if(!owner||owner->runtimeIdentity()!=&runtime||owner->contextIdentity()!=&ctx||owner->epoch()!=frontier.epoch)
+            throw std::runtime_error("First graphics enrollment did not bind its actual factory owner");
+        owner->requireHealthy();reo_resident_live::completeFirstEntryVuFrontierOnEe(runtime,frontier);
+    }catch(...){reo_resident_live::failFirstEntryVuFrontierOnEe(runtime);throwOwnedSourceFailure(&runtime);}
+}
+} // namespace reo_parent_natural
+
+#include "pre_entry_control_journal.inl"
