index 0000000..c385a0b
--- /dev/null
+++ b/ps2xRuntime/src/lib/instruction_input_evidence.hpp
@@ -0,0 +1,125 @@
+#pragma once
+#include "source_instruction_origin.hpp"
+#include "parent_context_lifecycle.h"
+#include <array>
+namespace reo_source_instrumentation {
+class EntryScope;
+class InstructionInputScope;
+inline thread_local InstructionInputScope* actualInstructionInputs=nullptr;
+struct GuardedInputRead {
+    reo_parent_natural::SourceSpace space;uint32_t offset=0,bytes=0;
+    std::array<uint8_t,16> value{};
+};
+struct GuardedMemoryTransfer {
+    uint32_t effectiveAddress=0,bytes=0;bool fast=false;
+    uint32_t firstRead=0,readCount=0;std::array<uint8_t,16> value{};
+};
+struct InstructionInputLife {bool active=true;uint64_t instruction=0;};
+struct InstructionInputStorage {
+    std::shared_ptr<InstructionInputLife> life=std::make_shared<InstructionInputLife>();
+    std::array<GuardedInputRead,64> inputs{};std::array<GuardedMemoryTransfer,8> memory{};
+};
+class InstructionInputEvidence final {
+    friend class InstructionInputScope;
+    std::shared_ptr<reo_parent_natural::ControlTarget> target_;std::shared_ptr<const InstructionInputLife> life_;
+    PS2Runtime* runtime_;R5900Context* context_;InstructionOrigin origin_;uint64_t epoch_,binding_,instruction_;
+    int32_t task_;std::thread::id thread_;uint32_t reads_,transfers_;
+    std::array<GuardedInputRead,64> inputs_{};std::array<GuardedMemoryTransfer,8> memory_{};
+    InstructionInputEvidence(const InstructionInputScope&);
+public:
+    InstructionInputEvidence(const InstructionInputEvidence&)=delete;
+    const InstructionOrigin& origin()const noexcept{return origin_;}
+    const reo_parent_natural::ControlTarget* issuerTarget()const noexcept{return target_.get();}
+    PS2Runtime& runtime()const noexcept{return *runtime_;}
+    R5900Context& context()const noexcept{return *context_;}
+    uint64_t epoch()const noexcept{return epoch_;}
+    uint64_t bindingGeneration()const noexcept{return binding_;}
+    uint32_t readCount()const noexcept{return reads_;}
+    uint32_t transferCount()const noexcept{return transfers_;}
+    const GuardedInputRead& read(uint32_t index)const{if(index>=reads_)throw std::out_of_range("Instruction read witness");return inputs_[index];}
+    const GuardedMemoryTransfer& transfer(uint32_t index)const{if(index>=transfers_)throw std::out_of_range("Instruction memory-transfer witness");return memory_[index];}
+    void validateBeforeActualCpuStore(const reo_parent_natural::ControlTarget&,R5900Context&,const InstructionOrigin&)const;
+};
+using InstructionInputEvidenceHandle=std::shared_ptr<const InstructionInputEvidence>;
+class CpuInputWriteTarget {
+public:virtual ~CpuInputWriteTarget()=default;
+    virtual reo_parent_natural::SourceWritePermit beginGuardedCpuContextWrite(R5900Context&,const InstructionInputEvidenceHandle&,
+        uint32_t,const void*,uint32_t,const InstructionOrigin&)=0;
+};
+class InstructionInputScope final {
+    friend class EntryScope;friend class InstructionInputEvidence;
+    PS2Runtime* runtime_;R5900Context* context_;InstructionInputScope* prior_;
+    std::shared_ptr<reo_parent_natural::ControlTarget> target_;std::unique_ptr<InstructionInputStorage> storage_;
+    InstructionOrigin origin_{};uint64_t epoch_=0,binding_=0;int32_t task_=0;std::thread::id thread_;
+    uint32_t reads_=0,transfers_=0;
+    InstructionInputScope(PS2Runtime* runtime,R5900Context* context)
+      :runtime_(runtime),context_(context),prior_(actualInstructionInputs),thread_(std::this_thread::get_id()){
+        // This small lifetime token is allocated only on the first owned
+        // instruction/read, not once per ordinary generated function entry.
+        actualInstructionInputs=this;
+    }
+    void validate(const reo_parent_natural::ControlTarget& target,R5900Context& context)const{
+        using namespace reo_parent_natural;
+        if(actualInstructionInputs!=this||currentRuntime()!=runtime_||currentContext()!=context_||&context!=context_||
+           !runtime_||!ps2ActualGuestExecutionDepth(runtime_)||runtime_->isStopRequested()||target.runtimeIdentity()!=runtime_||
+           context.pc!=origin_.pc||!origin_.pc||std::this_thread::get_id()!=thread_)
+            throw std::invalid_argument("Guarded CPU input lacks actual instruction/context scope");
+        if(target_&&(&target!=target_.get()||target.epoch()!=epoch_||actualOwnerBindingGeneration()!=binding_||
+            ps2_sched::currentThread()!=task_))throw std::invalid_argument("Guarded CPU input binding changed within instruction");
+    }
+    void bind(const std::shared_ptr<reo_parent_natural::ControlTarget>& target,R5900Context& context){
+        validate(*target,context);
+        if(!target_){if(!storage_)storage_=std::make_unique<InstructionInputStorage>();target_=target;epoch_=target->epoch();
+            binding_=reo_parent_natural::actualOwnerBindingGeneration();task_=ps2_sched::currentThread();if(task_<1)throw std::invalid_argument("CPU input lacks actual guest task");}
+    }
+public:
+    InstructionInputScope(const InstructionInputScope&)=delete;
+    ~InstructionInputScope(){if(storage_)storage_->life->active=false;actualInstructionInputs=prior_;}
+    void at(uint32_t pc,uint32_t opcode){
+        if(storage_){if(storage_->life->instruction==UINT64_MAX)throw std::overflow_error("Instruction input identity exhausted");++storage_->life->instruction;}
+        origin_={pc,opcode,ContextWriteIntent::NumericOrOpaque};target_.reset();reads_=0;transfers_=0;
+    }
+    void guardedRead(const std::shared_ptr<reo_parent_natural::ControlTarget>& target,R5900Context& context,
+        reo_parent_natural::SourceSpace space,uint32_t offset,const void* value,uint32_t bytes){
+        if(!origin_.pc)return;bind(target,context);
+        if(!value||!bytes||bytes>16||reads_==storage_->inputs.size())throw std::length_error("Guarded CPU input exceeds bounded instruction evidence");
+        auto& read=storage_->inputs[reads_++];read={space,offset,bytes,{}};std::memcpy(read.value.data(),value,bytes);
+    }
+    void guardedMemoryTransfer(const std::shared_ptr<reo_parent_natural::ControlTarget>& target,R5900Context& context,
+        uint32_t effectiveAddress,bool fast,reo_parent_natural::SourceSpace space,uint32_t firstOffset,uint32_t firstBytes,
+        const void* value,uint32_t bytes){
+        if(!origin_.pc)return;bind(target,context);
+        if(!bytes||bytes>16||firstBytes>bytes||!firstBytes||!value||transfers_==storage_->memory.size())
+            throw std::invalid_argument("Actual load transfer exceeds bounded instruction evidence");
+        const uint32_t begin=reads_;guardedRead(target,context,space,firstOffset,value,firstBytes);
+        if(firstBytes<bytes)guardedRead(target,context,space,0,static_cast<const uint8_t*>(value)+firstBytes,bytes-firstBytes);
+        auto& transfer=storage_->memory[transfers_++];transfer={effectiveAddress,bytes,fast,begin,reads_-begin,{}};std::memcpy(transfer.value.data(),value,bytes);
+    }
+    InstructionInputEvidenceHandle capture(R5900Context& context,const InstructionOrigin& origin,const std::shared_ptr<reo_parent_natural::ControlTarget>& selected){
+        using namespace reo_parent_natural;
+        if(!target_){if(!selected)throw std::invalid_argument("CPU input evidence has no actual owner");bind(selected,context);}
+        validate(*target_,context);
+        if(origin.pc!=origin_.pc||origin.word!=origin_.word)throw std::invalid_argument("CPU write differs from original instruction input evidence");
+        return InstructionInputEvidenceHandle(new InstructionInputEvidence(*this));
+    }
+};
+inline InstructionInputEvidence::InstructionInputEvidence(const InstructionInputScope& source)
+ :target_(source.target_),life_(source.storage_->life),runtime_(source.runtime_),context_(source.context_),origin_(source.origin_),epoch_(source.epoch_),
+  binding_(source.binding_),instruction_(source.storage_->life->instruction),task_(source.task_),thread_(source.thread_),reads_(source.reads_),transfers_(source.transfers_),
+  inputs_(source.storage_->inputs),memory_(source.storage_->memory){}
