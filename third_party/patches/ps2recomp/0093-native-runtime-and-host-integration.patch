+            }
+            invalidate(s,at,bytes);
+        }
+    }
+    static PreEntryControlWriteHandle prepare(PS2Runtime& rt,const void* ram,R5900Context& ctx,uint32_t at,const void* data,uint32_t bytes,const reo_source_instrumentation::InstructionOrigin& origin){
+        if(!actualFirstEntryEnrollmentRequested())return {};
+        if(!bytes||at>=0x2000000u||bytes>0x2000000u-at)throw std::out_of_range("Pre-entry control store crosses RAM");
+        std::lock_guard lock(mutex_);auto& s=exact(rt,ram);if(s.generation->frozen.load(std::memory_order_acquire))return {};
+        if(s.pending)throw std::runtime_error("Pre-entry source writer overtook an unfinished store");
+        auto source=actualPreEntryIntegerSource;
+        if(!source){invalidate(s,at,bytes);return {};}
+        // A nested unreviewed body never inherits its caller's last store
+        // marker. Pool scopes likewise certify only their twelve exact sites.
+        if(source->kind()==PreEntryIntegerSource::Kind::Queue&&(source->pc()!=origin.pc||source->word()!=origin.word)){
+            invalidate(s,at,bytes);return {};
+        }
+        if(source->kind()==PreEntryIntegerSource::Kind::Pool){bool known=false;
+            for(uint32_t pc:{0x1a0da0u,0x1a0da4u,0x1a5b18u,0x1a0edcu,0x1a0f1cu,0x1a1074u,0x1a1110u,0x1a11a8u,0x1a122cu,
+                            0x1a13d8u,0x1a1470u,0x1a14c0u,0x1a1534u,0x1a1578u})if(origin.pc==pc)known=true;
