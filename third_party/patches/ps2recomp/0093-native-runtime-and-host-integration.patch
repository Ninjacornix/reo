+FirstEntryVuFrontier prepareFirstEntryVuFrontierOnEe(PS2Runtime& runtime){
+    if(reo_parent_natural::currentRuntime()!=&runtime||!reo_parent_natural::currentContext()||!ps2ActualGuestExecutionDepth(&runtime)||ps2IoRegLockDepth()!=0u)
+        throw std::logic_error("First VU frontier must retain the actual current EE outside IO");
+    auto session=find(runtime.memory());if(!session)throw std::runtime_error("First graphics entry has no actual registered resident VU session");
+    {std::lock_guard<std::recursive_mutex> lock(session->mutex);requireLive(*session);
+      if(session->waitRuntime!=&runtime||session->firstEntryPending)throw std::runtime_error("First VU frontier has a foreign/pending EE source");
+      sealWaitReceipt(*session,Barrier::GuestRead);session->firstEntryPending=true;}
+    // Existing real retirement requests are reused and committed in order.
+    // Every guest-lock level stays held; the GS owner never needs that lock.
+    for(;;){std::shared_ptr<WaitReceipt> receipt;
+        {std::lock_guard<std::recursive_mutex> lock(session->mutex);requireLive(*session);if(session->waitReceipts.empty())break;receipt=session->waitReceipts.front();}
+        auto result=receipt->request->wait();
+        {std::lock_guard<std::recursive_mutex> lock(session->mutex);requireLive(*session);
+          if(receipt->committed||session->waitReceipts.empty()||session->waitReceipts.front()!=receipt)throw std::runtime_error("First VU frontier retirement changed under held EE");
+          validateWaitReceipt(*session,*receipt,result);receipt->committed=true;session->committedWaitCut=receipt->cut;session->waitReceipts.pop_front();}}
+    std::lock_guard<std::recursive_mutex> lock(session->mutex);requireLive(*session);
+    // Deferred IRQ/DMA callbacks are serviced later under the normal genuine
+    // guest completion path; no callback may rewrite this first-entry Context.
+    FirstEntryVuFrontier frontier{session->epoch,session->bankGeneration,{}};
+    if(!session->authoritative){
+        if(session->coldSent||session->pending||!session->submittedOrdinals.empty())throw std::runtime_error("CPU first VU bank already entered a GPU prefix");
+        auto cold=std::make_shared<ColdBank>();std::memcpy(cold->state.data(),&runtime.vu1().state(),StateBytes);
+        if(!runtime.memory().getVU1Data())throw std::runtime_error("Missing actual first VU data");
+        std::memcpy(cold->data.data(),runtime.memory().getVU1Data(),DataBytes);
+        std::memcpy(cold->row.data(),runtime.memory().vif1_regs.row,16);std::memcpy(cold->column.data(),runtime.memory().vif1_regs.col,16);
+        cold->cycle=runtime.memory().vif1_regs.cycle;cold->mode=runtime.memory().vif1_regs.mode;cold->mask=runtime.memory().vif1_regs.mask;
