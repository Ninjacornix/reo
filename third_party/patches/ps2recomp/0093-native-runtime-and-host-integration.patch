+bool integerField(uint32_t at,uint32_t bytes)noexcept{
+    if(!bytes||bytes>16u)return false;
+    if(at<512u)return at/16u==(at+bytes-1u)/16u;
+    return (at==offsetof(R5900Context,pc)&&bytes==4u)||(at==offsetof(R5900Context,branch_pc)&&bytes==4u)||
+        (at==offsetof(R5900Context,in_delay_slot)&&bytes==1u)||(at==offsetof(R5900Context,cop0_status)&&bytes==4u);
+}
+bool integerWriteShape(uint32_t at,uint32_t bytes,const reo_source_instrumentation::InstructionOrigin& o)noexcept{
+    if(!integerField(at,bytes)||!site(o.pc,o.word))return false;
+    if(at==offsetof(R5900Context,pc)||at==offsetof(R5900Context,branch_pc)||at==offsetof(R5900Context,in_delay_slot))return true;
+    if(at==offsetof(R5900Context,cop0_status))return o.word==0x42000038u||o.word==0x42000039u;
