@@ -0,0 +1,17 @@
+#pragma once
+#include "ps2_runtime.h"
+#include <stdexcept>
+namespace reo_parent_natural {
+class OwnedSourceFailure final:public std::runtime_error {
+public:explicit OwnedSourceFailure(const char* message):std::runtime_error(message){}
+};
+// For actual source guard boundaries only. Called inside a catch after the
+// real bound target was selected; ordinary guest faults retain their handler.
+[[noreturn]] inline void throwOwnedSourceFailure(PS2Runtime* runtime){
+    if(runtime)runtime->requestStop();
+    try{throw;}catch(const OwnedSourceFailure&){throw;}catch(const std::exception& e){throw OwnedSourceFailure(e.what());}catch(...){throw OwnedSourceFailure("Owned graphics source guard failed");}
+}
+inline void rethrowOwnedSourceFailure(PS2Runtime* runtime){
+    try{throw;}catch(const OwnedSourceFailure&){if(runtime)runtime->requestStop();throw;}catch(...){}
+}
+}
