+constexpr uint32_t CodeBytes=16384,DataBytes=16384,StateBytes=632;
+constexpr uint32_t MaxOperations=4096,MaxBatchBytes=1u<<20,MaxLaunches=2048;
+enum class Kind:uint8_t {Control,Unpack,DataWrite,ControlByteWrite,Launch,OpaqueLeaseUnpack};
+enum class Barrier:uint8_t {DmaComplete,VifFlush,GuestRead,Reset,Stop};
+struct ColdBank {
+    std::array<uint8_t,StateBytes> state{};
+    std::array<uint8_t,DataBytes> data{};
+    std::array<uint32_t,4> row{},column{};
+    uint32_t cycle=0,mode=0,mask=0,reserved=0;
+};
+// Explicit synchronous CPU<->GPU ownership handoff. Unlike ColdBank (the boot
+// snapshot captured by bindCold), this carries the CURRENT architectural VU
+// state/data/controls at the moment of a CPU->GPU import or a GPU->CPU export.
+// It is never a boot snapshot and never reinitializes an existing bank through
+// the cold() path; the owner applies it as a distinct, epoch/generation-checked
+// operation.
+struct Handoff {
+    uint64_t epoch=0,bankGeneration=0;        // owner verifies against its live bank identity
+    std::array<uint8_t,StateBytes> state{};   // vf/vi/acc/q/p/i/pc/mac/clip/status/ebit/itop/xitop
+    std::array<uint8_t,DataBytes> data{};     // full VU data bank
+    std::array<uint32_t,4> row{},column{};    // VIF ROW/COL
+    uint32_t cycle=0,mode=0,mask=0;
+};
+struct Program {
+    std::array<uint8_t,CodeBytes> exactImage{};
+    std::vector<uint32_t> startPCs;
+    uint64_t bindingId=0;
+    bool canResume=false;
+    // True only for pinned kernels proving source equality before commit.
+    bool literalSourcePreserved=false;
+    bool entryZeroHasNoEvent=false,variableOutputCount=false;
+    uint32_t inputTagOffsetFromTop=1;
+    bool completeSetup=false,completeGeometry=false,completeClipping=false;
+    bool completeCarry=false,orderedEffects=false,exactTermination=false;
+    // Explicit per-program GPU launch admission. Empty/disabled preserves the
+    // record-only CPU fallback for that image. admittedFreshPCs lists exactly
+    // the fresh entry PCs with genuine RETAINED-COLD DEVICE parity evidence
+    // against an independent gold; it is always a subset of startPCs and never
+    // claims MSCNT continuation unless canResume is separately proven.
+    std::vector<uint32_t> admittedFreshPCs;
+    bool gpuAdmitted=false;
+    bool complete()const noexcept {
+        return bindingId && !startPCs.empty() && completeSetup && completeGeometry &&
+            completeClipping && completeCarry && orderedEffects && exactTermination;
+    }
+    bool accepts(uint32_t pc,bool resume)const noexcept {
+        if(!complete())return false;
+        if(resume)return canResume;
+        if((pc&7u)||pc>=CodeBytes)return false;
+        for(const auto value:startPCs)if(value==pc)return true;
+        return false;
+    }
+    // Admission decision for an actual GPU launch. Separate from accepts():
+    // completeness describes registry coverage, NOT bank ownership or the
+    // per-image launch evidence. A fresh launch must hit a device-proven
+    // admittedFreshPCs entry; a resume (MSCNT) launch requires canResume,
+    // which the packager may only assert with same-bank device continuation
+    // parity and which uses the GPU-resident continuation PC/vf0, never the
+    // stale CPU interpreter PC.
+    bool admitsGpu(uint32_t pc,bool resume)const noexcept {
+        if(!gpuAdmitted)return false;
+        if(resume)return canResume;
+        for(const auto value:admittedFreshPCs)if(value==pc)return true;
+        return false;
+    }
+};
+struct LiteralEffect {
+    // Verified literal input command metadata; geometry remains GPU-resident.
+    enum class Type:uint8_t {None,Strip,MaterialAD};
+    Type type=Type::None;
+    uint32_t vertexCapacity=0;
+    std::array<uint32_t,32> echo{};
+};
+struct Operation {
+    Kind kind=Kind::Control;
+    uint32_t command=0,latchedTops=0,controlByte=0;
+    std::vector<uint8_t> payload;
+    std::shared_ptr<const OpaqueLeaseUpload> opaqueLease;
+    std::shared_ptr<const Program> program;
+    uint64_t ordinal=0,codeGeneration=0;
+    uint32_t startPC=0,maxPairs=65536,top=0,itop=0;
+    bool resume=false;
+    std::shared_ptr<const OrderedStreamHint> orderedStream;
+    LiteralEffect effect{};
+};
+struct Batch {
+    uint64_t epoch=0,bankGeneration=0;
+    std::shared_ptr<const ColdBank> cold;
+    std::vector<Operation> operations;
+    uint32_t payloadBytes=0;
+};
+struct Retired {
+    uint64_t epoch=0,bankGeneration=0,ordinal=0;
+    uint32_t actualPairs=0,eventCount=0,status=0;
+    bool ended=false,exhausted=false;
+};
+// Retained PRE-LAUNCH snapshot of a launch the whole-owner verifier refused.
+// The owner captures the exact device state/data banks BEFORE every kernel
+// dispatch with a device-side copy (part of the recorded launch command, not a
+// post-failure read of the mutated live bank) and retains the per-job push and
+// literal-effect metadata at enqueue time. Recovery replays the refused
+// launch's program body on CPU from this snapshot exactly once per session.
+// Because the certified wrapper only commits state/data/events on full success,
+// any wrapper refusal (statuses 20..24 below) leaves no committed graphics
+// effect, which is the second recovery precondition.
+struct RetainedLaunchFailure {
+    bool available=false;
+    uint64_t ordinal=0;
+    uint32_t status=0;
+    uint32_t push[8]{};                        // entryPC,maxPairs,top,itop,operation,capacity,0,0
+    std::array<uint32_t,32> echo{};            // validated literal effect contract words
+    std::array<uint8_t,StateBytes> state{};    // retained pre-dispatch state bank
+    std::array<uint8_t,DataBytes> data{};      // retained pre-dispatch data bank
+    std::array<uint8_t,48> controls{};         // retained pre-dispatch VIF controls: ROW[16] COL[16] cycle[4] mode[4] mask[4] pad[4]
+    uint64_t bindingId=0;                      // program bindingId for exact-image verification
+    uint64_t imageDigest=0;                    // FNV-1a 64 of certified exactImage (captureDigest) for strict replay binding
+};
+// CPU replay diagnostic, armed only around an exact-once verifier-rejection
+// replay. Fields mirror the certified kernel's observable refusal envelope:
+// executed pairs, run termination reason and the bounded XGKICK chain metrics
+// the kernel's emitOrderedXg enforces (<=256 tags, <=16KiB total, EOP end).
+struct ReplayLaunchDiagnostic {
+    bool armed=false;
+    uint32_t executed=0,finalPC=0,kicks=0;
+    bool ended=false,exhausted=false,boundsStop=false;
+    struct Kick { uint32_t sourceVi=0,firstAddr=0,totalBytes=0,tags=0; bool done=false; };
+    Kick kick[8]{};
+};
+void armReplayCapture();
+void sampleReplayCapture(ReplayLaunchDiagnostic& out);
