+#pragma once
+#include "pre_entry_control_journal.h"
+#include "parent_first_entry.h"
+#include <optional>
+void sub_0018DCE0_0x18dce0(uint8_t*,R5900Context*,PS2Runtime*);
+void sub_0018DD40_0x18dd40(uint8_t*,R5900Context*,PS2Runtime*);
+void sub_0018DDD0_0x18ddd0(uint8_t*,R5900Context*,PS2Runtime*);
+namespace reo_parent_natural {
+// This catalogue is instruction metadata, never an issuer or a range grant.
+struct OriginalHeapControlSite {uint32_t entry,pc,word,address;};
+inline const OriginalHeapControlSite* originalHeapControlSite(uint32_t pc)noexcept {
+    static constexpr OriginalHeapControlSite sites[]={
+#include "local_source_catalogues/heap_control_sites.inc"
+    };
+    for(const auto& s:sites)if(s.pc==pc)return &s;return nullptr;
+}
+inline PS2Runtime::RecompiledFunction originalHeapControlBody(uint32_t entry)noexcept {
+    switch(entry){case 0x18dce0u:return &::sub_0018DCE0_0x18dce0;
+      case 0x18dd40u:return &::sub_0018DD40_0x18dd40;
+      case 0x18ddd0u:return &::sub_0018DDD0_0x18ddd0;default:return nullptr;}
+}
+inline bool originalHeapControlDestination(const OriginalHeapControlSite& s,uint32_t address)noexcept {
+    return s.address?address==s.address:address==0x29fdc4u||address==0x29fdc8u;
+}
+class PreEntryHeapSourceScope final {
+    friend void ::sub_0018DCE0_0x18dce0(uint8_t*,R5900Context*,PS2Runtime*);
+    friend void ::sub_0018DD40_0x18dd40(uint8_t*,R5900Context*,PS2Runtime*);
+    friend void ::sub_0018DDD0_0x18ddd0(uint8_t*,R5900Context*,PS2Runtime*);
+    std::optional<AccessScope> actualSourceEntry_;
+    reo_source_instrumentation::InstructionOrigin priorOrigin_=reo_source_instrumentation::actualInstructionOrigin;
+    PreEntryIntegerSourceHandle prior_;std::shared_ptr<PreEntryIntegerSource> source_;
+    std::shared_ptr<PreEntryIntegerSourceLife> life_;
+    uint32_t entry_,pc_=0,word_=0;PS2Runtime* runtime_;R5900Context* context_;
+    PreEntryHeapSourceScope(PS2Runtime* runtime,R5900Context* context,uint32_t entry,PS2Runtime::RecompiledFunction body)
+      :prior_(actualPreEntryIntegerSource),entry_(entry),runtime_(runtime),context_(context){
+        if(!actualFirstEntryEnrollmentRequested())return;
+        if(!runtime||!context||!body||body!=originalHeapControlBody(entry)||context->pc!=entry||runtime->lookupFunction(entry)!=body)
+            throw std::invalid_argument("Heap journal lacks exact registered original entry/body");
+        actualSourceEntry_.emplace(runtime,context);life_=std::make_shared<PreEntryIntegerSourceLife>();
+        // Reuse the existing exact-opcode integer-source representation. No
+        // common class layout/enum or existing Pool/Queue scope is changed.
+        source_=std::shared_ptr<PreEntryIntegerSource>(new PreEntryIntegerSource(PreEntryIntegerSource::Kind::Queue,runtime,context,entry,body,life_,[this]{requireSource();}));
+        actualPreEntryIntegerSource=source_;
+    }
+    void requireSource()const {
+        const auto* site=originalHeapControlSite(pc_);
+        if(!life_||!life_->active.load(std::memory_order_acquire)||actualPreEntryIntegerSource!=source_||context_->pc!=pc_||
+           !site||site->entry!=entry_||site->word!=word_||runtime_->lookupFunction(entry_)!=originalHeapControlBody(entry_))
+            throw std::invalid_argument("Heap control source is outside its exact original store lifetime");
+        uint32_t base=0;const uint32_t rs=(word_>>21u)&31u;if(rs)std::memcpy(&base,&context_->r[rs],4u);
+        const uint32_t address=(base+uint32_t(int32_t(int16_t(word_))))&PS2_RAM_MASK;
+        if((word_>>26u)!=0x2bu||!originalHeapControlDestination(*site,address))
+            throw std::invalid_argument("Heap original store is outside its fixed control destination catalogue");
+        if(entry_==0x18dce0u){uint32_t index=0;std::memcpy(&index,&context_->r[16],4u);
+            if(index<1u||index>2u||address!=0x29fdc4u+(index-1u)*4u)
+                throw std::invalid_argument("Heap handle store lost its actual two-arena initializer cursor");}
+    }
+public:
+    PreEntryHeapSourceScope(const PreEntryHeapSourceScope&)=delete;
+    ~PreEntryHeapSourceScope(){if(life_)life_->active.store(false,std::memory_order_release);if(source_){actualPreEntryIntegerSource=prior_;reo_source_instrumentation::actualInstructionOrigin=priorOrigin_;}}
+    void at(uint32_t pc,uint32_t word){if(!source_)return;pc_=pc;word_=word;reo_source_instrumentation::actualInstructionOrigin=reo_source_instrumentation::classifyInstruction(pc,word);source_->at(pc,word);source_->requireCurrent();}
+};
+}
