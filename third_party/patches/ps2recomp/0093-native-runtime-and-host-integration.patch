new file mode 100644
index 0000000..c963cf6
--- /dev/null
+++ b/ps2xRuntime/src/lib/gpu_resume_observer.h
@@ -0,0 +1,61 @@
+#pragma once
+#include "gpu_resume_collector.h"
+namespace reo_gpu_resume_observer {
+inline std::unique_ptr<reo_gpu_resume_capture::Collector> collector;
+inline std::once_flag configuration;
+inline std::mutex captureMutex;
+inline bool requested=false;
+using Ticket=reo_gpu_resume_capture::Ticket;
+inline uint32_t bounded(const char* name,uint32_t fallback) {
+    const auto* raw=std::getenv(name);const auto value=raw?std::strtoul(raw,nullptr,0):fallback;
+    if(!value||value>128)throw std::invalid_argument("Readonly launch capture limit must be1..128");
+    return uint32_t(value);
+}
+inline void configure() noexcept {
+    const char* resume=std::getenv("REO_GPU_RESUME_CAPTURE_DIR");
+    const char* continuity=std::getenv("REO_GPU_CONTINUITY_CAPTURE_DIR");
+    if((!resume||!*resume)&&(!continuity||!*continuity))return;requested=true;
+    try {
+        const char* listing=std::getenv("REO_GPU_RESUME_IMAGE_LIST");
+        if(!listing||!*listing)listing=std::getenv("REO_GPU_FRESH_IMAGE_LIST");
+        if(!listing||!*listing)throw std::runtime_error("Missing exact readonly resume image listing");
+        std::ifstream file(listing);if(!file)throw std::runtime_error("Cannot read readonly resume listing");
+        std::vector<reo_gpu_resume_capture::Identity> images;std::string line;
+        while(std::getline(file,line)){
+            if(line.empty())continue;std::istringstream fields(line);std::string digest,binding,entries,path;
+            if(!std::getline(fields,digest,'\t')||!std::getline(fields,binding,'\t')||
+               !std::getline(fields,entries,'\t')||!std::getline(fields,path))throw std::runtime_error("Malformed readonly resume listing");
+            if(!path.empty()&&path.back()=='\r')path.pop_back();
+            reo_gpu_resume_capture::Identity image;image.digest=digest;image.bindingId=std::stoull(binding,nullptr,0);
+            std::ifstream raw(path,std::ios::binary);raw.read(reinterpret_cast<char*>(image.image.data()),image.image.size());
+            if(raw.gcount()!=16384||raw.peek()!=std::char_traits<char>::eof())throw std::runtime_error("Readonly resume image must contain exactly16KiB");
+            // Fresh entries are retained in the identity listing but never
+            // used to restrict the actual resident resume PC.
+            std::istringstream pcs(entries);std::string pc;
+            while(std::getline(pcs,pc,','))image.entries.push_back(uint32_t(std::stoul(pc,nullptr,0)));
+            images.push_back(std::move(image));
+        }
+        const auto* startImage=std::getenv("REO_GPU_CONTINUITY_START_IMAGE");
+        const auto* selector=std::getenv("REO_GPU_CONTINUITY_START_SELECTOR");
+        const auto* after=std::getenv("REO_GPU_CONTINUITY_AFTER_SECONDS");
+        collector=std::make_unique<reo_gpu_resume_capture::Collector>(std::move(images),resume?resume:"",continuity?continuity:"",
+            bounded("REO_GPU_RESUME_CAPTURE_LIMIT",128),bounded("REO_GPU_CONTINUITY_CAPTURE_LIMIT",64),
+            startImage?startImage:"",selector?uint32_t(std::stoul(selector,nullptr,0)):std::numeric_limits<uint32_t>::max(),after?std::stod(after):0.0);
+        std::fprintf(stderr,"[GPU-RESUME] bounded readonly resident-PC/continuity capture enabled; no geometry replacement\n");
+    }catch(const std::exception& error){std::fprintf(stderr,"[GPU-RESUME] capture disabled: %s\n",error.what());}
+}
+inline Ticket begin(const uint8_t* code,const uint8_t* data,const void* state,size_t bytes,uint32_t pc,
+                    uint32_t top,uint32_t itop,bool resume,const void* regs,size_t regBytes) noexcept {
+    std::call_once(configuration,configure);if(!requested)return {};
+    std::lock_guard<std::mutex> lock(captureMutex);if(!collector)return {};
+    try{return collector->begin(code,data,state,bytes,pc,top&1023u,itop&1023u,resume,regs,regBytes);}
+    catch(const std::exception& error){std::fprintf(stderr,"[GPU-RESUME] capture stopped: %s\n",error.what());collector.reset();return {};}
+}
+inline void finish(const Ticket& ticket,const uint8_t* code,const uint8_t* data,const void* state,size_t bytes,
+                   const void* regs,size_t regBytes) noexcept {
+    if(ticket.resumeStem.empty()&&ticket.continuityStem.empty())return;
+    std::lock_guard<std::mutex> lock(captureMutex);if(!collector)return;
+    try{collector->finish(ticket,code,data,state,bytes,regs,regBytes);}
+    catch(const std::exception& error){std::fprintf(stderr,"[GPU-RESUME] return capture stopped: %s\n",error.what());collector.reset();}
+}
+}
