+    // Preserve the original scalar path for all nonfinite inputs, including
+    // NaN payload/operand selection. Finite operations retain separate rounding.
+    inline bool vuPackedFinite(__m128 value)
+    {
+        const __m128i exponent=_mm_set1_epi32(0x7F800000);
+        const __m128i bits=_mm_and_si128(_mm_castps_si128(value),exponent);
+        return _mm_movemask_ps(_mm_castsi128_ps(_mm_cmpeq_epi32(bits,exponent)))==0;
+    }
+    inline void vuPackedDest(float* dst,__m128 result,uint8_t dest)
+    {
+        if(dest==15) { _mm_storeu_ps(dst,result);return; }
+        alignas(16) static constexpr uint32_t masks[16][4]={
+            {0,0,0,0},{0,0,0,~0u},{0,0,~0u,0},{0,0,~0u,~0u},
+            {0,~0u,0,0},{0,~0u,0,~0u},{0,~0u,~0u,0},{0,~0u,~0u,~0u},
+            {~0u,0,0,0},{~0u,0,0,~0u},{~0u,0,~0u,0},{~0u,0,~0u,~0u},
+            {~0u,~0u,0,0},{~0u,~0u,0,~0u},{~0u,~0u,~0u,0},{~0u,~0u,~0u,~0u}};
+        const __m128 mask=_mm_castsi128_ps(_mm_load_si128(reinterpret_cast<const __m128i*>(masks[dest])));
+        const __m128 previous=_mm_loadu_ps(dst);
+        _mm_storeu_ps(dst,_mm_or_ps(_mm_and_ps(mask,result),_mm_andnot_ps(mask,previous)));
+    }
+    inline bool vuPackedBroadcast(float* dst,const float* src,float scalar,const float* acc,uint8_t dest)
+    {
+        const __m128 source=_mm_loadu_ps(src),broadcast=_mm_set1_ps(scalar);
+        if(!vuPackedFinite(source)||!vuPackedFinite(broadcast)) return false;
+        __m128 accumulator;
+        if(acc) {accumulator=_mm_loadu_ps(acc);if(!vuPackedFinite(accumulator)) return false;}
+        // Baseline MSVC MADDbc/MADDAbc: broadcast*source, then product+ACC.
+        // MULA's x lane has reversed multiply operands; finite inputs have the
+        // same bits in both orders. Nonfinite values stay on the scalar path.
+        __m128 result=_mm_mul_ps(broadcast,source);
+        if(acc) result=_mm_add_ps(result,accumulator);
+        vuPackedDest(dst,result,dest);return true;
+    }
+#endif
