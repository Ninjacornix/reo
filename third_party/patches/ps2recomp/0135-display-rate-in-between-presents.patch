+    // REO_DISPLAY_RATE=N (61..360): the GS worker, which owns the backend route, presents the
+    // last displayed image again between queue items on a fixed grid of display intervals.
+    // Slots within half an interval of a scanout capture are skipped, so presents total about
+    // N per second. Repeats only re-show the last image (the presenter camera-warps them).
+    std::chrono::microseconds displayRepeatInterval()
+    {
+        static const std::chrono::microseconds interval = [] {
+            const char* v = std::getenv("REO_DISPLAY_RATE");
+            const int rate = v ? std::atoi(v) : 0;
+            return std::chrono::microseconds(rate > 60 && rate <= 360 ? 1000000 / rate : 0);
+        }();
+        return interval;
+    }
+    std::chrono::steady_clock::time_point g_nextRepeat{}, g_lastCapture{};
+    std::atomic<uint64_t> g_displayRepeats{0};
+    void presentRepeatIfDue()
+    {
+        const auto interval = displayRepeatInterval();
+        if (interval.count() == 0 || !gs_backend_bridge::active()) return;
+        const auto now = std::chrono::steady_clock::now();
+        if (g_nextRepeat.time_since_epoch().count() == 0 || g_nextRepeat < now - interval) g_nextRepeat = now + interval;
+        if (now < g_nextRepeat) return;
+        g_nextRepeat += interval;
+        if (now - g_lastCapture < interval / 2) return;
+        bool presented = false;
+        try { if (g_backendRoute.presentRepeat(presented) && presented) g_displayRepeats.fetch_add(1, std::memory_order_relaxed); }
+        catch (...) {}  // a failed backend is reported by its regular path
+    }
