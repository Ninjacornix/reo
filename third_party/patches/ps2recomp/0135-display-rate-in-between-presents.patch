+// Called from the REO_DISPLAY_RATE helper thread: wait for the GS owner only briefly (the
+// route is busy with GS work most of the time; a shutdown may hold it while it waits on
+// other threads), then skip this repeat.
+bool Route::presentRepeat(bool& presented) {
+    presented = false;
+    std::unique_lock<std::mutex> lock(mutex_, std::defer_lock);
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::microseconds(3000);
+    while (!lock.try_lock()) {
+        if (std::chrono::steady_clock::now() >= deadline) return false;
+        std::this_thread::sleep_for(std::chrono::microseconds(100));
+    }
+    if (state_ != State::Accelerated) return false;
+    try { presented = backend_->presentRepeat(); }
+    catch (const std::exception& e) { error_ = e.what(); state_ = State::Failed; throw; }
+    catch (...) { error_ = "GPU backend execution failed"; state_ = State::Failed; throw; }
+    return true;
+}
 bool Route::residentParentControl(const std::function<void(reo_parent_natural::ControlTarget&)>& call) {
     if(!call)throw std::invalid_argument("Missing actual parent owner work");
     return execute([&](Backend& owner){owner.residentParentControl(call);});
