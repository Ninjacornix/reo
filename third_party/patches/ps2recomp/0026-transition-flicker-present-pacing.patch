+// Blocks until a snapshot newer than `seenSeq` exists or `timeoutMs` passes (D44); waking on
+// a condition variable avoids the coarse Windows sleep granularity that made presents jitter.
+uint64_t ps2GsWaitVblank(uint64_t seenSeq, int timeoutMs)
+{
+    std::unique_lock<std::mutex> lock(g_vblankWaitMutex);
+    g_vblankCv.wait_for(lock, std::chrono::milliseconds(timeoutMs),
+                        [seenSeq] { return g_vblankSeq.load(std::memory_order_acquire) != seenSeq; });
+    return g_vblankSeq.load(std::memory_order_acquire);
+}
 
