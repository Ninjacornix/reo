diff --git a/ps2xRuntime/src/lib/vu_cost_attribution.h b/ps2xRuntime/src/lib/vu_cost_attribution.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu_cost_attribution.h
@@ -0,0 +1,27 @@
+#pragma once
+// Private opt-in bounded diagnostics; no public runtime class fields.
+#include <cstdint>
+namespace vu_specialized {struct Program;}
+namespace vu_cost_attribution {
+struct Snapshot {uint64_t prepNs=0u,submitNs=0u;};
+class DmaScope {
+ void* impl_=nullptr;
+public:
+ explicit DmaScope(bool boundedKickSelected) noexcept;
+ ~DmaScope() noexcept;
+ DmaScope(const DmaScope&)=delete;
+ DmaScope& operator=(const DmaScope&)=delete;
+ void complete(uint32_t kickNumber) noexcept;
+};
+bool configured() noexcept;
+bool active() noexcept;
+Snapshot beginLaunch() noexcept;
+// Feed ONLY already-measured existing stage0/1 deltas. No clocks here.
+void recordStage(unsigned stage,uint64_t ns) noexcept;
+// Use the EXISTING full-run clock result/nativeattempt duration, once per launch.
+// key is the exact legacy Program* selected by the real full-image selector;
+// unknown firstPair is a coarse bucket ONLY, never collision-free identity.
+void recordRun(const vu_specialized::Program* key,uint64_t unknownFirstPair,
+ uint32_t startPC,Snapshot begin,uint64_t wallNs,uint64_t nativeNs,uint32_t pairs,
+ uint64_t nativePairs,uint64_t matchedPairs,uint64_t nativeLoops,uint64_t attempts) noexcept;
+}
diff --git a/ps2xRuntime/src/lib/vu_cost_attribution.cpp b/ps2xRuntime/src/lib/vu_cost_attribution.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu_cost_attribution.cpp
@@ -0,0 +1,76 @@
+#include "vu_cost_attribution.h"
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+namespace vu_cost_attribution {
+namespace {
+struct Bucket {
+ const vu_specialized::Program* key=nullptr;
+ uint64_t unknownFirstPair=0u;
+ uint32_t startPC=0u;
+ uint64_t calls=0u,wallNs=0u,prepNs=0u,submitNs=0u,nativeNs=0u;
+ uint64_t pairs=0u,nativePairs=0u,matchedPairs=0u,nativeLoops=0u,attempts=0u;
+};
+struct Work {
+ Work* previous=nullptr;
+ std::array<Bucket,64> buckets{};
+ uint32_t used=0u;
+ uint64_t prepNs=0u,submitNs=0u,droppedCalls=0u,droppedNs=0u,droppedPairs=0u,violations=0u;
+};
+thread_local Work* current=nullptr;
+}
+bool configured() noexcept {
+ static const bool setting=[]{const char* text=std::getenv("REO_VU_COST_ATTRIBUTION");return text&&std::strcmp(text,"1")==0;}();
+ return setting;
+}
+bool active() noexcept {return current!=nullptr;}
+DmaScope::DmaScope(bool selected) noexcept {
+ if(!selected||!configured())return;
+ if(auto* work=new(std::nothrow) Work) {work->previous=current;current=work;impl_=work;}
+}
+DmaScope::~DmaScope() noexcept {
+ if(auto* work=static_cast<Work*>(impl_)){current=work->previous;delete work;}
+}
+Snapshot beginLaunch() noexcept {return current?Snapshot{current->prepNs,current->submitNs}:Snapshot{};}
+void recordStage(unsigned stage,uint64_t ns) noexcept {
+ if(!current)return;
+ if(stage==0u)current->prepNs+=ns;
+ else if(stage==1u)current->submitNs+=ns;
+}
+void recordRun(const vu_specialized::Program* key,uint64_t prefix,uint32_t pc,
+ Snapshot begin,uint64_t wall,uint64_t native,uint32_t pairs,uint64_t nativePairs,
+ uint64_t matchedPairs,uint64_t loops,uint64_t attempts) noexcept {
+ auto* work=current;if(!work)return;
+ const uint64_t prep=work->prepNs-begin.prepNs,submit=work->submitNs-begin.submitNs;
+ if(prep>wall||submit>wall-prep||native>wall-prep-submit||nativePairs>matchedPairs||matchedPairs>pairs)
+  ++work->violations;
+ if(key)prefix=0u;
+ Bucket* bucket=nullptr;
+ for(uint32_t i=0u;i<work->used;++i)
+  if(work->buckets[i].key==key&&work->buckets[i].unknownFirstPair==prefix&&work->buckets[i].startPC==pc){bucket=&work->buckets[i];break;}
+ if(!bucket){
+  if(work->used==work->buckets.size()){++work->droppedCalls;work->droppedNs+=wall;work->droppedPairs+=pairs;return;}
+  bucket=&work->buckets[work->used++];bucket->key=key;bucket->unknownFirstPair=prefix;bucket->startPC=pc;
+ }
+ ++bucket->calls;bucket->wallNs+=wall;bucket->prepNs+=prep;bucket->submitNs+=submit;bucket->nativeNs+=native;
+ bucket->pairs+=pairs;bucket->nativePairs+=nativePairs;bucket->matchedPairs+=matchedPairs;bucket->nativeLoops+=loops;bucket->attempts+=attempts;
+}
+void DmaScope::complete(uint32_t number) noexcept {
+ const auto* work=static_cast<const Work*>(impl_);if(!work)return;
+ for(uint32_t i=0u;i<work->used;++i){const auto& b=work->buckets[i];
+  const bool valid=b.prepNs<=b.wallNs&&b.submitNs<=b.wallNs-b.prepNs&&b.nativeNs<=b.wallNs-b.prepNs-b.submitNs&&b.nativePairs<=b.matchedPairs&&b.matchedPairs<=b.pairs;
+  const uint64_t nonXg=valid?b.wallNs-b.prepNs-b.submitNs:0u;
+  const uint64_t residual=valid?nonXg-b.nativeNs:0u;
+  std::fprintf(stderr,"[VU-PROGRAM-COST] kick=%u known=%u key=%p unknown_first_pair=%016llx entry=%04x calls=%llu wall_ns=%llu prep_ns=%llu submit_ns=%llu native_ns=%llu non_xg_ns=%llu residual_ns=%llu pairs=%llu native_pairs=%llu fixed_pairs=%llu generic_pairs=%llu native_loops=%llu attempts=%llu valid=%u\n",
+   number,unsigned(b.key!=nullptr),static_cast<const void*>(b.key),static_cast<unsigned long long>(b.unknownFirstPair),b.startPC,
+   static_cast<unsigned long long>(b.calls),static_cast<unsigned long long>(b.wallNs),static_cast<unsigned long long>(b.prepNs),static_cast<unsigned long long>(b.submitNs),
+   static_cast<unsigned long long>(b.nativeNs),static_cast<unsigned long long>(nonXg),static_cast<unsigned long long>(residual),static_cast<unsigned long long>(b.pairs),
+   static_cast<unsigned long long>(b.nativePairs),static_cast<unsigned long long>(valid?b.matchedPairs-b.nativePairs:0u),static_cast<unsigned long long>(valid?b.pairs-b.matchedPairs:0u),
+   static_cast<unsigned long long>(b.nativeLoops),static_cast<unsigned long long>(b.attempts),unsigned(valid));
+ }
+ std::fprintf(stderr,"[VU-PROGRAM-COST-END] kick=%u buckets=%u dropped_calls=%llu dropped_ns=%llu dropped_pairs=%llu violations=%llu\n",number,work->used,
+  static_cast<unsigned long long>(work->droppedCalls),static_cast<unsigned long long>(work->droppedNs),static_cast<unsigned long long>(work->droppedPairs),static_cast<unsigned long long>(work->violations));
+}
+}
