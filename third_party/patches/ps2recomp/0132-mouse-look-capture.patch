+    // Mouse look for native camera mods (0132). Requested from the game thread;
+    // capture, raw-input deltas and cursor clipping live on the window thread.
+    std::atomic<bool> g_mouseLookRequested{false};
+    std::atomic<int> g_mouseDx{0}, g_mouseDy{0}, g_mouseWheel{0};
