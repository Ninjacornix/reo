+// Mouse look API for native camera mods (0132). Safe from any thread.
+void ps2HostSetMouseLook(bool enabled)
+{
+    g_mouseLookRequested.store(enabled);
+}
+// Drains accumulated relative motion and wheel since the last call. Returns
+// whether the cursor is currently captured for mouse look.
+bool ps2HostTakeMouseDelta(int *dx, int *dy, int *wheel)
+{
+    if (dx) *dx = g_mouseDx.exchange(0);
+    if (dy) *dy = g_mouseDy.exchange(0);
+    if (wheel) *wheel = g_mouseWheel.exchange(0);
+    return g_mouseCaptured;
+}
