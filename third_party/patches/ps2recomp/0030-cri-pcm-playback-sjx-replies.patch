--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/Syscalls/Helpers/CriAudio.cpp
@@ -0,0 +1,115 @@
+#include "CriAudio.h"
+#include "ps2_host_backend.h"
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <unordered_map>
+
+namespace ps2_cri_audio {
+namespace {
+constexpr uint32_t outputRate=48000;
+struct Channel { std::deque<int16_t> pcm; uint64_t queued=0, consumed=0; };
+struct Voice { uint32_t left=0,right=0,channels=0,frequency=48000,volume=256; bool playing=false; double phase=0; };
+std::mutex mutex;
+std::unordered_map<uint32_t,Channel> channels;
+std::unordered_map<uint32_t,Voice> voices;
+AudioStream stream{};
+bool ready=false;
+uint64_t outputFrames=0, signalFrames=0, underrunFrames=0;
+auto lastTick=std::chrono::steady_clock::now();
+auto lastReport=lastTick;
+uint64_t lastFrames=0,lastSignal=0,lastUnderrun=0;
+
+// Called by raylib's audio thread. Its sample requests provide the playback clock.
+void renderLocked(float* dst, unsigned frames) {
+    if (dst) std::fill(dst,dst+frames*2,0.0f);
+    for (unsigned i=0;i<frames;++i) {
+        float l=0,r=0; bool starved=false;
+        for (auto& entry:voices) {
+            Voice& v=entry.second;
+            if (!v.playing || !v.left || !v.channels) continue;
+            auto li=channels.find(v.left), ri=channels.find(v.right);
+            if (li==channels.end() || li->second.pcm.empty() ||
+                (v.channels>1 && (ri==channels.end() || ri->second.pcm.empty()))) { starved=true; continue; }
+            const float gain=std::min(v.volume,256u)/256.0f/32768.0f;
+            l+=li->second.pcm.front()*gain;
+            r+=(v.channels>1?ri->second.pcm.front():li->second.pcm.front())*gain;
+            v.phase+=v.frequency/static_cast<double>(outputRate);
+            while (v.phase>=1.0) {
+                if (li->second.pcm.empty() || (v.channels>1 && ri->second.pcm.empty())) break;
+                li->second.pcm.pop_front(); li->second.consumed+=2;
+                if (v.channels>1) { ri->second.pcm.pop_front();ri->second.consumed+=2; }
+                v.phase-=1.0;
+            }
+        }
+        if (dst) { dst[i*2]=std::clamp(l,-1.0f,1.0f); dst[i*2+1]=std::clamp(r,-1.0f,1.0f); }
+        ++outputFrames;
+        signalFrames+=(l!=0 || r!=0);
+        underrunFrames+=starved;
+    }
+}
+void callback(void* buffer, unsigned frames) { std::lock_guard<std::mutex> lock(mutex); renderLocked(static_cast<float*>(buffer),frames); }
+void ensureOutput() {
+    if (ready || !IsAudioDeviceReady()) return;
+    // A small source buffer bounds prefetch latency to approximately 11 ms.
+    SetAudioStreamBufferSizeDefault(512);
+    stream=LoadAudioStream(outputRate,32,2);
+    if (!IsAudioStreamValid(stream)) return;
+    SetAudioStreamCallback(stream,callback);
+    ready=true;
+    PlayAudioStream(stream);
+    std::fprintf(stderr,"[CRI-AUDIO] output ready: signed PCM16 -> stereo float32, 48000 Hz\n");
+}
+void tickLocked() {
+    const auto now=std::chrono::steady_clock::now();
+    if (!ready) {
+        // Deterministic wall-clock progress for headless tests; retains PCM rate,
+        // stereo pairing and fractional frames rather than assuming ADX bytes.
+        const auto ns=std::chrono::duration_cast<std::chrono::nanoseconds>(now-lastTick).count();
+        const uint64_t n=std::min<uint64_t>(outputRate/4,static_cast<uint64_t>(std::max<int64_t>(0,ns))*outputRate/1000000000ull);
+        if (n) { renderLocked(nullptr,static_cast<unsigned>(n));lastTick+=std::chrono::nanoseconds(n*1000000000ull/outputRate); }
+    }
+    if (now-lastReport>=std::chrono::seconds(1)) {
+        size_t queued=0;for(const auto& c:channels) queued+=c.second.pcm.size();
+        std::fprintf(stderr,"[CRI-AUDIO] frames=%llu signal=%llu underrun=%llu queuedSamples=%zu host=%d\n",
+          static_cast<unsigned long long>(outputFrames-lastFrames),static_cast<unsigned long long>(signalFrames-lastSignal),
+          static_cast<unsigned long long>(underrunFrames-lastUnderrun),queued,ready?1:0);
+        lastReport=now;lastFrames=outputFrames;lastSignal=signalFrames;lastUnderrun=underrunFrames;
+    }
+}
+}
+bool queue(uint32_t key,const uint8_t* bytes,uint32_t length,uint64_t& endByte) {
+    if (!key || !bytes || !length || (length&1) || length>0x4000) return false;
+    ensureOutput();
+    std::lock_guard<std::mutex> lock(mutex);tickLocked();
+    auto& c=channels[key];
+    if(c.pcm.size()+length/2>outputRate*2) return false;
+    for(uint32_t i=0;i<length;i+=2) { int16_t x;std::memcpy(&x,bytes+i,2);c.pcm.push_back(x); }
+    // Diagnostic capture runs on the guest producer, never the audio callback.
+    // Bounded to eight seconds per channel; files stay in the smoke directory.
+    if (std::getenv("REO_CRI_PCM_DUMP") && c.queued < outputRate*2u*8u) {
+        char name[64];std::snprintf(name,sizeof(name),"cri-pcm-%08x.raw",key);
+        if (FILE* f=std::fopen(name,c.queued?"ab":"wb")) {
+            std::fwrite(bytes,1,std::min<uint64_t>(length,outputRate*2u*8u-c.queued),f);
+            std::fclose(f);
+        }
+    }
+    c.queued+=length;endByte=c.queued;return true;
+}
+void configure(uint32_t voice,uint32_t left,uint32_t right,uint32_t nch,uint32_t freq,uint32_t vol,bool playing) {
+    ensureOutput();std::lock_guard<std::mutex> lock(mutex);tickLocked();
+    auto& v=voices[voice];v.left=left;v.right=right;v.channels=std::min(nch,2u);
+    v.frequency=std::clamp(freq?freq:48000u,8000u,96000u);v.volume=vol;v.playing=playing;
+}
+uint64_t consumed(uint32_t key) { std::lock_guard<std::mutex> lock(mutex);tickLocked();auto i=channels.find(key);return i==channels.end()?0:i->second.consumed; }
+void discard(uint32_t key) { std::lock_guard<std::mutex> lock(mutex);auto i=channels.find(key);if(i!=channels.end()){i->second.pcm.clear();i->second.consumed=i->second.queued;} }
+void reset() { std::lock_guard<std::mutex> lock(mutex);channels.clear();voices.clear();lastTick=std::chrono::steady_clock::now(); }
+void shutdown() {
+    if (ready && IsAudioDeviceReady()) { StopAudioStream(stream);UnloadAudioStream(stream); }
+    ready=false;stream={};reset();
+}
+}
