+// Private copied-runtime glue. A queued control callback owns all inputs and
+// outputs. Never capture a guest buffer or a caller's stack by reference.
+namespace {
+std::atomic<uint64_t> g_backendControlQueuedCount{0};
+bool gsBackendRouteTestEnabled()
+{
+    static const bool enabled = [] {
+        const char* value = std::getenv("REO_GS_BACKEND_ROUTE_TEST");
+        return value && std::atoi(value) != 0;
+    }();
+    return enabled;
+}
+// Same guest-visible SIGNAL/FINISH/LABEL effects as the serial GS. A concrete
+// adapter must deliver this at GPU completion, not on its parser callback.
+// Atomic status/ID publication preserves concurrent guest acknowledgments.
+void gsBackendCompletedEvent(GSRegisters* regs, uint8_t addr, uint64_t payload)
+{
+    if (!regs || ps2GsWorkerStopRequested()) return;
+    std::lock_guard<std::mutex> frontLock(g_gsPrivFrontMutex);
+    if (gs_backend_bridge::active() && (!t_backendEpoch || t_backendEpoch != gsPrivCurrentEpoch())) return;
+    const uint32_t id = uint32_t(payload), mask = uint32_t(payload >> 32);
+    if (addr == 0x60) {
+        gsPrivUpdate(regs->siglblid, [=](uint64_t old) {
+            return (old & 0xFFFFFFFF00000000ull) | ((uint32_t(old)&~mask)|(id&mask));
+        });
+        gsPrivUpdate(regs->csr, [](uint64_t old) { return old|1u; });
+        if (!(gsPrivLoad(regs->imr) & (1ull << 8))) ps2_syscalls::raiseIntcInterrupt(0u);
+    } else if (addr == 0x61) {
+        gsPrivUpdate(regs->csr, [](uint64_t old) { return old|2u; });
+        if (!(gsPrivLoad(regs->imr) & (1ull << 9))) ps2_syscalls::raiseIntcInterrupt(0u);
+    } else if (addr == 0x62) {
+        gsPrivUpdate(regs->siglblid, [=](uint64_t old) {
+            return (uint64_t((uint32_t(old>>32)&~mask)|(id&mask))<<32) | uint32_t(old);
+        });
+    }
+}
+struct GsBackendReply {
+    std::atomic<bool> done{false};
+    std::exception_ptr error;
+};
+std::shared_ptr<GsBackendReply> gsSubmitBackendControl(std::function<void()> fn)
+{
+    const uint64_t submittedEpoch = t_backendEpoch ? t_backendEpoch : gsPrivCurrentEpoch();
+    auto reply = std::make_shared<GsBackendReply>();
+    auto work = [reply, submittedEpoch, fn = std::move(fn)] {
+        const GsBackendEpochScope ownerEpoch(submittedEpoch);
+        try { fn(); } catch (...) { reply->error = std::current_exception(); }
+        reply->done.store(true, std::memory_order_release);
+        g_gsAsync.drained.notify_all();
+    };
+    if (t_isGsWorker || !gsThreadEnabled()) { work(); return reply; }
+    std::unique_lock<std::mutex> lock(g_gsAsync.m);
+    if (g_gsAsync.stopping) return reply;
+    // Bounded control metadata charged as 16 bytes, and independent of drawing
+    // pacing marks. A backend must not require an EE callback for completion.
+    g_gsAsync.drained.wait(lock, [] {
+        return g_gsAsync.stopping || g_gsAsync.queuedBytes + 16u <= kGsQueueMaxBytes;
+    });
+    if (g_gsAsync.stopping) return reply;
+    if (!g_gsAsync.started) {
+        g_gsAsync.started = true;
+        g_gsAsync.worker = std::thread(gsWorkerMain, g_gsInstance);
+    }
+    GsQueueItem item;
+    item.epoch = submittedEpoch;
+    item.isPacket = false;
+    item.control = std::move(work);
+    item.data.resize(16u);
+    ++g_gsAsync.enqueued;
+    g_gsAsync.queuedBytes += item.data.size();
+    g_gsAsync.queue.push_back(std::move(item));
+    if (gsBackendRouteTestEnabled())
+        g_backendControlQueuedCount.fetch_add(1u, std::memory_order_release);
+    lock.unlock();
+    g_gsAsync.work.notify_one();
+    return reply;
+}
+bool gsBackendControl(std::function<void()> fn)
+{
+    auto reply = gsSubmitBackendControl(std::move(fn));
+    if (!reply->done.load(std::memory_order_acquire)) {
+        std::unique_lock<std::mutex> lock(g_gsAsync.m);
+        g_gsAsync.drained.wait(lock, [&] {
+            return g_gsAsync.stopping || reply->done.load(std::memory_order_acquire);
+        });
+    }
+    // On cancellation the callback might still execute until host join; all
+    // callers below use shared owned storage, so this cannot access dead stack.
+    if (!reply->done.load(std::memory_order_acquire)) return false;
+    if (reply->error) {
+        ps2GsRequestWorkerStop();
+        std::rethrow_exception(reply->error);
+    }
+    return true;
+}
+bool gsBackendTransfer(uint8_t* dst, uint32_t maxBytes, uint32_t& count)
+{
+    if (!gs_backend_bridge::active()) return false;
+    if (!dst || !maxBytes) { count = 0; return true; }
+    struct Result { std::vector<uint8_t> bytes; uint32_t count = 0; };
+    auto result = std::make_shared<Result>();
+    result->bytes.resize(maxBytes);
+    const bool completed = gsBackendControl([result, maxBytes] {
+        g_backendRoute.readTransfer(result->bytes.data(), maxBytes, result->count);
+    });
+    count = completed ? result->count : 0;
+    if (count) std::memcpy(dst, result->bytes.data(), count);
+    return true;
+}
+bool gsBackendClear(uint32_t context, uint32_t rgba, bool active, bool& result)
+{
+    if (!gs_backend_bridge::active()) return false;
+    auto answer = std::make_shared<bool>(false);
+    const bool completed = gsBackendControl([answer, context, rgba, active] {
+        g_backendRoute.clear(context, rgba, active, *answer);
+    });
+    result = completed ? *answer : false;
+    return true;
+}
+void gsBackendReset()
+{
+    if (!gs_backend_bridge::active()) return;
+    gsBackendControl([] { g_backendRoute.reset(); });
+}
+}
+namespace gs_backend_bridge {
+uint64_t debugControlQueuedCount()
+{
+    return g_backendControlQueuedCount.load(std::memory_order_acquire);
+}
+bool active()
+{
+    const auto state = g_backendRoute.state();
+    // Failed is still GPU-owned. Do not run the stale software renderer.
+    return state == State::Accelerated || state == State::Failed;
+}
+void notifyPrivileged(uint32_t offset, uint8_t width, uint64_t input)
+{
+    if (!active()) return;
+    gsSubmitBackendControl([offset, width, input] {
+        try { g_backendRoute.privileged(offset, width, input); }
+        catch (...) { ps2GsRequestWorkerStop(); }
+    });
+}
+void writeFrontendPrivileged(GSRegisters& registers, uint32_t offset, uint8_t width, uint64_t input)
+{
+    if (!active()) return; // CPU-MMIO caller uses the software path in that case.
+    const bool reset = (gsPrivCsrInput(offset, width, input) & (uint64_t(1) << 9u)) != 0;
+    if (!reset) {
+        bool interrupt = false;
+        if (offset >= 0x1000u && offset < 0x1008u) gsPrivCpuCsrWrite(registers, offset, width, input);
+        else if (offset >= 0x1010u && offset < 0x1018u) interrupt = gsPrivCpuImrWrite(registers, offset, width, input);
+        if (interrupt) ps2_syscalls::raiseIntcInterrupt(0u);
+        notifyPrivileged(offset, width, input);
+        return;
+    }
+    // CPU RESET must precede every new-epoch capture/command in the FIFO. Reserve
+    // space before the front lock; the worker can retire old GPU work meanwhile.
+    // This private entry is CPU MMIO, never a backend event callback.
+    if (t_isGsWorker) throw std::logic_error("GPU front RESET requires CPU producer context");
+    GsQueueItem item;
+    item.isPacket = false;
+    item.data.resize(16u);
+    item.control = [offset, width, input] {
+        try { g_backendRoute.privileged(offset, width, input); }
+        catch (...) { ps2GsRequestWorkerStop(); }
+    };
+    std::unique_lock<std::mutex> queueLock(g_gsAsync.m);
+    g_gsAsync.drained.wait(queueLock, [] {
+        return g_gsAsync.stopping || g_gsAsync.queuedBytes + 16u <= kGsQueueMaxBytes;
+    });
+    if (g_gsAsync.stopping) return;
+    if (!g_gsAsync.started) {
+        g_gsAsync.started = true;
+        g_gsAsync.worker = std::thread(gsWorkerMain, g_gsInstance);
+    }
+    {
+        std::lock_guard<std::mutex> frontLock(g_gsPrivFrontMutex);
+        gsPrivCpuCsrWriteLocked(registers, offset, width, input);
+        item.epoch = gsPrivCurrentEpoch();
+        ++g_gsAsync.enqueued;
+        g_gsAsync.queuedBytes += item.data.size();
+        g_gsAsync.queue.push_back(std::move(item));
+    }
+    if (gsBackendRouteTestEnabled()) g_backendControlQueuedCount.fetch_add(1u, std::memory_order_release);
+    queueLock.unlock();
+    g_gsAsync.work.notify_one();
+}
+void exportCpuVram(uint8_t* dst, size_t bytes)
+{
+    if (!active() || !dst || !bytes) return;
+    auto buffer = std::make_shared<std::vector<uint8_t>>(bytes);
+    if (gsBackendControl([buffer] {
+        g_backendRoute.exportVram(0, buffer->data(), buffer->size());
+    })) std::memcpy(dst, buffer->data(), bytes);
+}
+}
+
+namespace gs_backend_bridge {
+void publishCompletedEvent(GSRegisters* regs, uint8_t addr, uint64_t payload) {
+    gsBackendCompletedEvent(regs, addr, payload);
+}
+void publishPrivilegedReset(const Privileged&) {
+    // CPU front already applied RESET immediately. Never overwrite it from queued GPU state.
+}
+std::optional<Privileged> peekEventFrontState() {
+    std::lock_guard<std::mutex> frontLock(g_gsPrivFrontMutex);
+    if (!g_gsPrivRegs || !t_backendEpoch || t_backendEpoch != gsPrivCurrentEpoch()) return std::nullopt;
+    return gsPrivSnapshot(*g_gsPrivRegs);
+}
+}
