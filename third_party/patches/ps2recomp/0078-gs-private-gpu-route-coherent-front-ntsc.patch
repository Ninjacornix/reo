diff --git a/ps2xRuntime/src/lib/gs_backend_route.cpp b/ps2xRuntime/src/lib/gs_backend_route.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs_backend_route.cpp
@@ -0,0 +1,93 @@
+#include "gs_backend_route.h"
+#include <stdexcept>
+#include <limits>
+#include <utility>
+
+namespace gs_backend_bridge {
+namespace {
+thread_local uint8_t path = 3;
+std::mutex factoryMutex;
+Factory factory;
+}
+uint8_t currentPath() { return path; }
+PathScope::PathScope(uint8_t value) : previous_(path) {
+    if (value < 1 || value > 3) throw std::invalid_argument("Invalid GIF path");
+    path = value;
+}
+PathScope::~PathScope() { path = previous_; }
+void registerFactory(Factory value) { std::lock_guard<std::mutex> l(factoryMutex); factory = std::move(value); }
+Factory registeredFactory() { std::lock_guard<std::mutex> l(factoryMutex); return factory; }
+bool Route::start(Choice choice, const Init& init, Factory make, std::string& reason) {
+    stop();
+    std::lock_guard<std::mutex> lock(mutex_);
+    error_.clear(); vramSize_ = init.vramSize; state_ = State::Software;
+    reason.clear();
+    if (choice == Choice::Software) return false;
+    std::unique_ptr<Backend> candidate;
+    try {
+        if (!init.vram || init.vramSize != 4u * 1024u * 1024u)
+            throw std::invalid_argument("GS backend requires 4 MiB initial VRAM");
+        if (!make) throw std::runtime_error("paraLLEl backend factory is not registered");
+        candidate = make();
+        if (!candidate) throw std::runtime_error("GS backend factory returned null");
+        if (!candidate->init(init, reason)) {
+            if (reason.empty()) reason = "GS backend initialization returned false";
+            candidate->close(); return false;
+        }
+        reason.clear();
+        backend_ = std::move(candidate); state_ = State::Accelerated;
+        return true;
+    } catch (const std::exception& e) { reason = e.what(); }
+    catch (...) { reason = "GS backend initialization failed"; }
+    if (candidate) candidate->close();
+    return false;
+}
+void Route::stop() noexcept {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (backend_) { backend_->close(); backend_.reset(); }
+    state_ = State::Stopped;
+}
+State Route::state() const { return state_.load(std::memory_order_acquire); }
+std::string Route::failure() const { std::lock_guard<std::mutex> l(mutex_); return error_; }
+bool Route::gif(uint8_t p, const uint8_t* data, size_t size) {
+    return execute([&](Backend& b) {
+        if (p < 1 || p > 3 || !data || !size || (size & 15u)) throw std::invalid_argument("Unaligned GIF payload");
+        b.rawGif(p, data, size);
+    });
+}
+bool Route::reg(uint8_t r, uint64_t value) { return execute([&](Backend& b) { b.directRegister(r, value); }); }
+bool Route::privileged(uint32_t offset, uint8_t width, uint64_t input) {
+    return execute([&](Backend& b) {
+        if ((width != 1 && width != 2 && width != 4 && width != 8) || (offset & (width-1u)))
+            throw std::invalid_argument("Unaligned privileged GS store");
+        b.privilegedWrite(offset, width, input);
+    });
+}
+bool Route::reset() { return execute([](Backend& b) { b.reset(); }); }
+bool Route::capture(const Capture& c, Frame& out) {
+    return execute([&](Backend& b) {
+        out = b.capture(c); out.tick = c.tick;
+        if (out.width > 4096 || out.height > 4096 ||
+            out.rgba.size() != size_t(out.width) * out.height * 4u)
+            throw std::runtime_error("Invalid GPU capture dimensions");
+    });
+}
+bool Route::exportVram(size_t offset, uint8_t* dst, size_t bytes) {
+    return execute([&](Backend& b) {
+        if (!dst || offset > vramSize_ || bytes > vramSize_ - offset)
+            throw std::out_of_range("GPU VRAM readback bounds");
+        b.exportVram(offset, dst, bytes);
+    });
+}
+bool Route::readTransfer(uint8_t* dst, uint32_t bytes, uint32_t& count) {
+    return execute([&](Backend& b) {
+        if (!dst && bytes) throw std::invalid_argument("Null transfer destination");
+        count = b.readTransfer(dst, bytes);
+        if (count > bytes) throw std::runtime_error("Oversized GPU FIFO readback");
+    });
+}
+bool Route::clear(uint32_t c, uint32_t rgba, bool current, bool& result) {
+    return execute([&](Backend& b) { result = b.clearContext(c, rgba, current); });
+}
+bool Route::flush() { return execute([](Backend& b) { b.flush(); }); }
+} // namespace gs_backend_bridge
diff --git a/ps2xRuntime/src/lib/gs_backend_route.h b/ps2xRuntime/src/lib/gs_backend_route.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs_backend_route.h
@@ -0,0 +1,120 @@
+#pragma once
+// Private implementation API. This header changes no public runtime class layout.
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <stdexcept>
+#include <vector>
+
+struct GSRegisters;
+
+namespace gs_backend_bridge {
+enum class Choice { Software, Parallel };
+enum class State { Empty, Software, Accelerated, Failed, Stopped };
+// Runtime GSRegisters order, NOT paraLLEl's 8192-byte privileged register layout.
+using Privileged = std::array<uint64_t, 19>;
+struct Frame {
+    std::vector<uint8_t> rgba;
+    uint32_t width = 0, height = 0, displayFbp = 0, sourceFbp = 0;
+    bool preferred = false;
+    uint64_t tick = 0;
+};
+struct Capture { Privileged registers{}; uint64_t tick = 0; };
+struct Init {
+    const uint8_t* vram = nullptr;
+    size_t vramSize = 0;
+    Privileged registers{};
+    // addr 0x60/61/62, issued by adapter only at real ordered GS completion.
+    // In particular, paraLLEl's parser on_finish is insufficient on its own.
+    std::function<void(uint8_t addr, uint64_t payload)> completedEvent;
+};
+// All execution calls are serialized by Route. init/close are lifecycle calls;
+// adapters must permit serialized host thread handoff, or marshal internally.
+// No backend callback may wait for guest execution or call a guest handler.
+class Backend {
+public:
+    virtual ~Backend() = default;
+    virtual bool init(const Init&, std::string& error) = 0;
+    virtual void close() noexcept = 0;
+    virtual void reset() = 0;
+    virtual void rawGif(uint8_t path, const uint8_t*, size_t) = 0;
+    virtual void directRegister(uint8_t, uint64_t) = 0;
+    // Absolute GS offset (0x0000..0x1080), exact input width and input value.
+    // In particular, do not substitute the merged CSR for a W1C write.
+    virtual void privilegedWrite(uint32_t offset, uint8_t width, uint64_t input) = 0;
+    virtual Frame capture(const Capture&) = 0;
+    // Reads must synchronize relevant GPU work; flush() alone is not a fence.
+    virtual void exportVram(size_t offset, uint8_t*, size_t) = 0;
+    virtual uint32_t readTransfer(uint8_t*, uint32_t maxBytes) = 0;
+    virtual bool clearContext(uint32_t context, uint32_t rgba, bool active) = 0;
+    virtual void flush() = 0;
+};
+using Factory = std::function<std::unique_ptr<Backend>()>;
+class Route {
+public:
+    ~Route() { stop(); }
+    bool start(Choice choice, const Init&, Factory factory, std::string& reason);
+    void stop() noexcept;
+    State state() const;
+    bool accelerated() const { return state() == State::Accelerated; }
+    std::string failure() const;
+    bool gif(uint8_t path, const uint8_t*, size_t);
+    bool reg(uint8_t, uint64_t);
+    bool privileged(uint32_t offset, uint8_t width, uint64_t input);
+    bool reset();
+    bool capture(const Capture&, Frame&);
+    bool exportVram(size_t offset, uint8_t*, size_t);
+    bool readTransfer(uint8_t*, uint32_t maxBytes, uint32_t& count);
+    bool clear(uint32_t context, uint32_t rgba, bool active, bool& result);
+    bool flush();
+private:
+    template<class F> bool execute(F&& fn) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (state_ == State::Failed) throw std::runtime_error(error_);
+        if (state_ != State::Accelerated) return false;
+        try { fn(*backend_); }
+        catch (const std::exception& e) { error_ = e.what(); state_ = State::Failed; throw; }
+        catch (...) { error_ = "GPU backend execution failed"; state_ = State::Failed; throw; }
+        return true;
+    }
+    mutable std::mutex mutex_;
+    // Producer selection must never wait behind a long owner-thread GPU call.
+    std::atomic<State> state_{State::Empty};
+    std::string error_;
+    size_t vramSize_ = 0;
+    std::unique_ptr<Backend> backend_;
+};
+
+// The existing arbiter invokes its callback synchronously on the submitting
+// host thread. This scope carries its path into the copied GS queue item.
+uint8_t currentPath();
+class PathScope {
+public:
+    explicit PathScope(uint8_t path);
+    ~PathScope();
+    PathScope(const PathScope&) = delete;
+    PathScope& operator=(const PathScope&) = delete;
+private: uint8_t previous_;
+};
+
+// Factory registration happens before Runtime/GS init. Absence falls back at
+// startup. Selecting another factory during an active session is unsupported.
+void registerFactory(Factory);
+Factory registeredFactory();
+// Implemented in copied ps2_gs_gpu.cpp, behind its existing FIFO.
+void notifyPrivileged(uint32_t offset, uint8_t width, uint64_t input);
+// GPU CPU-MMIO entry. RESET commits its front epoch and FIFO insertion together.
+void writeFrontendPrivileged(GSRegisters& registers, uint32_t offset, uint8_t width, uint64_t input);
+void exportCpuVram(uint8_t* dst, size_t bytes);
+bool active();
+// nullopt: no current queue-owner epoch, or that owner was retired by CPU RESET.
+std::optional<Privileged> peekEventFrontState();
+// Fixture-only monotonic enqueue latch, enabled by REO_GS_BACKEND_ROUTE_TEST=1.
+uint64_t debugControlQueuedCount();
+} // namespace gs_backend_bridge
diff --git a/ps2xRuntime/src/lib/gs_priv_atomic.h b/ps2xRuntime/src/lib/gs_priv_atomic.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs_priv_atomic.h
@@ -0,0 +1,98 @@
+#pragma once
+#include "runtime/ps2_memory.h"
+#include <array>
+#include <atomic>
+#include <mutex>
+
+// Private CPU/event front authority. Never hold this across a GPU call/drain.
+inline std::mutex g_gsPrivFrontMutex;
+inline std::atomic<uint64_t> g_gsPrivResetEpoch{1};
+inline uint64_t gsPrivCurrentEpoch() {
+    return g_gsPrivResetEpoch.load(std::memory_order_acquire);
+}
+
+// Implementation-only access policy. Public GSRegisters layout remains intact.
+inline uint64_t gsPrivLoad(uint64_t& word) {
+    return std::atomic_ref<uint64_t>(word).load(std::memory_order_acquire);
+}
+inline void gsPrivStore(uint64_t& word, uint64_t value) {
+    std::atomic_ref<uint64_t>(word).store(value, std::memory_order_release);
+}
+template<class F> inline uint64_t gsPrivUpdate(uint64_t& word, F update) {
+    auto atom = std::atomic_ref<uint64_t>(word);
+    uint64_t old = atom.load(std::memory_order_relaxed), next;
+    do { next = update(old); }
+    while (!atom.compare_exchange_weak(old, next, std::memory_order_acq_rel,
+                                      std::memory_order_relaxed));
+    return next;
+}
+inline uint64_t gsPrivWriteLane(uint64_t& word, unsigned lane, unsigned width,
+                               uint64_t value, bool csr) {
+    const uint64_t mask = width == 8 ? ~uint64_t(0) : ((uint64_t(1) << (width*8))-1) << (lane*8);
+    const uint64_t bits = (value << (lane*8)) & mask;
+    return gsPrivUpdate(word, [=](uint64_t old) {
+        const uint64_t status = csr ? uint64_t(3) & mask : 0;
+        return ((old & ~mask) | (bits & ~status) | (old & status)) & ~(bits & status);
+    });
+}
+inline std::array<uint64_t*,19> gsPrivWords(GSRegisters& gs) {
+    return {&gs.pmode,&gs.smode1,&gs.smode2,&gs.srfsh,&gs.synch1,&gs.synch2,
+        &gs.syncv,&gs.dispfb1,&gs.display1,&gs.dispfb2,&gs.display2,&gs.extbuf,
+        &gs.extdata,&gs.extwrite,&gs.bgcolor,&gs.csr,&gs.imr,&gs.busdir,&gs.siglblid};
+}
+inline std::array<uint64_t,19> gsPrivSnapshot(GSRegisters& gs) {
+    std::array<uint64_t,19> result{};
+    auto words = gsPrivWords(gs);
+    for (size_t i=0;i<words.size();++i) result[i]=gsPrivLoad(*words[i]);
+    return result;
+}
+inline void gsPrivPublish(GSRegisters& gs, const std::array<uint64_t,19>& values) {
+    auto words = gsPrivWords(gs);
+    for (size_t i=0;i<words.size();++i) gsPrivStore(*words[i],values[i]);
+}
+// Absolute GS CSR offset and exact CPU input. Status bits 0..4 are W1C;
+// other writes do not replace CSR. RESET immediately retires the old epoch.
+inline uint64_t gsPrivCsrInput(uint32_t offset, unsigned width, uint64_t value) {
+    if (offset < 0x1000u || offset >= 0x1008u ||
+        (width != 1u && width != 2u && width != 4u && width != 8u) ||
+        width > 8u - (offset - 0x1000u)) return 0;
+    const unsigned shift = (offset - 0x1000u) * 8u;
+    const uint64_t inputMask = width == 8u ? ~uint64_t(0) : (uint64_t(1) << (width * 8u)) - 1u;
+    return (value & inputMask) << shift;
+}
+// Caller holds the front mutex. Used only for queue->front RESET insertion.
+inline bool gsPrivCpuCsrWriteLocked(GSRegisters& gs, uint32_t offset, unsigned width, uint64_t value) {
+    const uint64_t input = gsPrivCsrInput(offset, width, value);
+    if (input & (uint64_t(1) << 9u)) {
+        std::array<uint64_t,19> reset{};
+        reset[15] = 0x551B4000ull;
+        reset[16] = 0x7F00ull;
+        gsPrivPublish(gs, reset);
+        g_gsPrivResetEpoch.fetch_add(1u, std::memory_order_release);
+        return true;
+    }
+    gsPrivUpdate(gs.csr, [input](uint64_t old) { return old & ~(input & 0x1Full); });
+    return false;
+}
+inline bool gsPrivCpuCsrWrite(GSRegisters& gs, uint32_t offset, unsigned width, uint64_t value) {
+    std::lock_guard<std::mutex> lock(g_gsPrivFrontMutex);
+    return gsPrivCpuCsrWriteLocked(gs, offset, width, value);
+}
+inline void gsPrivFieldTick(GSRegisters& gs) {
+    std::lock_guard<std::mutex> lock(g_gsPrivFrontMutex);
+    gsPrivUpdate(gs.csr, [](uint64_t old) { return (old ^ (uint64_t(1) << 13u)) | (uint64_t(1) << 3u); });
+}
+// Returns an IRQ request; caller raises it only after this short mutex is released.
+inline bool gsPrivCpuImrWrite(GSRegisters& gs, uint32_t offset, unsigned width, uint64_t value) {
+    if (offset < 0x1010u || offset >= 0x1018u ||
+        (width != 1u && width != 2u && width != 4u && width != 8u) ||
+        width > 8u - (offset - 0x1010u)) return false;
+    const unsigned shift = (offset - 0x1010u) * 8u;
+    const uint64_t mask = width == 8u ? ~uint64_t(0) : ((uint64_t(1) << (width * 8u)) - 1u) << shift;
+    const uint64_t bits = (value << shift) & mask;
+    std::lock_guard<std::mutex> lock(g_gsPrivFrontMutex);
+    const uint64_t old = gsPrivLoad(gs.imr);
+    const uint64_t next = (((old & ~mask) | bits) & 0x1F00ull) | 0x6000ull;
+    gsPrivStore(gs.imr, next);
+    return (gsPrivLoad(gs.csr) & 0x1Full & ((old & ~next) >> 8u)) != 0;
+}
