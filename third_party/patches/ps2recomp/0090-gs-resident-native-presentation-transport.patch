+void validateCaptureFrame(const Capture& c, const Frame& out) {
+    if (out.width > 4096 || out.height > 4096)
+        throw std::runtime_error("Invalid GPU capture dimensions");
+    if (!out.resident) {
+        if (out.rgba.size() != size_t(out.width) * out.height * 4u)
+            throw std::runtime_error("Invalid GPU host capture payload");
+    } else {
+        const auto& r = *out.resident;
+        if (!r.valid() || !out.rgba.empty() || r.width != out.width || r.height != out.height ||
+            r.tick != c.tick || r.epoch != c.epoch || r.displayFbp != out.displayFbp || r.sourceFbp != out.sourceFbp)
+            throw std::runtime_error("Invalid GPU resident capture metadata");
+    }
+}
