+namespace reo_gpu_present {
+// UI receives numbers only: it never receives a Vulkan object, pointer or lease.
+struct Receipt {
+    uint64_t tick=0,epoch=0,serial=0;
+    uint32_t width=0,height=0,displayFbp=0,sourceFbp=0;
+    bool preferred=false;
+    bool valid()const{return width&&height&&width<=4096&&height<=4096&&serial;}
+};
+struct Target {
+    uintptr_t hwnd=0;
+    uint32_t width=0,height=0;
+    bool linear=false;
+};
+// Implemented in the actual GS runtime owner, not in generated guest code.
+bool requested()noexcept;
+bool active()noexcept;
+void publishTarget(Target);
+Target target();
+bool currentEpoch(uint64_t)noexcept;
+bool publishedReceipt(Receipt&);
+void requestDiagnosticCapture()noexcept;
+}
