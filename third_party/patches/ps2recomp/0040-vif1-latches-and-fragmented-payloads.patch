+    uint32_t vif1PayloadBytes(uint8_t opcode, uint8_t num, uint16_t imm, uint32_t cycle)
+    {
+        if (opcode == VIF_STMASK) return 4u;
+        if (opcode == VIF_STROW || opcode == VIF_STCOL) return 16u;
+        if (opcode == VIF_MPG) return (num ? num : 256u) * 8u;
+        if (opcode == VIF_DIRECT || opcode == VIF_DIRECTHL) return (imm ? imm : 65536u) * 16u;
+        if ((opcode & 0x60u) != 0x60u) return 0u;
+        const uint32_t vn = (opcode >> 2) & 3u, vl = opcode & 3u;
+        const uint32_t bits = vl == 0 ? 32u : vl == 2 ? 8u : 16u;
+        const uint32_t vectorBytes = vn == 3 && vl == 3 ? 2u : ((vn + 1u) * bits + 7u) / 8u;
+        // Keep the existing zero-cycle behavior while correcting stream carry.
+        const uint32_t cl = (cycle & 255u) ? (cycle & 255u) : 1u;
+        const uint32_t wl = ((cycle >> 8) & 255u) ? ((cycle >> 8) & 255u) : 1u;
+        const uint32_t writes = num ? num : 256u;
+        const uint32_t sources = cl >= wl ? writes : (writes / wl) * cl + std::min(writes % wl, cl);
+        return (sources * vectorBytes + 3u) & ~3u;
+    }
