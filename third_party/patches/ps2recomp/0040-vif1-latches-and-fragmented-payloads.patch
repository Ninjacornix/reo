+                return;
+            elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now() - state.first).count();
+            if (!state.armed)
+            {
+                if (elapsed < config.afterSeconds)
+                    return;
+                uint32_t gateWord = 0;
+                if (config.hasGate)
+                {
+                    if (!memory.getRDRAM() || config.gate > PS2_RAM_SIZE - 4u)
+                        return;
+                    std::memcpy(&gateWord, memory.getRDRAM() + config.gate, sizeof(gateWord));
+                    if ((gateWord & config.mask) != (config.value & config.mask))
+                        return;
+                }
+                state.armed = true;
+                auto snapshot = [&](const char* path, const uint8_t* source, uint32_t length)
+                {
+                    if (!source || length > config.byteBudget - state.writtenBytes)
+                        return;
+                    if (FILE* file = std::fopen(path, "wb"))
+                    {
+                        state.writtenBytes += std::fwrite(source, 1, length, file);
+                        std::fclose(file);
+                    }
+                };
+                snapshot("vif1_initial_code.bin", memory.getVU1Code(), PS2_VU1_CODE_SIZE);
+                snapshot("vif1_initial_data.bin", memory.getVU1Data(), PS2_VU1_DATA_SIZE);
+                snapshot("vif1_initial_regs.bin", reinterpret_cast<const uint8_t*>(&memory.vif1_regs), sizeof(VIFRegisters));
+                std::fprintf(stderr, "[VIF1-DUMP] armed elapsed=%.6f gate=0x%x word=0x%x count=%u budget=%llu\n",
+                    elapsed, config.gate, gateWord, config.count, static_cast<unsigned long long>(config.byteBudget));
+            }
+            active = true;
+            index = state.nextIndex++;
+            bytes = size;
+            before = memory.vif1_regs;
+            dataHash = vifDiagnosticHash(data, size);
+            codeHash = vifDiagnosticHash(memory.getVU1Code(), PS2_VU1_CODE_SIZE);
+            vuDataHash = vifDiagnosticHash(memory.getVU1Data(), PS2_VU1_DATA_SIZE);
+            if (size <= config.byteBudget - state.writtenBytes)
+            {
+                char path[64];
+                std::snprintf(path, sizeof(path), "vif1_%04u.bin", index);
+                if (FILE* file = std::fopen(path, "wb"))
+                {
+                    const size_t written = std::fwrite(data, 1, size, file);
+                    state.writtenBytes += written;
+                    completeFile = written == size;
+                    std::fclose(file);
+                }
+            }
+        }
+
+        bool logCommand() { return active && state.loggedCommands++ < 2048u; }
+
+        ~VifDiagnosticCapture()
+        {
+            if (!active)
+                return;
+            if (FILE* file = std::fopen("vif1_buffers.jsonl", index ? "a" : "w"))
+            {
+                std::fprintf(file, "{\"index\":%u,\"bytes\":%u,\"elapsed\":%.9f,\"complete_file\":%s,"
+                    "\"input_fnv\":\"%016llx\",\"code_before_fnv\":\"%016llx\","
+                    "\"data_before_fnv\":\"%016llx\",\"before\":",
+                    index, bytes, elapsed, completeFile ? "true" : "false",
+                    static_cast<unsigned long long>(dataHash), static_cast<unsigned long long>(codeHash),
+                    static_cast<unsigned long long>(vuDataHash));
+                vifDiagnosticRegisters(file, before);
+                std::fprintf(file, ",\"after\":");
+                vifDiagnosticRegisters(file, memory.vif1_regs);
+                std::fprintf(file, ",\"carry_bytes\":%u,\"retained_bytes\":%u,\"code_after_fnv\":\"%016llx\",\"data_after_fnv\":\"%016llx\"}\n",
+                    carryBytes, retainedBytes,
+                    static_cast<unsigned long long>(vifDiagnosticHash(memory.getVU1Code(), PS2_VU1_CODE_SIZE)),
+                    static_cast<unsigned long long>(vifDiagnosticHash(memory.getVU1Data(), PS2_VU1_DATA_SIZE)));
+                std::fclose(file);
+            }
+        }
+    };
