+
+// Private implementation-only hook. No clocks, allocation or logging here.
+void ps2VifKickStageRecord(unsigned stage,uint64_t ns,uint64_t bytes,uint64_t queueBytes) noexcept
+{
+    if(auto* work=t_vifKickVuWork;work && stage<5u) {
