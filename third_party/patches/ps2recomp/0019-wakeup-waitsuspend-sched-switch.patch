+    // REO_THREAD_LOG: wake/resume/suspend/sleep operations on threads 4..8 (CRI servers, D34).
+    void logThreadOp(const char *op, int target, int status, int wakeups, int suspends, uint32_t ra)
+    {
+        static const bool s_log = std::getenv("REO_THREAD_LOG") != nullptr;
+        static std::atomic<int> s_n{0};
+        if (!s_log || target < 7 || target > 7 || s_n.fetch_add(1) > 20000)
+            return;
+        std::fprintf(stderr, "[THOP] %s by %d: t%d status=%d wake=%d susp=%d ra=0x%x vsync=%llu\n", op,
+                     g_currentThreadId, target, status, wakeups, suspends, ra,
+                     static_cast<unsigned long long>(ps2_syscalls::GetCurrentVSyncTick()));
+    }
+
+    // EE kernel rescheduling on WakeupThread/ResumeThread/ChangeThreadPriority: when the
+    // call leaves a thread of strictly higher priority ready, it runs before the caller
+    // continues; by default the runtime switches only at the caller's next preemption
+    // point. Opt-in (REO_IMMEDIATE_SWITCH=1): the M1 checkpoint does not need it once
+    // WakeupThread releases WAITSUSPEND sleepers (D34), so it stays off until validated.
+    void switchIfOutranked(PS2Runtime *runtime, int target, bool targetReady)
+    {
+        static const bool s_on = std::getenv("REO_IMMEDIATE_SWITCH") != nullptr;
+        const int self = ps2_sched::currentThread();
+        if (!s_on || !targetReady || !runtime || self < 0 || !ps2_sched::outranks(target, self))
+            return;
+        ps2_sched::awaitQueued(target, 20000);
+        PS2Runtime::GuestExecutionReleaseScope yieldCpu(runtime);
+    }
+}
