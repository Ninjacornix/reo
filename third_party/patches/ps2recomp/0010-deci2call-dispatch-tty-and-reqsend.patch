+    // 0x7C Deci2Call(call, u32 *param). No DECI2 host is attached (retail console).
+    // 0x10 kputs: print the string at param[0] as EE TTY output.
+    // 3 ReqSend: print the TTY payload (packet param[1], text at +0xC) and fail (-1):
+    //   with no host the "write done" event never arrives, and callers that wait for
+    //   it (SLUS-20765 0x115BE8) spin forever unless the send is rejected.
+    // Other calls (open/close/poll/...) succeed (1).
     void Deci2Call(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
-        (void)rdram;
         (void)runtime;
-        setReturnS32(ctx, KE_OK);
+        const uint32_t call = getRegU32(ctx, 4);
+        const uint32_t paramAddr = getRegU32(ctx, 5);
+        if (call == 3u && paramAddr)
+        {
+            const uint8_t *param = getConstMemPtr(rdram, paramAddr);
+            uint32_t pkt = 0;
+            if (param)
+            {
+                std::memcpy(&pkt, param + 4, sizeof(pkt));
+            }
+            const uint8_t *hdr = pkt ? getConstMemPtr(rdram, pkt) : nullptr;
+            if (hdr)
+            {
+                uint16_t len = 0;
+                std::memcpy(&len, hdr, sizeof(len));
+                if (len > 0xCu && len <= 0x10Cu)
+                {
+                    std::string text = readGuestCStringBounded(rdram, pkt + 0xCu, len - 0xCu);
+                    while (!text.empty() && (text.back() == '\n' || text.back() == '\r'))
+                    {
+                        text.pop_back();
+                    }
+                    std::cerr << "[EE-TTY] " << text << std::endl;
+                }
+            }
+            setReturnS32(ctx, -1);
+            return;
+        }
+        if (call == 0x10u && paramAddr)
+        {
+            const uint8_t *param = getConstMemPtr(rdram, paramAddr);
+            if (param)
+            {
+                uint32_t strAddr = 0;
+                std::memcpy(&strAddr, param, sizeof(strAddr));
+                std::string text = readGuestCStringBounded(rdram, strAddr, 1024u);
+                while (!text.empty() && (text.back() == '\n' || text.back() == '\r'))
+                {
+                    text.pop_back();
+                }
+                std::cerr << "[EE-TTY] " << text << std::endl;
+            }
+        }
+        setReturnS32(ctx, 1);
     }
 
