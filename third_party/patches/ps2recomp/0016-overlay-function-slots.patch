+void PS2Runtime::registerOverlayFunction(uint32_t base, uint32_t magic, uint32_t idOffset, uint32_t overlayId,
+                                         uint32_t address, RecompiledFunction func)
+{
+    OverlaySlot *slot = nullptr;
+    for (auto &s : m_overlaySlots)
+    {
+        if (s.base == base)
+        {
+            slot = &s;
+            break;
+        }
+    }
+    if (!slot)
+    {
+        m_overlaySlots.push_back(OverlaySlot{});
+        slot = &m_overlaySlots.back();
+        slot->base = base;
+        slot->end = base;
+        slot->magic = magic;
+        slot->idOffset = idOffset;
+    }
+    if (address + 4u > slot->end)
+        slot->end = address + 4u;
+    slot->functions[(static_cast<uint64_t>(overlayId) << 32) | address] = func;
+}
+
+const PS2Runtime::RecompiledFunction *PS2Runtime::findOverlayFunction(uint32_t address) const
+{
+    if (m_overlaySlots.empty())
+        return nullptr;
+    const uint8_t *rdram = const_cast<PS2Memory &>(m_memory).getRDRAM();
+    if (!rdram)
+        return nullptr;
+    for (const auto &s : m_overlaySlots)
+    {
+        if (address < s.base || address >= s.end)
+            continue;
+        uint32_t magic = 0, id = 0;
+        std::memcpy(&magic, rdram + (s.base & PS2_RAM_MASK), 4);
+        if (magic != s.magic)
+            continue;
+        std::memcpy(&id, rdram + ((s.base + s.idOffset) & PS2_RAM_MASK), 4);
+        auto it = s.functions.find((static_cast<uint64_t>(id) << 32) | address);
+        if (it != s.functions.end())
+            return &it->second;
+        // Slot ranges can overlap (a large overlay at one base covers another base);
+        // keep looking: the address may belong to the overlay resident in a later slot.
+    }
+    return nullptr;
+}
