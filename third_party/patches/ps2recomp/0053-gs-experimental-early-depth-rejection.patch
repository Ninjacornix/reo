+    enum class EarlyTriangleResult { Survives, Bounds, Date, Depth, InvalidDepth };
+
+    // Experimental read-only rejection. Survivors still run the complete tested
+    // writer, preserving alpha-failure handling, destination snapshots, masks
+    // and live texture/frame/depth aliases. No texture or palette cache is added.
+    EarlyTriangleResult testTriangleBeforeShading(const GSContext &ctx, const uint8_t *vram,
+                                                  uint32_t vramSize, int x, int y, uint32_t z)
+    {
+        if (x < ctx.scissor.x0 || x > ctx.scissor.x1 || y < ctx.scissor.y0 || y > ctx.scissor.y1)
+            return EarlyTriangleResult::Bounds;
+        const uint32_t width = ctx.frame.fbw ? ctx.frame.fbw : 1u;
+        const bool frame16 = ctx.frame.psm == GS_PSM_CT16 || ctx.frame.psm == GS_PSM_CT16S;
+        const uint32_t frameBytes = frame16 ? 2u : 4u;
+        const uint32_t frameBlock = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+        const uint32_t frameOffset = ctx.frame.psm == GS_PSM_CT32 || ctx.frame.psm == GS_PSM_CT24
+            ? GSPSMCT32::addrPSMCT32(frameBlock, width, uint32_t(x), uint32_t(y))
+            : addrPSMCT16Family(frameBlock, width, ctx.frame.psm, uint32_t(x), uint32_t(y));
+        if (frameOffset + frameBytes > vramSize) return EarlyTriangleResult::Bounds;
+        if ((ctx.test & (1ull << 14)) != 0)
+        {
+            if (ctx.frame.psm == GS_PSM_CT24) return EarlyTriangleResult::Date;
+            uint32_t destination = 0;
+            std::memcpy(&destination, vram + frameOffset, frameBytes);
+            if (((destination >> (frame16 ? 15u : 31u)) & 1u) != ((ctx.test >> 15) & 1u))
+                return EarlyTriangleResult::Date;
+        }
+        if ((ctx.test & (1ull << 16)) == 0) return EarlyTriangleResult::Survives;
+        const unsigned function = unsigned((ctx.test >> 17) & 3u);
+        if (function == 0) return EarlyTriangleResult::Depth;
+        const uint8_t format = uint8_t((ctx.zbuf >> 24) & 15u);
+        if (format != 0 && format != 1 && format != 2 && format != 10)
+            return EarlyTriangleResult::InvalidDepth;
+        const uint32_t bytes = format == 2 || format == 10 ? 2u : 4u;
+        const uint32_t mask = format == 1 ? 0xFFFFFFu : bytes == 2 ? 0xFFFFu : 0xFFFFFFFFu;
+        const uint32_t block = uint32_t(ctx.zbuf & 0x1FFu) << 5;
+        if (!vramSize) return EarlyTriangleResult::Bounds;
+        const uint32_t offset = depthAddress(block, width, format, uint32_t(x), uint32_t(y)) % vramSize;
+        if (offset + bytes > vramSize) return EarlyTriangleResult::Bounds;
+        if (function > 1)
+        {
+            uint32_t destination = 0;
+            std::memcpy(&destination, vram + offset, bytes);
+            destination &= mask;
+            const uint32_t source = std::min(z, mask); // Triangle format overflow clamps.
+            if (function == 2 ? source < destination : source <= destination)
+                return EarlyTriangleResult::Depth;
+        }
+        return EarlyTriangleResult::Survives;
     }
 
