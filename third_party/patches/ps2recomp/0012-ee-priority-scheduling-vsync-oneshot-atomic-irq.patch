+namespace ps2_sched
+{
+    namespace
+    {
+        constexpr int kMaxTid = 256;
+        std::atomic<int> g_priority[kMaxTid];
+        std::atomic<uint8_t> g_suspended[kMaxTid];
+        std::atomic<uint8_t> g_waiting[kMaxTid]; // runnable, waiting for the guest lock
+        std::atomic<int> g_waitingGuests{0};
+        std::atomic<int> g_waitingWorkers{0}; // non-guest host threads waiting for the lock
+        thread_local int t_tid = -1;
+        std::mutex g_wakeMutex;
+        std::condition_variable g_wake;
+
+        bool validTid(int tid) { return tid >= 0 && tid < kMaxTid; }
+
+        void notifyAll()
+        {
+            std::lock_guard<std::mutex> lock(g_wakeMutex);
+            g_wake.notify_all();
+        }
+
+        // Another eligible waiter must run before `tid`.
+        bool higherWaiter(int tid)
+        {
+            if (g_waitingWorkers.load(std::memory_order_acquire) > 0)
+                return true;
+            if (g_waitingGuests.load(std::memory_order_acquire) == 0)
+                return false;
+            const int mine = g_priority[tid].load(std::memory_order_relaxed);
+            for (int i = 0; i < kMaxTid; ++i)
+            {
+                if (i != tid && g_waiting[i].load(std::memory_order_relaxed) &&
+                    !g_suspended[i].load(std::memory_order_relaxed) &&
+                    g_priority[i].load(std::memory_order_relaxed) < mine)
+                    return true;
+            }
+            return false;
+        }
+    }
+
+    void setCurrentThread(int tid) { t_tid = validTid(tid) ? tid : -1; }
+    int currentThread() { return t_tid; }
+
+    void setPriority(int tid, int priority)
+    {
+        if (!validTid(tid))
+            return;
+        g_priority[tid].store(priority, std::memory_order_release);
+        notifyAll();
+    }
+
+    void setSuspended(int tid, bool suspended)
+    {
+        if (!validTid(tid))
+            return;
+        g_suspended[tid].store(suspended ? 1u : 0u, std::memory_order_release);
+        notifyAll();
+    }
+
+    void forget(int tid)
+    {
+        if (!validTid(tid))
+            return;
+        g_suspended[tid].store(0u, std::memory_order_release);
+        notifyAll();
+    }
+
+    bool mustYield(int tid)
+    {
+        if (!validTid(tid))
+            return false;
+        if (g_suspended[tid].load(std::memory_order_acquire))
+            return true;
+        return higherWaiter(tid);
+    }
+
+    // Blocks until the calling host thread may run guest code, then holds `mutex`.
+    template <typename Mutex>
+    void acquire(Mutex &mutex)
+    {
+        const int tid = t_tid;
+        if (!validTid(tid))
+        {
+            g_waitingWorkers.fetch_add(1, std::memory_order_acq_rel);
+            mutex.lock();
+            g_waitingWorkers.fetch_sub(1, std::memory_order_acq_rel);
+            return;
+        }
+        g_waiting[tid].store(1u, std::memory_order_release);
+        g_waitingGuests.fetch_add(1, std::memory_order_acq_rel);
+        for (;;)
+        {
+            mutex.lock();
+            if (!mustYield(tid))
+                break;
+            mutex.unlock();
+            notifyAll();
+            std::unique_lock<std::mutex> lock(g_wakeMutex);
+            g_wake.wait_for(lock, std::chrono::milliseconds(1));
+        }
+        g_waitingGuests.fetch_sub(1, std::memory_order_acq_rel);
+        g_waiting[tid].store(0u, std::memory_order_release);
+    }
+
+    void released() { notifyAll(); }
+}
