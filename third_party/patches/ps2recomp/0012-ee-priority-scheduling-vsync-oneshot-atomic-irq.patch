+// Blocks on `cv` with the guest-execution lock released. The guest lock is re-acquired
+// *without* holding `lock` (lock order: guest lock, then host mutexes; re-acquiring it
+// while holding `lock` deadlocks against a running thread that needs `lock`), then
+// `lock` is re-taken and `pred` re-checked, since the state may have changed in between.
+template <typename Lock, typename Cv, typename Pred>
+static void waitReleasingGuest(PS2Runtime *runtime, Lock &lock, Cv &cv, Pred pred)
+{
+    for (;;)
+    {
+        {
+            PS2Runtime::GuestExecutionReleaseScope releaseGuestExecution(runtime);
+            cv.wait(lock, pred);
+            lock.unlock();
+        }
+        lock.lock();
+        if (pred())
+            return;
+    }
+}
