diff --git a/ps2xRuntime/src/lib/ps2_guest_sched.h b/ps2xRuntime/src/lib/ps2_guest_sched.h
new file mode 100644
index 0000000..365d28e
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_guest_sched.h
@@ -0,0 +1,28 @@
+#pragma once
+
+// EE thread scheduling policy for the guest-execution lock (internal to ps2_runtime).
+//
+// The EE kernel never time-slices: a thread keeps the CPU until it blocks, until it
+// suspends itself, or until a thread of strictly higher priority (lower number) becomes
+// ready. Middleware relies on this (CRI ADX locks by raising the caller to priority 1
+// and resuming a priority-8 busy thread so lower-priority threads cannot run).
+// The guest-execution lock enforces it: a host thread running guest thread `tid` only
+// gives up the lock at a preemption point when mustYield(tid) is true, and only
+// (re)acquires it while no eligible thread of higher priority is waiting.
+
+namespace ps2_sched
+{
+    // Guest thread run by the calling host thread; -1 = not a guest thread (interrupt,
+    // alarm and RPC workers), which is treated as more urgent than any guest thread.
+    void setCurrentThread(int tid);
+    int currentThread();
+
+    void setPriority(int tid, int priority);
+    void setSuspended(int tid, bool suspended);
+    // Thread exited or was deleted.
+    void forget(int tid);
+
+    // True when `tid` must give up the CPU now (suspended, or a higher-priority
+    // thread / non-guest worker is waiting for the lock).
+    bool mustYield(int tid);
+}
