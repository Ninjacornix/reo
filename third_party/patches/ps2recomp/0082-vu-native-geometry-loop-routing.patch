diff --git a/ps2xRuntime/src/lib/vu_native_geometry_route.cpp b/ps2xRuntime/src/lib/vu_native_geometry_route.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu_native_geometry_route.cpp
@@ -0,0 +1,50 @@
+#include "vu_native_geometry_route.h"
+#include "runtime/ps2_vu1.h"
+#include <atomic>
+#include <cstring>
+#include <limits>
+namespace vu_native_geometry {
+namespace {
+std::atomic<const ProgramTable*> published{nullptr};
+bool disjoint(const void* a,size_t an,const void* b,size_t bn) noexcept {
+    const uintptr_t x=reinterpret_cast<uintptr_t>(a),y=reinterpret_cast<uintptr_t>(b);
+    const uintptr_t max=std::numeric_limits<uintptr_t>::max();
+    if(!a||!b||x>max-an||y>max-bn)return false;
+    return x+an<=y||y+bn<=x;
+}
+}
+bool registerProgramTable(const ProgramTable* table) noexcept {
+    if(!table||!table->count){published.store(nullptr,std::memory_order_release);return true;}
+    if(!table->programs||table->count>64)return false;
+    for(uint32_t i=0;i<table->count;++i) {
+        const auto& p=table->programs[i];const auto* legacy=p.legacyProgram;
+        if(!legacy||!legacy->exactCodeImage||!legacy->codeBytes||legacy->codeBytes>16384||
+           (legacy->codeBytes&7u)||!legacy->dataBytes||legacy->dataBytes>16384||!p.entryLoops)return false;
+        for(uint32_t j=0;j<i;++j)if(table->programs[j].legacyProgram==legacy)return false;
+        for(uint32_t entry=0;entry<legacy->codeBytes/8;++entry) {
+            const auto* loop=p.entryLoops[entry];if(!loop)continue;
+            if(!loop->execute||!loop->minPairs||loop->firstPC!=entry*8||
+               (loop->lastPC&7u)||loop->lastPC<loop->firstPC||loop->lastPC+8>legacy->codeBytes||
+               loop->minPairs>legacy->codeBytes/8)return false;
+            for(uint32_t pc=loop->firstPC;pc<=loop->lastPC;pc+=8) {
+                uint32_t lower,upper;std::memcpy(&lower,legacy->exactCodeImage+pc,4);
+                std::memcpy(&upper,legacy->exactCodeImage+pc+4,4);
+                if(upper&0x40000000u)return false;
+                if(!(upper&0x80000000u)&&((lower>>25)&127u)==64u&&(lower&2047u)==0x6fcu)return false;
+            }
+        }
+    }
+    published.store(table,std::memory_order_release);return true;
+}
+uint32_t registeredProgramCount() noexcept {const auto* table=published.load(std::memory_order_acquire);return table?table->count:0;}
+const Program* selectProgram(const vu_specialized::Program* legacy,const uint8_t* code,
+    uint32_t codeBytes,const uint8_t* data,uint32_t dataBytes,const VU1State* state,bool captureActive) noexcept {
+    if(!legacy||captureActive)return nullptr;
+    const auto* table=published.load(std::memory_order_acquire);if(!table)return nullptr;
+    if(codeBytes!=legacy->codeBytes||dataBytes!=legacy->dataBytes||
+       !disjoint(state,sizeof(VU1State),code,codeBytes)||!disjoint(state,sizeof(VU1State),data,dataBytes)||
+       !disjoint(code,codeBytes,data,dataBytes))return nullptr;
+    for(uint32_t i=0;i<table->count;++i)if(table->programs[i].legacyProgram==legacy)return table->programs+i;
+    return nullptr;
+}
+}
diff --git a/ps2xRuntime/src/lib/vu_native_geometry_route.h b/ps2xRuntime/src/lib/vu_native_geometry_route.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu_native_geometry_route.h
@@ -0,0 +1,31 @@
+#pragma once
+// Private runtime extension. Public VU class/header/layout remains unchanged.
+#include "vu_specialized_route.h"
+namespace vu_native_geometry {
+struct Result { uint32_t pairs=0,vertices=0; };
+struct DynamicLoop {
+    uint32_t firstPC,lastPC,minPairs; // Inclusive legal body span; no E or XGKICK.
+    // minPairs is a cheap admission-budget threshold, not a consumed-pair lower
+    // bound: rigid loop reserves80 but a complete clipped vertex consumes78.
+    // Zero means complete refusal BEFORE mutation. Positive means exact completed
+    // iteration prefix with complete state/data/PC/branch residue and no callbacks.
+    // Must not consume E or XGKICK, exceed remainingPairs, or return pending E/branch.
+    Result (*execute)(vu_specialized::Invocation&);
+};
+struct Program {
+    const vu_specialized::Program* legacyProgram;
+    const DynamicLoop* const* entryLoops; // codeBytes/8 entries, normally sparse.
+};
+struct ProgramTable {const Program* programs;uint32_t count;};
+// Publish immutable caller-owned table/legacy program/images/entry arrays before
+// runtime initialization. Every replaced object must live until all VU calls end.
+// Registration is not concurrent mutation permission. No hidden native defaults.
+bool registerProgramTable(const ProgramTable*) noexcept;
+uint32_t registeredProgramCount() noexcept;
+// Once per synchronous launch AFTER existing full-image legacy selection. Adds
+// state/CODE and state/data disjointness, capture exclusion, immutable key matching.
+// Code/data stability includes any later generic callbacks; no async MPG promise.
+const Program* selectProgram(const vu_specialized::Program*,const uint8_t* code,
+    uint32_t codeBytes,const uint8_t* data,uint32_t dataBytes,
+    const VU1State* state,bool captureActive) noexcept;
+}
