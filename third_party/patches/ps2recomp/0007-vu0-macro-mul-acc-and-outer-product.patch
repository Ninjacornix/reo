diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index 27c6683..0c283c6 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -144,6 +144,8 @@ static inline uint32_t ps2_plzcw32(uint32_t x)
 #define PS2_VADD(a, b) _mm_add_ps((__m128)(a), (__m128)(b))
 #define PS2_VSUB(a, b) _mm_sub_ps((__m128)(a), (__m128)(b))
 #define PS2_VMUL(a, b) _mm_mul_ps((__m128)(a), (__m128)(b))
+// VU outer product (OPMULA/OPMSUB): lanes x,y,z = a.y*b.z, a.z*b.x, a.x*b.y (w = a.w*b.w, masked by callers)
+#define PS2_VOPMUL(a, b) _mm_mul_ps(_mm_shuffle_ps((__m128)(a), (__m128)(a), _MM_SHUFFLE(3, 0, 2, 1)), _mm_shuffle_ps((__m128)(b), (__m128)(b), _MM_SHUFFLE(3, 1, 0, 2)))
 #define PS2_VDIV(a, b) _mm_div_ps((__m128)(a), (__m128)(b))
 #define PS2_VMULQ(a, q) _mm_mul_ps((__m128)(a), _mm_set1_ps(q))
 #define PS2_VBLEND(a, b, mask) PS2_BLENDV_PS((__m128)(a), (__m128)(b), (__m128)(mask))
