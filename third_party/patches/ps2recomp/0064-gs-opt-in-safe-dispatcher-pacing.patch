+// Backedge query: TLS/atomic reads only, no waits, locks, or guest CPU release.
+bool ps2GsProducerPacePending() noexcept
+{
+    if (t_gsProducerPaceDebt.generation != g_gsSessionGeneration.load(std::memory_order_acquire))
+        t_gsProducerPaceDebt = {};
+    return t_gsProducerPaceDebt.target != 0u && ps2_sched::currentThread() >= 1;
+}
+
+// Called only by a guest dispatcher after callbacks and MMIO have returned,
+// with its GuestExecutionReleaseScope already active. Each producer waits for
+// its own frozen debt; later IRQ/frame marks cannot extend this wait.
+void ps2GsWaitProducerPace()
+{
+    if (!ps2GsProducerPacePending()) return;
+    const auto debt = t_gsProducerPaceDebt;
+    t_gsProducerPaceDebt = {};
+    const GsWaitTimer waitTimer;
+    std::unique_lock<std::mutex> lock(g_gsAsync.m);
+    g_gsAsync.drained.wait(lock, [debt] {
+        return g_gsAsync.stopping || g_gsAsync.completed >= debt.target ||
+               debt.generation != g_gsSessionGeneration.load(std::memory_order_acquire);
+    });
+    waitTimer.finish("dispatcher", debt.target, "producer");
+}
