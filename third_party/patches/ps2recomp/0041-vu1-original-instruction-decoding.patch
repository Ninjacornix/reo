+
+    // Opt-in original-input capture. Files are bounded independently of a corrupt
+    // interpreter's computed GIF length, and are never submitted to the GS.
+    struct VuTraceRecord { uint32_t pc, lower, upper; int32_t vi[16]; };
+    struct VuCapture
+    {
+        std::filesystem::path base;
+        std::vector<VuTraceRecord> trace;
+        bool active = false;
+        static void write(const std::filesystem::path& path, const void* bytes, size_t size)
+        {
+            if (FILE* out = std::fopen(path.string().c_str(), "wb"))
+            { std::fwrite(bytes, 1, size, out); std::fclose(out); }
+        }
+        VuCapture(uint8_t* code, uint32_t codeSize, uint8_t* data, uint32_t dataSize,
+                  const VU1State& state, PS2Memory* memory, uint32_t maxCycles)
+        {
+            const char* dir = std::getenv("REO_VU1_DUMP");
+            if (!dir || !*dir) return;
+            const uint32_t index = s_debugVu1RunCount.fetch_add(1, std::memory_order_relaxed);
+            uint32_t limit = 128;
+            if (const char* value = std::getenv("REO_VU1_DUMP_LIMIT"))
+                limit = std::min(512ul, std::strtoul(value, nullptr, 10));
+            if (index >= limit) return;
+            std::error_code error;
+            std::filesystem::create_directories(dir, error);
+            if (error) return;
+            char name[40]; std::snprintf(name, sizeof(name), "vu1-run-%04u", index);
+            base = std::filesystem::path(dir) / name;
+            write(base.string()+".code.bin", code, std::min(codeSize, 16384u));
+            write(base.string()+".data.bin", data, std::min(dataSize, 16384u));
+            write(base.string()+".state.bin", &state, sizeof(state));
+            const uint32_t meta[] = {0x31555652u, 1, codeSize, dataSize, maxCycles,
+                memory ? memory->vif1_regs.top : 0, memory ? memory->vif1_regs.tops : 0,
+                state.itop, uint32_t(sizeof(VU1State)), uint32_t(sizeof(VuTraceRecord))};
+            write(base.string()+".meta.bin", meta, sizeof(meta));
+            trace.reserve(1024); active = true;
+        }
+        void step(const VU1State& state, uint32_t lower, uint32_t upper)
+        {
+            if (!active || trace.size() >= 1024) return;
+            VuTraceRecord record{state.pc, lower, upper, {}};
+            std::memcpy(record.vi, state.vi, sizeof(record.vi)); trace.push_back(record);
+        }
+        ~VuCapture()
+        {
+            if (active) write(base.string()+".trace.bin", trace.data(), trace.size()*sizeof(VuTraceRecord));
+        }
+    };
 }
 
