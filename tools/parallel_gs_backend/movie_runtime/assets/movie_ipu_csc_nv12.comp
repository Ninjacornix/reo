#version 450
layout(local_size_x=16,local_size_y=16) in;
// Imported NV12 plane formats are R8_UNORM and R8G8_UNORM. Fetch the nearest
// source bytes explicitly; no chroma interpolation or color-space conversion.
layout(set=0,binding=0) uniform sampler2D yPlane;
layout(set=0,binding=1) uniform sampler2D uvPlane;
layout(set=0,binding=2,rgba8ui) writeonly uniform uimage2D rgba;
layout(push_constant) uniform MovieParameters {uint width;uint height;uint th0;uint th1;} params;
void main() {
    uvec2 pixel=gl_GlobalInvocationID.xy;
    if(pixel.x>=params.width||pixel.y>=params.height)return;
    int y=int(texelFetch(yPlane,ivec2(pixel),0).r*255.0+0.5)-16;
    ivec2 uv=ivec2(texelFetch(uvPlane,ivec2(pixel/2u),0).rg*255.0+0.5)-128;
    ivec3 rgb=clamp(ivec3(0x95*y+0xcc*uv.y,0x95*y-0x32*uv.x-0x68*uv.y,0x95*y+0x102*uv.x)>>7,0,255);
    uint a=all(lessThan(uvec3(rgb),uvec3(params.th0&511u)))?0u:
           all(lessThan(uvec3(rgb),uvec3(params.th1&511u)))?64u:128u;
    imageStore(rgba,ivec2(pixel),uvec4(rgb,a));
}
