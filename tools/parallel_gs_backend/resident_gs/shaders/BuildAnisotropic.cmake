# Keep the pinned GS shader as the base; fail if its injection points change.
file(READ "${UPSTREAM}/ubershader.comp" source)
string(REPLACE "#version 450" "#version 450\n#extension GL_GOOGLE_include_directive : require" source "${source}")
set(anchor "vec4 compute_combined_color(")
set(call "sample_texture(tex, tex2, uv, stq.z, perspective)")
string(FIND "${source}" "${anchor}" found_anchor)
string(FIND "${source}" "${call}" found_call)
if(found_anchor LESS 0 OR found_call LESS 0)
    message(FATAL_ERROR "Pinned GS shader changed: review anisotropic integration")
endif()
string(REPLACE "${anchor}" "#include \"anisotropic.glsl\"\n\n${anchor}" source "${source}")
string(REPLACE "${call}" "sample_anisotropic(primitive_index, tex, tex2, uv, stq, perspective, attrs)" source "${source}")
file(MAKE_DIRECTORY "${OUT}")
file(WRITE "${OUT}/anisotropic.comp" "${source}")
set(header "// Generated; do not edit.\n#pragma once\n#include <cstddef>\n#include <cstdint>\nnamespace reo_anisotropic {\n")
foreach(color RANGE 0 1)
    foreach(depth RANGE 0 1)
        set(binary "${OUT}/anisotropic_${color}${depth}.spv")
        execute_process(COMMAND "${GLSLANG}" -V --target-env vulkan1.2 -Os -S comp
            "-I${UPSTREAM}" "-I${CMAKE_CURRENT_LIST_DIR}" "-I${UPSTREAM}/../../Granite/assets/shaders/inc"
            "-DFEEDBACK_COLOR=${color}" "-DFEEDBACK_DEPTH=${depth}"
            -o "${binary}" "${OUT}/anisotropic.comp" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Anisotropic shader compilation failed (${color}/${depth})")
        endif()
        execute_process(COMMAND "${VALIDATOR}" --target-env vulkan1.2 "${binary}" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Anisotropic SPIR-V validation failed")
        endif()
        file(READ "${binary}" hex HEX)
        string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
        string(APPEND header "alignas(4) static const unsigned char shader${color}${depth}[] = {${bytes}};\n")
    endforeach()
endforeach()
string(APPEND header "static const unsigned char* const code[2][2]={{shader00,shader01},{shader10,shader11}};\nstatic const std::size_t size[2][2]={{sizeof(shader00),sizeof(shader01)},{sizeof(shader10),sizeof(shader11)}};\n}\n")
file(WRITE "${OUT}/anisotropic_spirv.hpp" "${header}")
