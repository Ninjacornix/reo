void seed(Consuming& f,unsigned n){
    for(unsigned slot=1;slot<=36;++slot){s::SceneDescriptor item;item.active=std::uint8_t((slot+n)%7?128:0);item.instance_index=std::uint8_t(slot);item.ownership_tag=std::uint16_t((n+slot)%5);item.template_index=(n+slot)%19?std::uint8_t((n+slot)%f.q.templates.state().count):255;item.claim_tag=std::uint8_t(n+slot);item.flags=n*1664525u+slot;item.parameter=std::int16_t(slot);item.attachment_id=42;sync_full(f.q,slot,item);}
