+    def _columns(self, table: str) -> set[str]:
+        # Callers supply only constant schema identifiers.
+        return {str(row['name']) for row in self._connection.execute(f'PRAGMA table_info({table})')}
+
+    def _archive_legacy_records(self) -> bool:
+        columns = self._columns('records')
+        if 'record_id' not in columns:
+            return False
+        required = {'record_id', 'game', 'board', 'user_id', 'player', 'score', 'details', 'recorded_at'}
+        if not required <= columns:
+            raise sqlite3.DatabaseError('Unrecognized legacy records schema; migration rolled back')
+        # Keep every original submission, including boards not understood by
+        # this Outbreak-specific migration. Never replace an existing archive.
+        self._connection.execute('ALTER TABLE records RENAME TO records_legacy_v1')
+        self._connection.execute('DROP INDEX IF EXISTS records_rank')
+        return True
