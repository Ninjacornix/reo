<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.20</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Outbreak.Launcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <Import Project="native/GraphicsPreview.targets" />
  <ItemGroup>
    <Compile Remove="shared/**/*.cs;desktop/**/*.cs;cross-tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../examples/mods/no-infection.json" Link="examples/mods/no-infection.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../examples/mods/randomizer.json" Link="examples/mods/randomizer.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../examples/mods/randomizer-file2.json" Link="examples/mods/randomizer-file2.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../docs/MODDING.md" Link="docs/MODDING.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/PROVENANCE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Covers/ARTWORK-NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Resource Include="Assets/app-icon.ico" />
    <None Update="Assets/app-icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Resource Include="artifacts/shaders/ColorPreview.ps" Link="Shaders/ColorPreview.ps" />
  </ItemGroup>
  <ItemGroup>
    <RetiredModExample Include="practice-mode;weapon-shuffle;item-randomizer;zombie-randomizer;outbreak-randomizer;ground-enemy-randomizer" />
  </ItemGroup>
  <Target Name="RemovePackagedCoverImagesFromBuild" AfterTargets="Build" Condition="'$(OutDir)' != ''">
    <ItemGroup><OldPackagedCover Include="$(OutDir)Assets/Covers/**/*.jpg;$(OutDir)Assets/Covers/**/*.png;$(OutDir)Assets/Covers/**/*-wrap.json" /></ItemGroup>
    <Delete Files="@(OldPackagedCover)" />
  </Target>
  <Target Name="RemovePackagedCoverImagesFromPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup><PublishedCover Include="$(PublishDir)Assets/Covers/**/*.jpg;$(PublishDir)Assets/Covers/**/*.png;$(PublishDir)Assets/Covers/**/*-wrap.json" /></ItemGroup>
    <Delete Files="@(PublishedCover)" />
  </Target>
  <Target Name="RemoveRetiredModExamplesFromBuild" AfterTargets="Build">
    <Delete Files="@(RetiredModExample->'$(OutDir)examples/mods/%(Identity).json')" />
  </Target>
  <Target Name="RemoveRetiredModExamplesFromPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Delete Files="@(RetiredModExample->'$(PublishDir)examples/mods/%(Identity).json')" />
  </Target>
</Project>
