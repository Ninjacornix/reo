<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.1</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Outbreak.Launcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../LICENSES/REO-upstream-MIT.txt" Link="LICENSES/REO-upstream-MIT.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../LICENSES/SMAA-MIT.txt" Link="LICENSES/SMAA-MIT.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/PROVENANCE.md" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/app-icon.ico" />
    <Content Include="Assets/app-icon.ico" Link="Assets/app-icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="artifacts/shaders/ColorPreview.ps" Link="Shaders/ColorPreview.ps" />
  </ItemGroup>
</Project>
