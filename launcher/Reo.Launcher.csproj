<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Outbreak.Launcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../LICENSES/REO-upstream-MIT.txt" Link="LICENSES/REO-upstream-MIT.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/PROVENANCE.md" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/*.png" />
  </ItemGroup>
</Project>
