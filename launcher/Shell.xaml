<Window x:Class="Outbreak.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Outbreak.Launcher" Title="RE: Outbreak" Icon="pack://application:,,,/Outbreak.Launcher;component/Assets/app-icon.ico" Width="1120" Height="790" MinWidth="980" MinHeight="690" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Background="#121415" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True">
   <Grid x:Name="ArtworkLayer" Opacity="0.46">
    <Image x:Name="Backdrop" Stretch="UniformToFill" HorizontalAlignment="Right" Width="610"/>
    <Image x:Name="OutgoingBackdrop" Stretch="UniformToFill" HorizontalAlignment="Right" Width="610" Opacity="0"/>
   </Grid>
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF121415" Offset="0"/><GradientStop Color="#F4121415" Offset="0.30"/><GradientStop Color="#60121415" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#80121415" Offset="0"/><GradientStop Color="#00121415" Offset="0.4"/><GradientStop Color="#FF121415" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
  </Grid>
  <Border Background="#181A1B">
   <Grid Margin="16,28,16,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Margin="12,0,0,36"><TextBlock Text="RE: Outbreak" FontSize="20"/><TextBlock x:Name="VersionLabel" Style="{StaticResource Hint}" Margin="0,2,0,0"/></StackPanel>
     <Button x:Name="NavPlay" Tag="Play" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Play" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavGraphics" Tag="Graphics" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Graphics" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavController" Tag="Controller" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Controls" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavSaves" Tag="Saves" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Save games" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavCoop" Tag="Coop" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Co-op" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavMods" Tag="Mods" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}" Visibility="Collapsed"><TextBlock Text="Mods" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavCheats" Tag="Cheats" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Cheats" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavSetup" Tag="Setup" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Game files" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavLogs" Tag="Logs" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Log" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
    </StackPanel>
    <StackPanel Grid.Row="2"><Button x:Name="PadBadge" Tag="Controller" Click="Navigate" Content="Checking input" Style="{StaticResource NavButton}" HorizontalContentAlignment="Left" Padding="12,6" FontSize="13" Margin="0,0,0,10" ToolTip="Open Controls" AutomationProperties.Name="Input device, open Controls"/><Button x:Name="UpdateButton" Content="Check for updates" Click="CheckForUpdates" ToolTip="Check GitHub Releases and install a newer Windows package" FontSize="13" HorizontalContentAlignment="Left"/>
     <TextBlock x:Name="UpdateState" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="10,8,0,0"/>
     <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Height="4" Minimum="0" Maximum="100" Margin="10,8,0,0" Foreground="{StaticResource Accent}"/>
     <Button x:Name="UpdateCancel" Content="Cancel download" Click="CancelUpdate" Visibility="Collapsed" FontSize="12" Margin="0,8,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="34,29,34,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel x:Name="PageHeader" Margin="0,0,0,20"><TextBlock x:Name="PageTitle" Text="Play" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel>
   <Grid x:Name="PageContent" Grid.Row="1" Margin="0,0,0,18">
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid>
      <StackPanel x:Name="PagePlay">
       <ListBox x:Name="GamePicker" SelectionChanged="GameSelectionChanged" SelectedValuePath="Tag" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,22" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Choose game">
        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBoxItem Tag="file1" Style="{StaticResource GameChoice}" Margin="0,0,9,0" AutomationProperties.Name="Outbreak File 1">
        <Border x:Name="GameCard1" Background="#EE1C1E20" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border x:Name="PosterFrame1" CornerRadius="3" ClipToBounds="True" Margin="0,0,16,0" Visibility="Collapsed"><Image x:Name="GamePoster1" Width="72" Height="106" Stretch="UniformToFill"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Outbreak" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="File #1" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock x:Name="GameStatus1" Style="{StaticResource Hint}" Margin="0,10,0,0"/></StackPanel>
         </Grid>
        </Border>
        </ListBoxItem>
        <ListBoxItem Tag="file2" Style="{StaticResource GameChoice}" Margin="9,0,0,0" IsEnabled="False" AutomationProperties.Name="Outbreak File 2, coming later">
        <Border x:Name="GameCard2" Background="#EE1C1E20" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border x:Name="PosterFrame2" CornerRadius="3" ClipToBounds="True" Margin="0,0,16,0" Visibility="Collapsed"><Image x:Name="GamePoster2" Width="72" Height="106" Stretch="UniformToFill"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Outbreak" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="File #2" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock x:Name="GameStatus2" Style="{StaticResource Hint}" Margin="0,10,0,0"/></StackPanel>
         </Grid>
        </Border>
        </ListBoxItem>
       </ListBox>
       <Border x:Name="NextStep" Background="#EE1C1E20" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="7" Padding="20,16" Margin="0,0,0,24">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock x:Name="NextStepTitle" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="NextStepDetail" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
         <Button x:Name="NextStepButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="NextStepClicked" VerticalAlignment="Center" Padding="22,10"/>
        </Grid>
       </Border>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
        <StackPanel>
        <Grid Margin="0,0,0,12"><TextBlock Text="Before you play" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Check again" Click="RecheckRequirements" HorizontalAlignment="Right" Padding="10,4" FontSize="12"/></Grid>
        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CheckDotnetMark" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Status"/><TextBlock x:Name="CheckDotnetText" Grid.Column="1" VerticalAlignment="Center"/></Grid>
        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CheckVulkanMark" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Status"/><TextBlock x:Name="CheckVulkanText" Grid.Column="1" VerticalAlignment="Center"/><Button x:Name="CheckVulkanAction" Grid.Column="2" Tag="CheckVulkan" Click="ChecklistAction" Padding="10,4" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CheckDiskMark" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Status"/><TextBlock x:Name="CheckDiskText" Grid.Column="1" VerticalAlignment="Center"/><Button x:Name="CheckDiskAction" Grid.Column="2" Tag="CheckDisk" Click="ChecklistAction" Padding="10,4" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CheckDiscMark" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Status"/><TextBlock x:Name="CheckDiscText" Grid.Column="1" VerticalAlignment="Center"/><Button x:Name="CheckDiscAction" Grid.Column="2" Tag="CheckDisc" Click="ChecklistAction" Padding="10,4" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CheckToolsMark" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Status"/><TextBlock x:Name="CheckToolsText" Grid.Column="1" VerticalAlignment="Center"/></Grid>
        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CheckBuildMark" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Status"/><TextBlock x:Name="CheckBuildText" Grid.Column="1" VerticalAlignment="Center"/></Grid>
        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CheckInputMark" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Status"/><TextBlock x:Name="CheckInputText" Grid.Column="1" VerticalAlignment="Center"/><Button x:Name="CheckInputAction" Grid.Column="2" Tag="CheckInput" Click="ChecklistAction" Padding="10,4" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
        </StackPanel>
        <StackPanel Grid.Column="2">
       <TextBlock Text="Launch settings" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,14"/>
        <StackPanel><TextBlock Text="Play mode" Style="{StaticResource Hint}"/><TextBlock x:Name="PlayNetworkSummary" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Margin="0,14,0,0"><TextBlock Text="Display" Style="{StaticResource Hint}"/><TextBlock x:Name="PlayDisplaySummary" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Margin="0,14,0,0"><TextBlock Text="Input device" Style="{StaticResource Hint}"/><TextBlock x:Name="PlayInputSummary" Margin="0,4,0,0"/></StackPanel>
        </StackPanel>
       </Grid>
       <TextBlock x:Name="SessionSummary" Visibility="Collapsed"/>
      </StackPanel>
      <StackPanel x:Name="PageGraphics" Visibility="Collapsed">
       <TextBlock Text="Display" Style="{StaticResource Section}"/>
       <CheckBox x:Name="Fullscreen" Content="Borderless fullscreen" Click="SaveSettings" ToolTip="Ctrl+Enter toggles fullscreen in game. Alt+F4 closes the game."/>
       <Grid Margin="0,14,0,16"><TextBlock Text="Window resolution" VerticalAlignment="Center"/><ComboBox x:Name="WindowSize" HorizontalAlignment="Right" DisplayMemberPath="Name" SelectionChanged="SettingChanged"/></Grid>
       <TextBlock Text="Fullscreen uses the monitor's desktop resolution." Style="{StaticResource Hint}" Margin="0,0,0,18"/>
       <Grid Margin="0,4,0,16"><TextBlock Text="Aspect ratio" VerticalAlignment="Center"/><ComboBox x:Name="AspectRatio" HorizontalAlignment="Right" SelectionChanged="SettingChanged"><ComboBoxItem Content="4:3 (original)"/><ComboBoxItem Content="16:9"/></ComboBox></Grid>
       <Grid Margin="0,4,0,16"><TextBlock Text="Screen fit" VerticalAlignment="Center"/><ComboBox x:Name="ScreenFit" HorizontalAlignment="Right" SelectionChanged="SettingChanged"><ComboBoxItem Content="Fit (centered)"/><ComboBoxItem Content="Native size (centered)"/><ComboBoxItem Content="Stretch to window"/><ComboBoxItem Content="Fill (crop edges)"/></ComboBox></Grid>
       <TextBlock x:Name="ScreenFitHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,18"/>
       <Grid Margin="0,4,0,16"><TextBlock Text="Image scaling" VerticalAlignment="Center"/><ComboBox x:Name="Filter" HorizontalAlignment="Right" SelectionChanged="SettingChanged"><ComboBoxItem Content="Bilinear"/><ComboBoxItem Content="Nearest"/></ComboBox></Grid>
       <Grid Margin="0,4,0,16"><TextBlock Text="Texture filtering (3D)" VerticalAlignment="Center"/><ComboBox x:Name="TextureFilter" HorizontalAlignment="Right" SelectionChanged="SettingChanged"><ComboBoxItem Content="Original"/><ComboBoxItem Content="Bilinear"/></ComboBox></Grid>
       <Grid Margin="0,4,0,16"><TextBlock Text="Anisotropic filtering" VerticalAlignment="Center"/><ComboBox x:Name="AnisotropicFilter" HorizontalAlignment="Right" SelectionChanged="SettingChanged" ToolTip="Improves 3D textures viewed at an angle. Includes bilinear filtering; higher levels cost more GPU time."><ComboBoxItem Content="Off"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/><ComboBoxItem Content="8×"/><ComboBoxItem Content="16×"/></ComboBox></Grid>
       <Grid Margin="0,4,0,16"><TextBlock Text="Anti-aliasing" VerticalAlignment="Center"/><ComboBox x:Name="AntiAlias" HorizontalAlignment="Right" SelectionChanged="SettingChanged"><ComboBoxItem Content="Off"/><ComboBoxItem Content="FXAA"/><ComboBoxItem Content="SMAA"/></ComboBox></Grid>
       <TextBlock Text="FXAA and SMAA smooth edges on the GPU. They do not increase texture detail." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
       <Grid Margin="0,22,0,12"><TextBlock Text="Brightness and gamma" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Reset" Click="ResetColor" HorizontalAlignment="Right" Padding="14,6"/></Grid>
       <Border Background="#080A0A" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,18">
        <Grid Height="320"><Image x:Name="RoomPreview" Stretch="Uniform"/><TextBlock x:Name="PreviewEmpty" Text="Room preview unavailable" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
       </Border>
       <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
         <Grid><TextBlock Text="Brightness"/><TextBlock x:Name="BrightnessValue" Text="100%" HorizontalAlignment="Right"/></Grid>
         <Slider x:Name="Brightness" Minimum="50" Maximum="150" Value="100" SmallChange="1" LargeChange="10" ValueChanged="ColorChanged" Margin="0,8,0,0" AutomationProperties.Name="Brightness"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <Grid><TextBlock Text="Gamma"/><TextBlock x:Name="GammaValue" Text="1.00" HorizontalAlignment="Right"/></Grid>
         <Slider x:Name="Gamma" Minimum="0.5" Maximum="2" Value="1" SmallChange="0.01" LargeChange="0.1" ValueChanged="ColorChanged" Margin="0,8,0,0" AutomationProperties.Name="Gamma"/>
        </StackPanel>
       </Grid>
       <TextBlock Text="Gameplay" Style="{StaticResource Section}"/>
       <TextBlock Text="Original game timing"/><TextBlock Text="30 game updates / 60 display refreshes" Style="{StaticResource Hint}" Margin="0,6,0,14"/>
       <CheckBox x:Name="AsyncVif" Content="Parallel geometry worker" Click="SaveSettings"/>
       <TextBlock Text="Movies" Style="{StaticResource Section}"/>
       <CheckBox x:Name="GpuMovies" Content="Decode movies on the graphics card" Click="SaveSettings" IsEnabled="False"/>
       <TextBlock x:Name="GpuMoviesHint" Text="Checking the graphics card..." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
       <TextBlock Text="Changes apply on the next launch." Style="{StaticResource Hint}" Margin="0,14,0,0"/>
      </StackPanel>
      <StackPanel x:Name="PageController" Visibility="Collapsed">
       <Grid Margin="0,4,0,17"><TextBlock Text="Input device" VerticalAlignment="Center"/><ComboBox x:Name="InputDevicePicker" Width="340" HorizontalAlignment="Right" DisplayMemberPath="Name" SelectionChanged="InputDeviceChanged"/></Grid>
       <TextBlock x:Name="ControllerDetail" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
       <WrapPanel Margin="0,0,0,18"><Button x:Name="BindingsTab" Content="Bindings" Click="ShowBindings" Margin="0,0,8,0"/><Button x:Name="LayoutTab" Content="Sticks" Click="ShowInputLayout"/></WrapPanel>
       <StackPanel x:Name="InputBindingsPanel">
        <Grid x:Name="CapturePanel" Visibility="Collapsed" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock x:Name="CaptureHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="CancelCaptureButton" Grid.Column="1" Content="Cancel" Click="CancelCapture"/></Grid>
        <UniformGrid x:Name="BindingRows" Columns="2"/>
        <Button Content="Reset bindings" Click="ResetBindings" HorizontalAlignment="Left" Margin="0,18,0,8"/>
       </StackPanel>
       <StackPanel x:Name="InputLayoutPanel" Visibility="Collapsed">
        <StackPanel x:Name="StickSettings">
         <Grid Margin="0,5,0,18"><TextBlock x:Name="DeadZoneLabel" Text="Dead zone: 12%" VerticalAlignment="Center"/><Slider x:Name="DeadZone" Minimum="0" Maximum="30" Value="12" Width="300" HorizontalAlignment="Right" ValueChanged="DeadZoneChanged"/></Grid>
         <CheckBox x:Name="SwapSticks" Content="Swap left and right sticks" Click="SaveInputOptions"/><CheckBox x:Name="InvertRightY" Content="Invert right stick Y" Click="SaveInputOptions"/>
         <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><local:StickPlot x:Name="LeftPlot" Height="140"/><local:StickPlot x:Name="RightPlot" Grid.Column="1" Height="140"/></Grid>
         <TextBlock Text="Outline: raw input. Filled dot: game input." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
        </StackPanel>
       </StackPanel>
      </StackPanel>
      <StackPanel x:Name="PageSaves" Visibility="Collapsed">
       <TextBlock Text="Memory card - Slot 1" FontSize="20"/>
       <StackPanel x:Name="CardControls" Margin="0,18,0,0">
        <ComboBox x:Name="CardSelection" SelectionChanged="CardChanged"/>
        <TextBlock x:Name="CardPath" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,18"/>
        <TextBlock Text="New card name" Margin="0,0,0,8"/>
        <WrapPanel><TextBox x:Name="NewCardName" Width="250" Margin="0,0,10,10" ToolTip="New memory card name"/><Button Content="Create card" Click="CreateCard" Margin="0,0,10,10"/><Button Content="Use existing folder" Click="BrowseCard" Margin="0,0,0,10"/></WrapPanel>
       </StackPanel>
       <TextBlock x:Name="SaveCount" Margin="0,10,0,20" Style="{StaticResource Hint}"/>
       <WrapPanel><Button Content="Open card folder" Click="OpenSaves" Margin="0,0,10,10"/><Button x:Name="BackupButton" Content="Back up card" Click="BackupSaves" Margin="0,0,0,10"/></WrapPanel>
       <TextBlock Text="8 MB PS2 card. Save and load from the game. Raw .ps2 images are not supported." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
      <StackPanel x:Name="PageCoop" Visibility="Collapsed">
       <TextBlock x:Name="CoopUnavailable" Text="Online play is available for File #1 only." Style="{StaticResource Hint}" Margin="0,0,0,16" Visibility="Collapsed"/>
       <StackPanel x:Name="CoopControls" MaxWidth="600" HorizontalAlignment="Left">
        <UniformGrid Columns="3" Margin="0,0,0,26">
         <RadioButton x:Name="ModeOffline" GroupName="CoopMode" Tag="offline" Style="{StaticResource ModeChoice}" Margin="0,0,6,0" Checked="CoopModeChanged" AutomationProperties.Name="Play alone"><StackPanel><TextBlock Text="Play alone" FontWeight="SemiBold"/><TextBlock Text="Single player" Style="{StaticResource Hint}"/></StackPanel></RadioButton>
         <RadioButton x:Name="ModeHost" GroupName="CoopMode" Tag="host" Style="{StaticResource ModeChoice}" Margin="3,0,3,0" Checked="CoopModeChanged" AutomationProperties.Name="Host a game"><StackPanel><TextBlock Text="Host a game" FontWeight="SemiBold"/><TextBlock Text="Friends join you" Style="{StaticResource Hint}"/></StackPanel></RadioButton>
         <RadioButton x:Name="ModeJoin" GroupName="CoopMode" Tag="join" Style="{StaticResource ModeChoice}" Margin="6,0,0,0" Checked="CoopModeChanged" AutomationProperties.Name="Join a game"><StackPanel><TextBlock Text="Join a game" FontWeight="SemiBold"/><TextBlock Text="Play in a friend's game" Style="{StaticResource Hint}"/></StackPanel></RadioButton>
        </UniformGrid>
        <StackPanel x:Name="OnlinePanel">
         <Label Content="Your player name" Target="{Binding ElementName=AccountUsername}" Padding="0" Foreground="{StaticResource Ink}"/>
         <TextBox x:Name="AccountUsername" Width="270" HorizontalAlignment="Left" TextChanged="OnlineSettingChanged" Margin="0,8,0,6" AutomationProperties.Name="Player name"/>
         <TextBlock Text="Other players see this name. 4-10 letters, numbers or _." Style="{StaticResource Hint}" Margin="0,0,0,24"/>
         <StackPanel x:Name="HostOptions">
          <TextBlock x:Name="HostStatus" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock x:Name="HostDetail" Style="{StaticResource Hint}" Margin="0,0,0,16"/>
          <Label Content="Friends join using this address" Target="{Binding ElementName=HostAddressPicker}" Padding="0" Foreground="{StaticResource Ink}"/>
          <WrapPanel Margin="0,8,0,6"><ComboBox x:Name="HostAddressPicker" Width="360" DisplayMemberPath="Label" SelectionChanged="HostAddressChanged" Margin="0,0,10,0" AutomationProperties.Name="Address friends use"/><Button x:Name="CopyServerButton" Content="Copy address" Click="CopyServerAddress" IsEnabled="False"/></WrapPanel>
          <TextBlock Text="Friends on your network find your game automatically. Others need this address." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
          <WrapPanel><Button x:Name="FirewallButton" Content="Allow friends through Windows Firewall" Click="AllowFirewall" Margin="0,0,10,0"/><TextBlock x:Name="FirewallStatus" VerticalAlignment="Center" MaxWidth="220" Style="{StaticResource Hint}"/></WrapPanel>
          <Button x:Name="StartServerButton" Content="Try again" Click="StartServerClicked" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,12,0,0"/>
          <Expander x:Name="PortOptions" Header="Ports" Foreground="{StaticResource Muted}" Margin="0,20,0,0">
           <StackPanel Margin="0,12,0,0" MaxWidth="460" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,10"><Label Content="Player sign-up (TCP)" Target="{Binding ElementName=SignupPortBox}" Padding="0" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/><TextBox x:Name="SignupPortBox" Width="110" HorizontalAlignment="Right" MaxLength="5" LostKeyboardFocus="PortsChanged" KeyDown="PortKeyDown"/></Grid>
            <Grid Margin="0,0,0,10"><Label Content="Game server (UDP)" Target="{Binding ElementName=GamePortBox}" Padding="0" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/><TextBox x:Name="GamePortBox" Width="110" HorizontalAlignment="Right" MaxLength="5" LostKeyboardFocus="PortsChanged" KeyDown="PortKeyDown"/></Grid>
            <TextBlock Style="{StaticResource Hint}" Text="Login (9090 UDP) and the app server (10127 TCP) are built into the game and cannot change. Friends' launchers pick up your other ports automatically."/>
            <TextBlock x:Name="PortStatus" Margin="0,8,0,0"/>
            <Button Content="Use default ports" Click="ResetPorts" HorizontalAlignment="Left" Margin="0,10,0,0"/>
           </StackPanel>
          </Expander>
          <Expander x:Name="InternetOptions" Header="Playing over the internet" Foreground="{StaticResource Muted}" Margin="0,20,0,0">
           <StackPanel Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Hint}" Text="Easiest: everyone joins the same VPN, such as Tailscale or ZeroTier, and you choose its address above. Without a VPN, your router has to let friends in."/>
            <WrapPanel Margin="0,12,0,8"><Button x:Name="PublicAddressButton" Content="Find my internet address" Click="FindPublicAddress" Margin="0,0,10,0"/><TextBlock x:Name="PublicAddressStatus" VerticalAlignment="Center" MaxWidth="260" Style="{StaticResource Hint}"/></WrapPanel>
            <CheckBox x:Name="AutoForward" Content="Ask my router to open the ports automatically (UPnP)" Click="OnlineSettingChanged"/>
            <TextBlock x:Name="ReachStatus" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
            <TextBlock Text="Ports to forward in your router" Margin="0,14,0,4"/>
            <TextBlock x:Name="PortList" Style="{StaticResource Hint}"/>
           </StackPanel>
          </Expander>
         </StackPanel>
         <StackPanel x:Name="JoinOptions">
          <Grid Margin="0,0,0,10"><TextBlock Text="Games on your network" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="SearchGamesButton" Content="Search again" Click="SearchGamesClicked" HorizontalAlignment="Right" Padding="12,6"/></Grid>
          <StackPanel x:Name="FoundGames"/>
          <TextBlock x:Name="SearchStatus" Style="{StaticResource Hint}" Margin="0,4,0,20"/>
          <Label Content="Or enter the host's address" Target="{Binding ElementName=CoopHost}" Padding="0" Foreground="{StaticResource Ink}"/>
          <TextBox x:Name="CoopHost" Width="270" HorizontalAlignment="Left" MaxLength="15" TextChanged="OnlineSettingChanged" Margin="0,8,0,6" AutomationProperties.Name="Host address"/>
          <TextBlock Text="The host can copy it from their Co-op page." Style="{StaticResource Hint}"/>
         </StackPanel>
         <CheckBox x:Name="AutoLobby" Content="Take me to the waiting room automatically" Click="OnlineSettingChanged" Margin="0,26,0,4"/>
         <TextBlock x:Name="AutoLobbyHint" Style="{StaticResource Hint}"/>
         <TextBlock x:Name="CoopValidation" Margin="0,16,0,0" Visibility="Collapsed"/>
         <TextBlock x:Name="AccountStatus" Margin="0,10,0,0"/>
        </StackPanel>
       </StackPanel>
      </StackPanel>
      <StackPanel x:Name="PageMods" Visibility="Collapsed">
       <TextBlock Text="Mod support is not available in this build." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
      </StackPanel>
      <StackPanel x:Name="PageCheats" Visibility="Collapsed">
       <TextBlock x:Name="CheatGame" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
       <TextBlock x:Name="CheatHelp" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,20"/>
       <StackPanel x:Name="CheatControls">
        <CheckBox x:Name="EnableCheats" Content="Enable cheats" Click="CheatToggled" Margin="0,0,0,20"/>
        <StackPanel x:Name="CheatList"/>
        <Expander Header="Custom cheats" Margin="0,24,0,0" Foreground="{StaticResource Muted}">
         <StackPanel Margin="0,16,0,0">
          <WrapPanel><Button Content="Import .pnach" Click="ImportCheats" Margin="0,0,10,0"/><Button Content="Open cheats folder" Click="OpenCheatFolder" Margin="0,0,10,0"/><Button Content="Reload" Click="ReloadCheats"/></WrapPanel>
          <TextBlock Text="Optional PCSX2 files for NTSC-U v2.00. EE data writes and RAW 0/1/2 codes are supported." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,12,0,0"/>
         </StackPanel>
        </Expander>
       </StackPanel>
      </StackPanel>
      <StackPanel x:Name="PageSetup" Visibility="Collapsed">
       <TextBlock Text="Disc image (.iso)"/>
       <TextBox x:Name="IsoPath" IsReadOnly="True" Margin="0,8,0,8"/>
       <WrapPanel><Button x:Name="ChooseIsoButton" Content="Choose ISO" Tag="iso" Click="BrowseFile" Margin="0,0,10,0"/><Button x:Name="ImportDiscButton" Content="Import" Click="ImportDisc"/></WrapPanel>
       <TextBlock x:Name="SupportedDiscHint" Text="Required: Outbreak File #1, NTSC-U v2.00 (SLUS-20765). PAL, Japanese and other revisions are unsupported." Style="{StaticResource Hint}" Margin="0,14,0,0"/>
       <TextBlock x:Name="DiscValidationStatus" TextWrapping="Wrap" Margin="0,10,0,0"/>
       <TextBlock x:Name="ImportState" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,18,0,10"/>
       <TextBlock Text="Already have a completed game build?" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,10"/>
       <Button x:Name="ExistingBuildButton" Content="Use existing build" Click="UseExistingBuild" HorizontalAlignment="Left"/>
       <TextBlock Text="Choose reo_recomp.exe from a compatible launcher build. Keep its entire folder, including local-build.json, DLLs and shaders. Your ISO is still required." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0"/>
       <TextBlock Text="Remove game" FontSize="16" FontWeight="SemiBold" Margin="0,30,0,8"/>
       <TextBlock x:Name="RemoveSummary" Style="{StaticResource Hint}" Text="Deletes the imported disc data, the built game and its build cache from this PC. Your ISO file and this launcher stay."/>
       <CheckBox x:Name="RemoveSaves" Content="Also delete save games for this game" Click="RemoveOptionsChanged" Margin="0,10,0,4"/>
       <CheckBox x:Name="RemoveTools" Content="Also remove the build and hosting tools (downloaded again when needed)" Click="RemoveOptionsChanged" Margin="0,4,0,10"/>
       <WrapPanel><Button x:Name="RemoveGameButton" Content="Remove game..." Click="RemoveGame" Margin="0,0,12,0"/><TextBlock x:Name="RemoveSize" VerticalAlignment="Center" Style="{StaticResource Hint}"/></WrapPanel>
       <Expander x:Name="DeveloperFiles" Header="Developer options" Foreground="{StaticResource Muted}" Margin="0,30,0,0">
        <StackPanel Margin="0,16,0,0">
         <TextBlock Text="Native executable"/><TextBox x:Name="ExePath" IsReadOnly="True" Margin="0,8,0,8"/><Button Content="Browse" Tag="exe" Click="BrowseFile" HorizontalAlignment="Left"/>
         <TextBlock Text="Reference ELF (File #2 development)" Margin="0,23,0,0"/><TextBox x:Name="ElfPath" IsReadOnly="True" Margin="0,8,0,8"/><Button Content="Browse" Tag="elf" Click="BrowseFile" HorizontalAlignment="Left"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </Grid>
    </ScrollViewer>
    <Grid x:Name="PageLogs" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ComboBox x:Name="LogSessionPicker" DisplayMemberPath="Name" SelectionChanged="LogSelectionChanged" Margin="0,0,0,10"/>
     <WrapPanel Grid.Row="1" Margin="0,0,0,12"><ComboBox x:Name="LogStreamPicker" SelectionChanged="LogSelectionChanged" MinWidth="180" Margin="0,0,10,0"><ComboBoxItem Content="Game debug"/><ComboBoxItem Content="Game output"/></ComboBox><Button Content="Open file" Click="BrowseLog" Margin="0,0,8,0"/><Button Content="Open folder" Click="OpenLogs"/><CheckBox x:Name="FollowLog" Content="Follow" IsChecked="True" Margin="15,6,0,6"/></WrapPanel>
     <TextBox x:Name="DebugLog" Grid.Row="2" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="12"/>
     <TextBlock x:Name="LogInfo" Grid.Row="3" Style="{StaticResource Hint}" Margin="0,9,0,0"/>
    </Grid>
   </Grid>
   <Image x:Name="OutgoingHeader" Grid.Row="0" Margin="0,0,0,20" Stretch="Fill" IsHitTestVisible="False" Opacity="0"/>
   <Image x:Name="OutgoingPage" Grid.Row="1" Margin="0,0,0,18" Stretch="Fill" IsHitTestVisible="False" Opacity="0"/>
   <StackPanel Grid.Row="2">
   <Border x:Name="ImportActivity" Visibility="Collapsed" Background="#EE1C1E20" CornerRadius="5" Padding="14" Margin="0,0,0,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0">
      <DockPanel Margin="0,0,0,8"><TextBlock x:Name="SetupCounts" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0" Style="{StaticResource Hint}"/><TextBlock x:Name="SetupStage" FontWeight="SemiBold"/></DockPanel>
      <ProgressBar x:Name="DiscProgress" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" AutomationProperties.Name="Game setup progress"/>
      <TextBlock x:Name="SetupDetail" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
      <TextBlock x:Name="ImportTiming" Style="{StaticResource Hint}"/>
     </StackPanel>
     <Button Grid.Column="1" Content="Cancel setup" Click="CancelImport" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <Border x:Name="HostSetupActivity" Visibility="Collapsed" Background="#EE1C1E20" CornerRadius="5" Padding="14" Margin="0,0,0,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0">
      <TextBlock x:Name="HostSetupStage" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ProgressBar x:Name="HostSetupProgress" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" AutomationProperties.Name="Server setup progress"/>
      <TextBlock x:Name="HostSetupDetail" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
     </StackPanel>
     <Button Grid.Column="1" Content="Cancel setup" Click="CancelServerSetup" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   </StackPanel>
   <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="SelectedGameLabel" FontSize="14" Margin="0,0,0,5"/><TextBlock x:Name="Status" Text="Ready" Style="{StaticResource Hint}"/></StackPanel><Button x:Name="StopButton" Grid.Column="1" Content="Stop" Click="StopGame" IsEnabled="False" Padding="24,11" Margin="0,0,10,0"/><Button x:Name="LaunchButton" Grid.Column="2" Content="Play" Click="LaunchGame" Style="{StaticResource PrimaryButton}" Padding="42,12" MinWidth="142"/></Grid>
  </Grid>
 </Grid>
</Window>
