       <Grid Margin="0,3,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Cheat configuration" FontSize="24"/>
        <TextBlock x:Name="CheatGame" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center"/>
       </Grid>
       <TextBlock x:Name="CheatSessionNote" Style="{StaticResource Hint}" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>
       <StackPanel x:Name="CheatControls">
        <Grid Height="44"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <TextBlock x:Name="CheatsEnabledLabel" Text="Enable cheats" FontSize="18" VerticalAlignment="Center"/>
         <CheckBox x:Name="EnableCheats" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="CheatToggled" Unchecked="CheatToggled" VerticalAlignment="Center" AutomationProperties.Name="Enable cheats" AutomationProperties.LabeledBy="{Binding ElementName=CheatsEnabledLabel}" AutomationProperties.HelpText="Apply selected cheats on the next game launch. Turning this off preserves your selections."/>
         <TextBlock x:Name="CheatSelectionState" Grid.Column="2" Style="{StaticResource Hint}" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,8,0,10"/>
        <StackPanel x:Name="CheatList"/>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,12"/>
        <WrapPanel x:Name="CheatFileActions"><Button x:Name="ImportCheatsButton" Content="Import .pnach" Click="ImportCheats" Margin="0,0,10,6"/><Button Content="Open cheats folder" Click="OpenCheatFolder" Margin="0,0,10,6"/><Button Content="Reload" Click="ReloadCheats" Margin="0,0,0,6"/></WrapPanel>
        <TextBlock Text="Selections are saved automatically. Changes apply on the next launch." Style="{StaticResource Hint}" FontSize="14" TextWrapping="Wrap" Margin="0,3,0,0"/>
       </StackPanel>
      </StackPanel>
      <StackPanel x:Name="PageLauncher" Visibility="Collapsed" MaxWidth="940" HorizontalAlignment="Stretch">
       <TextBlock Text="Launcher" FontSize="24" Margin="0,3,0,28"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="APPEARANCE" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,18"/>
         <Label Content="Font" Target="{Binding ElementName=LauncherFontPicker}" Padding="0" Foreground="{StaticResource Ink}" FontSize="18"/>
         <ComboBox x:Name="LauncherFontPicker" SelectedValuePath="Tag" SelectionChanged="LauncherAppearanceChanged" Margin="0,12,0,0" AutomationProperties.Name="Launcher font">
          <ComboBoxItem Content="Outbreak" Tag="outbreak"/><ComboBoxItem Content="Segoe UI" Tag="segoe-ui"/><ComboBoxItem Content="Tahoma" Tag="tahoma"/>
         </ComboBox>
         <TextBlock x:Name="LauncherFontHint" Text="Install either game to use the Outbreak font." Style="{StaticResource Hint}" FontSize="14" Margin="0,8,0,0" Visibility="Collapsed"/>
         <Label Content="Language" Target="{Binding ElementName=LauncherLanguagePicker}" Padding="0" Foreground="{StaticResource Ink}" FontSize="18" Margin="0,26,0,0"/>
         <ComboBox x:Name="LauncherLanguagePicker" SelectedValuePath="Tag" SelectionChanged="LauncherAppearanceChanged" Margin="0,12,0,0" AutomationProperties.Name="Launcher language"><ComboBoxItem Content="English" Tag="en"/></ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock Text="BACKGROUND" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,18"/>
         <Grid MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="LauncherMoviesLabel" Text="Background movies" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <CheckBox x:Name="LauncherBackgroundMovies" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="LauncherBackgroundMoviesChanged" Unchecked="LauncherBackgroundMoviesChanged" AutomationProperties.Name="Launcher background movies" AutomationProperties.LabeledBy="{Binding ElementName=LauncherMoviesLabel}"/>
         </Grid>
        </StackPanel>
       </Grid>
      </StackPanel>
      <StackPanel x:Name="PageDeveloper" Visibility="Collapsed" MaxWidth="940" HorizontalAlignment="Stretch">
       <TextBlock Text="Developer" FontSize="24" Margin="0,3,0,28"/>
       <TextBlock x:Name="DeveloperSessionNote" Text="Changes apply to your next session." Style="{StaticResource Hint}" FontSize="14" Margin="0,0,0,18" Visibility="Collapsed"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
         <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="NETWORK" Foreground="{StaticResource Muted}" FontSize="14"/><TextBlock Text="Co-op only" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="12"/></Grid>
         <Grid MinHeight="62"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DevNetworkLabel" Text="Packet timing" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/><CheckBox x:Name="DevNetworkTrace" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="DeveloperSettingChanged" Unchecked="DeveloperSettingChanged" AutomationProperties.Name="Record co-op packet timing" AutomationProperties.LabeledBy="{Binding ElementName=DevNetworkLabel}" AutomationProperties.HelpText="Record co-op packet timestamps, directions, sizes and headers in the session folder."/></Grid>
         <Grid MinHeight="62"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DevTransportLabel" Text="Transport log" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/><CheckBox x:Name="DevTransportLog" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="DeveloperSettingChanged" Unchecked="DeveloperSettingChanged" AutomationProperties.Name="Record network transport log" AutomationProperties.LabeledBy="{Binding ElementName=DevTransportLabel}" AutomationProperties.HelpText="Record native network socket activity in the game log."/></Grid>
         <Grid MinHeight="62"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DevSnapLabel" Text="SN@P packet log" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/><CheckBox x:Name="DevSnapTrace" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="DeveloperSettingChanged" Unchecked="DeveloperSettingChanged" AutomationProperties.Name="Record SN@P packet log" AutomationProperties.LabeledBy="{Binding ElementName=DevSnapLabel}" AutomationProperties.HelpText="Record the first game-protocol packet headers in the game log."/></Grid>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock Text="TIMING" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,18"/>
         <Grid MinHeight="62"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DevFrameLabel" Text="Frame timing" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/><CheckBox x:Name="DevFrameTiming" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="DeveloperSettingChanged" Unchecked="DeveloperSettingChanged" AutomationProperties.Name="Record frame timing" AutomationProperties.LabeledBy="{Binding ElementName=DevFrameLabel}" AutomationProperties.HelpText="Write frame start, scan-out and presentation times to frames.csv in the session folder."/></Grid>
         <Grid MinHeight="62"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="DevClockLabel" Text="Game clock and position" FontSize="18"/><TextBlock Text="File #1 only" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel><CheckBox x:Name="DevGameClock" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="DeveloperSettingChanged" Unchecked="DeveloperSettingChanged" AutomationProperties.Name="Record game clock and position" AutomationProperties.LabeledBy="{Binding ElementName=DevClockLabel}" AutomationProperties.HelpText="File #1 only. Write the game clock, room and player position to clock.csv for the first ten minutes."/></Grid>
        </StackPanel>
       </Grid>
       <TextBlock Text="SESSION FILES" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,30,0,14"/>
       <WrapPanel><Button x:Name="OpenSessionFoldersButton" Content="Open session folders" Click="OpenSessionFolders" Margin="0,0,8,8"/><Button x:Name="DeveloperViewLogsButton" Content="View logs" Tag="Logs" Click="Navigate" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel>
      <StackPanel x:Name="PageSetup" Visibility="Collapsed" MaxWidth="940" HorizontalAlignment="Stretch">
       <Grid Margin="0,3,0,28"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Game files" FontSize="24"/>
        <TextBlock x:Name="GameFilesEdition" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center"/>
       </Grid>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" MinWidth="300"/><ColumnDefinition Width="32"/><ColumnDefinition Width=".9*" MinWidth="260"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="GAME SOURCE" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,18"/>
         <Grid MinHeight="48" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Use game PAK" FontSize="18" VerticalAlignment="Center"/><CheckBox x:Name="UseGamePakSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="GameSourceChanged" Unchecked="GameSourceChanged" AutomationProperties.Name="Use PAK instead of ISO"/></Grid>
         <TextBlock x:Name="GameSourceLabel" Text="Disc image (.iso)" FontSize="18"/>
         <TextBox x:Name="IsoPath" Style="{StaticResource GameFilePath}" IsReadOnly="True" Margin="0,12,0,12" AutomationProperties.Name="Selected game disc image"/>
         <WrapPanel x:Name="DiscFileActions"><Button x:Name="ChooseIsoButton" Content="Choose ISO" Tag="iso" Click="BrowseFile" Margin="0,0,8,8"/><Button x:Name="ImportDiscButton" Content="Import and build" Click="ImportDisc" Background="{local:Palette AccentDeep}" BorderBrush="{StaticResource Accent}" Margin="0,0,0,8"/></WrapPanel>
         <TextBlock x:Name="SupportedDiscHint" Style="{StaticResource Hint}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
         <TextBlock x:Name="DiscValidationStatus" Style="{StaticResource CoopStatus}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
         <TextBlock x:Name="ImportState" Style="{StaticResource CoopStatus}" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
         <Expander Header="Asset exports" Style="{StaticResource ModOptionsDropdown}" Margin="0,20,0,0">
          <StackPanel x:Name="OriginalAssetOptions">
           <Grid MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Export during setup" FontSize="15" VerticalAlignment="Center"/><CheckBox x:Name="ExportOriginalAssets" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="OriginalAssetOptionChanged" Unchecked="OriginalAssetOptionChanged" AutomationProperties.Name="Export original assets during setup"/></Grid>
           <WrapPanel Margin="0,10,0,0"><Button x:Name="ExportOriginalAssetsNow" Content="Export now" Click="ExportOriginalAssetsClicked" FontSize="14" Margin="0,0,8,8"/><Button x:Name="OpenOriginalAssetExports" Content="Open exports folder" Click="OpenOriginalAssetExportsClicked" FontSize="14" Margin="0,0,0,8"/></WrapPanel>
           <Button x:Name="CleanOldImportsButton" Content="Clean up old imports..." Click="CleanOldImports" HorizontalAlignment="Left" FontSize="14" Margin="0,10,0,0"/>
          </StackPanel>
         </Expander>
         <TextBlock Text="GAME BUILD" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,32,0,16"/>
         <TextBlock x:Name="GameFilesBuildState" FontSize="20"/>
         <TextBox x:Name="SelectedBuildPath" Style="{StaticResource GameFilePath}" IsReadOnly="True" Margin="0,12,0,12" AutomationProperties.Name="Selected game build"/>
         <WrapPanel x:Name="BuildFileActions"><Button x:Name="ExistingBuildButton" Content="Use existing build" Click="UseExistingBuild" Margin="0,0,0,8"/></WrapPanel>
         <TextBlock x:Name="ExistingBuildHint" Style="{StaticResource Hint}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
         <Expander x:Name="DeveloperFiles" Header="Developer files" Style="{StaticResource ModOptionsDropdown}" Margin="0,28,0,0">
          <StackPanel Margin="0,16,0,4">
           <Label Content="Native executable" Target="{Binding ElementName=ExePath}" Padding="0" Foreground="{StaticResource Ink}" FontSize="14"/>
           <TextBox x:Name="ExePath" Style="{StaticResource GameFilePath}" IsReadOnly="True" Margin="0,8,0,10" AutomationProperties.Name="Developer native executable"/>
           <Button x:Name="BrowseExeButton" Content="Browse executable" Tag="exe" Click="BrowseFile" HorizontalAlignment="Left" FontSize="14"/>
           <Label Content="Reference ELF" Target="{Binding ElementName=ElfPath}" Padding="0" Foreground="{StaticResource Ink}" FontSize="14" Margin="0,20,0,0"/>
           <TextBox x:Name="ElfPath" Style="{StaticResource GameFilePath}" IsReadOnly="True" Margin="0,8,0,10" AutomationProperties.Name="Developer reference ELF"/>
           <Button x:Name="BrowseElfButton" Content="Browse ELF" Tag="elf" Click="BrowseFile" HorizontalAlignment="Left" FontSize="14"/>
          </StackPanel>
         </Expander>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock Text="LAUNCHER STORAGE" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,18"/>
         <Label Content="Data folder" Target="{Binding ElementName=StoragePath}" Padding="0" Foreground="{StaticResource Ink}" FontSize="18"/>
         <TextBox x:Name="StoragePath" Style="{StaticResource GameFilePath}" IsReadOnly="True" AutomationProperties.Name="Current storage folder" Margin="0,12,0,12"/>
         <WrapPanel><Button x:Name="ChooseStorageButton" Content="Change folder" Click="ChangeStorageFolder" Margin="0,0,8,8"/><Button x:Name="OpenStorageButton" Content="Open folder" Click="OpenStorageFolder" Margin="0,0,0,8"/></WrapPanel>
         <TextBlock x:Name="StorageStatus" Style="{StaticResource CoopStatus}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
         <TextBlock Text="REMOVE GAME" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,32,0,16"/>
         <TextBlock x:Name="RemoveSummary" Style="{StaticResource Hint}" FontSize="14" Text="Remove imported data, the game build and cache. Your ISO and launcher are kept." TextWrapping="Wrap" Margin="0,0,0,18"/>
         <StackPanel x:Name="GameRemovalControls">
          <Grid MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock x:Name="RemoveSavesLabel" Text="Include this game's saves" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
           <CheckBox x:Name="RemoveSaves" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="RemoveOptionsChanged" Unchecked="RemoveOptionsChanged" AutomationProperties.Name="Also delete this game's saves" AutomationProperties.LabeledBy="{Binding ElementName=RemoveSavesLabel}"/>
          </Grid>
          <Grid MinHeight="48" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock x:Name="RemoveToolsLabel" Text="Include shared build and hosting tools" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
           <CheckBox x:Name="RemoveTools" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="RemoveOptionsChanged" Unchecked="RemoveOptionsChanged" AutomationProperties.Name="Also remove shared build and hosting tools" AutomationProperties.LabeledBy="{Binding ElementName=RemoveToolsLabel}" AutomationProperties.HelpText="These tools are shared by both games and download again when needed."/>
          </Grid>
          <TextBlock x:Name="RemoveSize" Style="{StaticResource CoopStatus}" FontSize="14" Margin="0,16,0,12" AutomationProperties.LiveSetting="Polite"/>
          <Button x:Name="RemoveGameButton" Content="Remove game..." Click="RemoveGame" HorizontalAlignment="Left" FontSize="14"/>
         </StackPanel>
        </StackPanel>
       </Grid>
      </StackPanel>

     </Grid>
    </ScrollViewer>
    <Grid x:Name="PageLogs" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ComboBox x:Name="LogSessionPicker" DisplayMemberPath="Name" SelectionChanged="LogSelectionChanged" Margin="0,0,0,10"/>
     <WrapPanel Grid.Row="1" Margin="0,0,0,12"><ComboBox x:Name="LogStreamPicker" SelectionChanged="LogSelectionChanged" MinWidth="180" Margin="0,0,10,0"><ComboBoxItem Content="Game debug"/><ComboBoxItem Content="Game output"/></ComboBox><Button Content="Open file" Click="BrowseLog" Margin="0,0,8,0"/><Button Content="Open folder" Click="OpenLogs"/><CheckBox x:Name="FollowLog" Content="Follow" IsChecked="True" Margin="15,6,0,6"/></WrapPanel>
     <TextBox x:Name="DebugLog" Grid.Row="2" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Padding="12"/>
     <TextBlock x:Name="LogInfo" Grid.Row="3" Style="{StaticResource Hint}" Margin="0,9,0,0"/>
    </Grid>
   </Grid>
   <Image x:Name="OutgoingPage" Grid.Row="1" Margin="0,0,0,18" Stretch="Fill" IsHitTestVisible="False" Opacity="0"/>
   <StackPanel Grid.Row="2">
   <Border x:Name="BackgroundVideoActivity" Visibility="Collapsed" Background="{local:Palette Surface, Alpha=238}" CornerRadius="5" Padding="14" Margin="0,0,0,16">
    <StackPanel>
     <TextBlock x:Name="BackgroundVideoDetail" Text="Preparing background videos" FontWeight="Normal" Margin="0,0,0,8"/>
     <ProgressBar x:Name="BackgroundVideoProgress" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" AutomationProperties.Name="Background video preparation progress"/>
    </StackPanel>
   </Border>
   <Border x:Name="ArtworkActivity" Visibility="Collapsed" Background="{local:Palette Surface, Alpha=238}" CornerRadius="5" Padding="14" Margin="0,0,0,16">
    <StackPanel>
     <Grid Margin="0,0,0,8"><TextBlock Text="Downloading artwork" FontWeight="Normal"/><TextBlock x:Name="ArtworkDownloadDetail" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
     <ProgressBar x:Name="ArtworkDownloadProgress" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" AutomationProperties.Name="Artwork download progress"/>
    </StackPanel>
   </Border>
   <Border x:Name="ImportActivity" Visibility="Collapsed" Background="{local:Palette Surface, Alpha=238}" CornerRadius="5" Padding="14" Margin="0,0,0,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0">
      <DockPanel Margin="0,0,0,8"><TextBlock x:Name="SetupCounts" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0" Style="{StaticResource Hint}"/><TextBlock x:Name="SetupStage" FontWeight="Normal"/></DockPanel>
      <ProgressBar x:Name="DiscProgress" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" AutomationProperties.Name="Game setup progress"/>
      <TextBlock x:Name="SetupDetail" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
      <TextBlock x:Name="ImportTiming" Style="{StaticResource Hint}"/>
     </StackPanel>
     <Button Grid.Column="1" Content="Cancel setup" Click="CancelImport" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <Border x:Name="HostSetupActivity" Visibility="Collapsed" Background="{local:Palette Surface, Alpha=238}" CornerRadius="5" Padding="14" Margin="0,0,0,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0">
      <TextBlock x:Name="HostSetupStage" FontWeight="Normal" Margin="0,0,0,8"/>
      <ProgressBar x:Name="HostSetupProgress" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" AutomationProperties.Name="Server setup progress"/>
      <TextBlock x:Name="HostSetupDetail" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
     </StackPanel>
     <Button Grid.Column="1" Content="Cancel setup" Click="CancelServerSetup" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   </StackPanel>
   <Grid x:Name="LauncherFooter" Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ListBox x:Name="GamePicker" Width="400" HorizontalAlignment="Left" VerticalAlignment="Bottom" SelectionChanged="GameSelectionChanged" SelectedValuePath="Tag" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,24,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Choose game">
     <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
     <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBoxItem Tag="file1" Style="{StaticResource DiscChoice}" AutomationProperties.Name="Outbreak File 1" Margin="0,0,8,0">
      <ListBoxItem.ToolTip><StackPanel><TextBlock Text="Outbreak: File #1"/><TextBlock x:Name="DiscStatus1"/></StackPanel></ListBoxItem.ToolTip>
      <Grid Background="Transparent"><local:GameDiscView x:Name="GameDisc1" Edition="1"/></Grid>
     </ListBoxItem>
     <ListBoxItem Tag="file2" Style="{StaticResource DiscChoice}" AutomationProperties.Name="Outbreak File 2" Margin="8,0,0,0">
      <ListBoxItem.ToolTip><StackPanel><TextBlock Text="Outbreak: File #2"/><TextBlock x:Name="DiscStatus2"/></StackPanel></ListBoxItem.ToolTip>
      <Grid Background="Transparent"><local:GameDiscView x:Name="GameDisc2" Edition="2"/></Grid>
     </ListBoxItem>
    </ListBox>
    <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Click="StopGame" IsEnabled="False" Padding="24,11" Margin="0,0,10,24" VerticalAlignment="Bottom"/>
    <Button x:Name="LaunchButton" Grid.Column="2" Content="Play File #1" Click="LaunchGame" Style="{StaticResource PrimaryButton}" Padding="42,12" MinWidth="142" Margin="0,0,0,24" VerticalAlignment="Bottom"/>
   </Grid>
  </Grid>
  <!-- Status messages appear briefly in the top-right corner; MainWindow.StatusToast.cs shows and hides the card. -->
  <Border x:Name="StatusToast" Grid.Column="1" Panel.ZIndex="10" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0" MinWidth="300" MaxWidth="400" Background="{local:Palette Surface}" BorderBrush="{local:Palette Text, Alpha=46}" BorderThickness="1" CornerRadius="6" Cursor="Hand" MouseLeftButtonUp="DismissStatusToast">
   <Border.RenderTransform><TranslateTransform x:Name="StatusToastOffset"/></Border.RenderTransform>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Width="3" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="12,14,0,14"/>
    <StackPanel Grid.Column="1" Margin="12,12,18,13" VerticalAlignment="Center">
     <TextBlock x:Name="StatusToastTitle" Foreground="{local:Palette Text}" FontSize="16" FontWeight="Normal" TextWrapping="Wrap"/>
     <TextBlock x:Name="StatusToastDetail" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
     <local:StatusText x:Name="Status" Text="Ready" Visibility="Collapsed"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
