<Window x:Class="Outbreak.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Outbreak.Launcher" Title="RE: Outbreak" Icon="pack://application:,,,/Outbreak.Launcher;component/Assets/app-icon.ico" Width="1320" Height="920" MinWidth="980" MinHeight="690" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" Background="{local:Palette Background}" FontFamily="{DynamicResource GameDisplayFont}" FontSize="16" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid x:Name="BackgroundScene" Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
   <Grid x:Name="ArtworkLayer" Visibility="Collapsed">
    <Grid x:Name="ImageBackdropLayer" Opacity="0.46">
    <Image x:Name="Backdrop" Stretch="UniformToFill" HorizontalAlignment="Right" Width="610"/>
    <Image x:Name="OutgoingBackdrop" Stretch="UniformToFill" HorizontalAlignment="Right" Width="610" Opacity="0"/>
    </Grid>
    <Grid x:Name="BackgroundVideoLayer">
    <MediaElement x:Name="BackgroundMovieA" Stretch="UniformToFill" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Volume="0" IsHitTestVisible="False" Focusable="False" Opacity="0"/>
    <MediaElement x:Name="BackgroundMovieB" Stretch="UniformToFill" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Volume="0" IsHitTestVisible="False" Focusable="False" Opacity="0"/>
    </Grid>
   </Grid>
   <!-- Static shades are cached: each video frame then blends one texture instead of refilling every gradient. -->
   <Grid IsHitTestVisible="False"><Grid.CacheMode><BitmapCache/></Grid.CacheMode>
    <Rectangle x:Name="ImageBackgroundShade"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{local:Palette Background, Alpha=255}" Offset="0"/><GradientStop Color="{local:Palette Background, Alpha=244}" Offset="0.30"/><GradientStop Color="{local:Palette Background, Alpha=96}" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Rectangle x:Name="VideoBackgroundShade" Visibility="Collapsed"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{local:Palette Background, Alpha=255}" Offset="0"/><GradientStop Color="{local:Palette Background, Alpha=218}" Offset="0.30"/><GradientStop Color="{local:Palette Background, Alpha=48}" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <!-- Darkens the movie toward its edges, centred on the part the horizontal shade leaves visible. -->
    <Rectangle x:Name="VideoVignette" Visibility="Collapsed"><Rectangle.Fill><RadialGradientBrush Center="0.66,0.42" GradientOrigin="0.66,0.42" RadiusX="0.62" RadiusY="0.78"><GradientStop Color="{local:Palette Background, Alpha=0}" Offset="0"/><GradientStop Color="{local:Palette Background, Alpha=0}" Offset="0.45"/><GradientStop Color="{local:Palette Background, Alpha=110}" Offset="0.78"/><GradientStop Color="{local:Palette Background, Alpha=215}" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{local:Palette Background, Alpha=128}" Offset="0"/><GradientStop Color="{local:Palette Background, Alpha=0}" Offset="0.4"/><GradientStop Color="{local:Palette Background, Alpha=255}" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   </Grid>
  </Grid>
  <Border Background="{local:Palette Background}" BorderBrush="{local:Palette Text, Alpha=31}" BorderThickness="0,0,1,0">
   <Grid Margin="16,28,16,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Margin="12,0,0,36"><TextBlock Text="Outbreak" FontSize="20" FontFamily="{DynamicResource GameDisplayFont}"/><TextBlock x:Name="VersionLabel" Style="{StaticResource Hint}" Margin="0,2,0,0"/></StackPanel>
     <Button x:Name="NavPlay" Tag="Play" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Play" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavGraphics" Tag="Graphics" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Graphics" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavAudio" Tag="Audio" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Audio" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavController" Tag="Controller" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Controls" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavSaves" Tag="Saves" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Save games" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavCoop" Tag="Coop" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Co-op" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavMods" Tag="Mods" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Mods" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavCheats" Tag="Cheats" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Cheats" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavSetup" Tag="Setup" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Game files" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavLogs" Tag="Logs" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Log" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavDeveloper" Tag="Developer" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Developer" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
    </StackPanel>
    <StackPanel Grid.Row="2"><Button x:Name="UpdateButton" Content="Check for updates" Click="CheckForUpdates" ToolTip="Check GitHub Releases and install a newer Windows package" FontSize="14" HorizontalContentAlignment="Left"/>
     <TextBlock x:Name="UpdateState" Style="{StaticResource Hint}" FontSize="16" TextWrapping="Wrap" Margin="10,8,0,0"/>
     <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Height="4" Minimum="0" Maximum="100" Margin="10,8,0,0" Foreground="{StaticResource Accent}"/>
     <Button x:Name="UpdateCancel" Content="Cancel download" Click="CancelUpdate" Visibility="Collapsed" FontSize="16" Margin="0,8,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="34,29,34,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="PageContent" Grid.Row="1" Margin="0,0,0,18">
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid>
      <!-- Next step and the game cases take their height; the launch settings row is centred in the rest. -->
      <Grid x:Name="PagePlay"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <!-- Keep first-run setup actions visible above the larger case stage. -->
       <Border x:Name="NextStep" Background="{local:Palette Surface, Alpha=238}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="7" Padding="20,16" Margin="0,0,0,24">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock x:Name="NextStepTitle" FontSize="16" FontWeight="Normal"/><TextBlock x:Name="NextStepDetail" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
         <Button x:Name="NextStepButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="NextStepClicked" VerticalAlignment="Center" Padding="22,10"/>
        </Grid>
       </Border>
       <ListBox x:Name="GamePicker" Grid.Row="1" SelectionChanged="GameSelectionChanged" SelectedValuePath="Tag" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,22" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Choose game">
        <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBoxItem Tag="file1" Style="{StaticResource GameChoice}" AutomationProperties.Name="Outbreak File 1" Margin="0,0,9,0">
         <Border x:Name="GameCard1" BorderBrush="Transparent" BorderThickness="0">
          <StackPanel>
          <Grid Height="340">
           <TextBlock Text="#1" FontSize="142" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource GameDisplayFont}" FontWeight="Normal" Style="{StaticResource CaseNumber}" IsHitTestVisible="False"/>
           <Grid Margin="76,0,26,30" Opacity="{Binding SpotlightLevel, ElementName=GameCase1}" IsHitTestVisible="False"><Grid.CacheMode><BitmapCache/></Grid.CacheMode><Path x:Name="CaseBeam1" Data="M 0.32,0 L 0.68,0 L 0.9,1 L 0.1,1 Z" Stretch="Fill"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{local:Palette WarmIvory, Alpha=0}" Offset="0"/><GradientStop Color="{local:Palette WarmIvory, Alpha=22}" Offset="0.25"/><GradientStop Color="{local:Palette WarmIvory, Alpha=10}" Offset="0.65"/><GradientStop Color="{local:Palette WarmIvory, Alpha=0}" Offset="1"/></LinearGradientBrush></Path.Fill><Path.Effect><BlurEffect Radius="24"/></Path.Effect></Path></Grid>
           <local:GameCaseView x:Name="GameCase1" Edition="1" Margin="50,34,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          </Grid>
          <TextBlock Text="In the aftermath of a deadly viral outbreak, Raccoon City descends into chaos as its streets become overrun by the undead. Follow eight ordinary survivors, each with their own story, as they struggle to escape the collapsing city. With danger lurking around every corner and time running out, they must work together to survive the nightmare before Raccoon City is lost forever." Style="{StaticResource CaseBlurb}"/>
          </StackPanel>
         </Border>
        </ListBoxItem>
        <ListBoxItem Tag="file2" Style="{StaticResource GameChoice}" AutomationProperties.Name="Outbreak File 2" Margin="9,0,0,0">
         <Border x:Name="GameCard2" BorderBrush="Transparent" BorderThickness="0">
          <StackPanel>
          <Grid Height="340">
           <TextBlock Text="#2" FontSize="142" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource GameDisplayFont}" FontWeight="Normal" Style="{StaticResource CaseNumber}" IsHitTestVisible="False"/>
           <Grid Margin="76,0,26,30" Opacity="{Binding SpotlightLevel, ElementName=GameCase2}" IsHitTestVisible="False"><Grid.CacheMode><BitmapCache/></Grid.CacheMode><Path x:Name="CaseBeam2" Data="M 0.32,0 L 0.68,0 L 0.9,1 L 0.1,1 Z" Stretch="Fill"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{local:Palette WarmIvory, Alpha=0}" Offset="0"/><GradientStop Color="{local:Palette WarmIvory, Alpha=22}" Offset="0.25"/><GradientStop Color="{local:Palette WarmIvory, Alpha=10}" Offset="0.65"/><GradientStop Color="{local:Palette WarmIvory, Alpha=0}" Offset="1"/></LinearGradientBrush></Path.Fill><Path.Effect><BlurEffect Radius="24"/></Path.Effect></Path></Grid>
           <local:GameCaseView x:Name="GameCase2" Edition="2" Margin="50,34,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          </Grid>
          <TextBlock Text="As the nightmare in Raccoon City continues, the last remaining survivors face an increasingly desperate struggle for survival. With the deadly T-virus spreading uncontrollably and the city on the brink of destruction, eight ordinary people must navigate abandoned hospitals, infested streets, and other terrifying locations. Every moment brings them closer to either escape or becoming another victim of the outbreak." Style="{StaticResource CaseBlurb}"/>
          </StackPanel>
         </Border>
        </ListBoxItem>
       </ListBox>
       <!-- What Play will start with, as one quiet row of label/value pairs. -->
       <UniformGrid Grid.Row="2" Rows="1" VerticalAlignment="Center">
        <StackPanel Margin="0,0,24,0"><TextBlock Text="PLAY MODE" Style="{StaticResource LaunchLabel}"/><TextBlock x:Name="PlayNetworkSummary" Style="{StaticResource LaunchValue}"/></StackPanel>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="DISPLAY" Style="{StaticResource LaunchLabel}"/><TextBlock x:Name="PlayDisplaySummary" Style="{StaticResource LaunchValue}"/></StackPanel>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="CONTROLLER" Style="{StaticResource LaunchLabel}"/><TextBlock x:Name="PlayInputSummary" Style="{StaticResource LaunchValue}"/></StackPanel>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="MODS" Style="{StaticResource LaunchLabel}"/><TextBlock x:Name="PlayModsSummary" Style="{StaticResource LaunchValue}"/></StackPanel>
        <StackPanel><TextBlock Text="CHEATS" Style="{StaticResource LaunchLabel}"/><TextBlock x:Name="PlayCheatsSummary" Style="{StaticResource LaunchValue}"/></StackPanel>
       </UniformGrid>
       <TextBlock x:Name="SessionSummary" Grid.Row="2" Visibility="Collapsed"/>
      </Grid>
      <StackPanel x:Name="PageGraphics" Visibility="Collapsed">
       <CheckBox x:Name="Fullscreen" Content="Borderless fullscreen" Click="SaveSettings" ToolTip="Ctrl+Enter toggles fullscreen in game. Alt+F4 closes the game."/>
       <CheckBox x:Name="PerformanceOverlay" Content="Show performance counter" Checked="SaveSettings" Unchecked="SaveSettings" ToolTip="Show display FPS, frame time and game updates per second in the top-right corner. Applies on the next launch."/>
       <Grid Margin="0,14,0,16"><TextBlock Text="Window resolution" VerticalAlignment="Center"/><ComboBox x:Name="WindowSize" HorizontalAlignment="Right" DisplayMemberPath="Name" SelectionChanged="SettingChanged" AutomationProperties.Name="Window resolution" ToolTip="Windowed output size. Windows may limit sizes larger than your desktop. Borderless fullscreen uses the desktop resolution."/></Grid>
       <Grid Margin="0,4,0,16"><TextBlock Text="Aspect ratio" VerticalAlignment="Center"/><ComboBox x:Name="AspectRatio" HorizontalAlignment="Right" SelectionChanged="SettingChanged"><ComboBoxItem Content="4:3 (original)"/><ComboBoxItem Content="16:9 widescreen"/><ComboBoxItem Content="16:9 stretched"/><ComboBoxItem Content="21:9 ultrawide"/><ComboBoxItem Content="21:9 stretched"/><ComboBoxItem Content="32:9 super ultrawide"/><ComboBoxItem Content="32:9 stretched"/></ComboBox></Grid>
       <Grid Margin="0,4,0,16"><TextBlock Text="Screen fit" VerticalAlignment="Center"/><ComboBox x:Name="ScreenFit" HorizontalAlignment="Right" SelectionChanged="SettingChanged"><ComboBoxItem Content="Fit (centered)"/><ComboBoxItem Content="Native size (centered)"/><ComboBoxItem Content="Stretch to window"/><ComboBoxItem Content="Fill (crop edges)"/></ComboBox></Grid>
       <Grid Margin="0,4,0,16"><TextBlock Text="Image scaling" VerticalAlignment="Center"/><ComboBox x:Name="Filter" HorizontalAlignment="Right" SelectionChanged="SettingChanged"><ComboBoxItem Content="Bilinear"/><ComboBoxItem Content="Nearest"/></ComboBox></Grid>
       <Grid Margin="0,4,0,16"><TextBlock Text="Internal resolution" VerticalAlignment="Center"/><ComboBox x:Name="InternalResolution" HorizontalAlignment="Right" SelectionChanged="SettingChanged" AutomationProperties.Name="Internal resolution" ToolTip="Renders more scene detail before scaling to the output. Higher settings increase GPU load."><ComboBoxItem Content="Native"/><ComboBoxItem Content="2×" ToolTip="1024 × 896"/><ComboBoxItem Content="4×" ToolTip="2048 × 1792"/></ComboBox></Grid>
       <Grid Margin="0,4,0,16"><TextBlock Text="Texture filtering (3D)" VerticalAlignment="Center"/><ComboBox x:Name="TextureFilter" HorizontalAlignment="Right" SelectionChanged="SettingChanged"><ComboBoxItem Content="Original"/><ComboBoxItem Content="Bilinear"/></ComboBox></Grid>
       <Grid Margin="0,4,0,16"><TextBlock Text="Anisotropic filtering" VerticalAlignment="Center"/><ComboBox x:Name="AnisotropicFilter" HorizontalAlignment="Right" SelectionChanged="SettingChanged" ToolTip="Improves 3D textures viewed at an angle. Includes bilinear filtering; higher levels cost more GPU time."><ComboBoxItem Content="Off"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/><ComboBoxItem Content="8×"/><ComboBoxItem Content="16×"/></ComboBox></Grid>
       <Grid Margin="0,4,0,16"><TextBlock Text="Anti-aliasing" VerticalAlignment="Center"/><ComboBox x:Name="AntiAlias" HorizontalAlignment="Right" SelectionChanged="SettingChanged"><ComboBoxItem Content="Off"/><ComboBoxItem Content="FXAA"/><ComboBoxItem Content="SMAA"/></ComboBox></Grid>
       <Grid Margin="0,22,0,12"><TextBlock Text="Brightness and gamma" FontSize="16" FontWeight="Normal" VerticalAlignment="Center"/><Button Content="Reset" Click="ResetColor" HorizontalAlignment="Right" Padding="14,6"/></Grid>
       <Border Background="{local:Palette Background}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,18">
        <Grid Height="320"><Image x:Name="RoomPreview" Stretch="Uniform"/><TextBlock x:Name="PreviewEmpty" Text="Room preview unavailable" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
       </Border>
       <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
         <Grid><TextBlock Text="Brightness"/><TextBlock x:Name="BrightnessValue" Text="100%" HorizontalAlignment="Right"/></Grid>
         <Slider x:Name="Brightness" Minimum="50" Maximum="150" Value="100" SmallChange="1" LargeChange="10" ValueChanged="ColorChanged" Margin="0,8,0,0" AutomationProperties.Name="Brightness"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <Grid><TextBlock Text="Gamma"/><TextBlock x:Name="GammaValue" Text="1.00" HorizontalAlignment="Right"/></Grid>
         <Slider x:Name="Gamma" Minimum="0.5" Maximum="2" Value="1" SmallChange="0.01" LargeChange="0.1" ValueChanged="ColorChanged" Margin="0,8,0,0" AutomationProperties.Name="Gamma"/>
        </StackPanel>
       </Grid>
       <CheckBox x:Name="AsyncVif" Content="Parallel geometry worker" Click="SaveSettings"/>
       <CheckBox x:Name="GpuMovies" Content="Decode movies on the graphics card" Click="SaveSettings" IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
       <CheckBox x:Name="LauncherBackgroundMovies" Content="Play background movies in launcher" ToolTip="Turn off to use the normal placeholder images. Applies immediately." Checked="LauncherBackgroundMoviesChanged" Unchecked="LauncherBackgroundMoviesChanged"/>
      </StackPanel>
      <StackPanel x:Name="PageAudio" Visibility="Collapsed" MaxWidth="600" HorizontalAlignment="Left" Width="600">
       <StackPanel Margin="0,4,0,14">
        <Grid><TextBlock Text="Master"/><TextBlock x:Name="MasterVolumeValue" Text="100%" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid>
        <Slider x:Name="MasterVolume" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" ValueChanged="AudioChanged" Margin="0,6,0,0" AutomationProperties.Name="Master volume"/>
       </StackPanel>
       <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/>
       <StackPanel Margin="0,0,0,12">
        <Grid><TextBlock Text="Music"/><TextBlock x:Name="MusicVolumeValue" Text="100%" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid>
        <Slider x:Name="MusicVolume" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" ValueChanged="AudioChanged" Margin="0,6,0,0" AutomationProperties.Name="Music volume"/>
       </StackPanel>
       <StackPanel Margin="0,0,0,12">
        <Grid><TextBlock Text="Sound effects"/><TextBlock x:Name="SfxVolumeValue" Text="100%" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid>
        <Slider x:Name="SfxVolume" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" ValueChanged="AudioChanged" Margin="0,6,0,0" AutomationProperties.Name="Sound effects volume"/>
       </StackPanel>
       <StackPanel Margin="0,0,0,12">
        <Grid><TextBlock Text="Voice"/><TextBlock x:Name="VoiceVolumeValue" Text="100%" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid>
        <Slider x:Name="VoiceVolume" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" ValueChanged="AudioChanged" Margin="0,6,0,0" AutomationProperties.Name="Voice volume"/>
       </StackPanel>
       <StackPanel Margin="0,0,0,12">
        <Grid><TextBlock Text="UI"/><TextBlock x:Name="UiVolumeValue" Text="100%" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid>
        <Slider x:Name="UiVolume" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" ValueChanged="AudioChanged" Margin="0,6,0,0" AutomationProperties.Name="UI volume"/>
       </StackPanel>
       <TextBlock Text="Set a volume to 0% to mute it." Style="{StaticResource Hint}"/>
       <TextBlock Text="Cinematic audio follows Master volume." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
       <Button Content="Reset volumes" Click="ResetAudio" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      </StackPanel>
      <StackPanel x:Name="PageController" Visibility="Collapsed">
       <Grid Margin="0,4,0,17"><TextBlock Text="Input device" VerticalAlignment="Center"/><ComboBox x:Name="InputDevicePicker" Width="340" HorizontalAlignment="Right" DisplayMemberPath="Name" SelectionChanged="InputDeviceChanged"/></Grid>
       <TextBlock x:Name="ControllerDetail" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
       <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0"><TextBlock x:Name="RumbleLabel" Text="Rumble"/><TextBlock Text="Controller vibration." Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel>
        <CheckBox x:Name="RumbleSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="RumbleChanged" Unchecked="RumbleChanged" AutomationProperties.Name="Controller rumble" AutomationProperties.LabeledBy="{Binding ElementName=RumbleLabel}"/>
       </Grid>
       <WrapPanel Margin="0,0,0,18"><Button x:Name="BindingsTab" Content="Bindings" Click="ShowBindings" Margin="0,0,8,0"/><Button x:Name="LayoutTab" Content="Sticks" Click="ShowInputLayout"/></WrapPanel>
       <StackPanel x:Name="InputBindingsPanel">
        <Grid x:Name="CapturePanel" Visibility="Collapsed" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock x:Name="CaptureHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="CancelCaptureButton" Grid.Column="1" Content="Cancel" Click="CancelCapture"/></Grid>
        <UniformGrid x:Name="BindingRows" Columns="2"/>
        <Button Content="Reset bindings" Click="ResetBindings" HorizontalAlignment="Left" Margin="0,18,0,8"/>
       </StackPanel>
       <StackPanel x:Name="InputLayoutPanel" Visibility="Collapsed">
        <StackPanel x:Name="StickSettings">
         <Grid Margin="0,5,0,18"><TextBlock x:Name="DeadZoneLabel" Text="Dead zone: 12%" VerticalAlignment="Center"/><Slider x:Name="DeadZone" Minimum="0" Maximum="30" Value="12" Width="300" HorizontalAlignment="Right" ValueChanged="DeadZoneChanged"/></Grid>
         <CheckBox x:Name="SwapSticks" Content="Swap left and right sticks" Click="SaveInputOptions"/><CheckBox x:Name="InvertRightY" Content="Invert right stick Y" Click="SaveInputOptions"/>
         <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><local:StickPlot x:Name="LeftPlot" Height="140"/><local:StickPlot x:Name="RightPlot" Grid.Column="1" Height="140"/></Grid>
         <TextBlock Text="Outline: raw input. Filled dot: game input." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
        </StackPanel>
       </StackPanel>
      </StackPanel>
      <StackPanel x:Name="PageSaves" Visibility="Collapsed">
       <TextBlock Text="Memory card - Slot 1" FontSize="20"/>
       <StackPanel x:Name="CardControls" Margin="0,18,0,0">
        <ComboBox x:Name="CardSelection" SelectionChanged="CardChanged"/>
        <TextBlock x:Name="CardPath" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,18"/>
        <TextBlock Text="New card name" Margin="0,0,0,8"/>
        <WrapPanel><TextBox x:Name="NewCardName" Width="250" Margin="0,0,10,10" ToolTip="New memory card name"/><Button Content="Create card" Click="CreateCard" Margin="0,0,10,10"/><Button Content="Use existing folder" Click="BrowseCard" Margin="0,0,0,10"/></WrapPanel>
       </StackPanel>
       <TextBlock x:Name="SaveCount" Margin="0,10,0,20" Style="{StaticResource Hint}"/>
       <WrapPanel><Button Content="Open card folder" Click="OpenSaves" Margin="0,0,10,10"/><Button x:Name="BackupButton" Content="Back up card" Click="BackupSaves" Margin="0,0,0,10"/></WrapPanel>
       <TextBlock Text="8 MB PS2 card. Save and load from the game. Raw .ps2 images are not supported." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
      <StackPanel x:Name="PageCoop" Visibility="Collapsed">
       <TextBlock x:Name="CoopUnavailable" Text="Online play is unavailable for this game." Style="{StaticResource Hint}" Margin="0,0,0,16" Visibility="Collapsed"/>
       <StackPanel x:Name="CoopControls" MaxWidth="600" HorizontalAlignment="Left">
        <UniformGrid Columns="3" Margin="0,0,0,26">
         <RadioButton x:Name="ModeOffline" GroupName="CoopMode" Tag="offline" Style="{StaticResource ModeChoice}" Margin="0,0,6,0" Checked="CoopModeChanged" AutomationProperties.Name="Play alone"><StackPanel><TextBlock Text="Play alone" FontWeight="Normal"/><TextBlock Text="Single player" Style="{StaticResource Hint}"/></StackPanel></RadioButton>
         <RadioButton x:Name="ModeHost" GroupName="CoopMode" Tag="host" Style="{StaticResource ModeChoice}" Margin="3,0,3,0" Checked="CoopModeChanged" AutomationProperties.Name="Host a game"><StackPanel><TextBlock Text="Host a game" FontWeight="Normal"/><TextBlock Text="Friends join you" Style="{StaticResource Hint}"/></StackPanel></RadioButton>
         <RadioButton x:Name="ModeJoin" GroupName="CoopMode" Tag="join" Style="{StaticResource ModeChoice}" Margin="6,0,0,0" Checked="CoopModeChanged" AutomationProperties.Name="Join a game"><StackPanel><TextBlock Text="Join a game" FontWeight="Normal"/><TextBlock Text="Play in a friend's game" Style="{StaticResource Hint}"/></StackPanel></RadioButton>
        </UniformGrid>
        <StackPanel x:Name="OnlinePanel">
         <Label Content="Your player name" Target="{Binding ElementName=AccountUsername}" Padding="0" Foreground="{StaticResource Ink}"/>
         <TextBox x:Name="AccountUsername" Width="270" HorizontalAlignment="Left" TextChanged="OnlineSettingChanged" Margin="0,8,0,6" AutomationProperties.Name="Player name"/>
         <TextBlock Text="Other players see this name. 4-10 letters, numbers or _." Style="{StaticResource Hint}" Margin="0,0,0,24"/>
         <StackPanel x:Name="HostOptions">
          <TextBlock x:Name="HostStatus" FontSize="16" FontWeight="Normal" Margin="0,0,0,4"/>
          <TextBlock x:Name="HostDetail" Style="{StaticResource Hint}" Margin="0,0,0,16"/>
          <Label Content="Friends join using this address" Target="{Binding ElementName=HostAddressPicker}" Padding="0" Foreground="{StaticResource Ink}"/>
          <WrapPanel Margin="0,8,0,6"><ComboBox x:Name="HostAddressPicker" Width="360" DisplayMemberPath="Label" SelectionChanged="HostAddressChanged" Margin="0,0,10,0" AutomationProperties.Name="Address friends use"/><Button x:Name="CopyServerButton" Content="Copy address" Click="CopyServerAddress" IsEnabled="False"/></WrapPanel>
          <TextBlock Text="Friends on your network find your game automatically. Others need this address." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
          <WrapPanel><Button x:Name="FirewallButton" Content="Allow friends through Windows Firewall" Click="AllowFirewall" Margin="0,0,10,0"/><TextBlock x:Name="FirewallStatus" VerticalAlignment="Center" MaxWidth="220" Style="{StaticResource Hint}"/></WrapPanel>
          <Button x:Name="StartServerButton" Content="Try again" Click="StartServerClicked" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,12,0,0"/>
          <Expander x:Name="PortOptions" Header="Ports" Foreground="{StaticResource Muted}" Margin="0,20,0,0">
           <StackPanel Margin="0,12,0,0" MaxWidth="460" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,10"><Label Content="Player sign-up (TCP)" Target="{Binding ElementName=SignupPortBox}" Padding="0" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/><TextBox x:Name="SignupPortBox" Width="110" HorizontalAlignment="Right" MaxLength="5" LostKeyboardFocus="PortsChanged" KeyDown="PortKeyDown"/></Grid>
            <Grid Margin="0,0,0,10"><Label Content="Game server (UDP)" Target="{Binding ElementName=GamePortBox}" Padding="0" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/><TextBox x:Name="GamePortBox" Width="110" HorizontalAlignment="Right" MaxLength="5" LostKeyboardFocus="PortsChanged" KeyDown="PortKeyDown"/></Grid>
            <TextBlock Style="{StaticResource Hint}" Text="Login (9090 UDP) and the app server (10127 TCP) are built into the game and cannot change. Friends' launchers pick up your other ports automatically."/>
            <TextBlock x:Name="PortStatus" Margin="0,8,0,0"/>
            <Button Content="Use default ports" Click="ResetPorts" HorizontalAlignment="Left" Margin="0,10,0,0"/>
           </StackPanel>
          </Expander>
          <Expander x:Name="InternetOptions" Header="Playing over the internet" Foreground="{StaticResource Muted}" Margin="0,20,0,0">
           <StackPanel Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Hint}" Text="Easiest: everyone joins the same VPN, such as Tailscale or ZeroTier, and you choose its address above. Without a VPN, your router has to let friends in."/>
            <WrapPanel Margin="0,12,0,8"><Button x:Name="PublicAddressButton" Content="Find my internet address" Click="FindPublicAddress" Margin="0,0,10,0"/><TextBlock x:Name="PublicAddressStatus" VerticalAlignment="Center" MaxWidth="260" Style="{StaticResource Hint}"/></WrapPanel>
            <CheckBox x:Name="AutoForward" Content="Ask my router to open the ports automatically (UPnP)" Click="OnlineSettingChanged"/>
            <TextBlock x:Name="ReachStatus" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
            <TextBlock Text="Ports to forward in your router" Margin="0,14,0,4"/>
            <TextBlock x:Name="PortList" Style="{StaticResource Hint}"/>
           </StackPanel>
          </Expander>
         </StackPanel>
         <StackPanel x:Name="JoinOptions">
          <Grid Margin="0,0,0,10"><TextBlock Text="Games on your network" FontSize="16" FontWeight="Normal" VerticalAlignment="Center"/><Button x:Name="SearchGamesButton" Content="Search again" Click="SearchGamesClicked" HorizontalAlignment="Right" Padding="12,6"/></Grid>
          <StackPanel x:Name="FoundGames"/>
          <TextBlock x:Name="SearchStatus" Style="{StaticResource Hint}" Margin="0,4,0,20"/>
          <Label Content="Or enter the host's address" Target="{Binding ElementName=CoopHost}" Padding="0" Foreground="{StaticResource Ink}"/>
          <TextBox x:Name="CoopHost" Width="270" HorizontalAlignment="Left" MaxLength="15" TextChanged="OnlineSettingChanged" Margin="0,8,0,6" AutomationProperties.Name="Host address"/>
          <TextBlock Text="The host can copy it from their Co-op page." Style="{StaticResource Hint}"/>
         </StackPanel>
         <CheckBox x:Name="AutoLobby" Content="Take me to the waiting room automatically" Click="OnlineSettingChanged" Margin="0,26,0,4"/>
         <TextBlock x:Name="AutoLobbyHint" Style="{StaticResource Hint}"/>
         <TextBlock x:Name="CoopValidation" Margin="0,16,0,0" Visibility="Collapsed"/>
         <TextBlock x:Name="AccountStatus" Margin="0,10,0,0"/>
        </StackPanel>
       </StackPanel>
      </StackPanel>
      <StackPanel x:Name="PageMods" Visibility="Collapsed">
       <TextBlock x:Name="ModSeed" Style="{StaticResource Hint}" Margin="0,0,0,14" Visibility="Collapsed"/>
       <StackPanel x:Name="ModControls">
        <WrapPanel><Button Content="Import mod" Click="ImportMod" Margin="0,0,10,0"/><Button Content="Open mods folder" Click="OpenModFolder" Margin="0,0,10,0"/><Button Content="Reload" Click="ReloadMods"/></WrapPanel>
        <StackPanel x:Name="ModList" Margin="0,16,0,0"/>
        <TextBlock Text="To remove a mod, untick it and delete its JSON file from the mods folder." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,20,0,0"/>
       </StackPanel>
      </StackPanel>
      <StackPanel x:Name="PageCheats" Visibility="Collapsed">
       <TextBlock x:Name="CheatGame" FontSize="18" FontWeight="Normal" Margin="0,0,0,16"/>
       <StackPanel x:Name="CheatControls">
        <CheckBox x:Name="EnableCheats" Content="Enable cheats" Click="CheatToggled" Margin="0,0,0,20"/>
        <StackPanel x:Name="CheatList"/>
        <Expander Header="Custom cheats" Margin="0,24,0,0" Foreground="{StaticResource Muted}">
         <StackPanel Margin="0,16,0,0">
          <WrapPanel><Button Content="Import .pnach" Click="ImportCheats" Margin="0,0,10,0"/><Button Content="Open cheats folder" Click="OpenCheatFolder" Margin="0,0,10,0"/><Button Content="Reload" Click="ReloadCheats"/></WrapPanel>
         </StackPanel>
        </Expander>
       </StackPanel>
      </StackPanel>
      <StackPanel x:Name="PageDeveloper" Visibility="Collapsed" MaxWidth="600" HorizontalAlignment="Left">
       <TextBlock Text="Recordings are saved in each game's session folder. Leave these off for normal play; they apply on the next launch." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <TextBlock Text="Co-op network" Style="{StaticResource Section}"/>
       <CheckBox x:Name="DevNetworkTrace" Content="Packet timing" Click="DeveloperSettingChanged"/>
       <TextBlock Text="Every co-op packet's time, direction, size and header (coop-trace.jsonl). Full contents, including login, are removed when the game closes." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,14"/>
       <CheckBox x:Name="DevTransportLog" Content="Network transport log" Click="DeveloperSettingChanged"/>
       <TextBlock Text="Socket calls and results in the game log (first 256, then every 128th)." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,14"/>
       <CheckBox x:Name="DevSnapTrace" Content="SN@P packet log" Click="DeveloperSettingChanged"/>
       <TextBlock Text="Headers of the first 64 game protocol packets in the game log." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,14"/>
       <TextBlock Text="Timing" Style="{StaticResource Section}"/>
       <CheckBox x:Name="DevFrameTiming" Content="Frame timing" Click="DeveloperSettingChanged"/>
       <TextBlock Text="Per-frame start, scan-out and present times for about the first 9 minutes (frames.csv, written when the game closes)." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,14"/>
       <CheckBox x:Name="DevGameClock" Content="Game clock and player position" Click="DeveloperSettingChanged"/>
       <TextBlock Text="File #1 only. Game clock, room and your character's position for 10 minutes after entering the first room (clock.csv). Compare two players' files to see when they drift apart." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,14"/>
       <Button Content="Open session folders" Click="OpenSessionFolders" HorizontalAlignment="Left" Margin="0,8,0,0"/>
      </StackPanel>
      <StackPanel x:Name="PageSetup" Visibility="Collapsed">
       <TextBlock Text="Storage folder" FontSize="16" FontWeight="Normal"/>
       <TextBlock Text="By default, everything stays in the data folder inside the folder where you extracted the launcher. You can choose another storage folder below." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,8"/>
       <TextBox x:Name="StoragePath" IsReadOnly="True" AutomationProperties.Name="Current storage folder" Margin="0,0,0,10"/>
       <WrapPanel><Button x:Name="ChooseStorageButton" Content="Change folder…" Click="ChangeStorageFolder" Margin="0,0,10,0"/><Button Content="Open folder" Click="OpenStorageFolder"/></WrapPanel>
       <TextBlock x:Name="StorageStatus" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,24"/>
       <TextBlock Text="Disc image (.iso)"/>
       <TextBox x:Name="IsoPath" IsReadOnly="True" Margin="0,8,0,8"/>
       <WrapPanel><Button x:Name="ChooseIsoButton" Content="Choose ISO" Tag="iso" Click="BrowseFile" Margin="0,0,10,0"/><Button x:Name="ImportDiscButton" Content="Import" Click="ImportDisc"/></WrapPanel>
       <TextBlock x:Name="SupportedDiscHint" Text="Required: Outbreak File #1, NTSC-U v2.00 (SLUS-20765). PAL, Japanese and other revisions are unsupported." Style="{StaticResource Hint}" Margin="0,14,0,0"/>
       <TextBlock x:Name="DiscValidationStatus" TextWrapping="Wrap" Margin="0,10,0,0"/>
       <TextBlock x:Name="ImportState" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,18,0,10"/>
       <TextBlock Text="Already have a completed game build?" FontSize="16" FontWeight="Normal" Margin="0,24,0,10"/>
       <Button x:Name="ExistingBuildButton" Content="Use existing build" Click="UseExistingBuild" HorizontalAlignment="Left"/>
       <TextBlock x:Name="ExistingBuildHint" Text="Choose reo_recomp.exe from a compatible launcher build. Keep its entire folder, including local-build.json, DLLs and shaders. Your ISO is still required." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0"/>
       <TextBlock Text="Remove game" FontSize="16" FontWeight="Normal" Margin="0,30,0,8"/>
       <TextBlock x:Name="RemoveSummary" Style="{StaticResource Hint}" Text="Deletes the imported disc data, the built game and its build cache from this PC. Your ISO file and this launcher stay."/>
       <CheckBox x:Name="RemoveSaves" Content="Also delete save games for this game" Click="RemoveOptionsChanged" Margin="0,10,0,4"/>
       <CheckBox x:Name="RemoveTools" Content="Also remove the build and hosting tools (downloaded again when needed)" Click="RemoveOptionsChanged" Margin="0,4,0,10"/>
       <WrapPanel><Button x:Name="RemoveGameButton" Content="Remove game..." Click="RemoveGame" Margin="0,0,12,0"/><TextBlock x:Name="RemoveSize" VerticalAlignment="Center" Style="{StaticResource Hint}"/></WrapPanel>
       <Expander x:Name="DeveloperFiles" Header="Developer options" Foreground="{StaticResource Muted}" Margin="0,30,0,0">
        <StackPanel Margin="0,16,0,0">
         <TextBlock Text="Native executable"/><TextBox x:Name="ExePath" IsReadOnly="True" Margin="0,8,0,8"/><Button Content="Browse" Tag="exe" Click="BrowseFile" HorizontalAlignment="Left"/>
         <TextBlock Text="Reference ELF (File #2 development)" Margin="0,23,0,0"/><TextBox x:Name="ElfPath" IsReadOnly="True" Margin="0,8,0,8"/><Button Content="Browse" Tag="elf" Click="BrowseFile" HorizontalAlignment="Left"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </Grid>
    </ScrollViewer>
    <Grid x:Name="PageLogs" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ComboBox x:Name="LogSessionPicker" DisplayMemberPath="Name" SelectionChanged="LogSelectionChanged" Margin="0,0,0,10"/>
     <WrapPanel Grid.Row="1" Margin="0,0,0,12"><ComboBox x:Name="LogStreamPicker" SelectionChanged="LogSelectionChanged" MinWidth="180" Margin="0,0,10,0"><ComboBoxItem Content="Game debug"/><ComboBoxItem Content="Game output"/></ComboBox><Button Content="Open file" Click="BrowseLog" Margin="0,0,8,0"/><Button Content="Open folder" Click="OpenLogs"/><CheckBox x:Name="FollowLog" Content="Follow" IsChecked="True" Margin="15,6,0,6"/></WrapPanel>
     <TextBox x:Name="DebugLog" Grid.Row="2" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="{DynamicResource GameDisplayFont}" FontSize="16" Padding="12"/>
     <TextBlock x:Name="LogInfo" Grid.Row="3" Style="{StaticResource Hint}" Margin="0,9,0,0"/>
    </Grid>
   </Grid>
   <Image x:Name="OutgoingPage" Grid.Row="1" Margin="0,0,0,18" Stretch="Fill" IsHitTestVisible="False" Opacity="0"/>
   <StackPanel Grid.Row="2">
   <Border x:Name="BackgroundVideoActivity" Visibility="Collapsed" Background="{local:Palette Surface, Alpha=238}" CornerRadius="5" Padding="14" Margin="0,0,0,16">
    <StackPanel>
     <TextBlock x:Name="BackgroundVideoDetail" Text="Preparing background videos" FontWeight="Normal" Margin="0,0,0,8"/>
     <ProgressBar x:Name="BackgroundVideoProgress" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" AutomationProperties.Name="Background video preparation progress"/>
    </StackPanel>
   </Border>
   <Border x:Name="ArtworkActivity" Visibility="Collapsed" Background="{local:Palette Surface, Alpha=238}" CornerRadius="5" Padding="14" Margin="0,0,0,16">
    <StackPanel>
     <Grid Margin="0,0,0,8"><TextBlock Text="Downloading cover artwork" FontWeight="Normal"/><TextBlock x:Name="ArtworkDownloadDetail" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
     <ProgressBar x:Name="ArtworkDownloadProgress" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" AutomationProperties.Name="Cover artwork download progress"/>
    </StackPanel>
   </Border>
   <Border x:Name="ImportActivity" Visibility="Collapsed" Background="{local:Palette Surface, Alpha=238}" CornerRadius="5" Padding="14" Margin="0,0,0,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0">
      <DockPanel Margin="0,0,0,8"><TextBlock x:Name="SetupCounts" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0" Style="{StaticResource Hint}"/><TextBlock x:Name="SetupStage" FontWeight="Normal"/></DockPanel>
      <ProgressBar x:Name="DiscProgress" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" AutomationProperties.Name="Game setup progress"/>
      <TextBlock x:Name="SetupDetail" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
      <TextBlock x:Name="ImportTiming" Style="{StaticResource Hint}"/>
     </StackPanel>
     <Button Grid.Column="1" Content="Cancel setup" Click="CancelImport" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <Border x:Name="HostSetupActivity" Visibility="Collapsed" Background="{local:Palette Surface, Alpha=238}" CornerRadius="5" Padding="14" Margin="0,0,0,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0">
      <TextBlock x:Name="HostSetupStage" FontWeight="Normal" Margin="0,0,0,8"/>
      <ProgressBar x:Name="HostSetupProgress" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" AutomationProperties.Name="Server setup progress"/>
      <TextBlock x:Name="HostSetupDetail" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
     </StackPanel>
     <Button Grid.Column="1" Content="Cancel setup" Click="CancelServerSetup" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   </StackPanel>
   <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="SelectedGameLabel" FontFamily="{DynamicResource GameDisplayFont}" FontSize="30" FontWeight="Normal"/></StackPanel><Button x:Name="StopButton" Grid.Column="1" Content="Stop" Click="StopGame" IsEnabled="False" Padding="24,11" Margin="0,0,10,0"/><Button x:Name="LaunchButton" Grid.Column="2" Content="Play" Click="LaunchGame" Style="{StaticResource PrimaryButton}" Padding="42,12" MinWidth="142"/></Grid>
  </Grid>
  <!-- Status messages appear briefly in the top-right corner; MainWindow.StatusToast.cs shows and hides the card. -->
  <Border x:Name="StatusToast" Grid.Column="1" Panel.ZIndex="10" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0" MinWidth="300" MaxWidth="400" Background="{local:Palette Surface}" BorderBrush="{local:Palette Text, Alpha=46}" BorderThickness="1" CornerRadius="6" Cursor="Hand" MouseLeftButtonUp="DismissStatusToast">
   <Border.RenderTransform><TranslateTransform x:Name="StatusToastOffset"/></Border.RenderTransform>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Width="3" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="12,14,0,14"/>
    <StackPanel Grid.Column="1" Margin="12,12,18,13" VerticalAlignment="Center">
     <TextBlock x:Name="StatusToastTitle" Foreground="{local:Palette Text}" FontSize="16" FontWeight="Normal" TextWrapping="Wrap"/>
     <TextBlock x:Name="StatusToastDetail" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
     <local:StatusText x:Name="Status" Text="Ready" Visibility="Collapsed"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
