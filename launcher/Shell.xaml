<Window x:Class="Outbreak.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Outbreak.Launcher" Title="RE: Outbreak" Icon="pack://application:,,,/Outbreak.Launcher;component/Assets/app-icon.ico" Width="1320" Height="920" MinWidth="980" MinHeight="690" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" Background="{local:Palette Background}" FontFamily="{DynamicResource GameDisplayFont}" FontSize="16" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid x:Name="BackgroundScene" Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
   <Grid x:Name="ArtworkLayer" Visibility="Collapsed">
    <Grid x:Name="ImageBackdropLayer" Opacity="0.46">
    <Image x:Name="Backdrop" Stretch="UniformToFill" HorizontalAlignment="Right" Width="610"/>
    <Image x:Name="OutgoingBackdrop" Stretch="UniformToFill" HorizontalAlignment="Right" Width="610" Opacity="0"/>
    </Grid>
    <Grid x:Name="BackgroundVideoLayer">
    <MediaElement x:Name="BackgroundMovieA" Stretch="UniformToFill" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Volume="0" IsHitTestVisible="False" Focusable="False" Opacity="0"/>
    <MediaElement x:Name="BackgroundMovieB" Stretch="UniformToFill" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Volume="0" IsHitTestVisible="False" Focusable="False" Opacity="0"/>
    </Grid>
   </Grid>
   <!-- Static shades are cached: each video frame then blends one texture instead of refilling every gradient. -->
   <Grid IsHitTestVisible="False"><Grid.CacheMode><BitmapCache/></Grid.CacheMode>
    <Rectangle x:Name="ImageBackgroundShade"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{local:Palette Background, Alpha=255}" Offset="0"/><GradientStop Color="{local:Palette Background, Alpha=244}" Offset="0.30"/><GradientStop Color="{local:Palette Background, Alpha=96}" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Rectangle x:Name="VideoBackgroundShade" Visibility="Collapsed"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{local:Palette Background, Alpha=255}" Offset="0"/><GradientStop Color="{local:Palette Background, Alpha=218}" Offset="0.30"/><GradientStop Color="{local:Palette Background, Alpha=48}" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <!-- Darkens the movie toward its edges, centred on the part the horizontal shade leaves visible. -->
    <Rectangle x:Name="VideoVignette" Visibility="Collapsed"><Rectangle.Fill><RadialGradientBrush Center="0.66,0.42" GradientOrigin="0.66,0.42" RadiusX="0.62" RadiusY="0.78"><GradientStop Color="{local:Palette Background, Alpha=0}" Offset="0"/><GradientStop Color="{local:Palette Background, Alpha=0}" Offset="0.45"/><GradientStop Color="{local:Palette Background, Alpha=110}" Offset="0.78"/><GradientStop Color="{local:Palette Background, Alpha=215}" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{local:Palette Background, Alpha=128}" Offset="0"/><GradientStop Color="{local:Palette Background, Alpha=0}" Offset="0.4"/><GradientStop Color="{local:Palette Background, Alpha=255}" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   </Grid>
  </Grid>
  <Border Background="{local:Palette Background}" BorderBrush="{local:Palette Text, Alpha=31}" BorderThickness="0,0,1,0">
   <Grid Margin="16,28,16,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="NavigationScroll" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
    <StackPanel>
     <StackPanel Margin="12,0,0,36"><TextBlock Text="Outbreak" FontSize="20" FontFamily="{DynamicResource GameDisplayFont}"/><TextBlock x:Name="VersionLabel" Style="{StaticResource Hint}" Margin="0,2,0,0"/></StackPanel>
     <Button x:Name="NavPlay" Tag="Play" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Play" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavGraphics" Tag="Graphics" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Graphics" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavAudio" Tag="Audio" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Audio" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavController" Tag="Controller" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Controls" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavSaves" Tag="Saves" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Save games" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavCoop" Tag="Coop" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Co-op" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavMods" Tag="Mods" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Mods" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavCheats" Tag="Cheats" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Cheats" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavSetup" Tag="Setup" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Game files" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavLauncher" Tag="Launcher" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Launcher" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavLogs" Tag="Logs" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Log" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     <Button x:Name="NavDeveloper" Tag="Developer" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,3,0,3" Style="{StaticResource NavButton}"><TextBlock Text="Developer" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
    </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
     <TextBlock x:Name="UpdateState" FontSize="16" TextWrapping="Wrap" Margin="10,0,0,8"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Height="4" Minimum="0" Maximum="100" Margin="10,0,0,8" Foreground="{StaticResource Accent}"/>
     <Button x:Name="UpdateCancel" Content="Cancel download" Click="CancelUpdate" Visibility="Collapsed" FontSize="16" Margin="0,0,0,8"/>
     <Button x:Name="UpdateButton" Content="Check for updates" Click="CheckForUpdates" ToolTip="Check GitHub Releases and install a newer Windows package" FontSize="14" HorizontalContentAlignment="Left"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="34,29,34,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="PageContent" Grid.Row="1" Margin="0,0,0,18">
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid>
      <!-- Next step and the game cases take their height; the launch settings row is centred in the rest. -->
      <Grid x:Name="PagePlay"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <!-- Both editions share the measured notice slot, so choosing a ready
            game cannot pull the cases upward while the other still needs setup. -->
       <Grid x:Name="NextStepSlot">
       <Border x:Name="NextStep" Background="{local:Palette Surface, Alpha=238}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="7" Padding="20,16" Margin="0,0,0,24">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock x:Name="NextStepTitle" FontSize="16" FontWeight="Normal"/><TextBlock x:Name="NextStepDetail" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
         <Button x:Name="NextStepButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="NextStepClicked" VerticalAlignment="Center" Padding="22,10"/>
        </Grid>
       </Border>
       <Border x:Name="NextStepMeasure" Visibility="Hidden" IsHitTestVisible="False" Focusable="False" BorderThickness="1" Padding="20,16" Margin="0,0,0,24">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock x:Name="NextStepMeasureTitle" FontSize="16" FontWeight="Normal"/><TextBlock x:Name="NextStepMeasureDetail" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
         <Button x:Name="NextStepMeasureButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="22,10" Focusable="False"/>
        </Grid>
       </Border>
       </Grid>
       <ListBox x:Name="GameCasePicker" Grid.Row="1" SelectionChanged="GameSelectionChanged" RequestBringIntoView="KeepPlayViewport" SelectedValuePath="Tag" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,22" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Choose game">
        <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBoxItem Tag="file1" Style="{StaticResource GameChoice}" AutomationProperties.Name="Outbreak File 1" Margin="0,0,9,0">
         <Border x:Name="GameCard1" BorderBrush="Transparent" BorderThickness="0">
          <StackPanel>
          <Grid Height="340">
           <TextBlock Text="#1" FontSize="142" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource GameDisplayFont}" FontWeight="Normal" Style="{StaticResource CaseNumber}" IsHitTestVisible="False"/>
           <Grid Margin="76,0,26,30" Opacity="{Binding SpotlightLevel, ElementName=GameCase1}" IsHitTestVisible="False"><Grid.CacheMode><BitmapCache/></Grid.CacheMode><Path x:Name="CaseBeam1" Data="M 0.32,0 L 0.68,0 L 0.9,1 L 0.1,1 Z" Stretch="Fill"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{local:Palette WarmIvory, Alpha=0}" Offset="0"/><GradientStop Color="{local:Palette WarmIvory, Alpha=22}" Offset="0.25"/><GradientStop Color="{local:Palette WarmIvory, Alpha=10}" Offset="0.65"/><GradientStop Color="{local:Palette WarmIvory, Alpha=0}" Offset="1"/></LinearGradientBrush></Path.Fill><Path.Effect><BlurEffect Radius="24"/></Path.Effect></Path></Grid>
           <local:GameCaseView x:Name="GameCase1" Edition="1" Margin="50,34,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          </Grid>
          <TextBlock Text="In the aftermath of a deadly viral outbreak, Raccoon City descends into chaos as its streets become overrun by the undead. Follow eight ordinary survivors, each with their own story, as they struggle to escape the collapsing city. With danger lurking around every corner and time running out, they must work together to survive the nightmare before Raccoon City is lost forever." Style="{StaticResource CaseBlurb}"/>
          </StackPanel>
         </Border>
        </ListBoxItem>
        <ListBoxItem Tag="file2" Style="{StaticResource GameChoice}" AutomationProperties.Name="Outbreak File 2" Margin="9,0,0,0">
         <Border x:Name="GameCard2" BorderBrush="Transparent" BorderThickness="0">
          <StackPanel>
          <Grid Height="340">
           <TextBlock Text="#2" FontSize="142" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource GameDisplayFont}" FontWeight="Normal" Style="{StaticResource CaseNumber}" IsHitTestVisible="False"/>
           <Grid Margin="76,0,26,30" Opacity="{Binding SpotlightLevel, ElementName=GameCase2}" IsHitTestVisible="False"><Grid.CacheMode><BitmapCache/></Grid.CacheMode><Path x:Name="CaseBeam2" Data="M 0.32,0 L 0.68,0 L 0.9,1 L 0.1,1 Z" Stretch="Fill"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{local:Palette WarmIvory, Alpha=0}" Offset="0"/><GradientStop Color="{local:Palette WarmIvory, Alpha=22}" Offset="0.25"/><GradientStop Color="{local:Palette WarmIvory, Alpha=10}" Offset="0.65"/><GradientStop Color="{local:Palette WarmIvory, Alpha=0}" Offset="1"/></LinearGradientBrush></Path.Fill><Path.Effect><BlurEffect Radius="24"/></Path.Effect></Path></Grid>
           <local:GameCaseView x:Name="GameCase2" Edition="2" Margin="50,34,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          </Grid>
          <TextBlock Text="As the nightmare in Raccoon City continues, the last remaining survivors face an increasingly desperate struggle for survival. With the deadly T-virus spreading uncontrollably and the city on the brink of destruction, eight ordinary people must navigate abandoned hospitals, infested streets, and other terrifying locations. Every moment brings them closer to either escape or becoming another victim of the outbreak." Style="{StaticResource CaseBlurb}"/>
          </StackPanel>
         </Border>
        </ListBoxItem>
       </ListBox>
       <!-- What Play will start with, as one quiet row of label/value pairs. -->
       <UniformGrid Grid.Row="2" Rows="1" VerticalAlignment="Center">
        <StackPanel Margin="0,0,24,0"><TextBlock Text="PLAY MODE" Style="{StaticResource LaunchLabel}"/><TextBlock x:Name="PlayNetworkSummary" Style="{StaticResource LaunchValue}"/></StackPanel>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="DISPLAY" Style="{StaticResource LaunchLabel}"/><TextBlock x:Name="PlayDisplaySummary" Style="{StaticResource LaunchValue}"/></StackPanel>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="CONTROLLER" Style="{StaticResource LaunchLabel}"/><TextBlock x:Name="PlayInputSummary" Style="{StaticResource LaunchValue}"/></StackPanel>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="MODS" Style="{StaticResource LaunchLabel}"/><TextBlock x:Name="PlayModsSummary" Style="{StaticResource LaunchValue}"/></StackPanel>
        <StackPanel><TextBlock Text="CHEATS" Style="{StaticResource LaunchLabel}"/><TextBlock x:Name="PlayCheatsSummary" Style="{StaticResource LaunchValue}"/></StackPanel>
       </UniformGrid>
       <TextBlock x:Name="SessionSummary" Grid.Row="2" Visibility="Collapsed"/>
      </Grid>
      <Grid x:Name="PageGraphics" Visibility="Collapsed" MaxWidth="1120" HorizontalAlignment="Stretch">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid Margin="0,3,0,18">
        <TextBlock Text="Picture configuration" FontSize="24"/>
       </Grid>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" MinWidth="300"/><ColumnDefinition Width="24"/><ColumnDefinition Width="0.8*" MinWidth="280" MaxWidth="380"/></Grid.ColumnDefinitions>
        <ScrollViewer x:Name="GraphicsSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
         <StackPanel x:Name="GraphicsSettingsList">
          <TextBlock Text="DISPLAY" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,10"/>
          <Grid MinHeight="42" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="Borderless fullscreen" FontSize="14" VerticalAlignment="Center"/>
           <CheckBox x:Name="Fullscreen" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="SaveSettings" Unchecked="SaveSettings" AutomationProperties.Name="Borderless fullscreen" ToolTip="Ctrl+Enter toggles fullscreen in game."/>
          </Grid>
          <DockPanel MinHeight="48"><ComboBox x:Name="WindowSize" DockPanel.Dock="Right" Style="{StaticResource GraphicsChoice}" SelectionChanged="SettingChanged" AutomationProperties.Name="Window resolution" ToolTip="Windowed output size. Borderless fullscreen uses the desktop resolution."><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Width}"/><Run Text=" × "/><Run Text="{Binding Height}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Window resolution" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/></DockPanel>
          <DockPanel MinHeight="48"><ComboBox x:Name="AspectRatio" DockPanel.Dock="Right" Style="{StaticResource GraphicsChoice}" SelectionChanged="SettingChanged" AutomationProperties.Name="Aspect ratio"><ComboBoxItem Content="4:3 original"/><ComboBoxItem Content="16:9 widescreen"/><ComboBoxItem Content="16:9 stretched"/><ComboBoxItem Content="21:9 ultrawide"/><ComboBoxItem Content="21:9 stretched"/><ComboBoxItem Content="32:9 ultrawide"/><ComboBoxItem Content="32:9 stretched"/></ComboBox><TextBlock Text="Aspect ratio" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/></DockPanel>
          <DockPanel MinHeight="48"><ComboBox x:Name="ScreenFit" DockPanel.Dock="Right" Style="{StaticResource GraphicsChoice}" SelectionChanged="SettingChanged" AutomationProperties.Name="Screen fit"><ComboBoxItem Content="Fit"/><ComboBoxItem Content="Native size"/><ComboBoxItem Content="Stretch to window"/><ComboBoxItem Content="Fill"/></ComboBox><TextBlock Text="Screen fit" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/></DockPanel>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,16"/>
          <TextBlock Text="RENDERING" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,8"/>
          <DockPanel MinHeight="48"><ComboBox x:Name="InternalResolution" DockPanel.Dock="Right" Style="{StaticResource GraphicsChoice}" SelectionChanged="SettingChanged" AutomationProperties.Name="Internal resolution" ToolTip="Renders more scene detail before scaling. Higher settings increase GPU load."><ComboBoxItem Content="Native"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/></ComboBox><TextBlock Text="Internal resolution" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/></DockPanel>
          <DockPanel MinHeight="48"><ComboBox x:Name="TextureFilter" DockPanel.Dock="Right" Style="{StaticResource GraphicsChoice}" SelectionChanged="SettingChanged" AutomationProperties.Name="Texture filtering"><ComboBoxItem Content="Original"/><ComboBoxItem Content="Bilinear"/></ComboBox><TextBlock Text="Texture filtering" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/></DockPanel>
          <DockPanel MinHeight="48"><ComboBox x:Name="AnisotropicFilter" DockPanel.Dock="Right" Style="{StaticResource GraphicsChoice}" SelectionChanged="SettingChanged" AutomationProperties.Name="Anisotropic filtering" ToolTip="Sharpens textures viewed at an angle. Includes bilinear filtering."><ComboBoxItem Content="Off"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/><ComboBoxItem Content="8×"/><ComboBoxItem Content="16×"/></ComboBox><TextBlock Text="Anisotropic filtering" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/></DockPanel>
          <DockPanel MinHeight="48"><ComboBox x:Name="AntiAlias" DockPanel.Dock="Right" Style="{StaticResource GraphicsChoice}" SelectionChanged="SettingChanged" AutomationProperties.Name="Anti-aliasing"><ComboBoxItem Content="Off"/><ComboBoxItem Content="FXAA"/><ComboBoxItem Content="SMAA"/></ComboBox><TextBlock Text="Anti-aliasing" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/></DockPanel>
          <DockPanel MinHeight="48"><ComboBox x:Name="Filter" DockPanel.Dock="Right" Style="{StaticResource GraphicsChoice}" SelectionChanged="SettingChanged" AutomationProperties.Name="Image scaling"><ComboBoxItem Content="Bilinear"/><ComboBoxItem Content="Nearest"/></ComboBox><TextBlock Text="Image scaling" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/></DockPanel>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,16"/>
          <Grid Margin="0,0,0,12"><TextBlock Text="PICTURE" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center"/><Button Content="Reset" Click="ResetColor" HorizontalAlignment="Right" Padding="12,5" FontSize="14" AutomationProperties.Name="Reset brightness and gamma"/></Grid>
          <Grid><TextBlock Text="Brightness" FontSize="14"/><TextBlock x:Name="BrightnessValue" Text="100%" HorizontalAlignment="Right" FontSize="14"/></Grid>
          <Slider x:Name="Brightness" Style="{StaticResource AudioSlider}" Minimum="50" Maximum="150" Value="100" SmallChange="1" LargeChange="10" ValueChanged="ColorChanged" Margin="0,4,0,12" AutomationProperties.Name="Brightness"/>
          <Grid><TextBlock Text="Gamma" FontSize="14"/><TextBlock x:Name="GammaValue" Text="1.00" HorizontalAlignment="Right" FontSize="14"/></Grid>
          <Slider x:Name="Gamma" Style="{StaticResource AudioSlider}" Minimum="0.5" Maximum="2" Value="1" SmallChange="0.01" LargeChange="0.1" ValueChanged="ColorChanged" Margin="0,4,0,14" AutomationProperties.Name="Gamma"/>
          <Expander Header="More options" Style="{StaticResource ModOptionsDropdown}" Margin="0,4,0,6">
           <StackPanel>
            <CheckBox x:Name="PerformanceOverlay" Content="FPS counter" FontSize="14" Checked="SaveSettings" Unchecked="SaveSettings" ToolTip="Shows the in-game FPS counter. Applies on the next launch."/>
            <CheckBox x:Name="AsyncVif" Content="Parallel geometry worker" FontSize="14" Checked="SaveSettings" Unchecked="SaveSettings"/>
            <CheckBox x:Name="GpuMovies" Content="Decode movies on the graphics card" FontSize="14" Checked="SaveSettings" Unchecked="SaveSettings" IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
           </StackPanel>
          </Expander>
         </StackPanel>
        </ScrollViewer>
        <Grid x:Name="GraphicsPreviewPane" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid Margin="0,0,0,10"><TextBlock x:Name="GraphicsPreviewTitle" Text="PREVIEW" Foreground="{StaticResource Muted}" FontSize="14"/><TextBlock x:Name="GraphicsPreviewState" Text="Live preview" HorizontalAlignment="Right" FontSize="14" Foreground="{StaticResource Muted}"/></Grid>
         <Border x:Name="GraphicsPreviewStage" Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{local:Palette Background}" ClipToBounds="True">
          <Grid><Image x:Name="RoomPreview" Visibility="Collapsed" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.Name="Kevin graphics preview"/><local:GraphicsPreviewHost x:Name="GraphicsGpuView" Visibility="Collapsed" AutomationProperties.Name="Rotate and zoom Kevin preview" AutomationProperties.HelpText="Drag to rotate. Scroll to zoom. Release to keep the angle. Home restores the default view."/><TextBlock x:Name="PreviewEmpty" Text="Loading Kevin…" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
         </Border>
         <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <TextBlock x:Name="GraphicsPreviewCaption" Text="Drag to rotate. Scroll to zoom." FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
         </StackPanel>
        </Grid>
       </Grid>
      </Grid>
      <StackPanel x:Name="PageAudio" Visibility="Collapsed" MaxWidth="940" HorizontalAlignment="Stretch">
       <Grid Margin="0,3,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Sound configuration" FontSize="24"/>
        <TextBlock x:Name="AudioEditionLabel" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center"/>
       </Grid>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Output device" FontSize="18" VerticalAlignment="Center"/>
        <ComboBox x:Name="AudioOutputPicker" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="AudioOutputChanged" DropDownOpened="AudioOutputOpened" AutomationProperties.Name="Audio output device"/>
       </Grid>
       <TextBlock x:Name="AudioOutputHint" Visibility="Collapsed" Style="{StaticResource Hint}" FontSize="14" Margin="170,6,0,0"/>
       <Grid x:Name="AudioSubtitlesRow" Height="48"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock x:Name="AudioSubtitlesLabel" Text="Subtitles" FontSize="18" VerticalAlignment="Center"/>
        <CheckBox x:Name="AudioSubtitles" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="SubtitlesChanged" Unchecked="SubtitlesChanged" AutomationProperties.Name="Subtitles" AutomationProperties.LabeledBy="{Binding ElementName=AudioSubtitlesLabel}" AutomationProperties.HelpText="Show captions for spoken dialogue."/>
       </Grid>
       <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,10"/>
       <TextBlock x:Name="AudioChannelNote" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,8"/>
        <Grid Height="56" x:Name="AudioMasterRow"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="64"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
         <TextBlock Text="Master volume" FontSize="18" VerticalAlignment="Center"/>
         <Slider x:Name="MasterVolume" Grid.Column="1" Style="{StaticResource AudioSlider}" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" ValueChanged="AudioChanged" AutomationProperties.Name="Master volume" VerticalAlignment="Center"/>
         <TextBlock x:Name="MasterVolumeValue" Grid.Column="2" Text="100%" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
       <StackPanel x:Name="AudioChannels">
        <Grid Height="56" ><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="64"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
         <TextBlock Text="Music" FontSize="18" VerticalAlignment="Center"/>
