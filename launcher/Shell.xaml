             </Grid>
            </Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsSelected" Value="True"><Setter TargetName="CardRow" Property="Background" Value="{local:Palette Accent, Alpha=22}"/><Setter TargetName="CardMark" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="CardInUse" Property="Visibility" Value="Visible"/></Trigger>
             <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardRow" Property="Background" Value="{local:Palette Text, Alpha=14}"/></Trigger>
             <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CardRow" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
             <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate></Setter.Value></Setter>
          </Style></ListBox.ItemContainerStyle>
